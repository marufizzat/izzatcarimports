---
// Cada categoria = uma peca REAL do nosso estoque, recortada (public/categorias).
import { resumo } from '../lib/dados';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
// categoria nova (sem recorte ainda) usa o disco aprovado de pecas
const img = (k: string) => existsSync(join(process.cwd(), 'public', 'categorias', `${k}-360.webp`)) ? `/categorias/${k}-360.webp` : '/icones/pecas-192.webp';
const fams = resumo().familias.filter((f) => f.n !== 'Outros');
const nomes: Record<string, string> = { 'Peças de Interior': 'Interior', 'Peças de Exterior': 'Exterior' };
---
<ul class="cats">
  {fams.map((f) => (
    <li>
      <a class="cat" href={`/catalogo.html?tipo=${encodeURIComponent(f.n)}`}>
        <span class="cat-palco"><img src={img(f.k)} alt="" width="360" height="360" loading="lazy" decoding="async" /></span>
        <span class="cat-nome">{nomes[f.n] ?? f.n}</span>
        <span class="cat-qtd num">{f.c.toLocaleString('pt-BR')} peças</span>
      </a>
    </li>
  ))}
  <li>
    <a class="cat cat-procura" href="/procuro-peca.html">
      <span class="cat-palco"><img src="/icones/conversa-192.webp" alt="" width="96" height="96" loading="lazy" class="cat-icone" /></span>
      <span class="cat-nome">Não achou?</span>
      <span class="cat-qtd">A gente procura no pátio</span>
    </a>
  </li>
</ul>
<style>
  .cats { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .cats li { display: grid; }
  @media (min-width: 640px) { .cats { grid-template-columns: repeat(4, 1fr); gap: 14px; } }
  
  @media (min-width: 1180px) { .cats { grid-template-columns: repeat(5, 1fr); } }
  .cat { position: relative; display: grid; grid-template-rows: auto auto 1fr; align-content: start; padding: 12px 14px 14px; border-radius: 18px;
         background: var(--surface); box-shadow: var(--shadow-1); isolation: isolate;
         transition: transform .3s cubic-bezier(.2,.7,.2,1), box-shadow .3s ease; }
  .cat-palco { position: relative; display: block; aspect-ratio: 16 / 11; }
  @media (min-width: 640px) { .cat-palco { aspect-ratio: 4 / 3; } }
  .cat-procura { background: var(--accent-soft); box-shadow: inset 0 0 0 1.5px color-mix(in oklab, var(--accent), transparent 55%); }
  .cat .cat-icone { inset: 18% 30% 18%; width: 40%; height: 64%; }
  .cat-palco::before { content: ""; position: absolute; inset: 14% 10% 4%; border-radius: 50%; z-index: -1;
         background: radial-gradient(closest-side, color-mix(in oklab, var(--accent), transparent 86%), transparent); opacity: 0; transition: opacity .35s ease; }
  .cat-palco::after { content: ""; position: absolute; left: 22%; right: 22%; bottom: 4%; height: 8%; border-radius: 50%; z-index: -1;
         background: radial-gradient(closest-side, rgb(0 0 0 / .22), transparent); filter: blur(2px); }
  .cat img { position: absolute; inset: 4% 7% 10%; width: 86%; height: 86%; object-fit: contain; transition: transform .45s cubic-bezier(.2,.7,.2,1); }
  .cat-nome { margin-top: 6px; font-weight: 700; font-size: 15px; font-stretch: 90%; line-height: 1.2; }
  @media (min-width: 640px) { .cat { padding: 14px 16px 16px; } .cat-nome { font-size: 16px; } }
  .cat-qtd { font-size: 13.5px; color: var(--ink-2); }
  @media (hover: hover) {
    .cat:hover { transform: translateY(-3px); box-shadow: var(--shadow-2); }
    .cat:hover img { transform: translateY(-4px) rotate(-2deg) scale(1.04); }
    .cat:hover .cat-palco::before { opacity: 1; }
  }
</style>
