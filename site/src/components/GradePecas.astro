---
import CartaoPeca from './CartaoPeca.astro';
import type { Peca } from '../lib/dados';
interface Props { lista: Peca[]; total: number; linkTodas: string; rotulo?: string; }
const { lista, total, linkTodas, rotulo } = Astro.props;
---
<div class="grade-pecas">{lista.map((p, i) => <CartaoPeca p={p} eager={i < 2} />)}</div>
{total > lista.length && (
  <div class="grade-mais"><a class="botao botao-grafite" href={linkTodas}>{rotulo ?? `Ver as ${total.toLocaleString('pt-BR')} peças no catálogo`}</a></div>
)}
<style>
  .grade-pecas { display: grid; gap: 12px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 700px) { .grade-pecas { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; } }
  @media (min-width: 1100px) { .grade-pecas { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px; } }
  .grade-mais { display: flex; justify-content: center; margin-top: 32px; }
</style>
