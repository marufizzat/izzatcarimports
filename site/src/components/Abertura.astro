---
// Abertura da home (direcao A): pergunta + busca + seletor de carro, e a janela
// com o video REAL do showroom, o selo do CDV e uma peca de verdade flutuando.
import Icone from './Icone.astro';
import SeletorCarro from './SeletorCarro.astro';
import SeloCDV from './SeloCDV.astro';
import Selos from './Selos.astro';
import Video from './Video.astro';
import { foto, brl } from '../lib/dados';
import type { Peca } from '../lib/dados';
interface Props { destaque: Peca; }
const { destaque } = Astro.props;
---
<section class="abertura">
  <div class="moldura abertura-grade">
    <div class="abertura-texto">
      <h1 class="display abertura-h1">Qual peça o seu carro precisa?</h1>
      <p class="lead abertura-lead">Peças originais de carros com baixa legal no Detran-RS. Nota fiscal e 90 dias de garantia em toda peça.</p>
      <div class="abertura-busca"><slot name="busca">
        <form class="busca" action="/catalogo.html" method="get" role="search">
          <Icone nome="busca" />
          <input name="q" type="search" placeholder="Peça, carro ou código" aria-label="Buscar peça" autocomplete="off" />
          <button class="botao botao-laranja" type="submit">Buscar</button>
        </form>
      </slot></div>
      <p class="abertura-ou">Ou escolha o seu carro</p>
      <SeletorCarro />
    </div>
    <div class="abertura-janela">
      <div class="janela">
        <Video nome="v-showroom" class="janela-video" rotulo="Showroom da Izzat Car Imports em Aceguá" prioridade />
      </div>
      <SeloCDV class="abertura-selo" tamanho={128} />
      <a class="abertura-peca" href={`/peca/${destaque.slug}.html`}>
        <img src={foto(destaque.fotos[0], 'C')} alt="" width="88" height="88" />
        <span><small>{[destaque.b, destaque.m].filter(Boolean).join(' ')}</small><b>{destaque.n}</b><em class="num">R$ {brl(destaque.p)}</em></span>
      </a>
    </div>
  </div>
  <div class="moldura abertura-selos"><Selos /></div>
</section>

<style>
  .abertura { padding-block: 24px 48px; }
  .abertura-grade { display: grid; gap: 36px; align-items: center; }
  @media (min-width: 1024px) { .abertura-grade { grid-template-columns: minmax(0, 1.06fr) minmax(0, .94fr); gap: 64px; padding-top: 28px; } }
  .abertura-texto { display: grid; gap: 18px; min-width: 0; }
  .abertura-h1 { margin: 0; font-size: clamp(44px, 6.4vw, 84px); }
  .abertura-lead { margin: 0; max-width: 44ch; }
  .abertura-ou { margin: 8px 0 -6px; font-size: 14px; font-weight: 600; color: var(--ink-2); }
  .abertura-janela { position: relative; padding: 0 8px 28px 0; min-width: 0; }
  .janela { position: relative; aspect-ratio: 4 / 5; border-radius: 28px; overflow: hidden; background: #2a2a2e; box-shadow: var(--shadow-2); }
  @media (max-width: 1023px) { .janela { aspect-ratio: 1 / 1.02; } }
  .janela :global(.janela-video) { width: 100%; height: 100%; object-fit: cover; }
  .abertura-janela :global(.abertura-selo) { position: absolute; top: -18px; right: -6px; filter: drop-shadow(0 12px 22px rgb(150 60 0 / .35)); }
  @media (max-width: 640px) { .abertura-janela :global(.abertura-selo) { width: 92px; height: 92px; top: -14px; right: 2px; } }
  .abertura-peca { position: absolute; left: -14px; bottom: 0; display: flex; gap: 12px; align-items: center; padding: 10px 16px 10px 10px;
                   max-width: 340px; border-radius: 18px; background: var(--surface); box-shadow: var(--shadow-2); transition: transform .3s ease; }
  .abertura-peca:hover { transform: translateY(-3px); }
  @media (max-width: 640px) { .abertura-peca { left: 10px; right: 18px; bottom: 6px; max-width: none; } }
  .abertura-peca img { width: 72px; height: 72px; flex: none; border-radius: 12px; object-fit: contain; background: var(--plate); box-shadow: inset 0 0 0 1px var(--line); }
  .abertura-peca span { display: grid; gap: 2px; min-width: 0; }
  .abertura-peca small { font-size: 12px; font-weight: 650; color: var(--accent-text); }
  .abertura-peca b { font-size: 14.5px; font-weight: 600; line-height: 1.25; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
  .abertura-peca em { font-style: normal; font-stretch: 84%; font-weight: 800; font-size: 19px; }
  .abertura-selos { margin-top: 44px; padding-top: 28px; border-top: 1px solid var(--line); }
</style>
