---
// Cartao de carro: mosaico com 4 fotos REAIS de pecas desse carro + nome + anos + total.
import type { Resumo } from '../lib/dados';
import { foto } from '../lib/dados';
interface Props { c: Resumo['carros'][number]; }
const { c } = Astro.props;
const capas = [...c.capas, ...c.capas].slice(0, 4);
---
<a class="carro" href={`/carros/${c.k}.html`}>
  <span class="carro-mosaico" aria-hidden="true">
    {capas.map((k) => <img src={foto(k, 'V')} alt="" width="160" height="160" loading="lazy" decoding="async" />)}
  </span>
  <span class="carro-dados">
    <span class="carro-marca">{c.b}</span>
    <span class="carro-nome">{c.m}</span>
    <span class="carro-meta num"><span>{c.anos ? `${c.anos[0]} a ${c.anos[1]}` : 'Vários anos'}</span><span class="carro-qtd">{c.c} peças</span></span>
  </span>
</a>
<style>
  .carro { display: grid; gap: 14px; padding: 10px 10px 16px; border-radius: 20px; background: var(--surface); box-shadow: var(--shadow-1);
           transition: transform .3s cubic-bezier(.2,.7,.2,1), box-shadow .3s ease; }
  .carro-mosaico { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; border-radius: 14px; overflow: hidden; background: var(--line); }
  .carro-mosaico img { aspect-ratio: 1; width: 100%; object-fit: contain; background: var(--plate); padding: 8%; transition: transform .5s ease; }
  .carro-dados { display: grid; gap: 2px; padding: 0 6px; }
  .carro-marca { font-size: 13px; font-weight: 650; color: var(--accent-text); }
  .carro-nome { font-stretch: 78%; font-weight: 820; font-size: 26px; line-height: 1.05; }
  .carro-meta { display: flex; flex-direction: column; gap: 0; font-size: 13.5px; color: var(--ink-2); white-space: nowrap; }
  @media (min-width: 900px) { .carro-meta { flex-direction: row; align-items: center; gap: 8px; }
    .carro-qtd::before { content: ""; display: inline-block; width: 4px; height: 4px; margin-right: 8px; border-radius: 50%; background: var(--ink-3); vertical-align: middle; } }
  @media (hover: hover) { .carro:hover { transform: translateY(-3px); box-shadow: var(--shadow-2); }
    .carro:hover .carro-mosaico img:first-child { transform: scale(1.06); } }
</style>
