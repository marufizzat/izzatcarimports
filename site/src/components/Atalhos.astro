---
interface Props { titulo: string; itens: [string, number, string][]; }
const { titulo, itens } = Astro.props;
---
{itens.length > 0 && (
  <nav class="atalhos" aria-label={titulo}>
    <p>{titulo}</p>
    <div>{itens.map(([n, c, h]) => <a href={h}>{n}<span class="num">{c.toLocaleString('pt-BR')}</span></a>)}</div>
  </nav>
)}
<style>
  .atalhos { margin-top: 24px; }
  .atalhos p { margin: 0 0 10px; font-size: 14px; font-weight: 600; color: var(--ink-2); }
  .atalhos div { display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; padding: 2px 2px 6px; }
  @media (min-width: 900px) { .atalhos div { flex-wrap: wrap; overflow: visible; } }
  .atalhos a { flex: none; display: inline-flex; align-items: center; gap: 8px; padding: 10px 14px; border-radius: 12px; background: var(--surface);
               box-shadow: inset 0 0 0 1px var(--line); font-weight: 600; font-size: 14.5px; transition: box-shadow .2s; }
  .atalhos a:hover { box-shadow: inset 0 0 0 1.5px var(--accent); }
  .atalhos span { font-size: 12.5px; color: var(--ink-3); font-weight: 500; }
</style>
