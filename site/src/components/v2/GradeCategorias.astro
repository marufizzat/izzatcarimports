---
// Categorias: uma ARTE por família (peça em estúdio + nome desenhado na arte) + nº de peças vivo.
// Referência de layout: Shop by Category Grid (ziegfiroyt/ecommerce4, 21st.dev #29288) em bento.
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { resumo } from '../../lib/dados';
const fams = resumo().familias.filter((f) => f.n !== 'Outros' && existsSync(join(process.cwd(), 'public', 'arte', 'v2', `cat-${f.k}.webp`)));
const NO_CELULAR = 8;
---
<div class="cats" data-cats>
  <p class="cats-carro" data-cats-carro hidden>
    <span>Contando as peças do <b data-cats-nome></b>.</span>
    <button type="button" data-cats-trocar>Trocar carro</button>
  </p>
  <ul class="cats-grade">
    {fams.map((f, i) => (
      <li class:list={['cat', { 'cat-grande': i < 2, 'cat-extra': i >= NO_CELULAR }]}>
        <a href={`/categoria/${f.k}.html`} data-tipo={f.n} data-href-base={`/categoria/${f.k}.html`} data-base={f.c} aria-label={`${f.n}: ${f.c.toLocaleString('pt-BR')} peças`}>
          <img src={`/arte/v2/cat-${f.k}.webp`} alt="" width="800" height="800" loading="lazy" decoding="async" />
          <span class="cat-qtd num" data-qtd>{f.c.toLocaleString('pt-BR')} peças</span>
        </a>
      </li>
    ))}
  </ul>
  {fams.length > NO_CELULAR && (
    <button type="button" class="botao botao-linha cats-mais" data-mais aria-expanded="false">Ver as {fams.length} categorias</button>
  )}
</div>
<script>
  import { lerMeuCarro, serveNoModelo, anosNoModelo, EVENTO, type MeuCarro } from '../../lib/meuCarro';
  // Com carro salvo, cada categoria mostra a contagem DELE (busca.json so e baixado nesse caso).
  type Indice = { marcas: string[]; familias: string[]; id: string[]; b: number[]; m: string[]; y: ([number, number] | 0)[]; c: number[];
                  ms?: Record<string, string[]>; ys?: Record<string, ([number, number] | null)[]> };
  let indice: Promise<Indice> | null = null;
  const ler = () => (indice ??= fetch('/dados/busca.json').then((r) => r.json()));
  const raiz = document.querySelector<HTMLElement>('[data-cats]');

  function restaurar() {
    raiz?.querySelectorAll<HTMLAnchorElement>('a[data-tipo]').forEach((a) => {
      a.href = a.dataset.hrefBase!;
      (a.closest('li') as HTMLElement).style.display = '';
      const q = a.querySelector<HTMLElement>('[data-qtd]');
      const base = Number(a.dataset.base);
      if (q) { q.hidden = false; q.textContent = `${base.toLocaleString('pt-BR')} peças`; }
      a.setAttribute('aria-label', `${a.dataset.tipo}: ${base.toLocaleString('pt-BR')} peças`);
    });
    raiz?.querySelector<HTMLElement>('[data-cats-carro]')?.setAttribute('hidden', '');
  }

  async function aplicar(c: MeuCarro | null) {
    if (!raiz) return;
    if (!c) return restaurar();
    const d = await ler();
    const marca = d.marcas.indexOf(c.b);
    const cont = new Map<string, number>();
    for (let k = 0; k < d.id.length; k++) {
      // a peça de 2+ carros (ms) conta para cada um deles, com a faixa de anos daquele carro (ys)
      const p = { m: d.m[k], y: d.y[k] || null, ms: d.ms?.[k], ys: d.ys?.[k] };
      if (d.b[k] !== marca || !serveNoModelo(p, c.m)) continue;
      if (c.y != null) { const y = anosNoModelo(p, c.m); if (!y || c.y < y[0] || c.y > y[1]) continue; }
      const fam = d.familias[d.c[k]];
      cont.set(fam, (cont.get(fam) ?? 0) + 1);
    }
    const nome = [c.b, c.m, c.y].filter(Boolean).join(' ');
    raiz.querySelectorAll<HTMLAnchorElement>('a[data-tipo]').forEach((a) => {
      const n = cont.get(a.dataset.tipo!) ?? 0;
      const u = new URLSearchParams({ tipo: a.dataset.tipo!, marca: c.b, modelo: c.m });
      if (c.y) u.set('ano', String(c.y));
      a.href = `/catalogo.html?${u.toString()}`;
      const q = a.querySelector<HTMLElement>('[data-qtd]');
      (a.closest('li') as HTMLElement).style.display = n === 0 ? 'none' : '';
      if (q) q.textContent = `${n.toLocaleString('pt-BR')} ${n === 1 ? 'peça' : 'peças'}`;
      a.setAttribute('aria-label', `${a.dataset.tipo}: ${n.toLocaleString('pt-BR')} peças para o seu ${nome}`);
    });
    const aviso = raiz.querySelector<HTMLElement>('[data-cats-carro]');
    if (aviso) { aviso.hidden = false; aviso.querySelector('[data-cats-nome]')!.textContent = nome; }
  }

  raiz?.querySelector<HTMLButtonElement>('[data-cats-trocar]')?.addEventListener('click', () => window.dispatchEvent(new CustomEvent('abrir-meu-carro')));
  raiz?.querySelector<HTMLButtonElement>('[data-mais]')?.addEventListener('click', (e) => {
    raiz.classList.add('aberto'); (e.currentTarget as HTMLElement).remove();
  });
  aplicar(lerMeuCarro());
  window.addEventListener(EVENTO, (e) => aplicar((e as CustomEvent<MeuCarro | null>).detail));
</script>
<style>
  .cats-grade { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-flow: dense; }
  .cat a { position: relative; display: block; border-radius: 20px; overflow: hidden; background: #efeeeb; box-shadow: var(--shadow-1);
    transition: transform .35s cubic-bezier(.2,.7,.2,1), box-shadow .35s; }
  .cat img { display: block; width: 100%; height: auto; aspect-ratio: 1; transition: transform .6s cubic-bezier(.2,.7,.2,1); }
  .cat-qtd { position: absolute; top: 10px; right: 10px; padding: 5px 10px; border-radius: 99px; background: rgb(255 255 255 / .92);
    font-size: 12px; font-weight: 700; color: #1d1d1f; box-shadow: 0 2px 8px -4px rgb(0 0 0 / .25); }
  .cat-extra { display: none; }
  .aberto .cat-extra { display: block; }
  .cats-mais { margin: 16px auto 0; display: flex; }
  .cats-carro { margin: 0 0 16px; }
  @media (min-width: 700px) {
    .cats-grade { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
    .cat-extra { display: block; } .cats-mais { display: none; }
  }
  @media (min-width: 1080px) {
    .cats-grade { grid-template-columns: repeat(5, minmax(0, 1fr)); }
    .cat-grande { grid-column: span 2; grid-row: span 2; }
    .cat-qtd { top: 12px; right: 12px; font-size: 12.5px; }
    .cat-grande .cat-qtd { top: 18px; right: 18px; font-size: 14px; padding: 7px 13px; }
  }
  @media (hover: hover) {
    .cat a:hover { transform: translateY(-4px); box-shadow: var(--shadow-2); }
    .cat a:hover img { transform: scale(1.03); }
  }
  .cat a:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
  @media (prefers-reduced-motion: reduce) { .cat a, .cat img { transition: none; } }
</style>
