---
// Carros do pátio: arte do carro em estúdio (sem emblema) + logo real + nome + anos + nº de peças, vivos.
// Anos no mesmo formato do cartão da peça ("2013–2026", catalogo/etiqueta.ts).
import { resumo, logoInfo, arteDoCarro } from '../../lib/dados';
import { srcArte, SIZES } from '../../lib/variantes';
interface Props { limite?: number; todos?: boolean }
const { limite = 12, todos = false } = Astro.props;
const marcas = resumo().marcas;
const kMarca = (b: string) => marcas.find((m) => m.n === b)?.k ?? b.toLowerCase();
// a arte do carro (o principal sem arte própria usa a do apelido: lib/dados.ts)
const temArte = (k: string) => !!arteDoCarro(k);
const arte = (k: string) => `/arte/v2/carro-${arteDoCarro(k)}.webp`;
const carros = todos ? resumo().carros : resumo().carros.filter((c) => temArte(c.k)).slice(0, limite);
// "T-Cross" não parte no hífen ("T-" numa linha e "Cross" na outra): hífen que não quebra (U+2011)
// arte em 600/900/1200 (scripts/variantes-imagens.mjs): o cartão de 180 px do celular não baixa a de 1200
const sizes = todos ? SIZES.carrosTodos : SIZES.carrosHome;
const semQuebra = (s: string) => s.replace(/-/g, '\u2011');
// anos no mesmo formato dos cartões de peça (2013–2026)
const anosTxt = (a: [number, number]) => (a[0] === a[1] ? `${a[0]}` : `${a[0]}–${a[1]}`);
---
<ul class:list={["carros-v2", { todos }]}>
  {carros.map((c) => { const l = logoInfo(kMarca(c.b), 40, 26); return (
    <li data-b={c.b}><a class="carro-v2" href={`/carros/${c.k}.html`}>
      {temArte(c.k)
        ? <span class="carro-v2-arte"><img src={arte(c.k)} {...srcArte(arte(c.k), sizes)} alt="" width="1200" height="800" loading="lazy" decoding="async" /></span>
        : (() => { const g = logoInfo(kMarca(c.b), 110, 64); return <span class="carro-v2-arte carro-v2-sem">{g && <img src={g.src} alt="" width={g.w} height={g.h} style={`width:${g.w}px;height:${g.h}px`} class={g.png ? 'png' : 'svg'} loading="lazy" />}</span>; })()}
      <span class="carro-v2-info">
        <span class="carro-v2-logo">{l && <img src={l.src} alt="" width={l.w} height={l.h} class={l.png ? 'png' : 'svg'} loading="lazy" />}</span>
        <span class="carro-v2-txt"><b>{semQuebra(`${c.b} ${c.m}`)}</b><small class="num">{c.anos ? `${anosTxt(c.anos)} · ` : ''}{c.c.toLocaleString('pt-BR')} peças</small></span>
        <svg class="carro-v2-seta" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13m-5-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </span>
    </a></li>); })}
</ul>
<script>
  import { focoNoTrilho } from '../../lib/trilhoFoco';
  // trilho do celular (home): o carro com o foco do teclado fica inteiro na tela (o snap puxava de volta)
  focoNoTrilho('.carros-v2:not(.todos)');
</script>
<style>
  .carros-v2 { list-style: none; margin: 0; padding: 4px 2px 14px; display: grid; gap: 12px; grid-auto-flow: column; grid-auto-columns: 80%;
    overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
  .carros-v2::-webkit-scrollbar { display: none; }
  /* cartões da mesma linha com a mesma altura (nome em 2 linhas não desalinha a fileira) */
  .carros-v2 li { scroll-snap-align: start; display: grid; }
  .carros-v2 li[hidden] { display: none; }
  /* lista completa (página de carros): no celular vira grade de 2, não trilho */
  .carros-v2.todos { grid-auto-flow: row; grid-auto-columns: auto; grid-template-columns: repeat(2, minmax(0, 1fr)); overflow: visible; gap: 10px; }
  @media (min-width: 760px) { .carros-v2.todos { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; } }
  @media (min-width: 1180px) { .carros-v2.todos { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px; } }
  @media (max-width: 699px) {
    .carros-v2.todos .carro-v2-info { grid-template-columns: 1fr; gap: 6px; padding: 10px 12px 12px; }
    .carros-v2.todos .carro-v2-logo { width: 40px; height: 30px; }
    .carros-v2.todos .carro-v2-seta { display: none; }
    .carros-v2.todos .carro-v2-txt b { font-size: 17px; }
    .carros-v2.todos .carro-v2-txt small { font-size: 12.5px; }
  }
  @media (min-width: 700px) { .carros-v2 { grid-auto-flow: row; grid-auto-columns: auto; grid-template-columns: repeat(2, minmax(0, 1fr)); overflow: visible; gap: 16px; } }
  @media (min-width: 1080px) { .carros-v2 { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; } }
  .carro-v2 { display: grid; grid-template-rows: auto 1fr; height: 100%; border-radius: 22px; overflow: hidden; background: var(--surface); box-shadow: var(--shadow-1);
    transition: transform .35s cubic-bezier(.2,.7,.2,1), box-shadow .35s; }
  .carro-v2-arte { display: block; background: #efeeeb; overflow: hidden; }
  .carro-v2-arte img { display: block; width: 100%; height: auto; aspect-ratio: 3 / 2; transition: transform .7s cubic-bezier(.2,.7,.2,1); }
  /* carro ainda sem arte: painel de estúdio com o logo grande da marca */
  .carro-v2-sem { aspect-ratio: 3 / 2; display: grid; place-items: center;
    background: radial-gradient(70% 60% at 50% 42%, #fbfaf8 0%, #efeeeb 62%, #e6e4e0 100%); }
  .carro-v2-sem img { width: auto; height: auto; aspect-ratio: auto; opacity: .9; }
  .carro-v2-sem img.svg { filter: brightness(0) saturate(100%) invert(9%) sepia(5%) saturate(500%) hue-rotate(200deg); }
  .carro-v2-info { display: grid; grid-template-columns: 52px 1fr auto; gap: 12px; align-items: center; padding: 12px 16px 14px 12px; }
  .carro-v2-logo { width: 52px; height: 40px; display: grid; place-items: center; border-radius: 12px; background: #f3f2ef; }
  .carro-v2-logo img.svg { filter: brightness(0) saturate(100%) invert(9%) sepia(5%) saturate(500%) hue-rotate(200deg); }
  .carro-v2-txt b { display: block; font-stretch: 82%; font-weight: 820; font-size: 21px; line-height: 1.05; }
  .carro-v2-txt small { display: block; margin-top: 3px; font-size: 13.5px; color: var(--ink-2); }
  .carro-v2-seta { width: 22px; height: 22px; color: var(--ink-3); transition: transform .3s, color .3s; }
  @media (hover: hover) {
    .carro-v2:hover { transform: translateY(-4px); box-shadow: var(--shadow-2); }
    .carro-v2:hover .carro-v2-arte img { transform: scale(1.035); }
    .carro-v2:hover .carro-v2-seta { transform: translateX(3px); color: var(--accent-text); }
  }
  .carro-v2:focus-visible { outline: 3px solid var(--foco); outline-offset: 3px; }
  /* trilho do celular (home): o overflow cortaria o anel de fora; ali ele vai para dentro do cartão */
  @media (max-width: 699px) { .carros-v2:not(.todos) .carro-v2:focus-visible { outline-offset: -3px; } }
</style>
