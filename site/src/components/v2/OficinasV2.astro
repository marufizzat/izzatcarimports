---
// Oficinas e revendas (compra em lista): cartão escuro com texto vivo, os 3 passos numerados e ligados, e o botão.
// A arte (gerada, SEM texto desenhado) é o fundo do cartão inteiro: o pedido de uma oficina sendo separado no pátio à
// noite, com o Maruf pondo a última peça na caixa. A esquerda dela é preto puro (o mesmo #111214 do cartão) e recebe o
// texto. No tablet a arte vira uma faixa em cima e o texto se divide em 2 colunas; no celular, a arte quadrada em cima.
import Icone from '../Icone.astro';
import { whatsUrl } from '../../lib/dados';
import { larga } from '../../lib/escalaTela';
const msg = 'Sou de oficina/revenda e quero mandar uma lista de peças. Carro e ano: ____. Peças: ____';
const passos = ['Mande a lista com o carro e o ano', 'A gente confere no pátio', 'Responde pelo WhatsApp, com o código'];
---
<section class="faixa-escura ofi" aria-labelledby="ofi-titulo">
  <picture class="ofi-arte">
    <source media="(max-width: 639px)" srcset="/arte/v2/oficinas-maruf-celular-600.webp 600w, /arte/v2/oficinas-maruf-celular.webp 900w"
      sizes="calc(100vw - 32px)" width="900" height="900" />
    <img src="/arte/v2/oficinas-maruf.webp" srcset="/arte/v2/oficinas-maruf-900.webp 900w, /arte/v2/oficinas-maruf.webp 1536w"
      sizes={`(min-width: 1304px) ${larga(1240)}, calc(100vw - 64px)`}
      alt="O Maruf, da Izzat Car, põe um farol na caixa do pedido de uma oficina; na bancada, as outras peças separadas, cada uma com a sua etiqueta laranja"
      width="1536" height="1024" loading="lazy" decoding="async" />
  </picture>
  <div class="ofi-texto">
    <div class="ofi-cabeca">
      <p class="ofi-antes"><img src="/icones/oficina-96.webp" alt="" width="96" height="96" loading="lazy" decoding="async" />Oficinas e revendas</p>
      <h2 class="ofi-titulo" id="ofi-titulo">A gente separa as peças da <span class="pincel">sua oficina.</span></h2>
    </div>
    <ol class="ofi-passos">
      {passos.map((t, i) => <li><span class="ofi-n" aria-hidden="true">{i + 1}</span><span>{t}</span></li>)}
    </ol>
    <a class="botao botao-laranja ofi-botao" href={whatsUrl(msg)} rel="noopener" data-botao="oficinas"><Icone nome="whats" />Mandar a lista no WhatsApp</a>
  </div>
</section>
<style>
  .ofi { --fundo: #111214; --pad: clamp(24px, 4.4vw, 60px); position: relative; isolation: isolate; overflow: hidden; display: grid;
    border-radius: 28px; background: var(--fundo); box-shadow: 0 30px 60px -30px rgb(0 0 0 / .55); }
  /* o fio claro da borda fica por cima da arte */
  .ofi::after { content: ""; position: absolute; inset: 0; z-index: 2; border-radius: inherit; pointer-events: none;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / .07), inset 0 1px 0 rgb(255 255 255 / .06); }
  .ofi-arte { display: block; }
  .ofi-arte img { display: block; width: 100%; }
  .ofi-texto { position: relative; display: grid; justify-items: start; min-width: 0; }
  .ofi-cabeca { display: grid; gap: 16px; justify-items: start; min-width: 0; }

  /* antes do título: cápsula fina com o ícone da família e o nome em caixa alta */
  .ofi-antes { display: inline-flex; align-items: center; gap: 9px; margin: 0; padding: 5px 15px 5px 6px; border-radius: 999px;
    font-size: 12.5px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: #ff9a57;
    background: rgb(255 255 255 / .045); box-shadow: inset 0 0 0 1px rgb(255 138 61 / .3); }
  .ofi-antes img { width: 26px; height: 26px; }
  .ofi-titulo { margin: 0; font-stretch: 78%; font-weight: 820; font-size: clamp(34px, 4.1vw, 56px); line-height: .98; letter-spacing: -.012em;
    color: #f4f4f6; text-wrap: balance; max-width: 13ch; }
  .ofi-titulo .pincel::after { bottom: -.1em; height: .3em; }

  /* os 3 passos: números em anel laranja, ligados por um fio; o último (a resposta) vem cheio */
  .ofi-passos { list-style: none; margin: 0; padding: 0; display: grid; width: 100%; max-width: 430px; }
  .ofi-passos li { position: relative; display: grid; grid-template-columns: 40px minmax(0, 1fr); align-items: center; gap: 15px; padding-block: 11px;
    font-size: clamp(16px, 1.35vw, 17.5px); line-height: 1.3; font-weight: 600; color: #ececf0; text-wrap: balance; }
  .ofi-passos li:not(:last-child)::before { content: ""; position: absolute; z-index: 0; left: 19.25px; top: 50%; width: 1.5px; height: 100%;
    background: linear-gradient(180deg, rgb(255 138 61 / .7), rgb(255 138 61 / .22)); }
  .ofi-n { position: relative; z-index: 1; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%;
    font-stretch: 80%; font-weight: 820; font-size: 18px; line-height: 1; font-variant-numeric: lining-nums; color: #ff9a57;
    background: #18191c; box-shadow: inset 0 0 0 1.5px rgb(255 138 61 / .6), 0 0 0 3px var(--fundo); }
  .ofi-passos li:last-child .ofi-n { color: #1d1d1f; background: linear-gradient(180deg, #ff8a2e, var(--accent));
    box-shadow: inset 0 1px 0 rgb(255 255 255 / .35), 0 0 0 3px var(--fundo), 0 0 22px rgb(255 106 0 / .5); }
  .ofi-botao { margin-top: 4px; }

  /* PC: a arte (3:2, com preto em cima e embaixo) cobre o cartão: no cartão largo aparece a faixa do meio, com a cena
     grande; no mais estreito, a arte inteira. A esquerda (preto da arte) recebe o texto, com um véu que garante a leitura. */
  @media (min-width: 900px) {
    .ofi { align-items: center; min-height: clamp(500px, 42vw, 600px); padding: var(--pad); }
    .ofi-arte { position: absolute; inset: 0; z-index: -2; }
    .ofi-arte img { height: 100%; object-fit: cover; object-position: 100% 50%; }
    .ofi::before { content: ""; position: absolute; inset: 0; z-index: -1; pointer-events: none;
      background: linear-gradient(90deg, var(--fundo) 0, rgb(17 18 20 / .9) 22%, rgb(17 18 20 / 0) 46%); }
    .ofi-texto { gap: 22px; max-width: min(470px, 43%); }
  }
  @media (min-width: 900px) and (max-width: 1199px) {
    .ofi-passos { max-width: 300px; }
    .ofi-titulo { font-size: clamp(34px, 3.9vw, 44px); }
  }
  /* tablet: a cena numa faixa 16:9 em cima (ampliada: só a faixa do meio da arte; a base se desfaz no preto); embaixo,
     título e botão à esquerda, passos à direita */
  @media (min-width: 640px) and (max-width: 899px) {
    .ofi-arte { position: relative; aspect-ratio: 16 / 9; overflow: hidden;
      -webkit-mask-image: linear-gradient(180deg, #000 74%, transparent 99%); mask-image: linear-gradient(180deg, #000 74%, transparent 99%); }
    .ofi-arte img { position: absolute; right: -2%; top: 50%; width: auto; height: 150%; max-width: none; translate: 0 -51%; }
    .ofi-texto { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: start; gap: 22px 34px; margin-top: -6px; padding: 0 var(--pad) calc(var(--pad) + 4px); }
    .ofi-passos { grid-column: 2; grid-row: 1 / span 2; align-self: center; }
    .ofi-botao { grid-column: 1; }
    .ofi-titulo { font-size: clamp(34px, 5.2vw, 44px); }
  }
  /* celular: a arte quadrada em cima, na largura toda do cartão; a base dela se desfaz no preto e o texto sobe um pouco */
  @media (max-width: 639px) {
    .ofi-arte img { aspect-ratio: 1; object-fit: cover;
      -webkit-mask-image: linear-gradient(180deg, #000 74%, transparent 99%); mask-image: linear-gradient(180deg, #000 74%, transparent 99%); }
    .ofi-texto { gap: 20px; margin-top: -16px; padding: 0 var(--pad) calc(var(--pad) + 4px); }
    .ofi-botao { width: 100%; margin-top: 6px; }
  }
  /* 320: o botão numa linha só */
  @media (max-width: 359px) { .ofi-botao { gap: 8px; padding-inline: 10px; font-size: 14.5px; letter-spacing: 0; white-space: nowrap; } }
</style>
