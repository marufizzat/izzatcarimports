---
// Selos de confiança: 4 ícones-arte 3D (ChatGPT, mesmo estúdio) + texto vivo. Só fatos confirmados.
const selos = [
  ['garantia', '90 dias de garantia', 'Em toda peça'],
  ['nota-fiscal', 'Nota fiscal', 'Em toda venda'],
  ['cdv', 'Desmanche credenciado', 'Detran-RS · CDV nº 01060'],
  ['envio', 'Envio para todo o Brasil', 'Com código de rastreio'],
];
interface Props { class?: string }
---
<ul class:list={['selos-v2', Astro.props.class]} aria-label="Por que comprar com a gente">
  {selos.map(([k, t, s]) => (
    <li class="selo-v2">
      <img src={`/arte/v2/selo-${k}.webp`} alt="" width="84" height="84" loading="lazy" decoding="async" />
      <span><b>{t}</b><small>{s}</small></span>
    </li>
  ))}
</ul>
<style>
  .selos-v2 { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 1000px) { .selos-v2 { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; } }
  .selo-v2 { display: grid; justify-items: start; gap: 4px; padding: 12px 14px 14px; border-radius: 20px; background: var(--surface); box-shadow: var(--shadow-1); }
  .selo-v2 img { width: 56px; height: 56px; margin-left: -4px; object-fit: contain; }
  @media (min-width: 1000px) { .selo-v2 { display: flex; align-items: center; padding: 14px 18px 14px 10px; gap: 12px; } .selo-v2 img { width: 84px; height: 84px; margin: 0; flex: none; } }
  .selo-v2 b { display: block; font-stretch: 86%; font-weight: 800; font-size: clamp(15px, 1.25vw, 18.5px); line-height: 1.15; }
  .selo-v2 small { display: block; margin-top: 3px; font-size: clamp(12.5px, 1vw, 14.5px); color: var(--ink-2); line-height: 1.3; }
</style>
