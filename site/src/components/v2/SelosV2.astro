---
import SeloReputacao from '../SeloReputacao.astro';
// Selos de confiança: 4 ícones-arte 3D (ChatGPT, mesmo estúdio) + texto vivo. Só fatos confirmados.
// A reputação do Mercado Livre entra como mais um selo da fileira (no PC, 5 iguais; antes ela vinha numa faixa
// de 1240 px quase vazia). Os nós não quebram no meio: "CDV nº 01060" fica junto.
const selos = [
  ['garantia', '90 dias de garantia', 'Em toda peça'],
  ['nota-fiscal', 'Nota fiscal', 'Em toda venda'],
  ['cdv', 'Desmanche credenciado', 'Detran-RS · CDV nº 01060'],
  ['envio', 'Envio para todo o Brasil', 'Com código de rastreio'],
];
interface Props { class?: string }
---
<ul class:list={['selos-v2', Astro.props.class]} aria-label="Por que comprar com a gente">
  {selos.map(([k, t, s]) => (
    <li class="selo-v2">
      <img src={`/arte/v2/selo-${k}.webp`} alt="" width="84" height="84" loading="lazy" decoding="async" />
      <span><b>{t}</b><small>{s}</small></span>
    </li>
  ))}
  <SeloReputacao variante="faixa" />
</ul>
<style>
  .selos-v2 { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .selo-v2 { display: grid; justify-items: start; align-content: start; gap: 4px; padding: 12px 14px 14px; border-radius: 20px; background: var(--surface); box-shadow: var(--shadow-1); }
  .selo-v2 img { width: 56px; height: 56px; margin-left: -4px; object-fit: contain; }
  .selo-v2 b { display: block; font-stretch: 86%; font-weight: 800; font-size: clamp(15px, 1.25vw, 18.5px); line-height: 1.15; text-wrap: balance; }
  .selo-v2 small { display: block; margin-top: 3px; font-size: clamp(12.5px, 1vw, 14.5px); color: var(--ink-2); line-height: 1.3; text-wrap: pretty; }
  /* a reputação: no celular, a linha inteira embaixo dos 4 */
  .selos-v2 :global(.rep-cartao) { grid-column: 1 / -1; }
  .selos-v2 :global(.rep-texto b) { text-wrap: balance; }
  /* PC médio: 3 colunas (3 selos em cima; o 4º e a reputação, que ocupa 2, embaixo): nada sobra vazio */
  @media (min-width: 1000px) {
    .selos-v2 { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
    .selo-v2 { display: flex; align-items: center; padding: 14px 18px 14px 10px; gap: 12px; }
    .selo-v2 img { width: 76px; height: 76px; margin: 0; flex: none; }
    .selos-v2 :global(.rep-cartao) { grid-column: span 2; padding: 14px 22px; }
  }
  /* PC: os 5 selos numa fileira só (a reputação, que tem a frase mais longa, um pouco mais larga) */
  @media (min-width: 1180px) {
    .selos-v2 { grid-template-columns: repeat(4, minmax(0, 1fr)) minmax(0, 1.3fr); }
    .selo-v2 { padding: 14px 14px 14px 8px; gap: 8px; }
    .selo-v2 img { width: 60px; height: 60px; }
    .selo-v2 b { font-size: clamp(15px, 1.2vw, 17.5px); }
    .selo-v2 small { font-size: clamp(12.5px, .95vw, 14px); }
    .selos-v2 :global(.rep-cartao) { grid-column: auto; gap: 12px; padding: 14px 16px; }
    .selos-v2 :global(.rep-texto b) { font-size: clamp(15px, 1.2vw, 17.5px); }
    .selos-v2 :global(.rep-texto small) { font-size: clamp(12.5px, .95vw, 14px); }
  }
</style>
