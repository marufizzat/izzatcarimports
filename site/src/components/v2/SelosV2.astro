---
import SeloReputacao from '../SeloReputacao.astro';
// Selos de confiança: 4 ícones-arte 3D (ChatGPT, mesmo estúdio) + texto vivo. Só fatos confirmados.
// A reputação do Mercado Livre entra como mais um selo da fileira (no PC, 5 iguais; antes ela vinha numa faixa
// de 1240 px quase vazia). Os nós não quebram no meio: "CDV nº 01060" fica junto.
const selos = [
  ['garantia', '90 dias de garantia', 'Em toda peça'],
  ['nota-fiscal', 'Nota fiscal', 'Em toda venda'],
  ['cdv', 'Desmanche credenciado', 'Detran-RS\u00a0· CDV\u00a0nº\u00a001060'],
  ['envio', 'Envio para todo o Brasil', 'Frete pelo seu CEP'],
];
interface Props { class?: string }
---
<ul class:list={['selos-v2', Astro.props.class]} aria-label="Por que comprar com a gente">
  {selos.map(([k, t, s]) => (
    <li class="selo-v2">
      <img src={`/arte/v2/selo-${k}.webp`} alt="" width="84" height="84" loading="lazy" decoding="async" />
      <span><b>{t}</b><small>{s}</small></span>
    </li>
  ))}
  <SeloReputacao variante="faixa" />
</ul>
<style>
  .selos-v2 { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .selo-v2 { display: grid; justify-items: start; align-content: start; gap: 4px; padding: 12px 14px 14px; border-radius: 20px; background: var(--surface); box-shadow: var(--shadow-1); }
  .selo-v2 img { width: 56px; height: 56px; margin-left: -4px; object-fit: contain; }
  @media (min-width: 1000px) { .selo-v2 { display: flex; align-items: center; padding: 14px 18px 14px 10px; gap: 12px; } .selo-v2 img { width: 84px; height: 84px; margin: 0; flex: none; } }
  .selo-v2 b { display: block; font-stretch: 86%; font-weight: 800; font-size: clamp(15px, 1.25vw, 18.5px); line-height: 1.15; text-wrap: balance; }
  .selo-v2 small { display: block; margin-top: 3px; font-size: clamp(12.5px, 1vw, 14.5px); color: var(--ink-2); line-height: 1.3; text-wrap: balance; }
  /* PC largo: a reputação do ML vira o 5º selo, do mesmo tamanho dos outros (antes, uma faixa de 1240 px quase vazia) */
  @media (min-width: 1180px) {
    :global(ul.selos-v2:has(> li.rep-cartao)) { grid-template-columns: repeat(5, minmax(0, 1fr)); }
    :global(ul.selos-v2 > li.rep-cartao) { grid-column: auto; padding: 14px 16px; gap: 12px; }
    :global(ul.selos-v2:has(> li.rep-cartao) .selo-v2 img) { width: 68px; height: 68px; }
    :global(ul.selos-v2 > li.rep-cartao .rep-longo) { display: none; }
    :global(ul.selos-v2 > li.rep-cartao .rep-curto) { display: inline; }
  }
</style>
