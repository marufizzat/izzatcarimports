---
// Chamada para o WhatsApp em dois formatos.
//  - "faixa" (padrão): faixa baixa com texto VIVO e botão de verdade. O Maruf (recorte de arte gerada, sem fundo)
//    responde no celular e passa da borda de cima da faixa; ao lado, o balão de "digitando" e, no PC largo, a conversa
//    em dois balões (HTML, só enfeite: aria-hidden). O texto sai de `texto`: 1ª frase = título, última (sem ponto) =
//    botão, o meio = apoio. titulo/apoio/rotulo trocam cada parte. Na página de um carro (/carros/<k>.html) o título
//    já fala do carro: "Tem um Volvo XC60?". A folga de cima (o que o Maruf passa da faixa) é da própria faixa.
//  - "arte": a arte de estúdio com o texto DESENHADO (versão em pé no celular; o texto vai no alt).
//    Cada arte com o Maruf aparece em UMA página só: nao-achou (home), garantia, como-comprar, origem (o pátio)
//    e carro (página de cada carro, a faixa baixa 1536×512 no PC). arteW/arteH e celW/celH = o tamanho de cada
//    versão (reserva o espaço certo, a página não pula). Sem `href` (arte sem botão desenhado): vira <figure>, sem link.
import Icone from '../Icone.astro';
import { resumo } from '../../lib/dados';
interface Props { nome: string; texto: string; href?: string; class?: string; formato?: 'faixa' | 'arte'; titulo?: string; apoio?: string; rotulo?: string;
  arteW?: number; arteH?: number; celW?: number; celH?: number; }
const { nome, texto, href, class: cls, formato = 'faixa', arteW = 1536, arteH = 1024, celW = 1024, celH = 1536 } = Astro.props;
const Caixa = href ? 'a' : 'figure';

// a conversa de exemplo de cada assunto: [cliente, loja]. Sem prazo, sem promessa de resposta, sem "com foto", sem "tem aqui".
const naPeca = Astro.url.pathname.startsWith('/peca/');
const CONVERSA: Record<string, [string, string]> = {
  'banner-serve': [naPeca ? 'Essa peça serve no meu carro?' : 'Serve no meu Onix 2019?', 'A gente confere na peça antes de você comprar.'],
  'banner-nao-achou': ['Não achei meu carro: é um Tiggo 5x 2020.', 'A gente procura no pátio.'],
};
// recorte do Maruf com o celular (public/arte/v2/maruf-celular*.webp, com alfa): tamanho do arquivo maior
const MARUF = { w: 374, h: 440 };
const frases = texto.split(/(?<=[?.!])\s+/).map((f) => f.trim()).filter(Boolean);
const temRotulo = frases.length > 1 && !/[?.!:]$/.test(frases[frases.length - 1]);
let titulo = Astro.props.titulo ?? frases[0] ?? '';
let apoio = Astro.props.apoio ?? frases.slice(1, temRotulo ? -1 : undefined).join(' ');
const rotulo = Astro.props.rotulo ?? (temRotulo ? frases[frases.length - 1] : 'Chamar no WhatsApp');

// pergunta do cliente ("Serve no meu carro?") vira a nossa ("Serve no seu carro?")
titulo = titulo.replace(/\bno meu carro\b/i, 'no seu carro');
// página do carro: a pergunta já leva o carro
const naPaginaDoCarro = /^\/carros\/([^/]+)\.html$/.exec(Astro.url.pathname)?.[1];
const carro = naPaginaDoCarro && nome === 'banner-serve' && !Astro.props.titulo ? resumo().carros.find((c) => c.k === naPaginaDoCarro) : null;
if (carro) {
  titulo = `Tem um ${carro.b} ${carro.m}?`;
  apoio = Astro.props.apoio ?? 'Mande o ano e a peça que você procura. A gente confere no pátio e responde pelo WhatsApp.';
}
const [bolhaCliente, bolhaLoja] = CONVERSA[nome] ?? CONVERSA['banner-serve'];
---
{formato === 'arte' ? (
  <Caixa class:list={['banner-v2', { 'banner-v2-link': !!href }, cls]} {...(href ? { href, rel: 'noopener', 'aria-label': texto } : {})}>
    <picture>
      <source media="(max-width: 700px)" srcset={`/arte/v2/${nome}-celular.webp`} width={celW} height={celH} />
      <img src={`/arte/v2/${nome}.webp`} alt={texto} width={arteW} height={arteH} loading="lazy" decoding="async" />
    </picture>
  </Caixa>
) : (
  <div class:list={['fw-fora', cls]}>
    <div class="faixa-whats">
      <span class="fw-maruf">
        <img src="/arte/v2/maruf-celular-220.webp" srcset="/arte/v2/maruf-celular-220.webp 1x, /arte/v2/maruf-celular.webp 2x"
          alt="O Maruf, da Izzat Car, respondendo um cliente no celular" width={MARUF.w} height={MARUF.h} loading="lazy" decoding="async" />
      </span>
      <span class="fw-digitando" aria-hidden="true"><i></i><i></i><i></i></span>
      <div class="fw-texto">
        <p class="fw-titulo">{titulo}</p>
        {apoio && <p class="fw-apoio">{apoio}</p>}
      </div>
      <div class="fw-conversa" aria-hidden="true">
        <p class="fw-bolha fw-cliente">{bolhaCliente}</p>
        <p class="fw-bolha fw-loja">{bolhaLoja}</p>
      </div>
      <a class="botao botao-laranja fw-botao" href={href} rel="noopener"><Icone nome="whats" />{rotulo}</a>
    </div>
  </div>
)}
<style>
  .banner-v2 { display: block; margin: 0; border-radius: 26px; overflow: hidden; background: #efeeeb; box-shadow: var(--shadow-2); transition: transform .35s cubic-bezier(.2,.7,.2,1); }
  .banner-v2 img { display: block; width: 100%; height: auto; }
  /* só a arte com link sobe no hover (a sem botão é só imagem) */
  @media (hover: hover) { .banner-v2-link:hover { transform: translateY(-3px); } }
  /* foco do teclado: o anel global (global.css, :focus-visible), só um pouco mais afastado do cartão */
  .banner-v2:focus-visible { outline-offset: 4px; }

  /* faixa: cartão baixo e branco. O Maruf fica "atrás do balcão": a base do recorte encosta na borda de baixo (no
     celular, no topo do botão) e a cabeça passa da borda de cima (--pop, folga reservada em .fw-fora: nada pula). */
  .fw-fora { --pop: 46px; padding-top: var(--pop); }
  .faixa-whats { position: relative; isolation: isolate; display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center;
    gap: 16px 28px; min-height: 120px; padding: 22px 28px 22px 184px; border-radius: 24px; background: var(--surface); box-shadow: var(--shadow-1); }
  /* luz quente atrás do Maruf e no canto do botão */
  .faixa-whats::before { content: ""; position: absolute; inset: 0; z-index: -2; border-radius: inherit;
    background: radial-gradient(250px 180px at 96px 82%, #ffe6d0, transparent 72%), radial-gradient(320px 230px at 100% 0, var(--accent-soft), transparent 70%); }
  .fw-maruf { position: absolute; z-index: -1; left: 14px; bottom: 0; width: 164px; height: calc(100% + var(--pop)); overflow: hidden;
    border-bottom-left-radius: 16px; pointer-events: none; }
  .fw-maruf img { position: absolute; left: 50%; bottom: 0; width: auto; height: 100%; max-height: 186px; max-width: none; translate: -50% 0;
    filter: drop-shadow(0 6px 12px rgb(60 30 0 / .18)); }
  /* balão de "digitando": grafite com três pontos laranja, na altura da cabeça, cruzando a borda de cima */
  .fw-digitando { position: absolute; left: 150px; top: -20px; display: flex; align-items: center; gap: 5px; height: 30px; padding: 0 12px;
    border-radius: 15px 15px 15px 5px; background: #1d1d1f; box-shadow: 0 6px 14px -6px rgb(0 0 0 / .45); }
  .fw-digitando i { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); animation: fw-ponto 1.4s ease-in-out infinite both; }
  .fw-digitando i:nth-child(2) { animation-delay: .18s; }
  .fw-digitando i:nth-child(3) { animation-delay: .36s; }
  @keyframes fw-ponto { 0%, 60%, 100% { opacity: .35; transform: none; } 30% { opacity: 1; transform: translateY(-2px); } }
  @media (prefers-reduced-motion: reduce) { .fw-digitando i { animation: none; opacity: .9; } }
  :global(html.leve) .fw-digitando i { animation: none; opacity: .9; }
  .fw-texto { display: grid; gap: 6px; min-width: 0; }
  .fw-titulo { margin: 0; font-stretch: 80%; font-weight: 820; font-size: clamp(24px, 2.5vw, 32px); line-height: 1.02; letter-spacing: -.01em; color: var(--ink); text-wrap: balance; }
  .fw-apoio { margin: 0; max-width: 62ch; font-size: 16px; line-height: 1.5; color: var(--ink-2); text-wrap: balance; }
  .fw-botao { --h: var(--botao-g); padding: 0 24px; }
  /* a conversa (só no PC largo): o cliente à direita, em cinza claro; a loja à esquerda, em grafite */
  .fw-conversa { display: none; }
  .fw-bolha { margin: 0; max-width: 240px; padding: 8px 13px 9px; font-size: 14px; line-height: 1.3; font-weight: 560; text-wrap: balance; }
  .fw-cliente { justify-self: end; border-radius: 15px 15px 5px 15px; background: #f1f1f4; color: var(--ink); box-shadow: inset 0 0 0 1px var(--line); }
  .fw-loja { justify-self: start; border-radius: 15px 15px 15px 5px; background: #1d1d1f; color: #f5f5f7; box-shadow: 0 8px 16px -10px rgb(0 0 0 / .5); }
  .fw-loja::before { content: ""; display: inline-block; width: 6px; height: 6px; margin-right: 7px; border-radius: 50%; background: var(--accent); vertical-align: .12em; }
  @media (min-width: 1200px) {
    .faixa-whats { grid-template-columns: minmax(0, 1fr) auto auto; }
    .fw-conversa { display: grid; gap: 6px; width: 276px; }
  }
  /* celular: o Maruf à esquerda do texto, preso em cima (a cabeça passa da faixa); a base do recorte se desfaz no
     branco antes do botão, que ocupa a largura toda */
  @media (max-width: 760px) {
    .fw-fora { --pop: 34px; }
    .faixa-whats { grid-template-columns: minmax(0, 1fr); gap: 14px; min-height: 0; padding: 20px 18px; }
    .faixa-whats::before { background: radial-gradient(210px 190px at 70px 46%, #ffe6d0, transparent 72%), radial-gradient(260px 200px at 100% 0, var(--accent-soft), transparent 70%); }
    .fw-texto { min-height: 100px; align-content: center; padding-left: 122px; }
    .fw-maruf { left: 6px; top: calc(var(--pop) * -1); bottom: auto; width: 126px; height: auto; aspect-ratio: 374 / 440; overflow: visible; border-radius: 0;
      -webkit-mask-image: linear-gradient(180deg, #000 80%, transparent 99%); mask-image: linear-gradient(180deg, #000 80%, transparent 99%); }
    .fw-maruf img { position: static; width: 100%; height: auto; max-height: none; translate: none; }
    .fw-digitando { left: 112px; top: -17px; height: 28px; padding: 0 11px; }
    .fw-botao { width: 100%; white-space: normal; height: var(--h); }
  }
  @media (max-width: 359px) {
    .fw-texto { padding-left: 108px; }
    .fw-maruf { left: 2px; width: 114px; }
    .fw-digitando { left: 98px; }
    .fw-apoio { font-size: 15px; }
  }
</style>
