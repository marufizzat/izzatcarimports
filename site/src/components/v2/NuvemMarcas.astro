---
// Marcas com LOGO real + nome + nº de peças (logos: simple-icons e car-logos-dataset, GitHub).
// Referência: Logo Cloud grid (shadcnui-blocks/logo-cloud-09, 21st.dev #21465). No celular vira trilho de 3 linhas.
// Nome inteiro em até 2 linhas (nada de "Mercedes-B…"). O último cartão ("Outra marca?", WhatsApp) fecha a grade:
// ele ocupa as colunas que sobrariam vazias depois das 26 marcas, em qualquer largura.
// Número pequeno passa a ideia de pátio vazio: abaixo de 30 peças, a marca aparece sem a contagem.
import Icone from '../Icone.astro';
import { marcasVisiveis, logoInfo, whatsUrl } from '../../lib/dados';
// mesma lista da abertura e da caixa "Meu carro" (marcas com 5+ peças): o número bate em todo lugar
const marcas = marcasVisiveis();
const POUCAS = 30;
const sobra = (cols: number) => (cols - (marcas.length % cols)) % cols || cols;
---
<ul class="nuvem" style={`--fim3:${sobra(3)};--fim4:${sobra(4)};--fim6:${sobra(6)}`}>
  {marcas.map((m) => { const l = logoInfo(m.k); return (
    <li><a href={`/marca/${m.k}.html`} class="nuvem-item">
      <span class="nuvem-logo">{l && <img src={l.src} alt="" width={l.w} height={l.h} class={l.png ? 'png' : 'svg'} loading="lazy" decoding="async" />}</span>
      <span class="nuvem-nome">{m.n}</span>
      {m.c >= POUCAS && <span class="nuvem-qtd num">{m.c.toLocaleString('pt-BR')} peças</span>}
    </a></li>); })}
  <li class="nuvem-fim"><a href={whatsUrl('Olá! Procuro peça para o meu carro: ____ (marca, modelo e ano).')} class="nuvem-item nuvem-outra">
    <span class="nuvem-logo"><Icone nome="whats" /></span>
    <span class="nuvem-nome">Outra marca?</span>
    <span class="nuvem-qtd">A gente procura no pátio</span>
  </a></li>
</ul>
<style>
  .nuvem { list-style: none; margin: 0; padding: 4px 2px 12px; display: grid; gap: 10px;
    grid-auto-flow: column; grid-template-rows: repeat(3, auto); grid-auto-columns: minmax(200px, 62vw);
    overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
  .nuvem::-webkit-scrollbar { display: none; }
  .nuvem li { scroll-snap-align: start; display: grid; }
  @media (min-width: 640px) {
    .nuvem { grid-auto-flow: row; grid-template-rows: none; grid-template-columns: repeat(3, 1fr); overflow: visible; }
    .nuvem-fim { grid-column: span var(--fim3); }
  }
  @media (min-width: 900px) { .nuvem { grid-template-columns: repeat(4, 1fr); } .nuvem-fim { grid-column: span var(--fim4); } }
  @media (min-width: 1180px) { .nuvem { grid-template-columns: repeat(6, 1fr); gap: 12px; } .nuvem-fim { grid-column: span var(--fim6); } }
  .nuvem-item { display: grid; grid-template-columns: 64px minmax(0, 1fr); grid-template-rows: auto auto; column-gap: 12px; row-gap: 2px; align-content: center; align-items: center;
    min-height: 70px; padding: 12px 14px 12px 12px; border-radius: 16px; background: var(--surface); box-shadow: var(--shadow-1);
    transition: transform .25s cubic-bezier(.2,.7,.2,1), box-shadow .25s; }
  .nuvem-logo { grid-row: 1 / span 2; width: 64px; height: 46px; display: grid; place-items: center; border-radius: 12px; background: #f3f2ef; }
  .nuvem-logo img { display: block; }
  .nuvem-nome { align-self: end; font-weight: 750; font-size: 15.5px; line-height: 1.15; font-stretch: 84%; text-wrap: balance;
    display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; line-clamp: 2; overflow: hidden; }
  .nuvem-item:not(:has(.nuvem-qtd)) .nuvem-nome { grid-row: 1 / span 2; align-self: center; }
  .nuvem-qtd { align-self: start; font-size: 12.5px; color: var(--ink-2); }
  /* "Outra marca?": o mesmo cartão, com o laranja do WhatsApp (letra grafite) */
  .nuvem-outra { background: var(--accent-soft); box-shadow: inset 0 0 0 1.5px color-mix(in oklab, var(--accent), transparent 55%); }
  .nuvem-outra .nuvem-logo { background: var(--accent); color: #1d1d1f; }
  .nuvem-outra .nuvem-logo :global(svg) { width: 24px; height: 24px; }
  .nuvem-outra .nuvem-qtd { color: var(--ink); font-weight: 600; }
  @media (hover: hover) { .nuvem-item:hover { transform: translateY(-3px); box-shadow: var(--shadow-2); } .nuvem-outra:hover { box-shadow: inset 0 0 0 1.5px var(--accent), var(--shadow-2); } }
</style>
