---
// Vitrine de vendas da home: peças com PREÇO, em abas ("Em destaque", "Mais procuradas" e os 3 sistemas
// que mais vendem). Seleção pelos dados reais em lib/destaques.ts. Usa o cartão da peça (CartaoPeca) como ele
// é; a grade só posiciona os filhos diretos (o cartão pode vir embrulhado num <div>).
// PC: grade 4 x 2. Celular: trilho de 2 linhas que desliza para o lado. Aba fechada não baixa foto (lazy).
import CartaoPeca from '../CartaoPeca.astro';
import { abasVitrine } from '../../lib/destaques';
const abas = abasVitrine(8);
---
{abas.length > 0 && (
  <div class="vit" data-vitrine>
    <div class="vit-abas" role="tablist" aria-label="Vitrines de peças">
      {abas.map((a, i) => (
        <button type="button" class="vit-aba" role="tab" id={`vit-aba-${a.k}`} aria-controls={`vit-painel-${a.k}`}
                aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{a.rotulo}</button>
      ))}
    </div>
    {abas.map((a, i) => (
      <div class="vit-painel" role="tabpanel" id={`vit-painel-${a.k}`} aria-labelledby={`vit-aba-${a.k}`} tabindex="0" hidden={i !== 0}>
        <div class="vit-grade">{a.pecas.map((p) => <CartaoPeca p={p} />)}</div>
        <div class="vit-mais"><a class="botao botao-linha" href={a.link}>{a.linkRotulo}</a></div>
      </div>
    ))}
  </div>
)}

<script>
  // Abas acessíveis (setas, Home e End); a aba escolhida rola para dentro da fileira no celular.
  document.querySelectorAll<HTMLElement>('[data-vitrine]').forEach((raiz) => {
    const fileira = raiz.querySelector<HTMLElement>('.vit-abas');
    const abas = [...raiz.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const ativar = (aba: HTMLButtonElement, foco = false) => {
      abas.forEach((b) => {
        const on = b === aba;
        b.setAttribute('aria-selected', String(on));
        b.tabIndex = on ? 0 : -1;
        const painel = document.getElementById(b.getAttribute('aria-controls') || '');
        if (painel) painel.hidden = !on;
      });
      if (foco) aba.focus({ preventScroll: true });
      if (fileira && fileira.scrollWidth > fileira.clientWidth) {
        fileira.scrollTo({ left: aba.offsetLeft - (fileira.clientWidth - aba.offsetWidth) / 2, behavior: 'smooth' });
      }
    };
    abas.forEach((b, i) => {
      b.addEventListener('click', () => ativar(b));
      b.addEventListener('keydown', (e) => {
        const j = e.key === 'ArrowRight' ? (i + 1) % abas.length
          : e.key === 'ArrowLeft' ? (i - 1 + abas.length) % abas.length
          : e.key === 'Home' ? 0 : e.key === 'End' ? abas.length - 1 : -1;
        if (j < 0) return;
        e.preventDefault();
        ativar(abas[j], true);
      });
    });
  });
</script>

<style>
  .vit { display: grid; gap: 22px; min-width: 0; }

  /* abas: texto com o fio laranja embaixo (o mesmo do menu do cabeçalho), nunca pílula */
  .vit-abas { display: flex; gap: 2px; overflow-x: auto; scrollbar-width: none; overscroll-behavior-x: contain;
    border-bottom: 1px solid var(--line-2); margin-inline: -4px; padding-inline: 4px; }
  .vit-abas::-webkit-scrollbar { display: none; }
  .vit-aba { position: relative; flex: none; padding: 12px 16px 14px; border: 0; background: none; border-radius: 10px 10px 0 0;
    font-size: 16px; font-weight: 620; font-stretch: 92%; color: var(--ink-2); white-space: nowrap; cursor: pointer;
    transition: color .2s ease, background-color .2s ease; -webkit-tap-highlight-color: transparent; }
  .vit-aba:hover { color: var(--ink); background: color-mix(in oklab, var(--ink), transparent 95%); }
  .vit-aba[aria-selected="true"] { color: var(--ink); font-weight: 760; }
  .vit-aba[aria-selected="true"]::after { content: ""; position: absolute; left: 14px; right: 14px; bottom: -1px; height: 3px;
    border-radius: 3px 3px 0 0; background: var(--accent); }
  .vit-aba:focus-visible { outline-offset: -3px; }
  @media (min-width: 900px) { .vit-aba { font-size: 17px; padding-inline: 18px; } }
  /* celular: as abas deslizam; a borda direita esmaece para mostrar que tem mais */
  @media (max-width: 699px) { .vit-abas { padding-right: 32px; -webkit-mask-image: linear-gradient(90deg, #000 calc(100% - 36px), transparent);
    mask-image: linear-gradient(90deg, #000 calc(100% - 36px), transparent); } }

  .vit-painel { min-width: 0; }
  .vit-painel:focus-visible { outline-offset: 6px; border-radius: 18px; }
  .vit-painel[hidden] { display: none; }

  /* celular: trilho de 2 linhas, desliza para o lado (o 3º cartão aparece pela metade e convida) */
  .vit-grade { display: grid; grid-auto-flow: column; grid-template-rows: repeat(2, auto); grid-auto-columns: calc((100% - 12px) / 2.2);
    gap: 12px; overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; scrollbar-width: none;
    margin-inline: -16px; padding: 4px 16px 10px; scroll-padding-inline: 16px; }
  .vit-grade::-webkit-scrollbar { display: none; }
  .vit-grade > * { scroll-snap-align: start; min-width: 0; }
  @media (min-width: 700px) {
    .vit-grade { grid-auto-flow: row; grid-template-rows: none; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-auto-columns: auto;
      gap: 16px; overflow: visible; margin-inline: 0; padding: 4px 0 0; }
  }
  @media (min-width: 1100px) { .vit-grade { gap: 18px; } }

  .vit-mais { display: flex; justify-content: center; margin-top: 26px; }
  @media (max-width: 699px) { .vit-mais { margin-top: 14px; } .vit-mais .botao { width: 100%; } }
</style>
