---
// "Raio-x do carro" (home, depois das categorias; página do carro, acima da grade): a arte do carro em vista fantasma
// (public/arte/v2/raio-x.webp, aprovada pelo dono) com as ZONAS tocáveis por cima (lib/raioX.ts).
// - Passar o mouse, focar (Tab) ou tocar uma zona acende a parte: um véu laranja translúcido de bordas esfumadas e o
//   resto da arte escurece de leve (≤ 180 ms; nada se mexe com prefers-reduced-motion). No celular o toque marca a zona
//   e ela fica marcada até tocar outra.
// - Arte larga (640+ px): cada zona tem a etiqueta fixa "Frente 118" no fundo do estúdio, com uma linha-guia fina até o
//   ponto da parte. Arte estreita: só os pontos NUMERADOS na arte (o escolhido ganha o anel grafite) + a fila de fichas
//   embaixo com os mesmos números (a escolhida fica laranja).
// - O painel: o nome e quantas peças a zona tem, os tipos mais comuns dela (cada um um link EXATO do catálogo: tipo +
//   sub + lado/posição + o carro, com a foto da peça mais nova do tipo) e o botão laranja "Ver as peças da frente", que
//   mostra as peças mais novas da zona ali mesmo, num trilho de cartões (a zona inteira não cabe num endereço do
//   catálogo, que entende UM tipo e UM sub). Zona sem peça do carro: cinza, com "Me avise quando chegar" (WhatsApp).
// - home: as contagens do estoque inteiro saem no build. Com carro salvo, o título já nasce com o carro (script antes da
//   1ª pintura) e, no 1º toque na seção, /dados/carro/<k>.json (o do "Chegou para o seu carro") vira as contagens DELE
//   (no ano salvo; ano sem peça: o modelo em todos os anos, com aviso). Trocar o carro atualiza tudo sem recarregar.
// - página do carro (`carro`): as contagens daquele carro já saem no build.
// - DOIS MODOS (o seletor acima da arte): "Achar uma peça" (as zonas, o de sempre) e "Bati o carro" (os 8 pontos da
//   batida e a lista do conserto: components/v2/raioXBatida.ts, baixado só perto do seletor). E, do painel de cada zona,
//   "Ver o motor por dentro" (a vista explodida daquela parte, com cada peça clicável: lib/raioXVistas.ts diz quais
//   zonas têm vista; o código, a arte e a tabela das peças só no clique: components/v2/raioXPorDentro.ts).
//   O palco, a fila das fichas e a caixa do painel são os mesmos nos três: trocar não muda o tamanho de nada.
// - Endereço que já abre uma parte: #raio-x=frente (zona), #raio-x=batida ou #raio-x=batida:frente-esquerda (o modo e
//   o ponto), #raio-x=por-dentro:motor (a vista por dentro da zona; sem a zona, a da frente). O "Onde fica" da página
//   da peça usa o 1º.
// Teclado: Tab percorre as zonas na ordem do carro (ZONAS), Enter abre o painel e leva o foco para ele, Esc limpa.
// Leitor de tela: cada zona é um link "Frente: 118 peças"; a arte, as etiquetas e as fichas (um alvo maior para o dedo)
// ficam de fora. Sem ilha React; a busca do catálogo só desce com carro salvo (1º toque) ou no "Ver as peças".
import { ZONAS, ARTE } from '../../lib/raioX';
import { dadosRaioX } from '../../lib/raioXDados';
import { srcArte, srcsetArte } from '../../lib/variantes';
import { CHAVE } from '../../lib/meuCarro';
import Icone from '../Icone.astro';

// compacto (página do carro): o título menor, no tamanho dos atalhos da página, e sem a linha de apoio.
// recolhido (página do carro, abaixo de 1024 px): no lugar da arte, um cartão baixo com a miniatura que abre o Raio-x.
// A arte inteira na 1ª tela do celular virava o LCP da página (2,5 s em 4G lento, contra 0,74 s) e empurrava a grade.
interface Props { carro?: { b: string; m: string }; id?: string; titulo?: string; compacto?: boolean; recolhido?: boolean }
const { carro, id = 'raio-x', compacto = false, recolhido = false } = Astro.props;
// a miniatura do cartão recolhido: a variante de 320 px (feita por scripts/variantes-imagens.mjs) quando está em dia
const mini = srcsetArte(ARTE.src)?.includes('-320.webp') ? ARTE.src.replace(/\.webp$/, '-320.webp') : ARTE.src;
const dados = dadosRaioX(carro);
const nZ = (k: string) => dados.z.find((d) => d.k === k)?.n ?? 0;
const fmt = (n: number) => n.toLocaleString('pt-BR');
const nomeCarro = carro ? `${carro.b} ${carro.m}` : '';
const titulo = Astro.props.titulo ?? (carro ? `Onde fica a peça no ${nomeCarro}?` : 'Não sabe o nome da peça? Aponte no carro.');
const lead = 'Toque na parte do carro e veja as peças dela que a gente tem no estoque.';
// a arte ocupa a moldura inteira no celular e no tablet; no PC, a coluna da esquerda (≈ 58% da moldura de até 1240)
const sizes = '(max-width: 1023px) calc(100vw - 32px), (max-width: 1303px) calc(58vw - 40px), 716px';
const pct = (v: number, t: number) => `${((v / t) * 100).toFixed(2)}%`;
const rotulo = (k: string, nome: string) => {
  const n = nZ(k);
  const dc = carro ? ` do ${carro.m}` : '';
  return n ? `${nome}: ${fmt(n)} ${n === 1 ? 'peça' : 'peças'}${dc}` : `${nome}: nenhuma peça${dc} agora`;
};
// antes da 1ª pintura (só na home): com carro salvo, o título, a linha de apoio e o convite já com o carro
const antes = `(function(){try{var c=JSON.parse(localStorage.getItem(${JSON.stringify(CHAVE)})||'null');`
  + `if(!c||typeof c.b!=='string'||typeof c.m!=='string'||!c.b||!c.m)return;var r=document.currentScript.parentNode,`
  + `y=typeof c.y==='number'?' '+c.y:'',t=r.querySelector('[data-rx-titulo]'),l=r.querySelector('[data-rx-lead]'),b=r.querySelector('[data-rx-txt]');`
  + `t.textContent='Onde fica a peça no seu '+c.b+' '+c.m+y+'?';l.textContent='Toque na parte do carro e veja as peças do seu '+c.m+' que a gente tem.';`
  + `if(b)b.textContent='Trocar o carro'}catch(e){}})()`;
---
<div class:list={['rx', { 'rx-compacto': compacto, 'rx-recolhido': recolhido }]} data-rx data-rx-id={id} data-vista="achar" data-modo={carro ? 'carro' : 'home'} data-b={carro?.b} data-m={carro?.m} data-sizes={sizes}>
  <div class="rx-cabeca">
    <h2 class:list={[compacto ? 'rx-titulo-p' : 'titulo-secao']} id={`${id}-t`} data-rx-titulo>{titulo}</h2>
    {!compacto && <p class="lead" data-rx-lead>{lead}</p>}
    {!carro && (
      <button type="button" class="rx-convite" data-rx-trocar>
        <Icone nome="carro" /><span data-rx-txt>Diga o seu carro</span>
      </button>
    )}
    {!carro && <script is:inline set:html={antes} />}
  </div>

  {/* os dois modos: rádios de verdade (setas trocam, Tab entra e sai), desenhados como um seletor de dois lados */}
  <div class="rx-modos" role="radiogroup" aria-label="O que você precisa" data-rx-modos>
    <label><input type="radio" name={`${id}-modo`} value="achar" checked /><span><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>Achar uma peça</span></label>
    <label><input type="radio" name={`${id}-modo`} value="batida" /><span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m13 2-2.2 6.3L4 7l4.3 5L3 16l6.6.4L11 22l3.2-5.4L21 18l-3.6-5.3L22 8l-6.6.6z" /></svg>Bati o carro</span></label>
  </div>

  {recolhido && (
    <button type="button" class="rx-abrir" aria-expanded="false" aria-controls={`${id}-corpo`} data-rx-abrir>
      <img src={mini} alt="" width="320" height="213" loading="lazy" decoding="async" />
      <span class="rx-abrir-txt"><b>Aponte no carro</b><span>Frente, motor, portas, teto, rodas… e as peças do {carro?.m} em cada parte.</span></span>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
    </button>
  )}
  <div class="rx-corpo" id={`${id}-corpo`}>
    <div class="rx-arte">
      <div class="rx-palco" data-rx-palco>
        {/* prioridade baixa: na página do carro (PC) a arte cai na 1ª tela e disputava a rede com a arte do topo (o LCP) */}
        <img src={ARTE.src} {...srcArte(ARTE.src, sizes)} alt="" width={ARTE.w} height={ARTE.h} loading="lazy" decoding="async" fetchpriority="low" />
        {/* o véu escuro (o retângulo todo menos a parte acesa) e o véu laranja da parte: duas camadas só de desenho, com o
            desfoque do CSS (feito pela placa de vídeo; o filtro do SVG era redesenhado pela CPU a cada troca) */}
        <svg class="rx-camada rx-escuros" viewBox={`0 0 ${ARTE.w} ${ARTE.h}`} aria-hidden="true">
          {ZONAS.map((z) => <path data-furo={z.k} fill-rule="evenodd" d={`M-120,-120H${ARTE.w + 120}V${ARTE.h + 120}H-120Z ${z.realce.map((p) => `M${p.trim().split(/\s+/).join('L')}Z`).join(' ')}`} />)}
        </svg>
        <svg class="rx-camada rx-realces" viewBox={`0 0 ${ARTE.w} ${ARTE.h}`} aria-hidden="true">
          {ZONAS.map((z) => <g data-realce={z.k} class:list={[{ vazia: !nZ(z.k) }]}>{z.realce.map((p) => <polygon points={p} />)}</g>)}
        </svg>
        <svg class="rx-mapa" viewBox={`0 0 ${ARTE.w} ${ARTE.h}`} role="group" aria-labelledby={`${id}-t`}>
          <g class="rx-guias" aria-hidden="true">
            {ZONAS.map((z) => <line data-guia={z.k} x1={z.ancora[0]} y1={z.ancora[1]} x2={z.etiqueta[0]} y2={z.etiqueta[1]} />)}
          </g>
          {ZONAS.map((z) => (
            <a href={`#${id}-painel`} data-z={z.k} aria-label={rotulo(z.k, z.nome)} class:list={[{ vazia: !nZ(z.k) }]}>
              {z.poligonos.map((p) => <polygon class="rx-alvo" points={p} />)}
            </a>
          ))}
        </svg>
        {ZONAS.map((z, i) => (
          <span class:list={['rx-ponto', { vazia: !nZ(z.k) }]} data-ponto={z.k} style={`left:${pct(z.ancora[0], ARTE.w)};top:${pct(z.ancora[1], ARTE.h)}`} aria-hidden="true"><i class="num">{i + 1}</i></span>
        ))}
        {ZONAS.map((z) => (
          <span class:list={['rx-etiqueta', { vazia: !nZ(z.k) }]} data-etiqueta={z.k} style={`left:${pct(z.etiqueta[0], ARTE.w)};top:${pct(z.etiqueta[1], ARTE.h)}`} aria-hidden="true">{z.nome}<b class="num" data-etiqueta-n>{fmt(nZ(z.k))}</b></span>
        ))}
      </div>
      {/* um alvo maior para o dedo (as mesmas zonas, com os mesmos números): fora do Tab e do leitor de tela, que já têm as zonas */}
      <div class="rx-filas" data-rx-filas>
      <div class="rx-fichas" aria-hidden="true" data-rx-fichas>
        {ZONAS.map((z, i) => (
          <button type="button" tabindex="-1" data-ficha={z.k} class:list={[{ vazia: !nZ(z.k) }]}>
            <i class="num">{i + 1}</i><span>{z.nome}</span><small class="num" data-ficha-n>{fmt(nZ(z.k))}</small>
          </button>
        ))}
      </div>
      </div>
    </div>

    <div class="rx-painel" id={`${id}-painel`} data-rx-painel>
      <div class="rx-dica" data-rx-dica>
        <span class="rx-dica-icone" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11V5.5a1.5 1.5 0 0 1 3 0V10m0-1.5a1.5 1.5 0 0 1 3 0V11m0-1a1.5 1.5 0 0 1 3 0v4.5a6.5 6.5 0 0 1-6.5 6.5h-.6a6 6 0 0 1-4.6-2.2L4.4 15.3a1.6 1.6 0 0 1 2.4-2.1L9 15"/><path d="M5 4.5 3.5 3M14.5 4.5 16 3M9.8 1.5V0"/></svg>
        </span>
        <b>Escolha uma parte do carro</b>
        <ol class="rx-passos">
          <li><span class="num">1</span>Toque na parte, na imagem ou nos nomes logo abaixo dela.</li>
          <li><span class="num">2</span>Veja os tipos de peça daquela parte e quantas a gente tem de cada um.</li>
          <li><span class="num">3</span>Toque no tipo: o catálogo abre já filtrado{carro ? ` no ${carro.m}` : ''}.</li>
        </ol>
      </div>
      <div class="rx-conteudo" data-rx-conteudo hidden></div>
    </div>
  </div>
  <script type="application/json" data-rx-dados set:html={JSON.stringify(dados)} />
  <template data-rx-whats><Icone nome="whats" /></template>
</div>

<script>
  import { lerMeuCarro, nomeCarro, linkCatalogo, EVENTO, ABRIR, type MeuCarro } from '../../lib/meuCarro';
  import { ARQUIVO_CARRO } from '../../lib/chegouCarro';
  import {
    ZONAS, NA_FRENTE, NA_GALERIA, ARQUIVO_GALERIA, linkLinha, qtdPecas, contarZonas, pecasDaZona, lerRaioX,
    type CarroFiltro, type RaioXJson, type ZonaPainel, type LinhaPainel,
  } from '../../lib/raioX';
  import { linkAvisoParte, linkProcuraParte } from '../../lib/aviso';
  import { VISTAS, arteDaVista } from '../../lib/raioXVistas';
  import type { Filtros, Indice, Item } from '../../lib/busca';
  import type { Batida, CarroDaVez } from './raioXBatida';
  import type { PorDentro } from './raioXPorDentro';

  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const nf = (n: number) => n.toLocaleString('pt-BR');
  const calmo = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
  const SETA = '<svg class="rx-l-seta" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>';
  // a foto do cartão no trilho do painel: 168 px no celular, 176 no PC
  const SIZES_GALERIA = '(max-width: 1023px) 168px, 176px';
  type Procurar = (f: Filtros) => Item[];
  // devolve a vez ao navegador (scheduler.yield quando existe; senão um setTimeout)
  const pausa = () => (globalThis as { scheduler?: { yield?: () => Promise<void> } }).scheduler?.yield?.() ?? new Promise<void>((ok) => setTimeout(ok, 0));

  for (const raiz of document.querySelectorAll<HTMLElement>('[data-rx]')) ligar(raiz);

  function ligar(raiz: HTMLElement) {
    const home = raiz.dataset.modo === 'home';
    const base = lerRaioX(JSON.parse(raiz.querySelector('[data-rx-dados]')!.textContent || '{"b":[],"z":[]}') as RaioXJson);
    const painel = raiz.querySelector<HTMLElement>('[data-rx-painel]')!;
    const conteudo = raiz.querySelector<HTMLElement>('[data-rx-conteudo]')!;
    const dica = raiz.querySelector<HTMLElement>('[data-rx-dica]')!;
    const zonasA = [...raiz.querySelectorAll<SVGAElement>('a[data-z]')];
    const fichas = [...raiz.querySelectorAll<HTMLButtonElement>('[data-ficha]')];
    const todos = (sel: string) => [...raiz.querySelectorAll<HTMLElement>(sel)];
    // a linha de apoio sem carro (a do HTML; com carro salvo o script antes da pintura já trocou: volta para esta)
    const lead0 = 'Toque na parte do carro e veja as peças dela que a gente tem no estoque.';
    // as peças de cada parte acesa (realce, furo do véu, linha-guia, etiqueta, ponto, ficha, zona), lidas uma vez
    const pecasVisuais = todos('[data-realce], [data-furo], [data-guia], [data-etiqueta], [data-ponto], [data-ficha], a[data-z]')
      .map((el) => ({ el, k: el.dataset.realce ?? el.dataset.furo ?? el.dataset.guia ?? el.dataset.etiqueta ?? el.dataset.ponto ?? el.dataset.ficha ?? el.dataset.z }));

    // o que está valendo: as contagens (do estoque inteiro, do carro da página ou do carro salvo) e o filtro dos links
    let dados: ZonaPainel[] = base;
    let filtro: CarroFiltro = home ? {} : { marca: raiz.dataset.b, modelo: raiz.dataset.m };
    let carro: MeuCarro | null = home ? lerMeuCarro() : null;
    let estado: 'nada' | 'carregando' | 'ok' = 'nada';
    let aviso = '';
    let ativa: string | null = null;
    let passando: string | null = null;
    let vez = 0;
    // de onde saem as peças do "Ver as peças": a busca do carro (salvo ou da página) ou o arquivo das mais novas por zona
    let procurarCarro: Procurar | null = null;
    let galeria: Promise<{ itens: Item[]; zonas: Record<string, number[]> }> | null = null;
    // a capa da peça (capaItem de lib/busca.ts, que só desce com a busca) e a conta do carro em andamento
    let capa: ((it: Item) => string) | null = null;
    let contando: Promise<void> | null = null;
    // o que a arte mostra: as zonas ('achar'), os pontos da batida ('batida') ou uma parte por dentro ('dentro')
    let vista: 'achar' | 'batida' | 'dentro' = 'achar';
    let batida: Batida | null = null;
    let porDentro: PorDentro | null = null;
    const palco = raiz.querySelector<HTMLElement>('[data-rx-palco]')!;
    const filas = raiz.querySelector<HTMLElement>('[data-rx-filas]')!;
    const radios = [...raiz.querySelectorAll<HTMLInputElement>('[data-rx-modos] input')];

    const zona = (k: string) => ZONAS.find((z) => z.k === k)!;
    const conta = (k: string): ZonaPainel => dados.find((d) => d.k === k) ?? { k, n: 0, l: [] };
    const esperando = () => home && !!carro && estado !== 'ok';
    // "do seu XC60 2019" (carro salvo, na home) / "do XC60" (página do carro) / "no estoque"
    const doCarro = () => {
      if (!home) return `do ${raiz.dataset.m}`;
      return carro && estado === 'ok' && filtro.modelo ? `do seu ${carro.m}${filtro.ano ? ` ${filtro.ano}` : ''}` : 'no estoque';
    };

    function pintarZonas() {
      for (const z of ZONAS) {
        const k = z.k;
        const n = conta(k).n;
        const vazia = !esperando() && n === 0;
        for (const p of pecasVisuais) if (p.k === k) p.el.classList.toggle('vazia', vazia);
        for (const el of todos(`[data-etiqueta="${k}"] [data-etiqueta-n], [data-ficha="${k}"] [data-ficha-n]`)) el.textContent = esperando() ? '' : nf(n);
        const dc = doCarro() === 'no estoque' ? '' : ` ${doCarro()}`;
        raiz.querySelector(`a[data-z="${k}"]`)!.setAttribute('aria-label', esperando()
          ? `${z.nome}: ver as peças do seu ${carro!.m}` : n ? `${z.nome}: ${qtdPecas(n)}${dc}` : `${z.nome}: nenhuma peça${dc} agora`);
      }
    }

    // ---- o carro salvo (só na home): /dados/carro/<k>.json no 1º toque ----
    function carregarCarro(): Promise<void> {
      if (!home || !carro) return Promise.resolve();
      if (estado === 'nada') contando = contarCarro();
      return contando ?? Promise.resolve();
    }
    async function contarCarro() {
      if (!home || !carro || estado !== 'nada') return;
      estado = 'carregando';
      const minha = ++vez;
      const c = carro;
      try {
        const r = await fetch(ARQUIVO_CARRO(c.b, c.m));
        let novos: ZonaPainel[] | null = null;
        let f: CarroFiltro = { marca: c.b, modelo: c.m };
        let msg = '';
        let p: Procurar | null = null;
        if (r.ok) {
          const [{ Busca, capaItem }, ix] = await Promise.all([import('../../lib/busca'), r.json() as Promise<Indice>]);
          await pausa();
          const b = new Busca(ix);
          const q: Procurar = (x) => b.procurar(x);
          p = q;
          capa = (it) => capaItem(it, 'A');
          // uma parte do carro por vez, devolvendo a vez ao navegador entre elas (nenhuma tarefa longa no 1º toque)
          const contarAos = async (g: CarroFiltro) => {
            const out: ReturnType<typeof contarZonas> = [];
            for (const z of ZONAS) { await pausa(); out.push(...contarZonas(q, g, [z])); }
            return out;
          };
          let contas = await contarAos(c.y ? { ...f, ano: c.y } : f);
          if (c.y && contas.every((z) => z.n === 0)) {
            msg = `Agora não há peça do ${c.m} ${c.y} no site: as contagens são do ${c.m} de todos os anos.`;
            contas = await contarAos(f);
          } else if (c.y) f = { ...f, ano: c.y };
          if (contas.some((z) => z.n > 0)) {
            novos = contas.map((z) => ({ k: z.k, n: z.n, l: z.linhas.map((l, i) => ({ tipo: l.tipo, sub: l.sub, lado: l.lado, pos: l.pos, n: l.n, foto: i < NA_FRENTE ? capaItem(l.it, 'A') : '' })) }));
          }
        } else if (r.status !== 404) throw new Error(String(r.status));
        if (minha !== vez) return;
        if (novos) { dados = novos; filtro = f; aviso = msg; procurarCarro = p; }
        else { dados = base; filtro = {}; aviso = `Agora não há peça do seu ${nomeCarro(c)} no site: as contagens são do estoque inteiro.`; }
      } catch {
        if (minha !== vez) return;
        dados = base; filtro = {};
        aviso = 'Sem conexão para contar as peças do seu carro: as contagens são do estoque inteiro.';
      }
      estado = 'ok';
      pintarZonas();
      if (ativa && vista === 'achar') mostrar(ativa, false);
    }

    // ---- o painel ----
    function linhaHtml(l: LinhaPainel, rica: boolean) {
      const href = esc(linkLinha(l, filtro));
      const qtd = `<span class="rx-l-n num">${nf(l.n)}<span class="sr-only"> ${l.n === 1 ? 'peça' : 'peças'}</span></span>`;
      if (!rica) return `<li><a class="rx-tipo" href="${href}"><span>${esc(l.sub)}</span>${qtd}</a></li>`;
      const img = l.foto ? `<img src="${esc(l.foto)}" alt="" width="56" height="56" loading="lazy" decoding="async">` : '';
      return `<li><a class="rx-linha" href="${href}"><span class="rx-l-foto">${img}</span><span class="rx-l-nome">${esc(l.sub)}</span>${qtd}${SETA}</a></li>`;
    }

    /** O convite da vista por dentro da zona ("Ver o motor por dentro"), na altura de UMA linha do painel. */
    function conviteDentro(k: string) {
      const v = VISTAS[k];
      if (!v) return '';
      return `<button type="button" class="rx-dentro" data-rx-dentro="${k}"><img src="${arteDaVista(v, 320)}" alt="" width="84" height="56" loading="lazy" decoding="async">`
        + `<span><b>${esc(v.botao)}</b><small>${esc(v.resumo)}</small></span>${SETA}</button>`;
    }

    function mostrar(k: string, focar: boolean) {
      const z = zona(k);
      const c = conta(k);
      dica.hidden = true;
      conteudo.hidden = false;
      painel.classList.add('aberto');
      const dc = doCarro();
      const cabeca = (n: string, sub: string) => `<div class="rx-p-cabeca"><h3 class="rx-p-titulo" tabindex="-1">${esc(z.nome)}<span class="rx-p-n num">${esc(n)}</span></h3><p class="rx-p-sub">${esc(sub)}</p></div>`;
      let html = '';
      if (esperando()) {
        html = cabeca('', `Contando as peças do seu ${carro!.m}…`)
          + `<ul class="rx-linhas rx-esq" aria-hidden="true">${'<li><span class="rx-linha"><span class="rx-l-foto"></span><span class="rx-l-nome">&nbsp;</span></span></li>'.repeat(4)}</ul>`;
      } else if (!c.n) {
        const quem = carro ? `${carro.b} ${carro.m}` : `${raiz.dataset.b} ${raiz.dataset.m}`;
        html = cabeca(' · nenhuma peça agora', dc)
          + (aviso ? `<p class="rx-p-aviso">${esc(aviso)}</p>` : '')
          + `<p class="rx-p-vazio">Agora não há peça ${esc(z.de)} ${esc(dc)} no site. Peça o aviso no WhatsApp: a mensagem já vai pronta com o carro e a parte.</p>`
          + `<div class="rx-p-acoes"><a class="botao botao-linha rx-avise" data-botao="avise-carro" rel="noopener" href="${esc(linkAvisoParte(quem, filtro.ano ?? null, z.de))}">`
          + `${raiz.querySelector('template[data-rx-whats]')?.innerHTML ?? ''}Me avise quando chegar</a>`
          + `<a class="rx-p-outros" href="${esc(linkCatalogo({ b: filtro.marca || raiz.dataset.b || carro!.b, m: filtro.modelo || raiz.dataset.m || carro!.m, y: filtro.ano }))}">Ver todas as peças ${esc(dc)}</a></div>`
          // a vista por dentro continua valendo: cada peça dela vira um pedido "a gente procura no pátio"
          + conviteDentro(k);
      } else {
        // zona com vista por dentro: o convite "Ver o motor por dentro" ocupa o lugar de UMA linha (a altura do painel
        // fica a mesma); o tipo que saiu da frente continua no "Ver os N tipos"
        const convite = conviteDentro(k);
        const naFrente = convite ? NA_FRENTE - 1 : NA_FRENTE;
        const ricas = c.l.slice(0, naFrente);
        const resto = c.l.slice(naFrente);
        html = cabeca(` · ${qtdPecas(c.n)}`, `${dc}${c.l.length > 1 ? ` · ${c.l.length} tipos de peça` : ''}`)
          + (aviso ? `<p class="rx-p-aviso">${esc(aviso)}</p>` : '')
          + convite
          + `<ul class="rx-linhas">${ricas.map((l) => linhaHtml(l, true)).join('')}</ul>`;
        if (resto.length) {
          html += `<button type="button" class="rx-mais" aria-expanded="false" aria-controls="${painel.id}-resto">Ver os ${c.l.length} tipos ${esc(z.de)}</button>`
            + `<ul class="rx-resto" id="${painel.id}-resto" hidden>${resto.map((l) => linhaHtml(l, false)).join('')}</ul>`;
        }
        html += `<div class="rx-p-pe"><button type="button" class="botao botao-laranja rx-ver" aria-controls="${painel.id}-pecas">Ver as peças ${esc(z.de)}</button>`
          + `<div class="rx-galeria" id="${painel.id}-pecas" hidden></div></div>`;
      }
      if (!esperando()) {
        const carroMsg = home ? (carro ? nomeCarro({ ...carro, y: filtro.ano ?? carro.y }) : '') : `${raiz.dataset.b} ${raiz.dataset.m}`;
        html += `<a class="rx-patio" data-botao="raio-x" rel="noopener" href="${esc(linkProcuraParte(carroMsg, z.de, home))}">`
          + `<span>Não achou? <b>A gente procura no pátio</b></span>${SETA}</a>`;
      }
      conteudo.innerHTML = html;
      const mais = conteudo.querySelector<HTMLButtonElement>('.rx-mais');
      mais?.addEventListener('click', () => {
        const resto = conteudo.querySelector<HTMLElement>('.rx-resto')!;
        const abrir = resto.hidden;
        resto.hidden = !abrir;
        mais.setAttribute('aria-expanded', String(abrir));
        mais.textContent = abrir ? 'Ver menos tipos' : `Ver os ${c.l.length} tipos ${z.de}`;
        if (abrir) resto.querySelector<HTMLElement>('a')?.focus({ preventScroll: true });
      });
      conteudo.querySelector<HTMLButtonElement>('.rx-ver')?.addEventListener('click', (e) => void verPecas(k, e.currentTarget as HTMLButtonElement));
      const dentro = conteudo.querySelector<HTMLButtonElement>('[data-rx-dentro]');
      if (dentro) {
        // o dedo ou o mouse encostou: o código, a arte e a tabela da vista começam a descer antes do clique
        const cedo = () => void modPorDentro().then((m) => m.aquecerVista(k, raiz.dataset.sizes ?? '100vw')).catch(() => {});
        dentro.addEventListener('pointerenter', cedo, { once: true });
        dentro.addEventListener('touchstart', cedo, { once: true, passive: true });
        dentro.addEventListener('focus', cedo, { once: true });
        dentro.addEventListener('click', () => void abrirPorDentro(k, dentro));
      }
      if (focar) conteudo.querySelector<HTMLElement>('.rx-p-titulo')?.focus({ preventScroll: true });
    }

    // página do carro: o arquivo só do carro (o mesmo da grade do ano), uma vez
    let daPagina: Promise<void> | null = null;
    function buscaDaPagina(): Promise<void> {
      daPagina ??= Promise.all([
        fetch(ARQUIVO_CARRO(raiz.dataset.b!, raiz.dataset.m!)).then((r) => { if (!r.ok) throw new Error(String(r.status)); return r.json() as Promise<Indice>; }),
        import('../../lib/busca'),
      ]).then(([ix, { Busca, capaItem }]) => {
        const b = new Busca(ix);
        procurarCarro = (x) => b.procurar(x);
        capa = (it) => capaItem(it, 'A');
      }).catch((e) => { daPagina = null; throw e; });
      return daPagina;
    }

    // ---- "Ver as peças da frente": as mais novas da zona num trilho de cartões, ali mesmo ----
    async function pecasDe(k: string): Promise<Item[]> {
      if (!home) await buscaDaPagina();
      if (procurarCarro && filtro.modelo) return pecasDaZona(procurarCarro, filtro, zona(k));
      galeria ??= Promise.all([fetch(ARQUIVO_GALERIA).then((r) => { if (!r.ok) throw new Error(String(r.status)); return r.json(); }), import('../../lib/busca')])
        .then(([ix, { Busca }]) => ({ itens: new Busca(ix as Indice).itens, zonas: (ix as { zonas: Record<string, number[]> }).zonas }))
        .catch((e) => { galeria = null; throw e; });
      const g = await galeria;
      return (g.zonas[k] ?? []).map((i) => g.itens[i]).filter(Boolean);
    }

    async function verPecas(k: string, botao: HTMLButtonElement) {
      const caixa = conteudo.querySelector<HTMLElement>('.rx-galeria')!;
      botao.hidden = true;
      caixa.hidden = false;
      const z = zona(k);
      const total = conta(k).n;
      const { ESQ_CARTAO, porCartoes } = await import('./trilhoPessoal');
      caixa.innerHTML = `<p class="rx-g-titulo">As peças ${esc(z.de)}</p><div class="trilho rx-trilho" aria-busy="true">${ESQ_CARTAO.repeat(3)}</div>`;
      try {
        const [itens, { cartaoHtml, vigiarFotos }] = await Promise.all([pecasDe(k), import('../../lib/vendidaCartoes')]);
        if (ativa !== k || !caixa.isConnected) return;
        const mostra = itens.slice(0, NA_GALERIA);
        const trilho = caixa.querySelector<HTMLElement>('.rx-trilho')!;
        caixa.querySelector('.rx-g-titulo')!.textContent = total > mostra.length
          ? `As ${mostra.length} mais novas ${z.de}, de ${nf(total)}` : total === 1 ? `A peça ${z.de}` : `As ${nf(total)} peças ${z.de}`;
        vigiarFotos(trilho);
        porCartoes(trilho, mostra.map((it) => cartaoHtml(it, SIZES_GALERIA)).join(''));
        if (total > mostra.length) caixa.insertAdjacentHTML('beforeend', '<p class="rx-g-nota">Para ver todas, escolha o tipo da peça logo acima: cada um abre o catálogo já filtrado.</p>');
        trilho.querySelector<HTMLElement>('a')?.focus({ preventScroll: true });
      } catch {
        if (caixa.isConnected) caixa.innerHTML = '<p class="rx-g-nota">Sem conexão agora. Escolha o tipo da peça logo acima: cada um abre o catálogo já filtrado.</p>';
      }
    }

    // ---- a parte acesa (mouse em cima, foco ou a escolhida): véu, furo, linha-guia, etiqueta, ponto, ficha ----
    function acender() {
      const luz = passando ?? ativa;
      raiz.classList.toggle('rx-aceso', !!luz);
      for (const p of pecasVisuais) {
        p.el.classList.toggle('aceso', p.k === luz);
        p.el.classList.toggle('on', p.k === ativa);
      }
    }

    // o "passar o mouse" só onde há mouse de verdade, e nunca logo depois de escolher (a rolagem até o painel passa o
    // conteúdo por baixo do ponteiro parado: a parte acesa não pode trocar sozinha)
    const comMouse = matchMedia('(hover: hover) and (pointer: fine)');
    let escolhidaEm = 0;
    const passa = (e: PointerEvent) => e.pointerType === 'mouse' && comMouse.matches && performance.now() - escolhidaEm > 700;

    function selecionar(k: string, como: { focar?: boolean; rolar?: boolean } = {}) {
      raiz.classList.add('tocado');
      escolhidaEm = performance.now();
      void carregarCarro();
      if (ativa !== k || conteudo.hidden) {
        ativa = k;
        passando = null;
        acender();
        mostrar(k, !!como.focar);
      } else if (como.focar) conteudo.querySelector<HTMLElement>('.rx-p-titulo')?.focus({ preventScroll: true });
      // medir (a ficha na fila, o painel na tela) só DEPOIS da pintura: ler a posição logo depois de montar o painel
      // obrigava o navegador a calcular a página no meio do toque (~20 ms com CPU 6×)
      requestAnimationFrame(() => setTimeout(() => {
        if (ativa !== k) return;
        // a ficha escolhida à vista na fila (só o scroll da fila, nunca a página; na hora: a rolagem suave da fila era
        // cancelada pela da página até o painel, no Safari)
        const f = fichas.find((b) => b.dataset.ficha === k);
        const fila = f?.parentElement;
        if (f && fila && fila.scrollWidth > fila.clientWidth) {
          const fr = f.getBoundingClientRect();
          const lr = fila.getBoundingClientRect();
          fila.scrollLeft += fr.left - lr.left - (lr.width - fr.width) / 2;
        }
        // celular: o painel vem embaixo da arte; se ele começa fora da tela, rola só o bastante para o título e 2 tipos
        if (como.rolar || como.focar) {
          const r = painel.getBoundingClientRect();
          const falta = r.top + Math.min(r.height, 240) - innerHeight;
          if (falta > 0) scrollBy({ top: falta + 16, behavior: calmo() ? 'auto' : 'smooth' });
        }
      }));
    }

    // Esc: limpa a escolha (volta o "como funciona") e devolve o foco à zona
    let semAbrir = false;
    function limpar() {
      const k = ativa;
      // o foco estava no painel (que vai ser esvaziado) ou numa zona: volta para a zona que estava escolhida
      const dentro = raiz.contains(document.activeElement);
      ativa = null;
      passando = null;
      acender();
      conteudo.hidden = true;
      conteudo.innerHTML = '';
      dica.hidden = false;
      painel.classList.remove('aberto');
      if (k && dentro) {
        // o foco volta à zona sem abrir de novo (o foco pelo teclado abre a zona: aqui não)
        semAbrir = true;
        raiz.querySelector<SVGAElement>(`a[data-z="${k}"]`)?.focus({ preventScroll: true });
        semAbrir = false;
      }
    }

    // ---- os outros modos: "Bati o carro" e as vistas por dentro (código e estilo baixados sob demanda) ----
    const modBatida = () => import('./raioXBatida');
    const modPorDentro = () => import('./raioXPorDentro');
    const doCarroDe = (f: CarroFiltro) => (!f.modelo ? '' : `${home ? 'do seu' : 'do'} ${f.modelo}${f.ano ? ` ${f.ano}` : ''}`);
    /** O carro nas mensagens: o salvo (home; na página do carro, se é o mesmo) ou o da página, sem o ano. */
    const carroTxt = (): { nome: string; meu: boolean } => {
      // salvo sem ano: o ano em branco para a pessoa escrever (o mesmo texto de carroSalvoTxt, lib/whats.ts, que este
      // script não importa para não pesar em toda visita)
      if (home) return { nome: !carro ? '' : carro.y ? nomeCarro(carro) : `${carro.b} ${carro.m}, ano ____`, meu: true };
      const s = lerMeuCarro();
      return s && s.b === raiz.dataset.b && s.m === raiz.dataset.m && s.y
        ? { nome: nomeCarro(s), meu: true } : { nome: `${raiz.dataset.b} ${raiz.dataset.m}`, meu: false };
    };
    /** O carro que vale para a lista do conserto e as vistas por dentro: o salvo (home, com as mesmas quedas das zonas:
     *  ano sem peça = todos os anos; modelo sem peça = o estoque inteiro) ou o da página (no ano do salvo, se é o mesmo). */
    async function carroDaVez(): Promise<CarroDaVez> {
      const semCapa = () => '';
      if (home) {
        await carregarCarro();
        return { procurar: filtro.modelo ? procurarCarro : null, filtro, aviso, capa: capa ?? semCapa };
      }
      await buscaDaPagina();
      let f: CarroFiltro = { marca: raiz.dataset.b, modelo: raiz.dataset.m };
      let msg = '';
      const s = lerMeuCarro();
      if (s && s.b === f.marca && s.m === f.modelo && s.y) {
        if (procurarCarro!({ ...f, ano: s.y }).length) f = { ...f, ano: s.y };
        else msg = `Agora não há peça do ${s.m} ${s.y} no site: a lista é do ${s.m} de todos os anos.`;
      }
      return { procurar: procurarCarro, filtro: f, aviso: msg, capa: capa ?? semCapa };
    }
    const semPainel = () => {
      conteudo.hidden = true;
      conteudo.innerHTML = '';
      dica.hidden = false;
      painel.classList.remove('aberto');
    };
    // página do carro no celular: o Raio-x recolhido abre
    const abrirRecolhido = () => {
      raiz.classList.add('rx-aberto');
      raiz.querySelector('[data-rx-abrir]')?.setAttribute('aria-expanded', 'true');
    };
    let pegando: Promise<Batida> | null = null;
    const pegarBatida = () => (pegando ??= modBatida().then((m) => (batida = m.ligarBatida({
      raiz, palco, painel, conteudo, dica, fichas: filas, home, carro: carroDaVez,
      carroMsg: () => { const c = carroTxt(); return c.meu || !c.nome ? c.nome : `${c.nome}, ano ____`; },
      doCarro: doCarroDe,
      dizerCarro: () => window.dispatchEvent(new CustomEvent(ABRIR)),
      whats: raiz.querySelector('template[data-rx-whats]')?.innerHTML ?? '',
    }))).catch((e) => { pegando = null; throw e; }));

    async function abrirPorDentro(k: string, botao: HTMLElement | null) {
      try {
        const m = await modPorDentro();
        porDentro ??= m.ligarPorDentro({
          raiz, palco, painel, conteudo, dica, fichas: filas, home, carro: carroDaVez, carroMsg: carroTxt, doCarro: doCarroDe,
          sizes: raiz.dataset.sizes ?? '100vw',
          aoVoltar: () => {
            vista = 'achar';
            if (ativa) mostrar(ativa, false); else semPainel();
            acender();
          },
        });
        if (await porDentro.abrir(k, botao)) vista = 'dentro';
      } catch { /* sem conexão: o painel da zona continua como está */ }
    }

    /** Troca de modo (o seletor, ou o endereço #raio-x=batida). O palco, as fichas e a caixa do painel são os mesmos. */
    async function irPara(novo: 'achar' | 'batida', pontoInicial?: string) {
      if (vista === 'dentro') porDentro?.sair(false, true);
      for (const r of radios) r.checked = r.value === novo;
      if (novo === vista) { if (novo === 'batida' && pontoInicial) void batida?.selecionar(pontoInicial, { rolar: true }); return; }
      abrirRecolhido();
      if (novo === 'batida') {
        let b: Batida;
        // sem conexão para baixar o modo: o seletor volta para onde estava
        try { b = await pegarBatida(); } catch { for (const r of radios) r.checked = r.value === vista; return; }
        if (vista !== 'achar') return;
        ativa = null;
        passando = null;
        acender();
        vista = 'batida';
        raiz.dataset.vista = 'batida';
        b.entrar(pontoInicial);
      } else {
        batida?.sair();
        vista = 'achar';
        raiz.dataset.vista = 'achar';
        semPainel();
      }
    }
    for (const r of radios) r.addEventListener('change', () => { if (r.checked) void irPara(r.value as 'achar' | 'batida'); });
    // o código do modo de batida começa a descer quando a pessoa encosta no seletor (antes do clique)
    const modos = raiz.querySelector<HTMLElement>('[data-rx-modos]');
    const cedoBatida = () => void pegarBatida().catch(() => {});
    modos?.addEventListener('pointerenter', cedoBatida, { once: true });
    modos?.addEventListener('touchstart', cedoBatida, { once: true, passive: true });
    modos?.addEventListener('focusin', cedoBatida, { once: true });

    // ---- ouvintes ----
    for (const a of zonasA) {
      const k = a.dataset.z!;
      a.addEventListener('click', (e) => {
        e.preventDefault();
        // Enter (clique sem ponteiro: detail 0) leva o foco ao painel; o toque só abre
        selecionar(k, { focar: (e as MouseEvent).detail === 0, rolar: true });
      });
      // Tab: a zona focada já abre (o foco continua nela; Enter leva ao painel)
      a.addEventListener('focus', () => { if (!semAbrir && a.matches(':focus-visible')) selecionar(k); });
      a.addEventListener('pointerenter', (e) => { if (passa(e)) { passando = k; acender(); } });
      a.addEventListener('pointerleave', (e) => { if (e.pointerType === 'mouse' && passando === k) { passando = null; acender(); } });
    }
    for (const f of fichas) f.addEventListener('click', () => selecionar(f.dataset.ficha!, { rolar: true }));
    raiz.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      if (vista === 'dentro') { e.preventDefault(); porDentro?.sair(true); }
      else if (vista === 'batida') { if (batida?.esc()) e.preventDefault(); }
      else if (ativa) { e.preventDefault(); limpar(); }
    });
    // Aquecimento: quando a arte aparece na tela, com o navegador folgando, as duas camadas de desfoque são desenhadas
    // uma vez (quase transparentes) e um painel é montado fora da vista e desfeito. O 1º toque não paga a 1ª vez.
    const aquecer = () => {
      const k = ZONAS[1].k;
      const els = todos(`[data-realce="${k}"], [data-furo="${k}"]`);
      for (const el of els) el.classList.add('aquece');
      // a cópia do painel (com o atributo do escopo do CSS) fora da vista
      const molde = conteudo.cloneNode(false) as HTMLElement;
      molde.removeAttribute('hidden');
      molde.removeAttribute('data-rx-conteudo');
      molde.classList.add('rx-molde');
      molde.setAttribute('aria-hidden', 'true');
      const c = conta(k);
      molde.innerHTML = `<div class="rx-p-cabeca"><h3 class="rx-p-titulo">${esc(zona(k).nome)}</h3><p class="rx-p-sub">&nbsp;</p></div>`
        + `<ul class="rx-linhas">${c.l.slice(0, NA_FRENTE).map((l) => linhaHtml({ ...l, foto: '' }, true)).join('')}</ul>`;
      painel.appendChild(molde);
      void molde.offsetHeight;
      requestAnimationFrame(() => requestAnimationFrame(() => {
        for (const el of els) el.classList.remove('aquece');
        molde.remove();
      }));
    };
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((es) => {
        if (!es.some((e) => e.isIntersecting)) return;
        io.disconnect();
        if ('requestIdleCallback' in window) requestIdleCallback(aquecer, { timeout: 1500 });
        else setTimeout(aquecer, 200);
      }, { rootMargin: '200px' });
      io.observe(raiz.querySelector('[data-rx-palco]')!);
    }

    // "1º toque" na seção: o carro salvo começa a descer antes do clique (mouse em cima, dedo encostando, Tab)
    const cedo = () => {
      void carregarCarro();
      // e o modo "Bati o carro" fica pronto (código, estilo e a camada dos pontos) quando o navegador folgar
      if ('requestIdleCallback' in window) requestIdleCallback(cedoBatida, { timeout: 3000 });
      else setTimeout(cedoBatida, 600);
    };
    raiz.addEventListener('pointerenter', cedo, { once: true });
    raiz.addEventListener('touchstart', cedo, { once: true, passive: true });
    raiz.addEventListener('focusin', cedo, { once: true });

    // página do carro no celular: o cartão recolhido abre o Raio-x (e o foco vai para a 1ª parte do carro)
    const abrir = raiz.querySelector<HTMLButtonElement>('[data-rx-abrir]');
    abrir?.addEventListener('click', () => {
      abrirRecolhido();
      if (vista === 'achar') zonasA[0]?.focus({ preventScroll: true });
      else raiz.querySelector<HTMLElement>('.rxb-ponto')?.focus({ preventScroll: true });
    });

    // ---- o endereço que já abre uma parte: #raio-x=frente | #raio-x=batida[:ponto] | #raio-x=por-dentro[:zona] ----
    function doEndereco() {
      const m = /^#raio-x=([a-z-]+)(?::([a-z-]+))?$/.exec(location.hash);
      if (!m) return;
      const [, a, b] = m;
      const zonaDoLink = ZONAS.some((z) => z.k === a);
      // a vista por dentro: a da zona do endereço; sem zona (o endereço do piloto), a da frente
      const dentroDe = a === 'por-dentro' ? b ?? 'frente' : '';
      if (a === 'por-dentro' ? !VISTAS[dentroDe] : a !== 'batida' && !zonaDoLink) return;
      abrirRecolhido();
      // a página ainda se arruma (fotos, seções acima): chega agora e de novo depois da carga, se a pessoa não rolou
      const chegar = () => raiz.scrollIntoView({ block: 'start' });
      chegar();
      let mexeu = false;
      const parou = () => { mexeu = true; };
      addEventListener('wheel', parou, { once: true, passive: true });
      addEventListener('touchmove', parou, { once: true, passive: true });
      addEventListener('keydown', parou, { once: true });
      const depois = () => setTimeout(() => { if (!mexeu) chegar(); }, 350);
      if (document.readyState === 'complete') depois(); else addEventListener('load', depois, { once: true });
      if (a === 'batida') void irPara('batida', b);
      else {
        void irPara('achar').then(() => {
          selecionar(dentroDe || a);
          if (dentroDe) void abrirPorDentro(dentroDe, null);
        });
      }
    }
    doEndereco();
    addEventListener('hashchange', doEndereco);

    if (!home) return;
    raiz.querySelector('[data-rx-trocar]')?.addEventListener('click', () => window.dispatchEvent(new CustomEvent(ABRIR)));
    // trocou o carro (abertura, cabeçalho): título, convite, contagens e o painel aberto acompanham, sem recarregar
    window.addEventListener(EVENTO, (e) => {
      carro = (e as CustomEvent<MeuCarro | null>).detail;
      vez++;
      estado = 'nada';
      dados = base;
      filtro = {};
      aviso = '';
      procurarCarro = null;
      const t = raiz.querySelector('[data-rx-titulo]')!;
      const l = raiz.querySelector('[data-rx-lead]');
      const b = raiz.querySelector('[data-rx-txt]');
      t.textContent = carro ? `Onde fica a peça no seu ${nomeCarro(carro)}?` : 'Não sabe o nome da peça? Aponte no carro.';
      if (l) l.textContent = carro ? `Toque na parte do carro e veja as peças do seu ${carro.m} que a gente tem.` : lead0;
      if (b) b.textContent = carro ? 'Trocar o carro' : 'Diga o seu carro';
      contando = null;
      capa = null;
      pintarZonas();
      if (ativa && vista === 'achar') { mostrar(ativa, false); void carregarCarro(); }
      batida?.trocouCarro();
      porDentro?.trocouCarro();
    });
    if (carro) pintarZonas();
  }
</script>

