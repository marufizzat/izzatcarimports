  /* ---- as peças ---- */
  .abv2 .ab-pecas { list-style: none; margin: 0; padding: 0; }
  .abv2 .ab-p { position: absolute; left: 0; top: 0; width: calc(var(--w) * 1cqmin); aspect-ratio: var(--ar); --se: 1; --x: var(--cx, 50); --y: var(--cy, 40);
