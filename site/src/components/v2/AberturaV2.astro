  /* o DRL do farol ACENDE: a máscara são só as luzes acesas (farol-drl.webp) e por ela passa um véu escuro. Parado, o
     véu não existe (luz acesa). Na chegada o farol nasce apagado (.ab-apagado, posto antes da 1ª pintura) e o véu sai
     da esquerda para a direita (.ab-corre); ao escolher a marca ou o carro ele pisca duas vezes (.ab-pisca), como
     carro destravando. Só transform/opacity. */
  .abv2 .ab-drl { position: absolute; inset: 0; overflow: hidden; pointer-events: none;
    -webkit-mask: url(/arte/v2/abertura/farol-drl.webp) center / 100% 100% no-repeat; mask: url(/arte/v2/abertura/farol-drl.webp) center / 100% 100% no-repeat; }
  .abv2 .ab-drl i { position: absolute; top: 0; bottom: 0; left: -18%; width: 136%; opacity: 0;
