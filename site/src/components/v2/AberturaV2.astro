    transform: translate3d(calc(var(--px) * var(--d) * -1px), calc(var(--py) * var(--d) * -.6px), 0); }
  .abv2 .ab-p > a:focus-visible { outline: 3px solid var(--accent-text); outline-offset: 6px; }
  /* a área de toque é a peça + o rótulo, com folga (peça baixa, como a maçaneta, não fica com alvo pequeno) */
  .abv2 .ab-p > a::before { content: ""; position: absolute; inset: calc(-6px / var(--se)) calc(-6px / var(--se)) calc(-40px / var(--se)); }
  .abv2 .ab-f { position: absolute; inset: 0; display: block; }
  .abv2 .ab-img { position: absolute; inset: 0; width: 100%; height: 100%; max-width: none; object-fit: contain;
    filter: drop-shadow(0 calc(var(--w) * .05cqmin) calc(var(--w) * .06cqmin) rgb(60 40 30 / .2));
    transition: transform .22s cubic-bezier(.2, .9, .25, 1.15); }
  /* peça que o estado não usa: fora do layout (são 18; no máximo 5 ou 6 aparecem). Saindo (.ab-sai, posto pelo
