  /* ---- a arte do carro: larga como o palco, com o horizonte dela em cima do horizonte do palco ---- */
  .abv2 .ab-auto { position: absolute; left: 50%; top: calc(var(--ab-horizonte) - .4433 * var(--ab-aw)); width: var(--ab-aw); max-width: none; height: auto; aspect-ratio: 3 / 2; --ab-aw: 100cqw;
    transform: translate3d(calc(-50% + 1cqw + var(--px) * -5px), 0, 0) scale(1.035); transform-origin: 50% 66%; opacity: 0; pointer-events: none;
    -webkit-mask-image: linear-gradient(180deg, transparent 0, #000 15%, #000 88%, transparent 100%), linear-gradient(90deg, transparent 2%, #000 16%, #000 95%, transparent 100%);
    mask-image: linear-gradient(180deg, transparent 0, #000 15%, #000 88%, transparent 100%), linear-gradient(90deg, transparent 2%, #000 16%, #000 95%, transparent 100%);
