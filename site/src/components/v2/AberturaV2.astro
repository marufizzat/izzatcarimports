---
// Abertura v2: arte de estúdio à direita (no celular, embaixo) e UMA ação principal, no padrão das grandes
// lojas de autopeças: o cartão de busca com duas abas.
//   "Pelo carro" (aberta): marca com logo -> modelo -> ano -> "Ver as N peças" (SeletorCarro).
//   "Pelo nome ou código": a busca com sugestões + até 4 atalhos de tipos de peça, todos diferentes.
// Os selos (CDV, nota fiscal, 90 dias) ficam na faixa logo abaixo: aqui não se repetem.
import SeletorCarro from '../SeletorCarro.astro';
import Icone from '../Icone.astro';
import { populares } from '../../lib/populares';
interface Props { arte: string; arteCelular?: string; tom?: 'claro' | 'escuro'; }
const { arte, arteCelular, tom = 'claro' } = Astro.props;
const atalhos = populares(4);
---
<section class:list={['abv2', 'tema-estudio', `abv2-${tom}`]} aria-labelledby="abv2-titulo">
  <picture class="abv2-arte" aria-hidden="true">
    <source media="(max-width: 767px)" srcset={arteCelular ?? arte} />
    <img src={arte} alt="" width="1536" height="1024" fetchpriority="high" decoding="async" />
  </picture>
  <div class="moldura abv2-conteudo">
    <h1 id="abv2-titulo" class="display abv2-h1">Qual peça o seu carro precisa?</h1>
    <p class="abv2-lead">Peças originais de carros com baixa legal no Detran-RS.</p>
    <div class="abv2-cartao" data-abas>
      <div class="abv2-abas" role="tablist" aria-label="Como achar a peça">
        <button type="button" role="tab" id="abv2-aba-carro" aria-controls="abv2-painel-carro" aria-selected="true" tabindex="0">
          <Icone nome="carro" /><span>Pelo carro</span>
        </button>
        <button type="button" role="tab" id="abv2-aba-busca" aria-controls="abv2-painel-busca" aria-selected="false" tabindex="-1">
          <Icone nome="busca" /><span>Pelo nome ou código</span>
        </button>
      </div>
      <div class="abv2-painel" role="tabpanel" id="abv2-painel-carro" aria-labelledby="abv2-aba-carro">
        <SeletorCarro />
      </div>
      <div class="abv2-painel abv2-painel-busca" role="tabpanel" id="abv2-painel-busca" aria-labelledby="abv2-aba-busca" hidden>
        <slot name="busca" />
        {atalhos.length > 0 && (
          <div class="abv2-atalhos">
            <span>Mais comuns no pátio:</span>
            <ul>{atalhos.map((a) => <li><a href={`/catalogo.html?q=${encodeURIComponent(a.q)}`}>{a.n}</a></li>)}</ul>
          </div>
        )}
      </div>
    </div>
  </div>
</section>

<script>
  // Abas do cartão (padrão WAI-ARIA): clique ou setas. Ao abrir "Pelo nome ou código" pelo clique,
  // o cursor já vai para o campo.
  document.querySelectorAll<HTMLElement>('[data-abas]').forEach((caixa) => {
    const abas = Array.from(caixa.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const painel = (a: HTMLElement) => document.getElementById(a.getAttribute('aria-controls') || '');
    const escolher = (i: number, foco: 'aba' | 'campo' | null) => {
      abas.forEach((a, k) => {
        const on = k === i;
        a.setAttribute('aria-selected', String(on));
        a.tabIndex = on ? 0 : -1;
        const p = painel(a);
        if (p) p.hidden = !on;
      });
      if (foco === 'aba') abas[i].focus();
      else if (foco === 'campo') painel(abas[i])?.querySelector<HTMLInputElement>('input')?.focus();
    };
    abas.forEach((a, i) => {
      a.addEventListener('click', () => {
        if (a.getAttribute('aria-selected') === 'true') return;
        escolher(i, a.getAttribute('aria-controls') === 'abv2-painel-busca' ? 'campo' : null);
      });
      a.addEventListener('keydown', (e) => {
        const passo = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        const fim = e.key === 'Home' ? 0 : e.key === 'End' ? abas.length - 1 : -1;
        if (!passo && fim < 0) return;
        e.preventDefault();
        escolher(fim >= 0 ? fim : (i + passo + abas.length) % abas.length, 'aba');
      });
    });
  });
</script>

<style>
  .abv2 { position: relative; background: #f1f0ed; min-height: clamp(600px, calc(100svh - 84px), 860px); display: grid; align-content: start; }
  /* PC: a arte ocupa só a parte direita e some suave para o fundo do estúdio; recortada só ela
     (a seção não corta nada, para a lista de sugestões da busca poder passar por cima da faixa de selos) */
  .abv2-arte { position: absolute; inset: 0 0 0 auto; width: var(--abv2-larg, 62%); overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 26%); mask-image: linear-gradient(90deg, transparent 0, #000 26%); }
  .abv2-arte img { width: 100%; height: 100%; object-fit: cover; object-position: 85% 45%; }

  /* acima da arte e da faixa de selos (z-index 1); a caixa em si não pega clique, só o que tem dentro */
  .abv2-conteudo { position: relative; z-index: 2; display: grid; align-content: start; gap: 14px;
    padding-block: clamp(28px, 9vh, 96px) 72px; pointer-events: none; }
  .abv2-conteudo > * { pointer-events: auto; max-width: min(568px, 44vw); }
  .abv2-h1 { margin: 0; font-size: clamp(40px, calc(4.6vw + 6px), 76px); color: #1d1d1f; }
  .abv2-lead { margin: -2px 0 8px; font-size: clamp(16px, 1.3vw, 19px); line-height: 1.5; color: #4a4a50; max-width: 40ch; text-wrap: pretty; }

  /* o cartão: abas no topo, a escolha embaixo */
  .abv2-cartao { border-radius: 24px; background: #fff; box-shadow: 0 2px 6px rgb(16 16 20 / .06), 0 28px 56px -22px rgb(16 16 20 / .28), 0 0 0 1px rgb(16 16 20 / .04); }
  .abv2-abas { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr); padding: 0 10px; border-bottom: 1px solid var(--line); }
  .abv2-abas [role="tab"] { position: relative; min-width: 0; min-height: 58px; display: inline-flex; align-items: center; justify-content: center; gap: 9px;
    padding: 0 8px; border: 0; background: none; color: var(--ink-3); font-size: 15.5px; font-weight: 680; font-stretch: 94%; white-space: nowrap;
    transition: color .18s ease; }
  .abv2-abas [role="tab"] :global(svg) { width: 21px; height: 21px; flex: none; }
  .abv2-abas [role="tab"]:hover { color: var(--ink); }
  .abv2-abas [role="tab"][aria-selected="true"] { color: var(--ink); }
  .abv2-abas [role="tab"]::after { content: ""; position: absolute; left: 12px; right: 12px; bottom: -1px; height: 3px; border-radius: 3px 3px 0 0;
    background: var(--accent); transform: scaleX(0); transition: transform .22s cubic-bezier(.2, .7, .2, 1); }
  .abv2-abas [role="tab"][aria-selected="true"]::after { transform: none; }
  .abv2-abas [role="tab"]:focus-visible { outline-offset: -4px; border-radius: 14px; }
  .abv2-painel { padding: 18px 20px 20px; }
  .abv2-painel[hidden] { display: none; }
  .abv2-painel-busca { display: grid; gap: 14px; }

  .abv2-atalhos { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 10px; }
  .abv2-atalhos > span { font-size: 13.5px; font-weight: 600; color: var(--ink-3); }
  .abv2-atalhos ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .abv2-atalhos a { display: inline-flex; align-items: center; min-height: 36px; padding: 0 13px; border-radius: 99px; background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--line); font-size: 14px; font-weight: 620; color: var(--ink-2); transition: box-shadow .18s ease, color .18s ease; }
  .abv2-atalhos a:hover { color: var(--ink); box-shadow: inset 0 0 0 1.5px var(--ink-3); }

  /* celular: conteúdo em cima, a arte inteira EMBAIXO (nunca atrás do cartão) */
  @media (max-width: 767px) {
    .abv2 { display: flex; flex-direction: column; min-height: 0; background: #f2f1ee; }
    .abv2-conteudo { order: 1; padding-block: 20px 6px; gap: 12px; }
    .abv2-conteudo > * { max-width: none; }
    .abv2-lead { margin: -4px 0 4px; }
    .abv2-cartao { border-radius: 22px; }
    .abv2-abas { padding: 0 4px; }
    .abv2-abas [role="tab"] { min-height: 52px; font-size: 15px; gap: 7px; }
    .abv2-painel { padding: 14px 14px 16px; }
    .abv2-arte { order: 2; position: relative; inset: auto; width: auto; margin-top: -34px; -webkit-mask-image: none; mask-image: none; }
    .abv2-arte img { height: auto; aspect-ratio: 1 / 1; object-position: 50% 50%; }
    .abv2-arte::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, #f2f1ee 0%, rgb(242 241 238 / 0) 30%); }
  }
  @media (max-width: 400px) {
    .abv2-abas [role="tab"] { font-size: 14.5px; }
    .abv2-abas [role="tab"] :global(svg) { display: none; }
  }
  @media (prefers-color-scheme: dark) { .abv2 { color-scheme: light; } }

  /* o único movimento da abertura: a arte "respira" de leve conforme a pessoa rola (CSS, sem JS).
     Desligado em prefers-reduced-motion; só onde o navegador suporta linha do tempo de rolagem. */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .abv2-arte img { animation: abv-respira linear both; animation-timeline: scroll(root block); animation-range: 0px 70vh; }
    }
  }
  /* aparelho fraco: arte parada (como no "reduzir movimento") */
  :global(html.leve) .abv2-arte img { animation: none; }
  @keyframes abv-respira {
    from { transform: translate3d(0, -14px, 0) scale(1.08); }
    to { transform: translate3d(0, 12px, 0) scale(1.08); }
  }
</style>
