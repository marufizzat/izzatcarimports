---
// Abertura da home (rodada 15): "o estúdio vira o seu carro".
// Coluna do conteúdo: [Continuar] -> olho "Peças originais usadas" -> título com a PALAVRA VIVA ("carro" -> a marca ->
// o modelo e o ano, sobre o traço de pincel laranja) -> dois selos desenhados (desmanche legal · CDV; 10% no WhatsApp)
// -> o cartão de busca com duas abas ("Pelo carro": SeletorCarro; "Pelo nome ou código": a busca com sugestões).
// Palco (à direita a partir de 1024 px; abaixo do cartão no celular e no tablet): fundo de estúdio em CSS e as peças
// recortadas em camadas (public/arte/v2/abertura/, ferramentas/camada_abertura.py). Cada peça é um LINK para o bloco
// dela; com o carro escolhido, a arte do carro entra e as peças viram os atalhos DELE com a contagem do catálogo
// (lib/abertura.ts; comportamento em aberturaPalco.ts, que chega depois da 1ª pintura).
// Quem volta com carro salvo: o script no fim da seção (antes da 1ª pintura) já escreve o título e põe a arte do carro.
// Orçamento (CLAUDE.md, "Abertura viva"): no celular a única imagem da 1ª tela é o farolzinho (20 KB) e o LCP continua
// sendo o título; no PC o LCP é o farol recortado (pré-carregado pelo index.astro). Nada aqui muda de lugar depois de
// pintado: o que entra é absoluto ou tem a caixa reservada; movimento só em transform/opacity.
import SeletorCarro from '../SeletorCarro.astro';
import Icone from '../Icone.astro';
import { populares } from '../../lib/populares';
import { resumo, whatsUrl } from '../../lib/dados';
import { scriptCurto } from '../../lib/scriptCurto';
import { PECAS_PALCO, palavraViva, SIZES_AUTO, SIZES_HEROI } from '../../lib/abertura';
import medidas from '../../data/abertura-pecas.json';

const atalhos = populares(4);
const blocos = new Map(resumo().familias.map((f) => [f.n, f]));
const info = medidas as Record<string, { w: number; h: number; v: number[] }>;
const ARTE = '/arte/v2/abertura';
// a caixa de cada peça como atalho do carro (em % do lado menor do palco): todas com o mesmo peso visual
const CAIXA = { w: 18.5, h: 13.5 };
const pecas = PECAS_PALCO.filter((p) => blocos.has(p.bloco) && info[p.k]).map((p, i) => {
  const m = info[p.k];
  const ar = m.w / m.h;
  const w = p.cena?.w ?? CAIXA.w;
  const sc = Math.min(CAIXA.w / w, CAIXA.h / (w / ar));
  const bloco = blocos.get(p.bloco)!;
  const srcset = m.v.map((x) => `${ARTE}/${p.k}-${x}.webp ${x}w`).join(', ');
  // PC: o lado menor do palco tem até ~860 px; celular: o palco tem a largura da tela
  const sizes = i === 0 ? SIZES_HEROI : `(max-width: 1023px) ${Math.round(w * 0.7)}vw, ${Math.round(w * 8.2)}px`;
  return { ...p, i, ar, w, sc, srcset, sizes, src: `${ARTE}/${p.k}-${m.v[0]}.webp`, alt: Math.round(1000 / ar),
    href: `/categoria/${bloco.k}.html`, rotulo: `${p.bloco}: ver as peças` };
});
const heroi = pecas[0];
const msgDesconto = 'Quero comprar pelo WhatsApp com os 10% de desconto.';

// Antes da 1ª pintura: (1) as peças que não são a heroína esperam a entrada (com hora para desistir: sem o script
// principal elas aparecem sozinhas); (2) quem tem carro salvo E com peça (o SeletorCarro marcou data-salvo) já nasce
// com o título dele e a arte do carro no palco.
const antes = `(function(){try{var s=document.currentScript.parentNode,d=document.documentElement,p=s.querySelector('[data-ab-palco]'),pc=matchMedia('(min-width: 1024px)').matches,`
  + `r=s.querySelector('[data-mc-raiz]'),salvo=!!r&&r.hasAttribute('data-salvo'),luz=s.querySelectorAll('.ab-drl'),h=s.querySelector('.ab-heroi'),`
  + `vivo=!matchMedia('(prefers-reduced-motion: reduce)').matches&&!d.classList.contains('leve');`
  // as imagens das peças ficam para depois: tirar() guarda o srcset (aberturaPalco.ts devolve quando a peça vai aparecer)
  + `function tirar(q){[].forEach.call(s.querySelectorAll(q),function(i){i.setAttribute('data-srcset',i.getAttribute('srcset'));i.setAttribute('data-src',i.getAttribute('src'));i.removeAttribute('srcset');i.removeAttribute('src')})}`
  // com movimento: as peças esperam a entrada (.ab-on) e o farol nasce apagado; a heroína do PC já nasce à vista (é o LCP)
  + `if(vivo){p.setAttribute('data-ab-anima','');[].forEach.call(luz,function(x){x.classList.add('ab-apagado')})}`
  // celular e tablet: o palco está abaixo do cartão e dorme (sem montar e sem baixar nada) até chegar na tela
  + `if(!pc){p.setAttribute('data-ab-dorme','');tirar('.ab-p img[srcset]')}else if(!salvo&&h){h.classList.add('ab-on');h.querySelector('.ab-img').loading='eager'}`
  // sem o script principal em 5 s (rede ruim, erro): a cena aparece sozinha, parada
  + `setTimeout(function(){if(s.hasAttribute('data-ab-montada'))return;p.removeAttribute('data-ab-anima');[].forEach.call(luz,function(x){x.classList.remove('ab-apagado')});if(p.hasAttribute('data-ab-dorme')){p.removeAttribute('data-ab-dorme');[].forEach.call(s.querySelectorAll('.ab-p[data-cena] img[data-srcset]'),function(i){i.srcset=i.getAttribute('data-srcset');i.src=i.getAttribute('data-src')})}},5000);`
  + `if(!salvo)return;`
  // quem volta com carro salvo (e com peça): o título dele, o estado "carro" e a arte do carro já na 1ª pintura
  + `var c=JSON.parse(localStorage.getItem('izzatcar.meuCarro'));var v=(${palavraViva.toString()})(c.m,c.y,c.b);`
  + `s.querySelector('[data-ab-palavra]').textContent=v.t;s.querySelector('[data-ab-h1]').style.setProperty('--ab-l',v.l);p.setAttribute('data-ab','carro');`
  // com o carro, as peças da cena de abertura não aparecem: as imagens delas só descem se virarem atalho dele
  + `if(pc)tirar('.ab-p img[srcset]');`
  + `var a=s.querySelector('[data-ab-auto]');if(pc&&typeof c.a==='string'&&/^[a-z0-9-]{1,80}$/.test(c.a)){var u='/arte/v2/carro-'+c.a+'.webp',w=Array.isArray(c.as)?c.as.filter(function(x){return x===(x|0)&&x>0&&x<=4000}):[];`
  + `a.loading='eager';a.setAttribute('fetchpriority','high');`
  + `if(w.length)a.setAttribute('srcset',w.map(function(x,i){return(i===w.length-1?u:u.replace(/\\.webp$/,'-'+x+'.webp'))+' '+x+'w'}).join(', '));a.setAttribute('src',u);a.setAttribute('data-on','')}`
  + `}catch(e){}})()`;
---
<section class="abv2 tema-estudio" aria-labelledby="abv2-titulo" data-ab-raiz>
  <div class="ab-fundo" aria-hidden="true"></div>
  <div class="moldura abv2-conteudo">
    {/* "Continuar de onde parou" (Continuar.astro): só para quem volta com lista ou busca; sem elas, não ocupa nada */}
    <slot name="topo" />
    <div class="ab-topo">
      <p class="ab-olho">Peças originais usadas</p>
      {/* celular e tablet: o farol aceso espia da direita (no PC ele está no palco; lá esta imagem nem é baixada) */}
      <span class="ab-espia" aria-hidden="true">
        <picture>
          <source media="(min-width: 1024px)" srcset="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" />
          <img src={`${ARTE}/farol-400.webp`} alt="" width="400" height={Math.round(400 / heroi.ar)} decoding="async" />
        </picture>
        <span class="ab-drl"><i></i></span>
      </span>
    </div>
    <h1 id="abv2-titulo" class="display abv2-h1" data-ab-h1>De qual peça o seu <br /><span class="ab-carro"><span data-ab-palavra>carro</span><svg class="ab-pincel" viewBox="0 0 240 18" preserveAspectRatio="none" aria-hidden="true"><path d="M2 12C40 5 100 2 160 3c28 .5 54 2 78 4.5 1.200.1 1.200 1.800 0 1.900-25 1-52 1-80 1.800-50 1.700-104 4.200-151 6.700C2.500 17.800-.5 13 2 12Z"/></svg></span> <span class="ab-resto" data-ab-resto>precisa?</span></h1>
    <ul class="ab-selos" aria-label="Quem é a Izzat Car">
      <li class="ab-selo ab-selo-cdv">
        <span class="ab-selo-i"><Icone nome="garantia" /></span>
        <span class="ab-selo-t"><b>Desmanche legal</b><small>CDV <span class="ab-so-largo">Detran-RS </span>nº&nbsp;01060</small></span>
      </li>
      <li>
        <a class="ab-selo ab-selo-whats" href={whatsUrl(msgDesconto)} data-botao="abertura-desconto" data-ab-whats target="_blank" rel="noopener">
          <span class="ab-selo-i"><Icone nome="whats" /></span>
          <span class="ab-selo-t"><b>10% de desconto</b><small>comprando pelo WhatsApp</small></span>
        </a>
      </li>
    </ul>
    <div class="abv2-cartao" data-abas>
      <div class="abv2-abas" role="tablist" aria-label="Como achar a peça">
        <button type="button" role="tab" id="abv2-aba-carro" aria-controls="abv2-painel-carro" aria-selected="true" tabindex="0">
          <Icone nome="carro" /><span>Pelo carro</span>
        </button>
        <button type="button" role="tab" id="abv2-aba-busca" aria-controls="abv2-painel-busca" aria-selected="false" tabindex="-1">
          <Icone nome="busca" /><span>Pelo nome ou código</span>
        </button>
      </div>
      <div class="abv2-painel" role="tabpanel" id="abv2-painel-carro" aria-labelledby="abv2-aba-carro">
        <SeletorCarro />
      </div>
      <div class="abv2-painel abv2-painel-busca" role="tabpanel" id="abv2-painel-busca" aria-labelledby="abv2-aba-busca" hidden>
        <slot name="busca" />
        {atalhos.length > 0 && (
          <div class="abv2-atalhos">
            <span>Mais comuns no pátio:</span>
            <ul>{atalhos.map((a) => <li><a href={`/catalogo.html?q=${encodeURIComponent(a.q)}`}>{a.n}</a></li>)}</ul>
          </div>
        )}
      </div>
    </div>
  </div>

  <div class="ab-palco" data-ab-palco>
    <div class="ab-cena">
      <div class="ab-chao" aria-hidden="true"></div>
      {/* a arte do carro escolhido (as 93 têm a mesma pose e o mesmo estúdio): duas, para uma dissolver na outra */}
      <img class="ab-auto" data-ab-auto alt="" width="1200" height="800" decoding="async" loading="lazy" sizes={SIZES_AUTO} />
      <img class="ab-auto" data-ab-auto alt="" width="1200" height="800" decoding="async" loading="lazy" sizes={SIZES_AUTO} />
      <p class="ab-legenda" data-ab-legenda aria-hidden="true"></p>
      <ul class="ab-pecas" data-ab-pecas aria-label="Atalhos: peças por parte do carro">
        {pecas.map((p) => (
          <li class:list={['ab-p', { 'ab-heroi': p.i === 0 }]} data-k={p.k} data-cena={p.cena ? '' : undefined}
              style={`--w:${p.w};--ar:${p.ar.toFixed(3)};--sc:${p.sc.toFixed(3)};--i:${p.i};` + (p.cena ? `--cx:${p.cena.x};--cy:${p.cena.y};--d:${p.cena.d}` : '--d:16')}>
            <a href={p.href} aria-label={p.rotulo}>
              <span class="ab-f">
                {p.cena
                  ? <img class="ab-img" src={p.src} srcset={p.srcset} sizes={p.sizes} alt="" width="1000" height={p.alt} loading="lazy" decoding="async" onload={p.i === 0 ? "this.parentNode.classList.add('ab-veio')" : undefined} />
                  : <img class="ab-img" data-src={p.src} data-srcset={p.srcset} sizes={p.sizes} alt="" width="1000" height={p.alt} decoding="async" />}
                {p.i === 0 && <span class="ab-drl"><i></i></span>}
                {p.i === 0 && <img class="ab-ref" src={p.src} srcset={p.srcset} sizes={p.sizes} alt="" width="1000" height={p.alt} loading="lazy" decoding="async" />}
              </span>
              <span class="ab-rot"><span data-ab-nome data-curto={p.curto}>{p.rot}</span><b class="num" data-ab-n hidden></b></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
  <p class="ab-sr" aria-live="polite" data-ab-voz></p>
  <script is:inline set:html={scriptCurto(antes)} />
</section>

<script>
  import { montarAbertura } from './aberturaPalco';
  // Abas do cartão (padrão WAI-ARIA): clique ou setas. Ao abrir "Pelo nome ou código" pelo clique,
  // o cursor já vai para o campo.
  document.querySelectorAll<HTMLElement>('[data-abas]').forEach((caixa) => {
    const abas = Array.from(caixa.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const painel = (a: HTMLElement) => document.getElementById(a.getAttribute('aria-controls') || '');
    const escolher = (i: number, foco: 'aba' | 'campo' | null) => {
      abas.forEach((a, k) => {
        const on = k === i;
        a.setAttribute('aria-selected', String(on));
        a.tabIndex = on ? 0 : -1;
        const p = painel(a);
        if (p) p.hidden = !on;
      });
      if (foco === 'aba') abas[i].focus();
      else if (foco === 'campo') painel(abas[i])?.querySelector<HTMLInputElement>('input')?.focus();
    };
    abas.forEach((a, i) => {
      a.addEventListener('click', () => {
        if (a.getAttribute('aria-selected') === 'true') return;
        escolher(i, a.getAttribute('aria-controls') === 'abv2-painel-busca' ? 'campo' : null);
      });
      a.addEventListener('keydown', (e) => {
        const passo = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        const fim = e.key === 'Home' ? 0 : e.key === 'End' ? abas.length - 1 : -1;
        if (!passo && fim < 0) return;
        e.preventDefault();
        escolher(fim >= 0 ? fim : (i + passo + abas.length) % abas.length, 'aba');
      });
    });
  });
  const sec = document.querySelector<HTMLElement>('[data-ab-raiz]');
  if (sec) montarAbertura(sec);
</script>

<style is:global>
  /* ====== Abertura viva (tudo preso a .abv2) ====== */
  /* fonte de espera do título: um negrito do aparelho reduzido para a largura e a altura da Archivo condensada (enquanto
     a fonte não chega, a linha não quebra e o "precisa?" quase não anda: medido, CLS da troca de fonte) */
  @font-face { font-family: "Ab Espera"; src: local("Arial Bold"), local("Arial-BoldMT"), local("Roboto Bold"), local("Roboto-Bold"), local("Helvetica Neue Bold"), local("HelveticaNeue-Bold"), local("Arial");
    font-weight: 100 900; size-adjust: 85%; ascent-override: 103.3%; descent-override: 24.7%; line-gap-override: 0%; }

  .abv2 { position: relative; background: #f1f0ed; min-height: clamp(600px, calc(100svh - 84px), 860px); display: grid; align-content: start;
    /* onde o palco começa no PC: a margem da moldura + a coluna do conteúdo + um respiro */
    --ab-esq: calc((100% - min(100% - 64px, 1240px)) / 2 + min(568px, 44vw) + 20px); --ab-horizonte: 75cqh; }
  .abv2 .ab-sr { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  /* a parede do estúdio (os tons das artes dos carros), sumindo para o fundo da página à esquerda */
  .abv2 .ab-fundo { position: absolute; inset: 0 0 0 auto; width: 66%; pointer-events: none;
    background: radial-gradient(120% 90% at 78% 30%, rgb(255 255 255 / .55) 0, rgb(255 255 255 / 0) 60%), linear-gradient(98deg, #efe8e2 0%, #e4d9d3 48%, #d6c8c1 100%);
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 34%); mask-image: linear-gradient(90deg, transparent 0, #000 34%); }

  /* acima do palco e da faixa de selos (z-index 1); a caixa em si não pega clique, só o que tem dentro */
  .abv2 .abv2-conteudo { position: relative; z-index: 2; display: grid; grid-template-columns: minmax(0, 1fr); align-content: start; gap: 14px;
    padding-block: clamp(22px, 7vh, 80px) 72px; pointer-events: none; }
  .abv2 .abv2-conteudo > * { pointer-events: auto; max-width: min(568px, 44vw); }

  /* ---- olho + farolzinho ---- */
  .abv2 .ab-topo { position: relative; display: flex; align-items: center; min-height: 20px; margin-bottom: -4px; }
  .abv2 .ab-olho { margin: 0; display: inline-flex; align-items: center; gap: 10px; font-size: 12.5px; font-weight: 720; letter-spacing: .085em; text-transform: uppercase; color: #4a4a50; white-space: nowrap; }
  .abv2 .ab-olho::before { content: ""; width: 22px; height: 3px; border-radius: 3px; background: var(--accent); }
  .abv2 .ab-espia { display: none; }

  /* ---- título ---- */
  /* a letra cheia (--ab-fs) enquanto a 2ª linha cabe na coluna (--ab-col); nome de carro largo (--ab-l = a largura da linha
     em "em", lib/abertura.ts palavraViva) diminui a letra só o necessário. A altura do título é sempre a de 2 linhas cheias. */
  .abv2 .abv2-h1 { --ab-fs: clamp(40px, calc(4.6vw + 6px), 76px); --ab-col: min(568px, 44vw); margin: 0; min-height: calc(var(--ab-fs) * 1.84); color: #1d1d1f;
    font-family: "Archivo Variable", "Ab Espera", system-ui, sans-serif; font-size: min(var(--ab-fs), calc(var(--ab-col) / var(--ab-l, 5.77) / 1.02));
    text-wrap: nowrap; white-space: nowrap; min-width: 0; transition: font-size .22s cubic-bezier(.2, .8, .2, 1); }
  /* o título é UM bloco de texto só (é o LCP do celular: linha em bloco separado dividiria a área dele); a palavra e
     o "precisa?" só viram caixa durante a troca (.ab-anima) */
  .abv2 .ab-carro { position: relative; }
  .abv2 .ab-anima [data-ab-palavra], .abv2 .ab-anima .ab-resto { display: inline-block; }
  .abv2 .ab-pincel { position: absolute; z-index: -1; left: -3%; bottom: -.03em; width: 106%; height: .2em; fill: var(--accent); transform-origin: 0 50%; overflow: visible; }
  .abv2 .ab-pincel.ab-traca { animation: ab-traca .5s cubic-bezier(.2, .8, .2, 1) both; }
  .abv2 .ab-pincel.ab-traca2 { animation: ab-traca2 .5s cubic-bezier(.2, .8, .2, 1) both; }
  @keyframes ab-traca { from { transform: scaleX(0); } to { transform: none; } }
  @keyframes ab-traca2 { from { transform: scaleX(0); } to { transform: none; } }

  /* ---- selos ---- */
  /* colunas de largura fixa: a fonte que chega depois não mexe em nenhum selo */
  .abv2 .ab-selos { list-style: none; margin: 2px 0 6px; padding: 0; display: grid; grid-template-columns: 218px 232px; gap: 10px; }
  .abv2 .ab-selos > li { display: flex; min-width: 0; }
  .abv2 .ab-selo { flex: 1; overflow: hidden; }
  .abv2 .ab-selo { display: flex; align-items: center; gap: 10px; min-width: 0; min-height: 50px; padding: 7px 16px 7px 8px; border-radius: 16px; color: #1d1d1f;
    background: linear-gradient(180deg, #fff, #fbfaf8); box-shadow: 0 0 0 1px rgb(16 16 20 / .07), 0 1px 1px rgb(16 16 20 / .04), 0 10px 22px -16px rgb(16 16 20 / .4), inset 0 1px 0 #fff; }
  .abv2 .ab-selo-i { flex: none; width: 36px; height: 36px; display: grid; place-items: center; border-radius: 11px; }
  .abv2 .ab-selo-i svg { width: 21px; height: 21px; }
  .abv2 .ab-selo-t { display: grid; gap: 1px; min-width: 0; }
  .abv2 .ab-selo-t b { font-size: 15px; font-weight: 780; font-stretch: 92%; line-height: 1.15; letter-spacing: -.005em; white-space: nowrap; }
  .abv2 .ab-selo-t small { font-size: 12.5px; font-weight: 520; line-height: 1.2; color: #5b5b61; white-space: nowrap; }
  .abv2 .ab-selo-cdv .ab-selo-i { color: #fff; background: linear-gradient(160deg, #3a3a3f, #1d1d1f 70%); box-shadow: inset 0 1px 0 rgb(255 255 255 / .18), 0 2px 5px -2px rgb(16 16 20 / .5); }
  .abv2 .ab-selo-whats { background: linear-gradient(180deg, #f1fbf5, #e6f6ec); box-shadow: 0 0 0 1px rgb(23 131 74 / .2), 0 10px 22px -16px rgb(15 98 53 / .55), inset 0 1px 0 #fff;
    transition: transform .16s cubic-bezier(.2, .8, .2, 1), box-shadow .16s ease; }
  .abv2 .ab-selo-whats .ab-selo-i { color: #fff; background: linear-gradient(160deg, #2ad06b, #17a24f 75%); box-shadow: inset 0 1px 0 rgb(255 255 255 / .3), 0 2px 5px -2px rgb(15 98 53 / .6); }
  .abv2 .ab-selo-whats b { color: #0c5a30; }
  .abv2 .ab-selo-whats small { color: #1f6b41; }
  .abv2 .ab-selo-whats:hover { transform: translateY(-1px); box-shadow: 0 0 0 1px rgb(23 131 74 / .34), 0 14px 26px -16px rgb(15 98 53 / .7), inset 0 1px 0 #fff; }
  .abv2 .ab-selo-whats:active { transform: translateY(0) scale(.985); }
  .abv2 .ab-selo-whats:focus-visible { outline: 3px solid #0f6235; outline-offset: 2px; }

  /* ---- o cartão: abas no topo, a escolha embaixo ---- */
  .abv2 .abv2-cartao { border-radius: 24px; background: #fff; box-shadow: 0 2px 6px rgb(16 16 20 / .06), 0 28px 56px -22px rgb(16 16 20 / .28), 0 0 0 1px rgb(16 16 20 / .04); }
  .abv2 .abv2-abas { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr); padding: 0 10px; border-bottom: 1px solid var(--line); }
  .abv2 .abv2-abas [role="tab"] { position: relative; min-width: 0; min-height: 58px; display: inline-flex; align-items: center; justify-content: center; gap: 9px;
    padding: 0 8px; border: 0; background: none; color: var(--ink-3); font-size: 15.5px; font-weight: 680; font-stretch: 94%; white-space: nowrap;
    transition: color .18s ease; }
  .abv2 .abv2-abas [role="tab"] svg { width: 21px; height: 21px; flex: none; }
