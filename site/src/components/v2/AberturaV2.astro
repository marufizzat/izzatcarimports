  /* o piso: a linha de luz laranja no horizonte (a mesma das artes dos carros) e o brilho do chão */
  .abv2 .ab-chao { position: absolute; left: 0; right: 0; top: var(--ab-horizonte); bottom: 0; pointer-events: none;
    background: linear-gradient(180deg, rgb(203 186 177 / .5) 0, rgb(222 211 204 / .28) 46%, rgb(241 240 237 / 0) 100%);
