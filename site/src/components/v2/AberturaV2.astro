  /* a heroína no piso: sombra de contato (só com a imagem na tela: .ab-veio) e reflexo (a mesma imagem, virada) */
  .abv2 .ab-heroi .ab-f::before { content: ""; position: absolute; left: 6%; right: 4%; bottom: -3%; height: 16%; border-radius: 50%; opacity: 0;
