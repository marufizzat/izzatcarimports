  .abv2 .ab-drl.ab-pisca2 i { animation: ab-pisca2 .66s linear both; }
  @keyframes ab-corre { from { opacity: 1; transform: none; } to { opacity: 1; transform: translateX(100%); } }
  /* dois nomes para a mesma animação: trocar de um para o outro recomeça sem forçar layout */
  @keyframes ab-pisca { 0%, 100% { opacity: 0; } 10%, 30% { opacity: 1; } 42%, 54% { opacity: 0; } 64%, 82% { opacity: 1; } }
  @keyframes ab-pisca2 { 0%, 100% { opacity: 0; } 10%, 30% { opacity: 1; } 42%, 54% { opacity: 0; } 64%, 82% { opacity: 1; } }

  /* a vida: deriva lenta (só transform), só com o palco na tela e a aba à vista */
  .abv2 .ab-p.ab-on:not(.ab-heroi) .ab-f, .abv2 .ab-heroi.ab-on[data-slot] .ab-f { animation: ab-deriva calc(7s + var(--i) * .9s) ease-in-out calc(var(--i) * -1.3s) infinite alternate paused; }
