  .abv2 .ab-palco[data-ab-anima] .ab-p:not(.ab-on) { opacity: 0; }
  .abv2 .ab-palco[data-ab-anima] .ab-p:not(.ab-on) .ab-f { translate: 0 -14px; }
  .abv2 .ab-f { transition: translate .7s cubic-bezier(.2, .9, .25, 1.1) var(--at, 0ms); }

  /* o rótulo: sempre do mesmo tamanho (a peça encolhe em volta do carro, o texto não) */
  .abv2 .ab-rot { position: absolute; left: 50%; top: calc(100% + 7px / var(--se)); display: inline-flex; align-items: center; gap: 7px; padding: 6px 12px; border-radius: 99px;
