---
// Logo ORIGINAL (frontend/public/logo.png do app, 600x435). Nunca redesenhado nem deformado: a largura sai da altura,
// na proporção do arquivo. Leva para "/" (um endereço só para a home). Site sempre claro: só a versão clara.
interface Props { altura?: number; class?: string; }
const { altura = 52, class: cls } = Astro.props;
const largura = Math.round(altura * 600 / 435);
---
<a href="/" class:list={['logo', cls]} aria-label="Izzat Car Imports, início">
  <img src="/identidade/logo.png" alt="Izzat Car Imports" width={largura} height={altura} />
</a>
