---
// Logo ORIGINAL (frontend/public/logo.png do app, 600x435). Nunca redesenhado.
// No tema escuro (ou sobre fundo escuro) entra a versao com a palavra em branco.
interface Props { escuro?: boolean; altura?: number; class?: string; }
const { escuro = false, altura = 52, class: cls } = Astro.props;
const largura = Math.round(altura * 600 / 435);
---
<a href="/index.html" class={`logo ${cls ?? ''}`} aria-label="Izzat Car Imports, início">
  <picture>
    <img src={escuro ? '/identidade/logo-dark.png' : '/identidade/logo.png'} alt="Izzat Car Imports" width={largura} height={altura} />
  </picture>
</a>
