---
interface Props { class?: string; }
const itens = [
  ['garantia', '90 dias de garantia', 'Em toda peça'],
  ['nota-fiscal', 'Nota fiscal', 'Em toda venda'],
  ['patio', 'CDV Detran-RS nº 01060', 'Desmanche credenciado'],
  ['envios', 'Envio para todo o Brasil', 'Com código de rastreio'],
];
---
<ul class={`selos ${Astro.props.class ?? ''}`}>
  {itens.map(([ic, b, s]) => (
    <li class="selo"><img src={`/icones/${ic}-96.webp`} alt="" width="44" height="44" loading="lazy" /><div><b>{b}</b><span>{s}</span></div></li>
  ))}
</ul>
<style>
  .selos { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 18px 16px; }
  @media (min-width: 900px) { .selos { grid-template-columns: repeat(4, auto); justify-content: space-between; } }
</style>
