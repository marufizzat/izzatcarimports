---
import Logo from './Logo.astro';
import Icone from './Icone.astro';
import SugestoesBusca from './ui/SugestoesBusca';
import MeuCarroEstilo from './ui/MeuCarroEstilo.astro';
import { whatsUrl, resumo } from '../lib/dados';
const links: [string, string][] = [
  ['Peças', '/catalogo.html'], ['Carros', '/carros.html'],
  ['Como comprar', '/como-comprar.html'], ['O pátio', '/sobre.html'],
];
const atual = Astro.url.pathname;
const ativo = (h: string) => atual === h || (h === '/catalogo.html' && atual.startsWith('/peca/')) ||
  (h === '/carros.html' && atual.startsWith('/carros/'));
const carros = resumo().carros.slice(0, 8);
// Busca à vista no PC a partir de 1100 px (fora do catálogo, que tem a própria), também na home: a aba de busca da
// abertura é só mais uma entrada (antes a do topo sumia ao abrir a aba e deixava um buraco no cabeçalho).
// O campo vem pronto no HTML (sem JS, ele já busca no catálogo). As sugestões ao vivo (React) só carregam quando a
// pessoa chega no campo: sem ilha do Astro aqui, a página não leva o código das ilhas nem o React à toa.
const buscaNoTopo = !atual.startsWith('/catalogo');
---
<MeuCarroEstilo />
<header class="cab">
  <div class="moldura cab-linha">
    <Logo altura={64} />
    <nav class="cab-nav" aria-label="Principal">
      {links.map(([t, h]) => <a href={h} aria-current={ativo(h) ? 'page' : undefined}>{t}</a>)}
    </nav>
    {buscaNoTopo && (
      <div class="cab-busca" data-cab-busca>
        <SugestoesBusca placeholder="Peça ou código" />
      </div>
    )}
    <div class="cab-acoes">
      <button class="cab-carro" type="button" data-abrir-carro aria-haspopup="dialog" aria-label="Meu carro: escolher o seu carro">
        <Icone nome="carro" />
        <span class="cab-carro-txt" data-carro-txt>Meu carro</span>
      </button>
      {/* o chip já nasce com o carro salvo (antes do script principal: o cabeçalho e a abertura nunca discordam).
          Mesmo desenho de pintarChip(); marca também html[data-carro] para quem reserva lugar ao carro (catálogo). */}
      <script is:inline>try{var c=JSON.parse(localStorage.getItem('izzatcar.meuCarro')),b=document.currentScript.previousElementSibling,t=b.lastElementChild,s=(k,x)=>{var e=document.createElement('span');e.className='cab-carro-'+k;e.append(x);return e},m;c.m&&(document.documentElement.dataset.carro='',b.className+=' com-carro',m=s('modelo',s('marca',c.b+' ')),m.append(c.m),t.replaceChildren(m),c.y&&t.append(s('ano',''+c.y)))}catch(e){}</script>
      {/* Lista de orçamento (lib/lista.ts): só com 1+ peça. O número já nasce certo (script logo abaixo, antes da 1ª
          pintura, como o chip): marca html[data-lista] e o CSS mostra o ícone. Só abaixo de 360 px ele ocupa o lugar da
          lupa (o mesmo tamanho: nada se mexe nem aperta no celular de 320). */}
      <a class="cab-icone cab-lista" href="/lista.html" data-lista-cab aria-current={atual === '/lista.html' ? 'page' : undefined}><Icone nome="lista" /><span class="sr-only">Lista de orçamento: </span><b></b></a>
      <script is:inline>try{var n=JSON.parse(localStorage['izzatcar.lista']).length;n&&(document.documentElement.dataset.lista=n,document.currentScript.previousElementSibling.lastChild.textContent=n)}catch(e){}</script>
      <a class="cab-icone cab-lupa" href="/catalogo.html#busca" aria-label="Buscar peça"><Icone nome="busca" /></a>
      <a class="botao botao-laranja cab-whats" href={whatsUrl('Procuro uma peça.')} data-botao="cabecalho" data-whats-carro aria-label="Chamar no WhatsApp">
        <Icone nome="whats" /><span>WhatsApp</span>
      </a>
      <button class="cab-icone cab-menu" type="button" aria-label="Abrir menu" aria-haspopup="dialog" aria-controls="menu-movel" data-abrir-menu>
        <Icone nome="menu" />
      </button>
    </div>
  </div>
</header>

<dialog id="meu-carro-dialogo" class="mc-dialogo" aria-labelledby="mc-dlg-titulo">
  <div class="mc-dlg-topo">
    <div>
      {/* <p> e não <h2>: a caixa fica no HTML de toda página, antes do h1 (o Google lia "Seu carro" como o 1º título) */}
      <p id="mc-dlg-titulo" class="mc-dlg-titulo">Seu carro</p>
      <p class="mc-dlg-sub">Escolha uma vez: o site passa a mostrar as peças do seu carro.</p>
    </div>
    <button class="mc-dlg-fechar" type="button" aria-label="Fechar" data-fechar-carro>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
    </button>
  </div>
  <div class="mc-raiz" data-mc-raiz></div>
</dialog>

<dialog id="menu-movel" class="menu-movel" aria-label="Menu">
  <div class="menu-topo">
    <Logo altura={52} />
    <button class="cab-icone" type="button" aria-label="Fechar menu" data-fechar-menu>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
    </button>
  </div>
  {/* só o meio rola: o "Chamar no WhatsApp" fica sempre à vista no pé do menu, até no celular de 320 px */}
  <div class="menu-corpo">
    <nav class="menu-links" aria-label="Menu principal">
      {links.map(([t, h]) => <a href={h} aria-current={ativo(h) ? 'page' : undefined}>{t}</a>)}
      <a href="/garantia.html" aria-current={atual === '/garantia.html' ? 'page' : undefined}>Garantia e trocas</a>
      <a href="/procuro-peca.html" aria-current={atual === '/procuro-peca.html' ? 'page' : undefined}>Procuro peça</a>
    </nav>
    <p class="menu-rotulo">Carros com mais peças</p>
    <div class="menu-carros">
      {carros.map((c) => <a href={`/carros/${c.k}.html`}>{c.b} {c.m}</a>)}
    </div>
  </div>
  <a class="botao botao-laranja menu-whats" href={whatsUrl('Procuro uma peça.')} data-botao="menu" data-whats-carro><Icone nome="whats" />Chamar no WhatsApp</a>
</dialog>

<script>
  import { lerMeuCarro, EVENTO, ABRIR, ESCOLHIDO, type MeuCarro } from '../lib/meuCarro';
  import { nomeCarro } from '../lib/meuCarro';
  import { whatsUrl, comMeuCarro, carroSalvoTxt, conviteCarro } from '../lib/whats';
  import { lerLista, EVENTO_LISTA, ouvirOutrasAbas, pecasTxt } from '../lib/lista';

  // WhatsApp do topo e do menu: com carro salvo, a mensagem já leva o carro ("Procuro uma peça para Volvo XC60 2019.")
  function whatsComCarro() {
    const c = lerMeuCarro();
    const txt = c ? `Procuro uma peça para ${nomeCarro(c)}.` : 'Procuro uma peça.';
    document.querySelectorAll<HTMLAnchorElement>('a[data-whats-carro]').forEach((a) => { a.href = whatsUrl(txt); });
  }
  whatsComCarro();
  window.addEventListener(EVENTO, whatsComCarro);

  // "Pedir no WhatsApp" dos cartões (os do build, os do catálogo e os montados por script): a linha "Meu carro: …" entra
  // no clique, com o carro salvo de agora ou o convite com o carro da peça. É a MESMA mensagem da página da peça
  // (revisão 11, P1: o cartão mandava sem a linha). Um ouvinte só, na página inteira.
  const comCarroNoCartao = (e: Event) => {
    const a = (e.target as Element | null)?.closest?.<HTMLAnchorElement>('a.etiqueta-acao');
    const href = a?.getAttribute('href') || '';
    const corte = href.indexOf('?text=');
    if (!a || corte < 0) return;
    const d = a.parentElement?.querySelector<HTMLElement>('a.etiqueta')?.dataset;
    const c = lerMeuCarro();
    try {
      const msg = comMeuCarro(decodeURIComponent(href.slice(corte + 6)), c ? carroSalvoTxt(c) : conviteCarro(d?.b, d?.m, d?.ms));
      a.setAttribute('href', `${href.slice(0, corte)}?text=${encodeURIComponent(msg)}`);
    } catch { /* link malformado: segue como está */ }
  };
  document.addEventListener('click', comCarroNoCartao, true);
  document.addEventListener('auxclick', comCarroNoCartao, true);

  // chip do cabeçalho: mostra o carro salvo (sem carro: "Meu carro"). O mesmo desenho do script do HTML (logo acima).
  // Modelo e ano em partes separadas: no aperto, o modelo ganha reticências e o ano nunca some.
  const parte = (k: string, ...filhos: (Node | string)[]) => {
    const e = document.createElement('span');
    e.className = 'cab-carro-' + k;
    e.append(...filhos);
    return e;
  };
  function pintarChip(c: MeuCarro | null) {
    document.documentElement.toggleAttribute('data-carro', !!c);
    document.querySelectorAll<HTMLElement>('[data-abrir-carro]').forEach((b) => {
      const txt = b.querySelector<HTMLElement>('[data-carro-txt]');
      if (!txt) return;
      if (c) {
        txt.replaceChildren(parte('modelo', parte('marca', c.b + ' '), c.m));
        if (c.y) txt.append(parte('ano', String(c.y)));
        b.classList.add('com-carro');
        b.setAttribute('aria-label', 'Seu carro: ' + [c.b, c.m, c.y].filter(Boolean).join(' ') + '. Trocar ou tirar');
        b.title = 'Trocar ou tirar o seu carro';
      } else {
        txt.textContent = 'Meu carro';
        b.classList.remove('com-carro');
        b.setAttribute('aria-label', 'Meu carro: escolher o seu carro');
        b.removeAttribute('title');
      }
    });
  }
  pintarChip(lerMeuCarro());
  window.addEventListener(EVENTO, (e) => pintarChip((e as CustomEvent<MeuCarro | null>).detail));

  // Lista de orçamento: o ícone com o número (o script do HTML já pintou o 1º; aqui segue a lista ao vivo, também quando
  // ela muda noutra aba). Peça nova na lista: o número dá um pulinho.
  const cabLista = document.querySelector<HTMLAnchorElement>('[data-lista-cab]');
  let nLista = -1;
  function pintarLista() {
    const n = lerLista().length;
    const raiz = document.documentElement;
    if (n) raiz.dataset.lista = String(n);
    else delete raiz.dataset.lista;
    if (cabLista) {
      const num = cabLista.querySelector('b')!;
      num.textContent = n ? String(n) : '';
      cabLista.title = n ? `Lista de orçamento: ${pecasTxt(n)}` : 'Lista de orçamento';
      // pulinho pela Web Animations (sem forçar o cálculo da página no meio do toque)
      if (nLista >= 0 && n > nLista && num.animate && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        num.animate([{ transform: 'scale(1)' }, { transform: 'scale(1.35)', offset: .4 }, { transform: 'scale(1)' }], { duration: 450, easing: 'cubic-bezier(.3,1.6,.5,1)' });
      }
    }
    nLista = n;
  }
  pintarLista();
  window.addEventListener(EVENTO_LISTA, pintarLista);
  ouvirOutrasAbas();

  // caixa "Seu carro" (carregada só ao abrir). Aberta pela faixa da peça (origem 'peca'): ao escolher o ano a caixa
  // fecha sozinha, a página volta para a faixa e a resposta acende ali (serve / confira o ano).
  const caixa = document.getElementById('meu-carro-dialogo') as HTMLDialogElement | null;
  const raizCaixa = caixa?.querySelector<HTMLElement>('[data-mc-raiz]');
  async function abrirCarro(ev?: Event) {
    if (!caixa || !raizCaixa || caixa.open) return;
    raizCaixa.dataset.origem = (ev as CustomEvent<{ origem?: string } | null> | undefined)?.detail?.origem ?? '';
    const { montarPicker } = await import('./ui/meuCarroPicker');
    montarPicker(raizCaixa);
    caixa.showModal();
  }
  window.addEventListener(ABRIR, abrirCarro);
  document.querySelectorAll('[data-abrir-carro]').forEach((b) => b.addEventListener('click', () => abrirCarro()));
  caixa?.querySelector('[data-fechar-carro]')?.addEventListener('click', () => caixa.close());
  caixa?.addEventListener('click', (e) => { if (e.target === caixa) caixa.close(); });
  caixa?.addEventListener(ESCOLHIDO, () => {
    caixa.close();
    const faixa = document.querySelector<HTMLElement>('[data-meu-carro]');
    if (!faixa) return;
    const reduz = matchMedia('(prefers-reduced-motion: reduce)').matches;
    faixa.scrollIntoView({ block: 'center', behavior: reduz ? 'auto' : 'smooth' });
    faixa.classList.remove('enc-destaque');
    requestAnimationFrame(() => faixa.classList.add('enc-destaque'));
    setTimeout(() => faixa.classList.remove('enc-destaque'), 1600);
  });

  // busca do cabeçalho (PC): monta as sugestões (React) no 1º contato com o campo (mouse, foco ou toque).
  // O que já foi digitado e o foco passam para o campo novo.
  const cabBuscaRaiz = document.querySelector<HTMLElement>('[data-cab-busca]');
  if (cabBuscaRaiz) {
    let montada = false;
    const montar = async () => {
      if (montada) return;
      montada = true;
      const [{ createElement }, { createRoot }, { default: SugestoesBusca }] = await Promise.all([
        import('react'), import('react-dom/client'), import('./ui/SugestoesBusca'),
      ]);
      const campo = cabBuscaRaiz.querySelector('input');
      createRoot(cabBuscaRaiz).render(createElement(SugestoesBusca, {
        placeholder: campo?.placeholder, inicial: campo?.value ?? '', autoFoco: !!campo && document.activeElement === campo,
      }));
    };
    for (const tipo of ['pointerenter', 'focusin', 'touchstart']) cabBuscaRaiz.addEventListener(tipo, montar, { passive: true });
  }

  const d = document.getElementById('menu-movel') as HTMLDialogElement | null;
  document.querySelectorAll('[data-abrir-menu]').forEach((b) => b.addEventListener('click', () => d?.showModal()));
  document.querySelectorAll('[data-fechar-menu]').forEach((b) => b.addEventListener('click', () => d?.close()));
  d?.addEventListener('click', (e) => { if (e.target === d) d.close(); });
</script>

<style is:global>
  /* Globais de propósito (sem o atributo de escopo em cada link do cabeçalho e do menu): tudo preso a
     .cab (cabeçalho) ou .menu-movel (menu do celular). Site sempre claro. */
  .cab { position: sticky; top: 0; z-index: 50; background: color-mix(in oklab, var(--bg), transparent 12%);
         backdrop-filter: blur(18px) saturate(160%); -webkit-backdrop-filter: blur(18px) saturate(160%);
         border-bottom: 1px solid color-mix(in oklab, var(--line), transparent 25%); }
  /* aparelho fraco: fundo sólido da mesma cor (desfocar a página a cada quadro da rolagem pesa) */
  html.leve .cab { background: var(--bg); -webkit-backdrop-filter: none; backdrop-filter: none; }
  .cab .cab-linha { display: flex; align-items: center; gap: 10px; height: 68px; }
  /* o logo nunca encolhe nem deforma: o que aperta é o resto (no celular estreito ele fica menor, na proporção certa) */
  .cab .cab-linha > .logo { flex: none; }
  .cab .cab-linha > .logo img { height: 54px; width: auto; max-width: none; display: block; }
  .cab .cab-nav { display: none; gap: 2px; }
  .cab .cab-nav a { position: relative; padding: 10px 14px; border-radius: 10px; font-weight: 560; font-size: 15.5px; color: var(--ink-2);
               white-space: nowrap; transition: color .2s, background-color .2s; }
  .cab .cab-nav a:hover { color: var(--ink); background: color-mix(in oklab, var(--ink), transparent 94%); }
  .cab .cab-nav a[aria-current="page"] { color: var(--ink); }
  .cab .cab-nav a[aria-current="page"]::after { content: ""; position: absolute; left: 14px; right: 14px; bottom: 3px; height: 3px; border-radius: 3px;
               background: var(--accent); }
  .cab .cab-acoes { margin-left: auto; min-width: 0; display: flex; align-items: center; gap: 4px; }
  :is(.cab, .menu-movel) .cab-icone { flex: none; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 12px; border: 0; background: transparent; color: inherit; }
  :is(.cab, .menu-movel) .cab-icone:hover { background: color-mix(in oklab, currentColor, transparent 92%); }
  :is(.cab, .menu-movel) .cab-icone svg { width: 23px; height: 23px; }
  .cab .cab-whats { --h: var(--botao-p); flex: none; padding: 0 12px; font-size: 15px; }
  /* Lista de orçamento: só com 1+ peça (html[data-lista]); abaixo de 1100 px no lugar da lupa (mesmo tamanho) */
  .cab .cab-lista { display: none; position: relative; }
  html[data-lista] .cab .cab-lista { display: grid; }
  /* celular com a lista: a lupa FICA (a busca é o centro de uma loja de peças); quem cede é o texto do "Meu carro", que
     vira só o ícone (como já é no celular estreito; o ponto laranja diz que há carro salvo). Só abaixo de 360 px não
     cabem os cinco: aí a lista ocupa o lugar da lupa (a busca continua no menu). */
  @media (max-width: 359px) { html[data-lista] .cab .cab-lupa { display: none; } }
  @media (min-width: 360px) and (max-width: 519px) {
    html[data-lista] .cab .cab-carro { width: 48px; padding: 0; justify-content: center; }
    html[data-lista] .cab .cab-carro .cab-carro-txt { display: none !important; }
    html[data-lista] .cab .cab-carro.com-carro::after { content: ""; position: absolute; top: 7px; right: 7px; width: 8px; height: 8px; border-radius: 50%;
      background: var(--accent); box-shadow: 0 0 0 2px var(--accent-soft); }
  }
  .cab .cab-lista b { position: absolute; top: 3px; right: 1px; min-width: 19px; height: 19px; padding: 0 5px; border-radius: 10px;
    display: grid; place-items: center; background: var(--accent); color: #1d1d1f; font-size: 11.5px; font-weight: 800; line-height: 1;
    font-variant-numeric: tabular-nums; box-shadow: 0 0 0 2px var(--bg); pointer-events: none; }
  .cab .cab-lista[aria-current="page"] { background: var(--accent-soft); }
  .cab .cab-whats span { display: none; }
  @media (max-width: 379px) { .cab .cab-linha > .logo img { height: 48px; } }
  @media (max-width: 339px) { .cab .cab-linha > .logo img { height: 44px; } }
  @media (min-width: 400px) { .cab .cab-acoes { gap: 6px; } }
  @media (min-width: 960px) {
    .cab .cab-linha { height: 84px; gap: 16px; } .cab .cab-linha > .logo img { height: 66px; }
    .cab .cab-nav { display: flex; } .cab .cab-acoes { gap: 10px; }
    .cab .cab-whats { padding: 0 18px; } .cab .cab-whats span { display: inline; } .cab .cab-menu { display: none; }
  }

  .menu-movel { margin: 0 0 0 auto; width: min(100%, 420px); height: 100dvh; max-height: none; border: 0; padding: 18px 20px calc(20px + env(safe-area-inset-bottom));
                background: var(--bg); color: var(--ink); display: none; flex-direction: column; gap: 14px; overflow: hidden;
                transform: translateX(100%); transition: transform .32s cubic-bezier(.2,.8,.2,1), overlay .32s allow-discrete, display .32s allow-discrete; }
  .menu-movel[open] { display: flex; transform: none; }
  @starting-style { .menu-movel[open] { transform: translateX(100%); } }
  .menu-movel::backdrop { background: rgb(10 10 12 / .45); backdrop-filter: blur(4px); }
  html.leve .menu-movel::backdrop { backdrop-filter: none; }
  .menu-movel .menu-topo { flex: none; display: flex; justify-content: space-between; align-items: center; }
  .menu-movel .menu-topo .logo img { height: 52px; width: auto; }
  .menu-movel .menu-corpo { flex: 1; min-height: 0; overflow-y: auto; overscroll-behavior: contain; display: flex; flex-direction: column; gap: 18px;
                            margin-inline: -4px; padding: 0 4px 8px; }
  .menu-movel .menu-links { display: grid; }
  .menu-movel .menu-links a { padding: 14px 4px; font-stretch: 84%; font-weight: 800; font-size: 26px; line-height: 1.15; border-bottom: 1px solid var(--line); }
  .menu-movel .menu-links a[aria-current="page"] { color: var(--accent-text); }
  .menu-movel .menu-rotulo { margin: 4px 0 -6px; font-size: 13.5px; font-weight: 600; color: var(--ink-3); }
  .menu-movel .menu-carros { display: flex; flex-wrap: wrap; gap: 8px; }
  .menu-movel .menu-carros a { padding: 9px 13px; border-radius: 10px; background: var(--surface); box-shadow: inset 0 0 0 1px var(--line); font-size: 14.5px; font-weight: 560; }
  /* o pé do menu: fora da parte que rola, sempre à vista (um véu da cor do fundo por cima da lista) */
  .menu-movel .menu-whats { flex: none; --h: var(--botao-g); width: 100%; box-shadow: inset 0 1px 0 rgb(255 255 255 / .38), inset 0 -1px 0 rgb(0 0 0 / .12),
                            0 1px 2px rgb(140 50 0 / .25), 0 8px 20px -8px color-mix(in oklab, var(--accent), transparent 30%), 0 -14px 18px -6px var(--bg); }
  @media (max-width: 380px) { .menu-movel .menu-links a { font-size: 22px; padding-block: 11px; } }
</style>

<style is:global>
  /* ---- busca no cabeçalho (PC): o mesmo campo com sugestões da abertura, em versão compacta; a lupa sai ----
     De 1100 a 1279 px o menu fica mais junto e o chip mostra só modelo e ano: sobra lugar para o campo inteiro. */
  .cab .cab-busca { display: none; }
  @media (min-width: 1100px) {
    .cab .cab-nav { flex: none; }
    /* o campo encolhe primeiro (fator 100) até o mínimo, que cabe o texto de exemplo inteiro ("Peça ou código": curto de
       propósito, para sobrar lugar ao carro); daí em diante, só o chip cede (reticências no modelo; o ano fica) */
    .cab .cab-busca { display: block; flex: 1 100 340px; min-width: 200px; max-width: 440px; margin-left: auto; }
    .cab .cab-busca ~ .cab-acoes { margin-left: 0; flex: 0 1 auto; }
    .cab .cab-busca ~ .cab-acoes > .cab-lupa { display: none; }
    .cab .cab-busca .sb-busca:not(.sb-grande) { height: 56px; border-radius: 14px; padding: 0 4px 0 14px; gap: 6px; box-shadow: inset 0 0 0 1.5px var(--line-2); }
    .cab .cab-busca .sb-busca:not(.sb-grande):focus-within { box-shadow: inset 0 0 0 2px var(--accent), 0 0 0 4px color-mix(in oklab, var(--accent), transparent 82%); }
