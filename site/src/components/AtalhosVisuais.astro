---
// Listas de atalho com cara de vitrine (paginas de categoria e carro).
// modo "marca": ficha com o LOGO real da marca num disco claro + nome + contagem (como em /carros.html).
// modo "tipo": cartão baixo com a FOTO do grupo (arte de estúdio da família ou capa de estúdio de uma peça) + nome
//   + contagem. Baixo de propósito: os atalhos não empurram as peças para a 3ª tela.
// Só os `limite` primeiros aparecem de cara; o resto (e os grupos com menos de `minimo` peças, que expõem estoque
// fraco) fica atrás do botão "Ver todas/todos". O botão é a última ficha da lista (no celular, o fim do trilho).
interface Logo { src: string; w: number; h: number; png: boolean }
interface Item { n: string; c: number; h: string; logo?: Logo | null; foto?: string | null; arte?: boolean }
// limitePc: no PC (cartões em grade), quantos aparecem de cara (ex.: 4 + o botão = uma fileira só).
interface Props { titulo: string; modo: 'marca' | 'tipo'; itens: Item[]; limite?: number; limitePc?: number; minimo?: number; mais?: string; id?: string }
const { titulo, modo, itens: todos, limite = 10, limitePc, minimo = 1, mais, id } = Astro.props;
// Tipo sem foto não vira cartão vazio.
const itens = modo === 'tipo' ? todos.filter((i) => !!i.foto) : todos;
// de cara: os maiores (até `limite`) com pelo menos `minimo` peças; o resto só no "Ver todas"
// "Ver todas" com 1 escondido só troca 1 ficha por outra: nesse caso mostra tudo
const fortes = itens.filter((i) => i.c >= minimo);
const comTudo = (s: Set<Item>) => (itens.length - s.size <= 1 ? new Set(itens) : s);
const deCara = comTudo(new Set(fortes.slice(0, limite)));
const deCaraPc = comTudo(new Set(fortes.slice(0, Math.min(limitePc ?? limite, limite))));
// o botão só aparece onde ele mostra alguma coisa: se no celular já está tudo à vista, ele fica só no PC
const escondeCelular = deCara.size < itens.length;
const tudo = !escondeCelular && deCaraPc.size === itens.length;
const n = itens.length;
const rotuloMais = mais ?? (modo === 'marca' ? `Ver as ${n} marcas` : `Ver os ${n} tipos`);
const idLista = `${id ?? `av-${modo}`}-lista`;
const qtd = (c: number) => `${c.toLocaleString('pt-BR')} ${c === 1 ? 'peça' : 'peças'}`;
---
{itens.length > 0 && (
  <nav class:list={['av', `av-${modo}`]} aria-labelledby={id ? `${id}-titulo` : undefined} aria-label={id ? undefined : titulo} data-av>
    <h2 class="av-titulo" id={id ? `${id}-titulo` : undefined}>{titulo}</h2>
    <ul class="av-lista" id={idLista}>
      {itens.map((i) => (
        <li class:list={[{ 'av-extra': !tudo && !deCara.has(i), 'av-extra-pc': !tudo && deCara.has(i) && !deCaraPc.has(i) }]}>
          {modo === 'marca' ? (
            <a class="av-chip" href={i.h}>
              <span class="av-disco">{i.logo && <img src={i.logo.src} alt="" width={i.logo.w} height={i.logo.h} class:list={[{ svg: !i.logo.png }]} loading="lazy" />}</span>
              <b>{i.n}</b><small class="num"><span class="sr-only">, </span>{i.c.toLocaleString('pt-BR')}<span class="sr-only"> {i.c === 1 ? 'peça' : 'peças'}</span></small>
            </a>
          ) : (
            <a class="av-cartao" href={i.h}>
              <span class:list={['av-foto', { 'av-foto-arte': i.arte }]}><img src={i.foto!} alt="" width="800" height={i.arte ? 632 : 800} loading="lazy" decoding="async" /></span>
              <span class="av-txt"><b>{i.n}</b><small class="num">{qtd(i.c)}</small></span>
            </a>
          )}
        </li>
      ))}
      {!tudo && (
        <li class:list={['av-mais-li', { 'av-mais-so-pc': !escondeCelular }]}>
          <button class:list={['av-mais', `av-mais-${modo}`]} type="button" aria-expanded="false" aria-controls={idLista} data-av-mais data-menos="Ver menos">
            <span data-av-rotulo>{rotuloMais}</span>
          </button>
        </li>
      )}
    </ul>
  </nav>
)}
<script>
  import { focoNoTrilho } from '../lib/trilhoFoco';
  // no celular a lista é um trilho com snap: o item com o foco do teclado nunca fica meio fora da tela
  focoNoTrilho('.av-lista');
  // "Ver todas": mostra o resto da lista no mesmo lugar (o foco fica no botão, que vira "Ver menos")
  document.querySelectorAll<HTMLButtonElement>('[data-av-mais]').forEach((b) => {
    const nav = b.closest<HTMLElement>('[data-av]');
    const rotulo = b.querySelector<HTMLElement>('[data-av-rotulo]');
    if (!nav || !rotulo) return;
    const mais = rotulo.textContent || '';
    b.addEventListener('click', () => {
      const aberto = !nav.hasAttribute('data-aberto');
      nav.toggleAttribute('data-aberto', aberto);
      b.setAttribute('aria-expanded', String(aberto));
      rotulo.textContent = aberto ? (b.dataset.menos || mais) : mais;
    });
  });
</script>
<style>
  .av { margin-top: clamp(24px, 3vw, 32px); }
  .av-titulo { margin: 0 0 12px; font-stretch: 84%; font-weight: 800; font-size: clamp(21px, 2vw, 26px); line-height: 1.1; letter-spacing: -.005em; color: var(--ink); text-wrap: balance; }
  /* folga de 8 px em volta: o anel do teclado não é cortado pela rolagem do trilho */
  .av-lista { list-style: none; margin: -8px; padding: 8px 8px 12px; display: flex; gap: 10px; overflow-x: auto; scroll-snap-type: x proximity;
    scroll-padding-inline: 8px; scrollbar-width: none; overscroll-behavior-x: contain; }
  .av-lista::-webkit-scrollbar { display: none; }
  .av-lista li { flex: none; display: flex; scroll-snap-align: start; }
  .av:not([data-aberto]) .av-lista > li.av-extra { display: none; }
  @media (min-width: 900px) { .av:not([data-aberto]) .av-lista > li.av-extra-pc { display: none; } }
  @media (max-width: 899px) { .av-lista > li.av-mais-so-pc { display: none; } }
  @media (min-width: 900px) { .av-lista { overflow: visible; flex-wrap: wrap; } }

  /* marca: ficha com logo */
  .av-chip { display: inline-flex; align-items: center; gap: 10px; height: 52px; padding: 0 16px 0 6px; border-radius: 16px; background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line); color: var(--ink); transition: box-shadow .2s, transform .2s; }
  .av-disco { width: 40px; height: 40px; display: grid; place-items: center; border-radius: 50%; background: #fff; box-shadow: inset 0 0 0 1px rgb(0 0 0 / .07); }
  .av-disco:empty { display: none; }
  .av-disco img { max-width: 30px; max-height: 22px; width: auto; height: auto; }
  .av-disco img.svg { filter: brightness(0) saturate(100%) invert(9%) sepia(5%) saturate(500%) hue-rotate(200deg); }
  .av-chip b { font-size: 15px; font-weight: 650; }
  .av-chip small { font-size: 13px; color: var(--ink-3); font-weight: 500; }

  /* tipo/sistema: cartão baixo, foto quadrada à esquerda */
  .av-cartao { display: grid; grid-template-columns: 64px minmax(0, 1fr); align-items: center; gap: 12px; width: 236px; padding: 8px 14px 8px 8px;
    border-radius: 16px; background: var(--surface); color: var(--ink); box-shadow: inset 0 0 0 1px var(--line); transition: transform .25s, box-shadow .25s; }
  .av-foto { display: block; width: 64px; height: 64px; border-radius: 11px; overflow: hidden; background: #f4f3f0; }
  .av-foto img { display: block; width: 100%; height: 100%; object-fit: cover; }
  /* arte da família (peça no pedestal): um pouco mais perto, centrada na peça */
  .av-foto-arte img { object-position: 50% 42%; transform: scale(1.18); }
  .av-txt { display: grid; gap: 2px; min-width: 0; }
  .av-txt b { font-size: 15px; line-height: 1.22; font-weight: 650; overflow-wrap: anywhere; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .av-txt small { font-size: 13px; color: var(--ink-3); font-weight: 500; }
  @media (min-width: 900px) {
    .av-tipo .av-lista { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 12px; }
    .av-tipo .av-lista li { display: flex; min-width: 0; }
    .av-cartao { width: 100%; }
  }
  @media (max-width: 899px) { .av-cartao { width: 214px; } }

  /* "Ver todas": a última ficha, com cara de botão de linha */
  .av-mais { flex: none; display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 52px; padding: 0 18px; border: 0; border-radius: 12px;
    background: var(--surface); color: var(--ink); font-size: 15px; font-weight: 650; white-space: nowrap; box-shadow: inset 0 0 0 1.5px var(--line-2), 0 1px 2px rgb(0 0 0 / .04);
    transition: box-shadow .2s, background-color .2s; }
  .av-mais::after { content: ""; width: 7px; height: 7px; margin-top: -3px; border-right: 2px solid currentColor; border-bottom: 2px solid currentColor; transform: rotate(45deg); transition: transform .25s; }
  .av[data-aberto] .av-mais::after { margin-top: 3px; transform: rotate(-135deg); }
  .av-mais-tipo { min-height: 80px; width: 100%; }
  @media (max-width: 899px) { .av-mais-tipo { width: 150px; white-space: normal; text-align: left; } }

  @media (hover: hover) {
    .av-chip:hover, .av-cartao:hover { box-shadow: inset 0 0 0 1.5px var(--ink-3); transform: translateY(-1px); }
    .av-mais:hover { box-shadow: inset 0 0 0 1.5px var(--ink-3); background: var(--surface); }
  }
</style>
