---
// Listas de atalho com cara de vitrine (paginas de categoria, marca e carro).
// modo "marca": chip com o LOGO real da marca num disco claro + nome + contagem (como em /carros.html).
// modo "tipo": cartao com a FOTO de estudio de uma peca do grupo + nome + contagem.
interface Logo { src: string; w: number; h: number; png: boolean }
interface Item { n: string; c: number; h: string; logo?: Logo | null; foto?: string | null }
interface Props { titulo: string; modo: 'marca' | 'tipo'; itens: Item[] }
const { titulo, modo, itens: todos } = Astro.props;
// Tipo sem foto de estudio nao vira cartao vazio.
const itens = modo === 'tipo' ? todos.filter((i) => !!i.foto) : todos;
---
{itens.length > 0 && (
  <nav class:list={['av', `av-${modo}`]} aria-label={titulo}>
    <p class="av-titulo">{titulo}</p>
    <ul class="av-lista">
      {itens.map((i) => (
        <li>
          {modo === 'marca' ? (
            <a class="av-chip" href={i.h}>
              <span class="av-disco">{i.logo && <img src={i.logo.src} alt="" width={i.logo.w} height={i.logo.h} class:list={[{ svg: !i.logo.png }]} loading="lazy" />}</span>
              <b>{i.n}</b><small class="num">{i.c.toLocaleString('pt-BR')}</small>
            </a>
          ) : (
            <a class="av-cartao" href={i.h}>
              <span class="av-foto">{i.foto ? <img src={i.foto} alt="" width="800" height="800" loading="lazy" decoding="async" /> : <span class="av-sem" aria-hidden="true" />}</span>
              <span class="av-txt"><b>{i.n}</b><small class="num">{`${i.c.toLocaleString('pt-BR')} ${i.c === 1 ? 'peça' : 'peças'}`}</small></span>
            </a>
          )}
        </li>
      ))}
    </ul>
  </nav>
)}
<style>
  .av { margin-top: 28px; }
  .av-titulo { margin: 0 0 12px; font-size: 14px; font-weight: 650; color: var(--ink-2); }
  .av-lista { list-style: none; margin: 0; padding: 4px 2px 10px; display: flex; gap: 12px; overflow-x: auto; scroll-snap-type: x proximity; scrollbar-width: none; }
  .av-lista::-webkit-scrollbar { display: none; }
  .av-lista li { flex: none; display: flex; scroll-snap-align: start; }
  @media (min-width: 900px) { .av-lista { overflow: visible; flex-wrap: wrap; } }

  /* marca: chip com logo */
  .av-chip { display: inline-flex; align-items: center; gap: 9px; height: 46px; padding: 0 16px 0 6px; border-radius: 14px; background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line); color: var(--ink); transition: box-shadow .2s, transform .2s; }
  .av-chip:hover { box-shadow: inset 0 0 0 1.5px var(--ink-3); transform: translateY(-1px); }
  .av-disco { width: 34px; height: 34px; display: grid; place-items: center; border-radius: 50%; background: #fff; box-shadow: inset 0 0 0 1px rgb(0 0 0 / .06); }
  .av-disco:empty { display: none; }
  .av-disco img { max-width: 24px; max-height: 18px; width: auto; height: auto; }
  .av-disco img.svg { filter: brightness(0) saturate(100%) invert(9%) sepia(5%) saturate(500%) hue-rotate(200deg); }
  .av-chip b { font-size: 14.5px; font-weight: 650; }
  .av-chip small { font-size: 12.5px; color: var(--ink-3); font-weight: 500; }

  /* tipo: cartao com foto de estudio */
  .av-cartao { display: grid; grid-template-rows: auto 1fr; width: 178px; flex: 1; border-radius: 18px; background: var(--surface); overflow: hidden; color: var(--ink);
    box-shadow: 0 1px 0 rgb(0 0 0 / .03), inset 0 0 0 1px var(--line); transition: transform .25s, box-shadow .25s; }
  .av-cartao:hover { transform: translateY(-2px); box-shadow: 0 14px 28px -18px rgb(0 0 0 / .35), inset 0 0 0 1px var(--line-2); }
  .av-foto { display: block; aspect-ratio: 1 / 1; background: #f4f3f0; }
  .av-foto img { display: block; width: 100%; height: 100%; object-fit: contain; padding: 6%; }
  .av-sem { display: block; width: 100%; height: 100%; }
  .av-txt { display: grid; gap: 2px; padding: 12px 14px 14px; }
  .av-txt b { font-size: 15px; line-height: 1.25; font-weight: 650; }
  .av-txt small { font-size: 12.5px; color: var(--ink-3); font-weight: 500; }
  @media (min-width: 900px) { .av-cartao { width: auto; } .av-tipo .av-lista li { width: calc((100% - 4 * 12px) / 5); } }
  @media (max-width: 899px) { .av-cartao { width: 158px; } .av-txt b { font-size: 14px; } }
</style>
