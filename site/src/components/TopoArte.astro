---
// Topo das paginas internas: trilha + H1 + apoio, com a ARTE DE ESTUDIO na metade direita
// (o lado esquerdo da arte fica vazio para o texto). Sem arte: a marca (logo real) num disco de
// estudio. Sem nada: so o texto. Emite o BreadcrumbList (as paginas nao repetem).
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { SITE } from '../lib/dados';
interface Logo { src: string; w: number; h: number; png: boolean }
interface Props { trilha: [string, string][]; antes?: string; titulo: string; lead?: string; arte?: string; arteW?: number; arteH?: number; logo?: Logo | null; encaixe?: 'cobre' | 'contem' | 'meio'; }
const { trilha, antes, titulo, lead, arte, arteW = 1536, arteH = 640, logo, encaixe = 'cobre' } = Astro.props;
const temArte = !!arte && existsSync(join(process.cwd(), 'public', arte));
const ld = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: trilha.map(([n, h], i) => ({ '@type': 'ListItem', position: i + 1, name: n, item: `${SITE}${h}` })) };
---
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
<section class:list={['topo-arte-wrap', { 'com-arte': temArte, 'contem': temArte && encaixe === 'contem', 'meio': temArte && encaixe === 'meio', 'com-disco': !temArte && !!logo }]}>
  <div class="moldura">
    <nav class="trilha" aria-label="Você está em">
      {trilha.slice(0, -1).map(([n, h]) => <><a href={h}>{n}</a><span aria-hidden="true">/</span></>)}
      <span aria-current="page">{trilha[trilha.length - 1][0]}</span>
    </nav>
    <div class:list={["topo-caixa", { "tema-estudio": temArte }]}>
      <div class="topo-texto">
        {temArte && logo && (
          <p class="topo-marca"><img src={logo.src} alt="" width={logo.w} height={logo.h} class:list={[{ svg: !logo.png }]} />{antes}</p>
        )}
        {!(temArte && logo) && antes && <p class="topo-antes">{antes}</p>}
        <h1 class="display">{titulo}</h1>
        {lead && <p class="lead">{lead}</p>}
      </div>
      {temArte && <div class="topo-arte"><img src={arte} alt="" width={arteW} height={arteH} fetchpriority="high" decoding="async" /></div>}
      {!temArte && logo && (
        <div class="topo-disco" aria-hidden="true"><img src={logo.src} alt="" width={logo.w} height={logo.h} class:list={[{ svg: !logo.png }]} /></div>
      )}
    </div>
    <div class="topo-extra"><slot /></div>
  </div>
</section>
<style>
  .topo-arte-wrap { padding-block: 14px 8px; }
  .trilha { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 8px; font-size: 13.5px; color: var(--ink-3); margin-bottom: 14px; }
  .trilha a { color: var(--ink-2); padding-block: 6px; } .trilha a:hover { color: var(--ink); text-decoration: underline; }
  .topo-caixa { display: grid; gap: 22px; align-items: center; }
  .topo-texto { position: relative; z-index: 2; display: grid; gap: 12px; min-width: 0; }
  .topo-texto h1 { margin: 0; font-size: clamp(42px, 5.8vw, 80px); }
  .topo-texto .lead { margin: 0; max-width: 48ch; }
  .topo-antes { margin: 0; font-weight: 650; font-size: 15px; color: var(--accent-text); }
  .topo-marca { display: flex; align-items: center; gap: 12px; margin: 0; font-weight: 700; font-size: 16px; color: var(--ink); }
  .topo-marca img { flex: none; width: auto; max-width: 64px; height: 36px; object-fit: contain; }
  .topo-marca img.svg, .topo-disco img.svg { filter: brightness(0) saturate(100%) invert(9%) sepia(5%) saturate(500%) hue-rotate(200deg); }
  .topo-disco { display: grid; place-items: center; width: clamp(190px, 24vw, 280px); aspect-ratio: 1; justify-self: center; border-radius: 50%;
    background: radial-gradient(closest-side, #fff 64%, #f4f3f0 66%, #e8e7e3 100%); box-shadow: inset 0 0 0 1px rgb(0 0 0 / .05), 0 24px 40px -24px rgb(0 0 0 / .35); }
  .topo-disco img { display: block; max-width: 62%; max-height: 40%; width: auto; height: auto; }
  .topo-extra:empty { display: none; }
  .topo-extra { margin-top: 24px; }

  /* com arte: a arte preenche a caixa; o lado esquerdo fica limpo para o texto */
  .com-arte .topo-caixa { position: relative; min-height: clamp(340px, 34vw, 460px); border-radius: 28px; overflow: hidden; background: #f4f3f0; align-items: center; }
  .com-arte .topo-arte { position: absolute; inset: 0; z-index: 0; }
  .com-arte .topo-arte img { width: 100%; height: 100%; object-fit: cover; object-position: 100% 50%; }
  .com-arte .topo-arte::after { content: ""; position: absolute; inset: 0;
    background: linear-gradient(90deg, #f4f3f0 0%, #f4f3f0 40%, rgb(244 243 240 / .6) 46%, rgb(244 243 240 / 0) 56%); }
  .com-arte .topo-texto { padding: clamp(28px, 4vw, 56px); max-width: 44%; }
  .com-arte .topo-texto h1 { font-size: clamp(42px, 5.4vw, 76px); }

  /* arte quadrada ou 3:2 (carro, categoria): inteira, na metade direita, sem cortar */
  .com-arte.contem .topo-arte { left: 50%; right: 0; }
  .com-arte.contem .topo-arte img { object-fit: contain; object-position: 50% 50%; padding: 4% 6%; }
  .com-arte.contem .topo-arte::after { display: none; }
  .com-arte.contem .topo-caixa { min-height: clamp(360px, 36vw, 480px); }
  .com-arte.contem .topo-texto { max-width: 50%; }
  /* carro (fundo de estudio igual ao da caixa): a foto preenche a metade direita, sem moldura */
  .com-arte.meio .topo-arte { left: 50%; right: 0; }
  .com-arte.meio .topo-arte img { object-fit: cover; object-position: 80% 60%; }
  .com-arte.meio .topo-arte::after { display: none; }
  .com-arte.meio .topo-caixa { min-height: clamp(360px, 36vw, 480px); }
  .com-arte.meio .topo-texto { max-width: 50%; }

  /* com disco: a marca fica ao lado do texto */
  @media (min-width: 900px) { .com-disco .topo-caixa { grid-template-columns: minmax(0, 1fr) auto; gap: 40px; } }

  /* celular: o texto em cima, a arte embaixo (nunca sobre o carro/peça) */
  @media (max-width: 899px) {
    .com-arte .topo-caixa { display: flex; flex-direction: column; min-height: 0; border-radius: 26px; }
    .com-arte .topo-texto { max-width: none; padding: 24px 22px 14px; }
    .com-arte .topo-arte { position: relative; inset: auto; }
    .com-arte .topo-arte::after { display: none; }
    .com-arte .topo-arte img { height: auto; aspect-ratio: 16 / 10; object-position: 100% 50%; }
    .com-arte.contem .topo-arte { position: relative; inset: auto; left: auto; }
    .com-arte.contem .topo-arte img { aspect-ratio: auto; padding: 0; }
    .com-arte.contem .topo-texto { max-width: none; }
    .com-arte.meio .topo-arte { position: relative; inset: auto; left: auto; }
    .com-arte.meio .topo-arte img { aspect-ratio: 3 / 2; height: auto; }
    .com-arte.meio .topo-texto { max-width: none; }
  }
</style>
