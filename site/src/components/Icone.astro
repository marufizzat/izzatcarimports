---
// Icones de linha (desenho Lucide, licenca ISC) + o glifo do WhatsApp. Desenhos em src/lib/icones.ts:
// os longos vêm do sprite /icones.svg (<use>, com o traço no próprio símbolo), os curtos ficam aqui mesmo.
import { LINHA, noSprite, icone } from '../lib/icones';
interface Props { nome: string; class?: string; }
const { nome, class: cls } = Astro.props;
const sprite = noSprite(nome);
---
{sprite
  ? <svg class={cls} viewBox="0 0 24 24" aria-hidden="true"><use href={icone(nome)} /></svg>
  : <svg class={cls} viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" set:html={LINHA[nome] ?? ''} />}
