    window.addEventListener('scroll', () => { if (lupaImg) agendar(); }, { passive: true });
    window.addEventListener('resize', lupaFim, { passive: true });
  });

  // Copiar o código: "Copiado" (e o aviso para o leitor de tela) só quando copiou de verdade; se o navegador não
  // deixar, o código fica selecionado na tela para a pessoa copiar.
  let aviso: HTMLElement | null = null;
  const avisar = (txt: string) => {
    if (!aviso) { aviso = Object.assign(document.createElement('p'), { className: 'sr-only' }); aviso.setAttribute('role', 'status'); document.body.append(aviso); }
    aviso.textContent = '';
    requestAnimationFrame(() => { aviso!.textContent = txt; });
  };
  document.querySelectorAll<HTMLButtonElement>('[data-copiar]').forEach((b) => {
    const rot = b.querySelector('span') ?? b.lastChild!;
    const antes = rot.textContent;
    b.addEventListener('click', async () => {
      const cod = b.dataset.copiar || '';
      try {
        await navigator.clipboard.writeText(cod);
        rot.textContent = 'Copiado';
        avisar(`Código ${cod} copiado`);
        setTimeout(() => { rot.textContent = antes; }, 1600);
