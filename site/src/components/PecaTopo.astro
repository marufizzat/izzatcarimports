        const alvo = b.parentElement?.querySelector('.oem') ?? b.parentElement;
        if (alvo) { const r = document.createRange(); r.selectNodeContents(alvo); const s = getSelection(); s?.removeAllRanges(); s?.addRange(r); }
        avisar('Não deu para copiar sozinho: o código ficou selecionado');
      }
    });
  });
</script>

