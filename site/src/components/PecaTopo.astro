---
// Topo da pagina da peca: galeria (deslizar, miniaturas, lupa, tela cheia) + compra.
// Ordem da compra (a mesma no PC e no celular, e a mesma no HTML e na tela): nome e carro, preço forte com o estoque
// real (peça única), os botões e, logo depois, o "Serve no seu carro?" e a confiança. Depois: código, perguntas,
// compartilhar. Assim preço e botão sobem para a 1ª tela do celular; a barra fixa (pages/peca/[slug].astro) só aparece
// quando preço e botões saíram da tela (nunca dois preços à vista).
// Gatilhos so com dado de verdade: estoque = p.q (ML), reputacao = resumo().reputacao, CDV/nota/garantia do site.
import type { Peca } from '../lib/dados';
import { foto, brl, capaEstudio, codigoDaPeca, SITE } from '../lib/dados';
import { quadroFoto, fotosGaleria } from '../lib/quadroFoto';
import { linkWhats, cabecaPeca, CAUDA_PECA, DESCONTO_WHATS } from '../lib/whats';
import Icone from './Icone.astro';
import SeloReputacao from './SeloReputacao.astro';
import FaixaMeuCarro from './peca/FaixaMeuCarro.astro';
import Compartilhar from './peca/Compartilhar.astro';
import Acordeao from './ui/Acordeao.astro';
import { nomeModelos, modelosDa } from '../lib/meuCarro';
import { nomeMensagem } from '../lib/nomePeca';
interface Props { p: Peca; nivel?: 'h1' | 'h2'; }
const { p, nivel = 'h1' } = Astro.props;
const Titulo = nivel;
// todos os carros da peça ("Volvo S60 e XC60" quando ela serve nos dois), como no "Serve em" da ficha
const carro = nomeModelos(p);
const anos = p.y ? (p.y[0] === p.y[1] ? String(p.y[0]) : `${p.y[0]} a ${p.y[1]}`) : '';
const [reais, cent] = brl(p.p).split(',');
const url = `${SITE}/peca/${p.slug}.html`;
// só código com cara de código (lixo da extração, como "Par", não vira caixa com "Copiar")
const cod = codigoDaPeca(p.oem);
// Mensagem do WhatsApp (lib/whats.ts, a mesma do cartão): a abertura do site, a peça pelo nome limpo + carro + anos +
// código (nomeMensagem, lib/nomePeca.ts; nunca o título cru do ML), o preço e o link (que leva o MLB).
// Sem carro salvo vai "Meu carro é X ano ____"; com carro salvo o script troca essa linha.
const cabeca = cabecaPeca({ linha: nomeMensagem(p), preco: brl(p.p), url }, { desconto: true });
// peça de 2+ carros: o modelo fica em branco para a pessoa escrever o dela
const semCarro = !p.b ? '' : modelosDa(p).length > 1 ? `Meu carro é ${p.b} ____ ano ____. ` : `Meu carro é ${carro} ano ____. `;
const cauda = CAUDA_PECA;
const msg = cabeca + semCarro + cauda;
// Estoque real do ML: 1 = peca unica (usada: quando vende, acabou); mais de 1 = so a quantidade, sem pressa inventada.
const q = typeof p.q === 'number' && p.q >= 1 ? p.q : 0;
// 1ª foto = capa de estúdio (fundo limpo); depois as fotos reais do anúncio, que mostram o estado da peça, no mesmo
// quadro da capa (lib/quadroFoto.ts: peça centrada ocupando ~84%, ou a foto inteira num fundo de estúdio). Sem o
// marketing do vendedor (banner de entrega, garantia, dicas) e com a foto do carro inteiro no fim (fotosGaleria).
const est = capaEstudio(p.id);
const doAnuncio = fotosGaleria(p.fotos);
const fotos: { g: string; m: string; e?: boolean; q?: { cls?: string; style?: string } }[] = [
  ...(est ? [{ g: est, m: est, e: true }] : []),
  ...(doAnuncio.length ? doAnuncio : ['']).map((f) => ({ g: foto(f, 'F'), m: foto(f, 'A'), q: quadroFoto(f) })),
];
// 1ª tela do celular (CSS no fim): a altura que a foto pode ter depende de quantas linhas vêm abaixo dela. Contado no
// build pelo tamanho do texto (sem script, sem pulo na tela): nome curto = 1 linha (a foto ganha); nome longo = letra
// menor (cabe em 2); carro de 2+ modelos com nome comprido = anos na 2ª linha; preço de 5 dígitos + "Peça única" quebra
// no celular de 320.
const linhaCarro = [carro, anos].filter(Boolean).join(' · ');
const dobra = { 'nome-1l': p.n.length <= 20, 'nome-3l': p.n.length > 50, 'carro-2l': linhaCarro.length > 34, 'preco-2l': q === 1 && p.p >= 10000 };
// Objeções da compra, respondidas com o que o site ja diz (inicio, garantia, envios, como comprar). Nada novo.
// A promessa "a gente confere antes" fica na lista dos botões e no banner do fim (não se repete aqui).
const perguntas = [
  {
    pergunta: 'Como sei que serve no meu carro?',
    resposta: [
      carro ? `Esta peça é ${p.m ? 'do' : 'de'} ${carro}${anos ? `, ${anos}` : ''}.` : '',
      cod ? `Compara o código gravado na sua peça velha com o desta (${cod}): se for o mesmo, é a mesma peça.`
          : 'Ela não tem código gravado: para conferir, manda o modelo e o ano do seu carro no WhatsApp.',
    ].filter(Boolean).join(' '),
    link: cod ? { href: '#como-achar-codigo', texto: 'Onde achar o código' } : undefined,
  },
  {
    pergunta: 'E se não servir?',
    // Só o que o site já afirma (a gente confere antes, 90 dias, WhatsApp, a gente avalia e resolve). A regra de troca por
    // incompatibilidade (prazo, frete, compra errada) ainda não foi definida pelo Maruf: nada de "troca ou devolução"
    // aqui nem na garantia (auditorias 3, item 1.2, e 4, item 3.2).
    resposta: 'Na dúvida, manda o modelo e o ano antes de comprar: a gente confere na peça. Depois da compra, são 90 dias '
      + 'de garantia: fala no WhatsApp com o número do pedido que a gente avalia e resolve. '
      + 'Comprando pelo Mercado Livre, vale também a proteção de compra da plataforma.',
    link: { href: '/garantia.html', texto: 'Ver a garantia' },
  },
  {
    pergunta: 'Como é o envio?',
    // regra do dono (09/11): frete a combinar pelo site; frete e prazo do ML são os do anúncio (sem prazo próprio)
    resposta: 'Enviamos para todo o Brasil. Pelo WhatsApp, o frete é combinado na hora, pelo seu CEP. Comprando pelo Mercado Livre, o frete e o prazo são os calculados lá, no anúncio.',
    link: { href: '/envios.html', texto: 'Ver envios' },
  },
  {
    pergunta: 'Tem nota fiscal?',
    resposta: 'Sim, em toda venda. E a peça é original, de carro com baixa legal no Detran-RS: somos desmanche credenciado, CDV nº 01060.',
  },
];
---
<div class:list={['peca-topo', dobra]}>
  <div class="galeria" data-galeria data-titulo={p.n}>
    <div class="galeria-palco" data-palco>
      {/* o trilho é a parada do teclado da galeria: setas trocam a foto, Enter abre a tela cheia (script abaixo) */}
      <ul class="galeria-trilho" data-trilho tabindex="0" aria-label="Fotos da peça: setas trocam, Enter amplia">
        {fotos.map((f, i) => (
          <li><img class:list={[{ estudio: f.e }, f.q?.cls]} style={f.q?.style} src={f.g} alt={i === 0 ? `${p.n}${carro ? `, ${carro}` : ''}, foto 1 de ${fotos.length}` : `${p.n}, foto ${i + 1} de ${fotos.length}`} width={f.q?.style ? undefined : 1000} height={f.q?.style ? undefined : 1000}
                   loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} decoding="async" /></li>
        ))}
      </ul>
      <span class="galeria-contador num" data-contador aria-live="polite">1 / {fotos.length}</span>
      <span class="galeria-dica galeria-dica-mouse" aria-hidden="true">Passe o mouse para ver de perto</span>
      <span class="galeria-dica galeria-dica-toque" aria-hidden="true">Toque para ampliar</span>
      <span class="galeria-dica galeria-dica-clique" aria-hidden="true">Clique para ampliar</span>
    </div>
    {fotos.length > 1 && (<>
      <div class="galeria-pontos" aria-hidden="true">
        {fotos.map((_, i) => <i class:list={[{ on: i === 0 }]} data-ponto />)}
      </div>
      <div class="galeria-miniaturas" role="group" aria-label="Miniaturas" data-minis>
        {fotos.map((f, i) => (
          <button type="button" aria-current={i === 0 ? 'true' : 'false'} aria-label={`Ver foto ${i + 1}`} data-ir={i}>
            {/* miniatura (-A: a foto inteira, na proporção dela, como a -F do palco): o mesmo quadro do palco, com o
                mesmo degradê nas bordas das fotos "inteiras" (classe i; a tela cheia copia esta miniatura) */}
            <img class:list={[{ estudio: f.e }, f.q?.cls]} style={f.q?.style} src={f.m} alt="" width={f.q?.style ? undefined : 72} height={f.q?.style ? undefined : 72} loading="lazy" decoding="async" />
          </button>
        ))}
      </div>
    </>)}
  </div>

  <div class="compra">
    <div class="compra-cabeca">
      <Titulo class:list={['compra-nome', { 'nome-longo': p.n.length > 36 }]}>{p.n}</Titulo>
      {p.b && (dobra['carro-2l'] && anos
        ? <p class="compra-carro"><b>{carro}</b><span class="compra-anos">{anos}</span></p>
        : <p class="compra-carro"><b>{carro}</b>{anos && ` · ${anos}`}</p>)}
    </div>

    <div class="compra-caixa">
      <div class="compra-preco-linha">
        <p class="compra-preco num"><small>R$</small>{reais}<small>,{cent}</small></p>
        {q === 1 && <span class="estoque estoque-unica"><i aria-hidden="true"></i>Peça única</span>}
        {q > 1 && <span class="estoque"><i aria-hidden="true"></i>{q} em estoque</span>}
      </div>
      {q === 1 && <p class="estoque-txt">Peça usada: quando vende, acabou.</p>}
      <div class="compra-botoes" data-compra-botoes>
        {/* desconto pelo WhatsApp (pedido do dono): selo claro colado no canto do botão laranja, sem ocupar altura
            (a 1ª tela do celular continua com o botão à vista). Só no WhatsApp, nunca no Mercado Livre. */}
        <p class="compra-desconto"><Icone nome="etiqueta" /><span>{DESCONTO_WHATS}% de desconto<span class="compra-desconto-onde"> pelo WhatsApp</span></span></p>
        <a class="botao botao-laranja" href={linkWhats(msg)} data-whats data-cabeca={cabeca} data-sem={semCarro} data-cauda={cauda}><Icone nome="whats" />Pedir no WhatsApp</a>
        <a class="botao botao-linha" href={p.ml} rel="nofollow noopener" data-compra>Comprar no Mercado Livre</a>
      </div>
      <ul class="compra-facil">
        <li><b>Na dúvida se serve?</b> A gente confere na peça antes de você comprar.</li>
        <li><b>WhatsApp:</b> mensagem pronta com a peça<span data-whats-carro></span>.</li>
        <li><b>Mercado Livre:</b> compra com a proteção da plataforma.</li>
      </ul>
    </div>

    {/* peça só com a marca: a linha do carro, lá em cima, já diz tudo (sem faixa repetida) */}
    {p.m && <FaixaMeuCarro b={p.b} m={p.m} y={p.y} ms={p.ms} ys={p.ys} />}

    <div class="confianca">
      <ul class="confianca-itens" aria-label="Garantias da compra">
        <li><a href="/garantia.html"><img src="/arte/v2/selo-garantia.webp" alt="" width="36" height="36" loading="lazy" decoding="async" /><span><b>90 dias de garantia</b><small class="confianca-link">Ver como funciona</small></span></a></li>
        <li><span><img src="/arte/v2/selo-nota-fiscal.webp" alt="" width="36" height="36" loading="lazy" decoding="async" /><span><b>Nota fiscal</b><small>Em toda venda</small></span></span></li>
        <li><span><img src="/arte/v2/selo-cdv.webp" alt="" width="36" height="36" loading="lazy" decoding="async" /><span><b>Desmanche credenciado</b><small>Detran-RS · <span class="sem-quebra">CDV nº 01060</span></small></span></span></li>
        <li><span><img src="/arte/v2/selo-envio.webp" alt="" width="36" height="36" loading="lazy" decoding="async" /><span><b>Envio para todo o Brasil</b><small>Frete pelo seu CEP</small></span></span></li>
      </ul>
      <SeloReputacao variante="linha" />
    </div>

    {cod && (
      <div class="compra-cod">
        <div>
          <span>Código gravado na peça</span>
          <b class="oem">{cod}</b>
          <a class="compra-ajuda" href="#como-achar-codigo">Onde fica o código na sua peça?</a>
        </div>
        <button type="button" class="botao botao-linha" data-copiar={cod}><Icone nome="copiar" />Copiar</button>
      </div>
    )}

    <section class="compra-perguntas" aria-labelledby="perguntas-peca">
      <h2 class="compra-perguntas-titulo" id="perguntas-peca">Antes de comprar</h2>
      <Acordeao itens={perguntas} ld={false} compacto />
    </section>

    <Compartilhar titulo={nomeMensagem(p)} url={url} />
  </div>
</div>

<script>
  import { lerMeuCarro, nomeCarro, EVENTO, type MeuCarro } from '../lib/meuCarro';

  // WhatsApp leva o carro salvo na mensagem (troca só a linha "Meu carro é ...").
  // [data-whats-espelho] (o botão da barra fixa do celular) recebe o mesmo link do botão principal.
  const pedidos = [...document.querySelectorAll<HTMLAnchorElement>('[data-whats]')];
  const espelhos = [...document.querySelectorAll<HTMLAnchorElement>('[data-whats-espelho]')];
  const principal = document.querySelector<HTMLAnchorElement>('[data-compra-botoes] [data-whats]') ?? pedidos[0];
  const avisos = [...document.querySelectorAll<HTMLElement>('[data-whats-carro]')];
  const atualizarWhats = (c: MeuCarro | null) => {
    pedidos.forEach((a) => {
      const base = a.getAttribute('href')!.split('?')[0];
      const linha = c ? `Meu carro é ${nomeCarro(c)}. ` : (a.dataset.sem || '');
      a.href = `${base}?text=${encodeURIComponent((a.dataset.cabeca || '') + linha + (a.dataset.cauda || ''))}`;
    });
    if (principal) espelhos.forEach((a) => { a.href = principal.href; });
    avisos.forEach((s) => { s.textContent = c ? ` e o seu ${nomeCarro(c)}` : ''; });
  };
  atualizarWhats(lerMeuCarro());
  window.addEventListener(EVENTO, (e) => atualizarWhats((e as CustomEvent<MeuCarro | null>).detail ?? null));

  // Galeria em tela cheia: módulo pequeno e sem React (ui/GaleriaTelaCheia.ts). Pré-busca quando o navegador folga
  // e no 1º toque na foto; o HTML dela só é montado na 1ª vez que abre.
  let telaCheia: Promise<typeof import('./ui/GaleriaTelaCheia')> | null = null;
  const carregarTelaCheia = () => (telaCheia ??= import('./ui/GaleriaTelaCheia'));

  document.querySelectorAll<HTMLElement>('[data-galeria]').forEach((g) => {
    const trilho = g.querySelector<HTMLElement>('[data-trilho]')!;
    const palco = g.querySelector<HTMLElement>('[data-palco]')!;
    const cont = g.querySelector<HTMLElement>('[data-contador]');
    const faixa = g.querySelector<HTMLElement>('[data-minis]');
    const minis = [...g.querySelectorAll<HTMLButtonElement>('[data-ir]')];
    const pontos = [...g.querySelectorAll<HTMLElement>('[data-ponto]')];
    const fotos = [...trilho.querySelectorAll<HTMLImageElement>('img')];
    const total = fotos.length;
    const titulo = g.dataset.titulo || '';
    const indice = () => Math.max(0, Math.min(total - 1, Math.round(trilho.scrollLeft / (trilho.clientWidth || 1))));
    let atual = 0;
    const calmo = window.matchMedia('(prefers-reduced-motion: reduce)');

    // miniaturas: uma parada só no Tab (a da foto à vista); as setas andam entre elas
    minis.forEach((b, j) => { b.tabIndex = j === 0 ? 0 : -1; });
    // no computador a faixa aparece na 1ª tela: as 6 primeiras carregam já (no celular ela fica escondida e nem baixa)
    if (faixa && window.matchMedia('(min-width: 960px)').matches) {
      minis.slice(0, 6).forEach((b) => { const im = b.querySelector('img'); if (im) im.loading = 'eager'; });
    }
    // degradê nas pontas da faixa quando há mais miniaturas escondidas
    const pontas = () => {
      if (!faixa) return;
      const fim = faixa.scrollWidth - faixa.clientWidth;
      faixa.classList.toggle('mais-esq', faixa.scrollLeft > 2);
      faixa.classList.toggle('mais-dir', faixa.scrollLeft < fim - 2);
    };

    // foto à vista mudou: contador, pontinhos, miniatura ativa (só a faixa rola; scrollIntoView mexia na página)
    const marcar = (i: number) => {
      if (i === atual) return;
      atual = i;
      lupaFim();
      if (cont) cont.textContent = `${i + 1} / ${total}`;
      pontos.forEach((d, j) => d.classList.toggle('on', i === j));
      minis.forEach((b, j) => { b.setAttribute('aria-current', String(i === j)); b.tabIndex = i === j ? 0 : -1; });
      const m = minis[i];
      if (faixa && m && faixa.clientWidth) {
        const esq = m.offsetLeft - 8, dir = m.offsetLeft + m.offsetWidth + 8 - faixa.clientWidth;
        const como = calmo.matches ? 'instant' : 'smooth';
        if (esq < faixa.scrollLeft) faixa.scrollTo({ left: esq, behavior: como });
        else if (dir > faixa.scrollLeft) faixa.scrollTo({ left: dir, behavior: como });
      }
    };
    const ir = (i: number, suave = true) => {
      const k = Math.max(0, Math.min(total - 1, i));
      trilho.scrollTo({ left: k * trilho.clientWidth, behavior: suave && !calmo.matches ? 'smooth' : 'instant' });
    };
    // um cálculo por quadro, no máximo (o evento de rolagem chega várias vezes por quadro)
    let agendado = false;
    trilho.addEventListener('scroll', () => {
      if (agendado) return;
      agendado = true;
      requestAnimationFrame(() => { agendado = false; marcar(indice()); });
    }, { passive: true });

    // toque/clique na foto (ou Enter no trilho) abre a galeria em tela cheia (pinça e zoom lá). Ao fechar, a página
    // fica na mesma foto em que a pessoa parou, e o foco volta ao trilho.
    const abrir = () => {
      const i = indice();
      carregarTelaCheia().then((m) => m.abrirGaleria({
        fotos: fotos.map((f) => f.getAttribute('src') || ''),
        minis: minis.map((b) => b.querySelector('img')),
        titulo, indice: i, foco: trilho,
        aoFechar: (k) => { if (k !== indice()) ir(k, false); },
      })).catch(() => {});
    };
    trilho.addEventListener('pointerdown', () => { lupaFim(); carregarTelaCheia(); }, { passive: true });
    trilho.addEventListener('click', abrir);
    trilho.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); abrir(); }
      else if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') { e.preventDefault(); ir(indice() + (e.key === 'ArrowRight' ? 1 : -1)); }
      else if (e.key === 'Home' || e.key === 'End') { e.preventDefault(); ir(e.key === 'Home' ? 0 : total - 1); }
    });
    // pré-busca depois da carga e quando o navegador folgar (só baixa o módulo; não monta nada). Antes do "load" ela
    // disputava a rede com a foto grande da 1ª tela no 4G lento.
    const preBuscar = () => {
      if ('requestIdleCallback' in window) requestIdleCallback(() => { carregarTelaCheia(); }, { timeout: 4000 });
      else setTimeout(() => { carregarTelaCheia(); }, 800);
    };
    if (document.readyState === 'complete') preBuscar();
    else window.addEventListener('load', preBuscar, { once: true });

    minis.forEach((b, j) => b.addEventListener('click', () => ir(j)));
    faixa?.addEventListener('keydown', (e) => {
      const j = minis.indexOf(document.activeElement as HTMLButtonElement);
      if (j < 0) return;
      const k = e.key === 'ArrowRight' ? j + 1 : e.key === 'ArrowLeft' ? j - 1 : e.key === 'Home' ? 0 : e.key === 'End' ? total - 1 : -2;
      if (k === -2 || !minis[k]) return;
      e.preventDefault();
      minis[k].focus();
      ir(k);
    });
    if (faixa) {
      let agFaixa = false;
      faixa.addEventListener('scroll', () => { if (!agFaixa) { agFaixa = true; requestAnimationFrame(() => { agFaixa = false; pontas(); }); } }, { passive: true });
      requestAnimationFrame(pontas);
    }

    // Computador (mouse, tela de 1180 px ou mais): lupa como nas lojas grandes. A foto do palco NUNCA muda de tamanho
    // (ampliada no lugar, as bordas da peça saíam do quadro e pareciam cortadas). Um guia sobre a foto marca a área e
    // o painel ao lado, sobre a coluna da compra, mostra essa área ampliada. O painel é o quadro do palco Z vezes maior
    // (o mesmo fundo de estúdio e a foto no mesmo lugar, inclusive a do anúncio enquadrada por lib/quadroFoto.ts),
    // deslocado: mostra exatamente o que está sob o guia. Montado no 1º uso; medidas uma vez por foto; por quadro, só
    // dois transform (nada de layout). Abaixo de 1180 px não há lugar para o painel: o clique abre a tela cheia.
    const podeLupa = window.matchMedia('(hover: hover) and (pointer: fine) and (min-width: 1180px)');
    let painel: HTMLElement | null = null;
    let quadro: HTMLElement, ampliada: HTMLImageElement, guia: HTMLElement;
    let lupaImg: HTMLImageElement | null = null;
    let mx = 0, my = 0, lupaAgendada = false, Z = 2, gw = 0, gh = 0;
    function lupaFim() {
      if (!lupaImg) return;
      lupaImg = null;
      g.classList.remove('lupa');
    }
    // a foto à vista como está desenhada no quadro (px do quadro): capa de estúdio (cover), foto do anúncio enquadrada
    // (fill, posta pelo --w/--x/--y e maior que o quadro) ou inteira (scale-down, com respiro: menor que a caixa)
    const lupaComecar = (im: HTMLImageElement, r: DOMRect) => {
      const nw = im.naturalWidth, nh = im.naturalHeight;
      if (!nw || !r.width) return false;   // ainda carregando: tenta no próximo movimento
      const s = getComputedStyle(im), c = im.getBoundingClientRect();
      const pl = parseFloat(s.paddingLeft), pt = parseFloat(s.paddingTop);
      const cw = c.width - pl - parseFloat(s.paddingRight), ch = c.height - pt - parseFloat(s.paddingBottom);
      const fit = s.objectFit;
      let k = fit === 'cover' ? Math.max(cw / nw, ch / nh) : Math.min(cw / nw, ch / nh);
      if (fit === 'scale-down') k = Math.min(1, k);
      const w = fit === 'fill' ? cw : nw * k, h = fit === 'fill' ? ch : nh * k;
      // zoom: capa de estúdio (1000 px) 2×; foto do anúncio pela resolução dela (até 1,25× o tamanho real, como a
      // capa), entre 2× e 2,5× (foto maior)
      Z = im.classList.contains('estudio') ? 2 : Math.max(2, Math.min(2.5, 1.25 * nw / w));
      if (!painel) {
        painel = document.createElement('div');
        painel.className = 'galeria-lupa';
        painel.setAttribute('aria-hidden', 'true');
        painel.append(quadro = document.createElement('div'));
        quadro.append(ampliada = new Image());
        ampliada.alt = '';
        ampliada.decoding = 'async';
        g.append(painel);
        guia = document.createElement('span');
        guia.className = 'galeria-guia';
        trilho.after(guia);
      }
      // à direita do palco, da altura dele e da largura dele (menos, se a janela acaba antes)
      const pw = Math.min(r.width, document.documentElement.clientWidth - r.right - 44), ph = r.height;
      if (pw < 240) return false;
      painel.style.cssText = `width:${pw}px;height:${ph}px`;
      quadro.style.cssText = `width:${r.width * Z}px;height:${r.height * Z}px`;
      ampliada.className = im.className;   // estudio | i (bordas que se desfazem no fundo)
      ampliada.style.cssText = `${im.getAttribute('style') || ''};left:${(c.left - r.left + pl + (cw - w) / 2) * Z}px;`
        + `top:${(c.top - r.top + pt + (ch - h) / 2) * Z}px;width:${w * Z}px;height:${h * Z}px`;
      const src = im.currentSrc || im.src;
      if (ampliada.src !== src) ampliada.src = src;
      gw = pw / Z; gh = ph / Z;
      guia.style.cssText = `width:${gw}px;height:${gh}px`;
      lupaImg = im;
      g.classList.add('lupa');
      return true;
    };
    const lupaDesenhar = () => {
      lupaAgendada = false;
      const im = fotos[atual];
      if (!im || !podeLupa.matches) return lupaFim();
      const r = im.parentElement!.getBoundingClientRect();
      if (lupaImg !== im && !lupaComecar(im, r)) return;
      // guia centrado no mouse, sem sair do quadro; o painel mostra a mesma área, Z vezes maior
      const x = Math.max(0, Math.min(r.width - gw, mx - r.left - gw / 2));
      const y = Math.max(0, Math.min(r.height - gh, my - r.top - gh / 2));
      guia.style.transform = `translate3d(${x}px,${y}px,0)`;
      quadro.style.transform = `translate3d(${-x * Z}px,${-y * Z}px,0)`;
    };
    const agendar = () => { if (!lupaAgendada) { lupaAgendada = true; requestAnimationFrame(lupaDesenhar); } };
    palco.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse' || !podeLupa.matches) return;
