---
// "Serve no seu carro?" logo abaixo do nome: UMA linha de encaixe (antes eram a faixa + o "Serve em" repetido).
// Peça com marca e modelo: 4 estados (convite, serve, confira o ano, outro carro). O HTML traz só o convite; os
// outros três só existem com carro salvo (localStorage, logo com JS), então o script os monta na hora, com o mesmo
// desenho (assim eles não pesam nas 5 mil páginas).
// Altura mínima reservada (2 linhas): no PC a troca de estado não mexe em nada; no celular, "serve" e
// "confira o ano" podem quebrar em 3 linhas e descer o preço uns 15-30 px (o botão segue na primeira tela).
// Peça só com a marca: "Peça de <marca>, anos" (sem prometer o modelo). Nunca escrevemos "não serve".
// Estilos globais (classes .enc-*, só deste componente): os estados montados pelo script usam as mesmas regras.
import Icone from '../Icone.astro';
interface Props { b: string; m: string; y: [number, number] | null; }
const { b, m, y } = Astro.props;
const anos = y ? (y[0] === y[1] ? String(y[0]) : `${y[0]} a ${y[1]}`) : '';
const carro = [b, m].filter(Boolean).join(' ');
---
{b && m ? (
  <section class="enc" data-meu-carro data-b={b} data-m={m} data-y0={y ? y[0] : ''} data-y1={y ? y[1] : ''} aria-label="Serve no seu carro?" aria-live="polite">
    <div class="enc-estado" data-estado="convite">
      <span class="enc-icone"><Icone nome="carro" /></span>
      <p class="enc-txt">
        <span>Serve em <b>{carro}</b>{anos && `, ${anos}`}</span>
        <button type="button" class="enc-acao" data-abrir-meu-carro>Conferir no meu carro</button>
      </p>
    </div>
  </section>
) : b ? (
  <section class="enc" aria-label="Carro da peça">
    <div class="enc-estado enc-fixo">
      <span class="enc-icone"><Icone nome="carro" /></span>
      <p class="enc-txt"><span>Peça de <b>{b}</b>{anos && `, ${anos}`}</span></p>
    </div>
  </section>
) : null}

<script>
  import { lerMeuCarro, serveNoMeuCarro, nomeCarro, EVENTO, type MeuCarro } from '../../lib/meuCarro';

  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  // o mesmo desenho do <Icone nome="check" />
  const CHECK = '<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>';
  const TROCAR = '<button type="button" class="enc-trocar" data-abrir-meu-carro>Trocar</button>';
  const SALVO = '<small>Seu carro salvo: <span data-nome-carro>carro</span></small>';

  document.querySelectorAll<HTMLElement>('[data-meu-carro]').forEach((el) => {
    const p = {
      b: el.dataset.b || '',
      m: el.dataset.m || '',
      y: el.dataset.y0 && el.dataset.y1 ? ([Number(el.dataset.y0), Number(el.dataset.y1)] as [number, number]) : null,
    };
    const carro = esc([p.b, p.m].filter(Boolean).join(' '));
    const anos = p.y ? (p.y[0] === p.y[1] ? String(p.y[0]) : `${p.y[0]} a ${p.y[1]}`) : '';
    const iconeCarro = el.querySelector('[data-estado="convite"] .enc-icone')?.innerHTML ?? '';
    const html: Record<string, string> = {
      sim: `<div class="enc-estado enc-sim" data-estado="sim"><span class="enc-icone">${CHECK}</span><p class="enc-txt"><span>Serve no seu <b data-nome-carro>carro</b></span><small>${anos ? `Peça de ${anos}` : `Peça do ${carro}`}</small></p>${TROCAR}</div>`,
      'confira-ano': `<div class="enc-estado enc-ano" data-estado="confira-ano"><span class="enc-icone" aria-hidden="true">!</span><p class="enc-txt"><span>Confira o ano: esta peça é de <b>${anos}</b></span>${SALVO}</p>${TROCAR}</div>`,
      outro: `<div class="enc-estado" data-estado="outro"><span class="enc-icone">${iconeCarro}</span><p class="enc-txt"><span>Serve em <b>${carro}</b>${anos ? `, ${anos}` : ''}</span>${SALVO}</p>${TROCAR}</div>`,
    };
    const mostrar = (c: MeuCarro | null) => {
      const s = serveNoMeuCarro(p, c);
      const chave = !c ? 'convite' : s ?? 'outro';
      if (!el.querySelector(`[data-estado="${chave}"]`) && html[chave]) el.insertAdjacentHTML('beforeend', html[chave]);
      el.querySelectorAll<HTMLElement>('[data-estado]').forEach((e) => { e.hidden = e.dataset.estado !== chave; });
      if (c) el.querySelectorAll('[data-nome-carro]').forEach((n) => { n.textContent = nomeCarro(c); });
    };
    mostrar(lerMeuCarro());
    window.addEventListener(EVENTO, (e) => mostrar((e as CustomEvent<MeuCarro | null>).detail ?? null));
    el.addEventListener('click', (e) => {
      if ((e.target as Element).closest('[data-abrir-meu-carro]')) window.dispatchEvent(new CustomEvent('abrir-meu-carro'));
    });
  });
</script>

<style is:global>
  .enc-estado[hidden] { display: none; }
  .enc { display: grid; }
  .enc-estado { display: flex; align-items: center; gap: 12px; min-height: 64px; padding: 10px 12px 10px 10px; border-radius: 14px;
                background: var(--surface); box-shadow: inset 0 0 0 1px var(--line); }
  .enc-fixo { min-height: 0; }
  .enc-icone { flex: none; width: 36px; height: 36px; border-radius: 10px; display: grid; place-items: center;
               background: var(--surface-2); color: var(--ink-2); box-shadow: inset 0 0 0 1px var(--line);
               font-weight: 850; font-size: 18px; line-height: 1; }
  .enc-icone svg { width: 20px; height: 20px; }
  .enc-txt { flex: 1; min-width: 0; margin: 0; display: grid; gap: 2px; font-size: 15px; line-height: 1.3; color: var(--ink-2); }
  .enc-txt b { color: var(--ink); font-weight: 680; }
  .enc-txt small { font-size: 13.5px; color: var(--ink-3); }
  .enc-acao, .enc-trocar { justify-self: start; border: 0; background: none; padding: 2px 0; font: inherit; font-size: 14px; font-weight: 650;
                           color: var(--ink); text-decoration: underline; text-decoration-thickness: 1.5px; text-underline-offset: 3px; cursor: pointer; }
  .enc-acao { text-decoration-color: var(--accent); }
  .enc-acao:hover, .enc-trocar:hover { color: var(--accent-text); }
  .enc-trocar { flex: none; align-self: center; padding: 8px 4px; color: var(--ink-2); }

  /* serve: verde */
  .enc-sim { background: #ecf8f0; box-shadow: inset 0 0 0 1px #bfe6cc; }
  .enc-sim .enc-icone { background: #16a34a; color: #fff; box-shadow: none; }
  .enc-sim .enc-icone svg { stroke-width: 2.8; width: 18px; height: 18px; }
  .enc-sim .enc-txt, .enc-sim .enc-txt b { color: #14532d; }
  .enc-sim .enc-txt small { color: #2f6b45; }
  .enc-sim .enc-trocar { color: #166534; }
  /* confira o ano: âmbar (nunca "não serve") */
  .enc-ano { background: #fff7e6; box-shadow: inset 0 0 0 1px #f1d9a6; }
  .enc-ano .enc-icone { background: #f5b700; color: #1d1d1f; box-shadow: none; }
  .enc-ano .enc-txt, .enc-ano .enc-txt b { color: #6b4100; }
  .enc-ano .enc-txt small, .enc-ano .enc-trocar { color: #7a4a00; }

  
</style>
