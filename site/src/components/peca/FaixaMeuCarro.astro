---
// Faixa "Meu carro" no topo da compra: diz se a peça serve no carro salvo no navegador.
// Os 4 estados (convite, serve, confira o ano, outro carro) ficam no HTML; o script mostra o certo.
// Nunca escrevemos "não serve".
import Icone from '../Icone.astro';
interface Props { b: string; m: string; y: [number, number] | null; }
const { b, m, y } = Astro.props;
const faixaAnos = y ? `${y[0]} a ${y[1]}` : '';
---
{b && m && (
  <section class="mc" data-meu-carro data-b={b} data-m={m} data-y0={y ? y[0] : ''} data-y1={y ? y[1] : ''} aria-label="Meu carro">
    <div class="mc-estado" data-estado="convite">
      <p class="mc-txt"><Icone nome="carro" />Escolha seu carro para conferir se serve</p>
      <button type="button" class="botao botao-linha mc-botao" data-abrir-meu-carro>Escolher carro</button>
    </div>
    <div class="mc-estado mc-sim" data-estado="sim" hidden>
      <p class="mc-txt"><span class="mc-ok"><Icone nome="check" /></span><span>Serve no seu <b data-nome-carro>carro</b></span></p>
      <button type="button" class="mc-trocar" data-abrir-meu-carro>Trocar</button>
    </div>
    <div class="mc-estado mc-ano" data-estado="confira-ano" hidden>
      <p class="mc-txt"><span>Confira o ano: esta peça é de {faixaAnos}</span></p>
      <button type="button" class="mc-trocar" data-abrir-meu-carro>Trocar</button>
    </div>
    <div class="mc-estado" data-estado="outro" hidden>
      <p class="mc-txt"><span>Seu carro salvo: <b data-nome-carro>carro</b></span></p>
      <button type="button" class="mc-trocar" data-abrir-meu-carro>Trocar</button>
    </div>
  </section>
)}

<script>
  import { lerMeuCarro, serveNoMeuCarro, nomeCarro, EVENTO, type MeuCarro } from '../../lib/meuCarro';

  document.querySelectorAll<HTMLElement>('[data-meu-carro]').forEach((el) => {
    const p = {
      b: el.dataset.b || '',
      m: el.dataset.m || '',
      y: el.dataset.y0 && el.dataset.y1 ? ([Number(el.dataset.y0), Number(el.dataset.y1)] as [number, number]) : null,
    };
    const estados = [...el.querySelectorAll<HTMLElement>('[data-estado]')];
    const mostrar = (c: MeuCarro | null) => {
      const s = serveNoMeuCarro(p, c);
      const chave = !c ? 'convite' : s ?? 'outro';
      estados.forEach((e) => { e.hidden = e.dataset.estado !== chave; });
      if (c) el.querySelectorAll('[data-nome-carro]').forEach((n) => { n.textContent = nomeCarro(c); });
    };
    mostrar(lerMeuCarro());
    window.addEventListener(EVENTO, (e) => mostrar((e as CustomEvent<MeuCarro | null>).detail ?? null));
    el.querySelectorAll<HTMLButtonElement>('[data-abrir-meu-carro]').forEach((b) =>
      b.addEventListener('click', () => window.dispatchEvent(new CustomEvent('abrir-meu-carro'))));
  });
</script>

<style>
  [hidden] { display: none !important; }
  .mc { display: grid; }
  .mc-estado { display: flex; align-items: center; justify-content: space-between; gap: 10px 14px; flex-wrap: wrap; padding: 14px 16px; border-radius: 16px; background: var(--surface); box-shadow: inset 0 0 0 1.5px var(--line); }
  .mc-txt { flex: 1 1 200px; margin: 0; display: flex; align-items: center; gap: 10px; min-width: 0; font-size: 15px; line-height: 1.35; color: var(--ink); }
  .mc-txt > :global(svg) { flex: none; width: 22px; height: 22px; color: var(--ink-2); }
  .mc-botao { --h: 40px; font-size: 14px; padding: 0 14px; }
  .mc-trocar { flex: none; border: 0; background: none; padding: 6px 2px; font: inherit; font-size: 14px; font-weight: 620; color: var(--ink-2); text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }
  .mc-trocar:hover { color: var(--ink); }
  .mc-sim { background: #e9f8ee; color: #14532d; box-shadow: inset 0 0 0 1.5px #b7e4c7; }
  .mc-sim .mc-txt { color: #14532d; }
  .mc-sim .mc-trocar { color: #166534; }
  .mc-ok { flex: none; width: 26px; height: 26px; border-radius: 50%; background: #16a34a; color: #fff; display: grid; place-items: center; }
  .mc-ok :global(svg) { width: 15px; height: 15px; color: #fff; stroke-width: 2.8; }
  .mc-ano { background: #fff7e6; color: #7a4a00; box-shadow: inset 0 0 0 1.5px #f1d9a6; }
  .mc-ano .mc-txt { color: #7a4a00; }
  .mc-ano .mc-trocar { color: #7a4a00; }
  @media (prefers-color-scheme: dark) {
    .mc-sim { background: #0f2a1a; color: #bdf0d1; box-shadow: inset 0 0 0 1.5px #1f5133; }
    .mc-sim .mc-txt { color: #bdf0d1; }
    .mc-sim .mc-trocar { color: #8ee3ad; }
    .mc-ano { background: #2b200c; color: #ffd58a; box-shadow: inset 0 0 0 1.5px #5a4217; }
    .mc-ano .mc-txt, .mc-ano .mc-trocar { color: #ffd58a; }
  }
</style>
