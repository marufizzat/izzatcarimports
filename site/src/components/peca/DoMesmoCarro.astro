---
// "Do mesmo carro": peças da MESMA GERAÇÃO do carro (anos que se sobrepõem), as da mesma família primeiro
// (regra em lib/relacionadas.ts). Outros anos só completam quando faltam peças, num grupo à parte com o
// nome dito ("Outros anos do Golf"), para nunca parecer que serve no mesmo carro.
// Peça sem modelo: "Da mesma marca" (sem prometer o carro).
import CartaoPeca from '../CartaoPeca.astro';
import type { Peca } from '../../lib/dados';
interface Props {
  titulo?: string;
  /** "Volkswagen Golf" (ou "Outras peças Volvo" quando é só a marca) */
  carro: string;
  /** só o modelo, para "Outros anos do Golf" */
  modelo?: string;
  /** anos da peça ("2014 a 2021"); vazio = sem ano */
  anos?: string;
  link: string; total: number;
  pecas: Peca[];
  outras?: Peca[];
  familia?: boolean;
  semAno?: boolean;
}
const { titulo = 'Do mesmo carro', carro, modelo = '', anos = '', link, total, pecas, outras = [], familia = false, semAno = false } = Astro.props;
const familiaTxt = familia ? ' Primeiro as da mesma família da peça.' : '';
const sub = semAno
  ? `${carro}. Esta peça não tem o ano no anúncio: confira o ano em cada uma.`
  : anos && pecas.length
    ? `${carro} da mesma geração desta peça (${anos}).${familiaTxt}`
    : anos
      ? `Agora não há outras peças do ${carro} de ${anos}.`
      : `${carro}.${familiaTxt}`;
---
<section class="secao faixa">
  <div class="moldura">
    <div class="cabeca linha">
      <div>
        <h2 class="titulo-secao">{titulo}</h2>
        <p class="sub">{sub}</p>
      </div>
      <a class="botao botao-linha" href={link}>Ver as {total} peças</a>
    </div>
    {pecas.length > 0 && <div class="trilho">{pecas.map((x) => <CartaoPeca p={x} />)}</div>}
    {outras.length > 0 && (
      <div class="outros-anos">
        <div class="outros-cabeca">
          <h3 class="outros-titulo">Outros anos do {modelo || carro}</h3>
          <p class="sub">Anos diferentes dos desta peça{anos ? ` (${anos})` : ''}: confira o ano no cartão antes de pedir.</p>
        </div>
        <div class="trilho">{outras.map((x) => <CartaoPeca p={x} />)}</div>
      </div>
    )}
  </div>
</section>

<style>
  .faixa { background: var(--bg-2); }
  .cabeca { display: grid; gap: 16px; margin-bottom: 24px; align-items: end; }
  @media (min-width: 768px) { .cabeca.linha { grid-template-columns: 1fr auto; } }
  .titulo-secao { margin: 0; }
  .sub { margin: 6px 0 0; font-size: 15px; color: var(--ink-2); text-wrap: pretty; }
  /* outra geração: separada por uma linha e com título próprio, nunca colada na mesma fila */
  .outros-anos { margin-top: 18px; padding-top: 26px; border-top: 1px solid var(--line); }
  .outros-cabeca { margin-bottom: 14px; }
  .outros-titulo { margin: 0; font-stretch: 84%; font-weight: 800; font-size: 21px; line-height: 1.15; }
</style>
