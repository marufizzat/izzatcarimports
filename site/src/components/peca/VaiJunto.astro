---
// "Vai junto": até 4 peças do MESMO carro (e da mesma geração) que costumam ser trocadas junto com esta (regra em
// lib/relacionadas.ts: vaiJunto). Logo depois da compra: é a hora de quem conserta juntar o resto do serviço na
// Lista de orçamento. Cartão compacto (capa leve, nome, anos e código, preço) e, no canto, o "+ lista" montado pelo
// script (components/peca/listaPeca.ts), com os dados lidos do próprio cartão: o HTML de cada peça leva só o mínimo.
// Sem peça que combine, quem chama não põe o bloco (nunca vazio, nunca peça de outro carro).
// Estilos globais presos a .vj (sem o atributo de escopo em cada tag).
import type { Peca } from '../../lib/dados';
import { brl, capa, capaPequena } from '../../lib/dados';
import { codigoPeca } from '../catalogo/etiqueta';
interface Props { pecas: Peca[]; carro: string; anos: string; com: string; }
const { pecas, carro, anos, com } = Astro.props;
const anosCartao = (y: Peca['y']) => (y ? (y[0] === y[1] ? String(y[0]) : `${y[0]}–${y[1]}`) : '');
---
<section class="vj" aria-labelledby="vj-titulo">
  <div class="moldura">
    <div class="vj-cx">
      <div class="vj-cabeca">
        <h2 class="vj-titulo" id="vj-titulo">Vai junto</h2>
        <p class="vj-sub">Do mesmo {carro}{anos && ` (${anos})`}: peças que costumam ser trocadas com {com}. Junte na sua lista e peça tudo de uma vez.</p>
      </div>
      <ul class="vj-lista" data-vj-raiz>
        {/* HTML curto (cada byte vai em 4 mil páginas): nome em <b>, anos e código em <small>, o código em <code> */}
        {pecas.map((x) => {
          const cod = codigoPeca(x.o);
          return (
            <li><a href={`/peca/${x.slug}.html`}><img src={capaPequena(capa(x, 'V'))} alt="" width="72" height="72" loading="lazy" /><b>{x.n}</b><small>{anosCartao(x.y)}{cod && <> · Cód. <code>{cod}</code></>}</small><span class="num">R$ {brl(x.p)}</span></a></li>
          );
        })}
      </ul>
    </div>
  </div>
</section>

{/* o "+ lista" de cada cartão é ligado pelo script do PecaTopo (ligarVaiJunto): um <script> a menos em 4 mil páginas */}

<style is:global>
  .vj { padding-block: 8px 40px; }
  .vj .vj-cx { display: grid; gap: 16px; padding: 20px 16px 16px; border-radius: 24px; background: var(--surface); box-shadow: inset 0 0 0 1px var(--line), var(--shadow-1); }
  .vj .vj-titulo { margin: 0; font-stretch: 84%; font-weight: 800; font-size: clamp(24px, 2.4vw, 30px); line-height: 1.05; }
  .vj .vj-sub { margin: 6px 0 0; font-size: 15px; line-height: 1.45; color: var(--ink-2); text-wrap: pretty; }
  .vj .vj-lista { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  /* cada peça: o cartão (link: capa + nome + anos/código + preço) e o "+ lista" no canto, irmãos (botão dentro de link
     quebra o HTML) */
  .vj .vj-lista > li { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) 44px; align-items: center; gap: 8px; min-height: 96px;
    padding: 10px 12px 10px 10px; border-radius: 16px; background: var(--surface); box-shadow: inset 0 0 0 1px var(--line); transition: box-shadow .2s; }
  .vj li > a { display: grid; grid-template-columns: 72px minmax(0, 1fr); grid-template-rows: auto auto auto; column-gap: 12px; align-items: start; align-content: center; min-width: 0; }
  /* o cartão inteiro é o alvo do link (a área de fora do botão) */
  .vj li > a::after { content: ""; position: absolute; inset: 0; border-radius: inherit; }
  .vj li > a:focus-visible { outline: none; box-shadow: none; }
  .vj li:has(> a:focus-visible) { outline: 3px solid var(--foco); outline-offset: 2px; }
  .vj li img { grid-row: 1 / 4; width: 72px; height: 72px; border-radius: 12px; object-fit: cover; background: linear-gradient(#f4f3f0, #e7e5e1); }
  .vj li b { margin-top: 1px; font-size: 15px; font-weight: 650; line-height: 1.25; color: var(--ink); overflow-wrap: anywhere;
    display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; line-clamp: 2; overflow: hidden; }
  .vj li small { margin-top: 3px; font-size: 12.5px; line-height: 1.3; color: var(--ink-3); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .vj li code { font-family: var(--font-mono); font-size: 11.5px; letter-spacing: .02em; color: var(--ink-2); }
  .vj li .num { align-self: end; margin-top: 4px; font-stretch: 86%; font-weight: 820; font-size: 18px; line-height: 1.1; color: var(--ink); }
  @media (hover: hover) {
    .vj li:hover { box-shadow: inset 0 0 0 1.5px var(--ink-3); }
    .vj li:hover b { text-decoration: underline; text-underline-offset: 3px; }
  }
  /* "+ lista": o mesmo ladrilho do botão da compra (laranja claro; verde quando já está na lista), acima do link */
  .vj .vj-add { position: relative; z-index: 1; display: grid; place-items: center; width: 44px; height: 44px; padding: 0; border: 0; border-radius: 12px;
    background: var(--accent-soft); color: var(--accent-text); box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--accent), transparent 74%);
    transition: background-color .2s, color .2s, transform .15s; -webkit-tap-highlight-color: transparent; }
  .vj .vj-add svg { width: 22px; height: 22px; }
  .vj .vj-add:hover { background: color-mix(in oklab, var(--accent-soft), var(--accent) 12%); }
  .vj .vj-add:active { transform: scale(.94); }
  .vj .vj-add.na-lista { color: var(--serve-ink); background: var(--serve-bg); box-shadow: inset 0 0 0 1px var(--serve-borda); animation: cl-ok .4s cubic-bezier(.3,1.5,.5,1); }
  @media (min-width: 600px) { .vj .vj-lista { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 960px) {
    .vj { padding-block: 0 56px; }
    .vj .vj-cx { grid-template-columns: minmax(0, 250px) minmax(0, 1fr); gap: 28px; align-items: center; padding: 26px 26px 26px 30px; }
    .vj .vj-lista { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  /* PC largo: as peças numa fila só (até 4) */
  @media (min-width: 1200px) {
    .vj .vj-cx { grid-template-columns: minmax(0, 1fr); gap: 18px; }
    .vj .vj-cabeca { display: flex; align-items: baseline; gap: 18px; }
    .vj .vj-sub { margin: 0; }
    .vj .vj-lista { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  @media (prefers-reduced-motion: reduce) { .vj .vj-add.na-lista { animation: none; } .vj li { transition: none; } }
</style>
