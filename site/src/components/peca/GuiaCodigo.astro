---
// "Como achar o código na sua peça velha": o código DESTA peça bem grande + onde procurar na peça velha
// + atalho para mandar a foto do código no WhatsApp.
// Estilos globais presos a .guia-codigo (sem o atributo de escopo em cada tag).
import Icone from '../Icone.astro';
import { whatsUrl } from '../../lib/dados';
interface Props { cod: string; titulo: string; url: string; }
const { cod, titulo, url } = Astro.props;
const msg = `Olá! Quero conferir se esta peça é igual à minha:\n${titulo}\n${url}\n\nVou mandar a foto do código da minha peça.`;
---
<section class="secao guia-codigo" id="como-achar-codigo" aria-labelledby="guia-codigo-titulo">
  <div class="moldura">
    <div class="gc-cartao">
      <div class="gc-codigo">
        <span class="gc-rot">Código desta peça</span>
        <b class="gc-num oem">{cod}</b>
        <p>Se a sua peça velha tem o mesmo código, é a mesma peça.</p>
      </div>
      <div class="gc-dicas">
        <h2 class="gc-titulo" id="guia-codigo-titulo">Como achar o código na sua peça velha</h2>
        <ol>
          <li><b>Procure a etiqueta</b> colada na carcaça. O código costuma ser a sequência maior de letras e números.</li>
          <li><b>Sem etiqueta?</b> Ele pode estar gravado em relevo no plástico ou estampado no metal. Limpe a sujeira e use a lanterna do celular.</li>
          <li><b>Ficou em dúvida?</b> Mande uma foto do código pelo botão abaixo.</li>
        </ol>
        <a class="botao botao-linha gc-botao" href={whatsUrl(msg)}><Icone nome="whats" />Mandar foto do código</a>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .guia-codigo { padding-top: 8px; scroll-margin-top: 90px; }
  .guia-codigo .gc-cartao { display: grid; gap: 0; border-radius: 22px; overflow: hidden; background: var(--surface); box-shadow: var(--shadow-1); }
  .guia-codigo .gc-codigo { padding: 26px 24px; background: var(--surface-2); display: flex; flex-direction: column; justify-content: center; gap: 8px; }
  .guia-codigo .gc-rot { font-size: 13.5px; font-weight: 650; color: var(--ink-2); }
  .guia-codigo .gc-num { font-size: clamp(30px, 6vw, 44px); font-weight: 700; letter-spacing: .02em; color: var(--ink); line-height: 1.05; overflow-wrap: anywhere; }
  .guia-codigo .gc-codigo p { margin: 0; font-size: 15px; line-height: 1.45; color: var(--ink-2); max-width: 30ch; }
  .guia-codigo .gc-dicas { padding: 26px 24px 28px; }
  .guia-codigo .gc-titulo { margin: 0 0 16px; font-size: clamp(24px, 2.4vw, 30px); font-weight: 800; font-stretch: 84%; line-height: 1.1; color: var(--ink); }
  /* números desenhados em disco laranja com letra grafite (o Tailwind zerava a lista: sobrava só o recuo) */
  .guia-codigo .gc-dicas ol { list-style: none; margin: 0 0 22px; padding: 0; display: grid; gap: 12px; counter-reset: dica; }
  .guia-codigo .gc-dicas li { position: relative; padding-left: 40px; font-size: 15.5px; line-height: 1.5; color: var(--ink-2); text-wrap: pretty; counter-increment: dica; }
  .guia-codigo .gc-dicas li::before { content: counter(dica); position: absolute; left: 0; top: -1px; width: 27px; height: 27px; border-radius: 50%;
                                      display: grid; place-items: center; background: var(--accent); color: var(--on-accent);
                                      font-size: 14px; font-weight: 800; line-height: 1; box-shadow: inset 0 1px 0 rgb(255 255 255 / .35); }
  .guia-codigo .gc-dicas li b { color: var(--ink); font-weight: 700; }
  .guia-codigo .gc-botao { display: inline-flex; gap: 8px; }
  @media (min-width: 820px) {
    .guia-codigo .gc-cartao { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
    .guia-codigo .gc-codigo { padding: 34px 34px; }
    .guia-codigo .gc-dicas { padding: 34px 38px 36px; }
  }
</style>
