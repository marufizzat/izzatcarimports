---
// "Tem o código gravado?": a etiqueta de exemplo (o código aparece como na peça) + a busca de verdade no catálogo
// (/catalogo.html?q=<código>). Usado na Garantia ("Evite a peça errada") e no Como comprar ("O código gravado").
import IconeInst from './IconeInst.astro';
import Icone from '../Icone.astro';
interface Props { id?: string; titulo?: string; texto?: string; class?: string }
const { id = 'h-codigo', titulo = 'Tem o código gravado?', texto = 'Digite o código da sua peça velha: aparecem as peças com o mesmo código.', class: cls } = Astro.props;
---
<form class:list={['bc', cls]} action="/catalogo.html" method="get" role="search" aria-labelledby={id}>
  <span class="bc-etiqueta" aria-hidden="true"><span class="bc-furo"></span>Cód. <span class="oem">95992471</span></span>
  <h3 class="bc-titulo" id={id}>{titulo}</h3>
  <p>{texto}</p>
  <div class="busca bc-campo">
    <IconeInst nome="lupa" />
    <input type="search" name="q" placeholder="Ex.: 95992471" aria-label="Código gravado na peça" autocomplete="off" autocapitalize="characters" spellcheck="false" enterkeyhint="search" required />
    <button class="botao botao-laranja botao-buscar" type="submit" aria-label="Buscar"><Icone nome="busca" /><span>Buscar</span></button>
  </div>
</form>
<style>
  .bc { min-width: 0; display: grid; gap: 10px; justify-items: start; padding: clamp(22px, 3vw, 32px); border-radius: 24px; background: var(--surface); box-shadow: var(--shadow-1); }
  .bc-etiqueta { position: relative; display: inline-flex; align-items: center; gap: 6px; padding: 9px 16px 9px 30px; border-radius: 8px 14px 14px 8px;
    background: var(--accent-soft); color: var(--ink); font-size: 14px; font-weight: 650; box-shadow: inset 0 0 0 1.5px color-mix(in oklab, var(--accent), transparent 55%); }
  .bc-etiqueta .oem { font-size: 15px; font-weight: 600; }
  .bc-furo { position: absolute; left: 11px; top: 50%; width: 9px; height: 9px; margin-top: -4.5px; border-radius: 50%; background: var(--surface); box-shadow: inset 0 1px 2px rgb(0 0 0 / .25); }
  .bc-titulo { margin: 8px 0 0; font-stretch: 80%; font-weight: 820; font-size: clamp(24px, 2.4vw, 30px); line-height: 1.05; text-wrap: balance; }
  .bc p { margin: 0; font-size: 16px; line-height: 1.5; color: var(--ink-2); text-wrap: pretty; }
  .bc-campo { width: 100%; height: 58px; margin-top: 8px; padding-left: 16px; border-radius: 14px; }
  .bc-campo > :global(svg) { width: 20px; height: 20px; color: var(--ink-3); flex: none; }
  .bc-campo input { width: 100%; min-width: 0; font-family: var(--font-mono); font-size: 16px; letter-spacing: .02em; }
  .bc-campo { padding-right: 5px; }
</style>
