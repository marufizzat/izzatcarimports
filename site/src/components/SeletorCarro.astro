---
// Cartao "Escolha o seu carro" da abertura: marca (logo) -> modelo -> ano, com contagem real de peças.
// O mesmo seletor abre na caixa do cabeçalho (ui/meuCarroPicker.ts). Monta quando o navegador esta ocioso.
---
<section class="mc-cartao mc-hero-cartao" aria-labelledby="mc-titulo-hero">
  <h2 class="mc-titulo" id="mc-titulo-hero">Escolha o seu carro</h2>
  <p class="mc-sub">Escolha uma vez e veja as peças dele em todo o site.</p>
  <div class="mc-raiz" data-mc-raiz data-hero>
    <p class="mc-aviso">Carregando os carros…</p>
  </div>
</section>
<script>
  import { montarPicker } from './ui/meuCarroPicker';
  const raiz = document.querySelector<HTMLElement>('[data-mc-raiz][data-hero]');
  const agendar = (f: () => void) => ('requestIdleCallback' in window ? window.requestIdleCallback(f) : window.setTimeout(f, 300));
  if (raiz) agendar(() => montarPicker(raiz));
</script>
