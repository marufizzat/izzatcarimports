---
// Marca -> modelo -> ano. Envia pro catalogo com os MESMOS parametros do site
// antigo (marca, modelo, ano), pra nenhum link de fora quebrar.
import { resumo } from '../lib/dados';
interface Props { compacto?: boolean; }
const { compacto = false } = Astro.props;
const marcas = resumo().marcas.filter((m) => m.c >= 5);
const dados = Object.fromEntries(marcas.map((m) => [m.n, m.m.map((x) => x.n)]));
const anoAtual = new Date().getFullYear() + 1;
const anos = Array.from({ length: anoAtual - 1994 }, (_, i) => anoAtual - i);
---
<form class:list={['seletor-carro', { compacto }]} action="/catalogo.html" method="get" data-seletor>
  <label class="seletor"><span>Marca</span>
    <select name="marca" data-marca>
      <option value="">Escolha</option>
      {marcas.map((m) => <option value={m.n}>{m.n}</option>)}
    </select>
  </label>
  <label class="seletor"><span>Modelo</span>
    <select name="modelo" data-modelo disabled><option value="">Escolha a marca</option></select>
  </label>
  <label class="seletor"><span>Ano</span>
    <select name="ano"><option value="">Qualquer</option>{anos.map((a) => <option value={a}>{a}</option>)}</select>
  </label>
  <button class="botao botao-grafite" type="submit">Ver peças</button>
  <script type="application/json" data-modelos set:html={JSON.stringify(dados)} />
</form>
<script>
  document.querySelectorAll<HTMLFormElement>('[data-seletor]').forEach((f) => {
    const dados = JSON.parse(f.querySelector('[data-modelos]')!.textContent || '{}');
    const marca = f.querySelector<HTMLSelectElement>('[data-marca]')!;
    const modelo = f.querySelector<HTMLSelectElement>('[data-modelo]')!;
    marca.addEventListener('change', () => {
      const lista: string[] = dados[marca.value] || [];
      modelo.innerHTML = '<option value="">' + (marca.value ? 'Todos os modelos' : 'Escolha a marca') + '</option>' +
        lista.map((m) => `<option value="${m}">${m}</option>`).join('');
      modelo.disabled = !marca.value;
    });
    f.addEventListener('submit', () => {
      f.querySelectorAll('select').forEach((s) => { if (!s.value) s.disabled = true; });
    });
  });
</script>
<style>
  .seletor-carro { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .seletor-carro .botao { height: 52px; }
  @media (min-width: 640px) {
    .seletor-carro { grid-template-columns: 1.1fr 1.1fr .8fr auto; }
    .seletor-carro .botao { grid-column: auto; }
  }
</style>
