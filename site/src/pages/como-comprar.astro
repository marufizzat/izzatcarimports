---
// Como comprar: os 4 passos, os dois jeitos de fechar (WhatsApp e Mercado Livre, este com a reputação da loja) e o
// código gravado (com a etiqueta de exemplo e a busca de verdade). A mensagem pronta aparece num só desenho: o cartão
// do WhatsApp, o mesmo da chamada final.
import Pagina from '../layouts/Pagina.astro';
import TopoArte from '../components/TopoArte.astro';
import Chamada from '../components/inst/Chamada.astro';
import CartaoWhats from '../components/inst/CartaoWhats.astro';
import BuscaCodigo from '../components/inst/BuscaCodigo.astro';
import IconeInst from '../components/inst/IconeInst.astro';
import Icone from '../components/Icone.astro';
import SeloReputacao from '../components/SeloReputacao.astro';
import BannerV2 from '../components/v2/BannerV2.astro';
import { whatsUrl, SITE } from '../lib/dados';

const canonical = `${SITE}/como-comprar.html`;
const canonicalPath = '/como-comprar.html';
const ML = 'https://www.mercadolivre.com.br/perfil/IZZAT_CAR_IMPORTS';
const msgConfere = 'Quero que vocês confiram uma peça. Meu carro é ____ (modelo) ____ (ano) e a peça é: ____';
const msgSite = 'Quero comprar uma peça. Pode me ajudar?';
const passos = [
  { src: '/arte/v2/passo-1.webp', alt: 'Ache a peça — Pelo nome, pelo carro ou pelo código gravado.' },
  { src: '/arte/v2/passo-2.webp', alt: 'Confirme o seu carro — Manda o modelo e o ano. A gente confere na peça.' },
  { src: '/arte/v2/passo-3.webp', alt: 'Feche a compra — No Mercado Livre ou direto pelo WhatsApp.' },
  { src: '/arte/v2/passo-4.webp', alt: 'Receba em casa — Com nota fiscal e código de rastreio.' },
];
---
<Pagina
  titulo="Como comprar peças originais | Izzat Car Imports"
  descricao="Em 4 passos: ache a peça, confirme o seu carro, feche a compra pelo Mercado Livre ou pelo WhatsApp e receba em casa com nota fiscal."
  canonical={canonical}
>
  <TopoArte trilha={[['Início', '/'], ['Como comprar', canonicalPath]]}
    titulo="Como comprar"
    lead="Quatro passos, do pedido até a peça na sua casa. Se preferir, a gente fecha tudo pelo WhatsApp." />

  <section class="moldura passos-wrap" aria-label="Os 4 passos">
    {/* no celular a fila desliza de lado: ganha parada no Tab só quando rola, como na home (lib/trilhoFoco.ts) */}
    <ol class="passos" aria-label="Como comprar, em 4 passos" data-rola>
      {passos.map((p, i) => (
        <li class="passo">
          <img src={p.src} alt={p.alt} width="800" height="800" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
        </li>
      ))}
    </ol>
  </section>
  {/* depois dos passos: o Maruf com o celular, o passo 2 ("confirme o seu carro") com rosto */}
  <div class="moldura">
    <BannerV2 formato="arte" nome="banner-como-comprar" href={whatsUrl(msgConfere)}
      texto="A gente confere. Manda o modelo e o ano. A gente confere na peça e responde com foto. Chamar no WhatsApp" />
  </div>

  <div class="moldura">
    <section class="inst-sec inst-duas" id="whatsapp" aria-labelledby="h-whatsapp">
      <div class="inst-texto">
        <h2 class="titulo-secao inst-h2" id="h-whatsapp">Comprar pelo WhatsApp</h2>
        <p>Mande a peça ou o carro no WhatsApp. A gente confirma se a peça serve no seu carro, passa o valor e combina o frete na hora, pelo seu CEP. A gente envia para todo o Brasil.</p>
        <p>A mensagem já abre pronta. Você só completa com o que precisa.</p>
        <div class="inst-acoes">
          <a class="botao botao-laranja inst-botao" href={whatsUrl(msgSite)} rel="noopener">
            <Icone nome="whats" />Chamar no WhatsApp
          </a>
        </div>
      </div>
      <CartaoWhats mensagem={msgSite} qr={false} class="cc-cartao" />
    </section>

    <section class="inst-sec inst-sec--linha inst-duas" id="mercado-livre" aria-labelledby="h-ml">
      <div class="inst-texto">
        <h2 class="titulo-secao inst-h2" id="h-ml">Comprar pelo Mercado Livre</h2>
        <p>As peças também estão na loja <b class="inst-quebra">IZZAT_CAR_IMPORTS</b> no Mercado Livre, com fotos e ficha técnica. Ali, o frete e o prazo são os calculados no anúncio.</p>
        <p>A compra segue a proteção do próprio Mercado Livre.</p>
      </div>
      <div class="inst-loja cc-loja">
        <span class="inst-disco inst-disco-g"><IconeInst nome="loja" /></span>
        <p class="inst-loja-nome"><small>Loja no Mercado Livre</small><b>IZZAT_CAR_IMPORTS</b></p>
        <SeloReputacao variante="compacto" />
        <a class="botao botao-linha inst-botao" href={ML} target="_blank" rel="noopener">Ver a loja no Mercado Livre</a>
      </div>
    </section>

    <section class="inst-sec inst-sec--linha" id="codigo" aria-labelledby="h-codigo-sec">
      <div class="inst-duas cc-codigo">
        <div class="inst-texto">
          <h2 class="titulo-secao inst-h2" id="h-codigo-sec">O código gravado na peça</h2>
          <p>Muitas peças originais trazem um código gravado ou impresso. Com ele, a gente acha a peça certa para o seu carro, sem chute.</p>
          <ol class="inst-numeros cc-numeros">
            <li>
              <div>
                <b>Pegue a peça velha</b>
                <p>Procure o código gravado ou impresso nela. São letras e números, às vezes numa etiqueta ou em relevo.</p>
              </div>
            </li>
            <li>
              <div>
                <b>Copie o código como está</b>
                <p>Letras e números, na mesma ordem. Se estiver difícil de ler, tire uma foto de perto.</p>
              </div>
            </li>
            <li>
              <div>
                <b>Busque ou mande pelo WhatsApp</b>
                <p>Pesquise o código no catálogo. Se não achar, mande a foto no WhatsApp e a gente confere.</p>
              </div>
            </li>
          </ol>
        </div>
        <BuscaCodigo id="h-codigo" titulo="Busque pelo código" texto="Digite o código da sua peça velha: aparecem as peças com o mesmo código." />
      </div>
    </section>
  </div>

  <Chamada
    id="h-chamada"
    titulo="Não sabe qual peça é?"
    texto="Mande o modelo, o ano e uma foto da peça no WhatsApp. A gente olha e responde por lá."
    mensagem="Não sei qual peça eu preciso. Meu carro é: ____ (modelo e ano)"
  />
</Pagina>

<script>
  import { paradaSeRolar } from '../lib/trilhoFoco';
  paradaSeRolar('[data-rola]');
</script>

<style>
  .passos-wrap { padding-block: clamp(8px, 2vw, 24px) clamp(40px, 6vw, 80px); }
  .passos {
    list-style: none; margin: 0 -16px; padding: 4px 16px 24px;
    display: grid; grid-auto-flow: column; grid-auto-columns: min(78vw, 320px); gap: 14px;
    overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; scroll-padding-inline: 16px;
    scrollbar-width: none;
  }
  .passos::-webkit-scrollbar { display: none; }
  .passo {
    scroll-snap-align: start; aspect-ratio: 1; border-radius: 20px; overflow: hidden;
    background: var(--surface-2); box-shadow: var(--shadow-1);
  }
  .passo img { width: 100%; height: 100%; object-fit: cover; }
  @media (min-width: 768px) {
    .passos { margin: 0; padding: 0; grid-auto-flow: row; grid-template-columns: repeat(2, 1fr); grid-auto-columns: auto; overflow: visible; gap: 20px; }
  }
  @media (min-width: 1024px) {
    .passos { grid-template-columns: repeat(4, 1fr); gap: 20px; }
  }
  .cc-cartao { width: 100%; max-width: 460px; justify-self: center; }
  @media (min-width: 900px) { .cc-cartao { justify-self: end; } }
  .cc-loja { width: 100%; max-width: 460px; justify-self: center; }
  @media (min-width: 900px) { .cc-loja { justify-self: end; } }
  @media (max-width: 600px) { .cc-loja .botao { width: 100%; } }
  .cc-codigo { align-items: start; }
  .cc-numeros { margin-top: 26px; }
</style>
