---
// Garantia e trocas: só o que o site já afirma (90 dias em toda peça, nota fiscal em toda venda, como acionar
// pelo WhatsApp, a gente avalia e resolve, proteção de compra do Mercado Livre, CDV nº 01060, com o link da lista
// oficial do Detran-RS, e o aviso contra golpe: o único WhatsApp é o do cadastro no Detran-RS). Sem "troca ou
// devolução" até o Maruf definir a regra (prazo, frete, compra errada): auditoria 4, item 3.2.
// Cada fato aparece UMA vez (antes o FAQ repetia a página palavra por palavra). Uma mensagem só para a garantia.
// FALTA O MARUF CONFIRMAR, antes de virar perguntas aqui: o que a garantia cobre e o que não cobre, a partir de
// quando conta o prazo, quem paga o frete da troca e em quantos dias a gente responde.
import Pagina from '../layouts/Pagina.astro';
import TopoArte from '../components/TopoArte.astro';
import Chamada from '../components/inst/Chamada.astro';
import IconeInst from '../components/inst/IconeInst.astro';
import BuscaCodigo from '../components/inst/BuscaCodigo.astro';
import Icone from '../components/Icone.astro';
import SeloReputacao from '../components/SeloReputacao.astro';
import BannerV2 from '../components/v2/BannerV2.astro';
import { whatsUrl, SITE, DETRAN_CDV } from '../lib/dados';

const canonical = `${SITE}/garantia.html`;
const canonicalPath = '/garantia.html';
const msgBanner = 'Quero uma peça original com nota fiscal e garantia. Meu carro é ____ (modelo e ano) e a peça é: ____';
const msgGarantia = 'Comprei uma peça e preciso de ajuda com a garantia. Número do pedido: ';
const passos = [
  { i: 'conversa', t: 'Chame no WhatsApp', s: 'Dentro do prazo de garantia. Informe o número do pedido e o que aconteceu com a peça.' },
  { i: 'camera', t: 'Mande fotos', s: 'Fotos da peça, mostrando o problema. Se tiver, inclua também a etiqueta ou o código gravado.' },
  { i: 'troca', t: 'A gente resolve', s: 'Em 90 dias, fale no WhatsApp com o número do pedido que a gente avalia e resolve.' },
];
---
<Pagina
  titulo="Garantia e trocas | Izzat Car Imports"
  descricao="90 dias de garantia em toda peça e nota fiscal em toda venda. Se algo der errado, fale pelo WhatsApp com o número do pedido que a gente avalia e resolve."
  canonical={canonical}
>
  <TopoArte trilha={[['Início', '/'], ['Garantia e trocas', canonicalPath]]}
    titulo="Garantia e trocas"
    lead="O que vale para toda peça que sai do pátio e o que fazer se ela der problema."
    arte="/arte/v2/topo-garantia.webp" />

  <div class="moldura">
    {/* certificado: o prazo grande e os três fatos que sustentam a garantia */}
    <section class="gar-cert" aria-labelledby="h-prazo">
      <div class="gar-cert-prazo">
        <p class="gar-cert-num display" aria-hidden="true">90<span>dias</span></p>
        <h2 class="gar-cert-titulo" id="h-prazo">de garantia em toda peça</h2>
      </div>
      <ul class="gar-cert-fatos">
        <li><span class="inst-disco"><IconeInst nome="nota" /></span><span><b>Nota fiscal em toda venda</b>Toda compra sai com nota fiscal, para você guardar.</span></li>
        <li><span class="inst-disco"><IconeInst nome="carro" /></span><span><b>Peça original</b>Vem de carro com baixa legal, conferida e fotografada no pátio.</span></li>
        <li><span class="inst-disco"><IconeInst nome="escudo" /></span><span><b>Desmanche credenciado</b>Detran-RS, CDV&nbsp;nº&nbsp;01060.
          <a class="gar-detran" href={DETRAN_CDV} target="_blank" rel="noopener">Confira na lista do Detran-RS<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg></a></span></li>
        {/* contra golpe com o nome do desmanche (o Detran-RS alerta): o número do site é o mesmo da lista oficial */}
        <li><span class="inst-disco"><IconeInst nome="conversa" /></span><span><b>WhatsApp oficial</b>O nosso é o <span class="num gar-fone">(53) 99117-0950</span>, o mesmo do cadastro no Detran-RS. Desconfie de outro número.</span></li>
      </ul>
    </section>

    {/* o Maruf mostrando a peça: a garantia com rosto, logo depois do certificado dos 90 dias */}
    <div class="gar-banner">
      <BannerV2 formato="arte" nome="banner-garantia" href={whatsUrl(msgBanner)}
        texto="Peça original, conferida. Com nota fiscal e 90 dias de garantia. Chamar no WhatsApp" />
    </div>

    <section class="inst-sec" aria-labelledby="h-problema">
      <div class="gar-cabeca">
        <div>
          <h2 class="titulo-secao inst-h2" id="h-problema">Se a peça der problema</h2>
          <p class="inst-lead-sec">Fale com a gente dentro do prazo. Quanto mais fotos e detalhes você mandar, mais rápido a gente resolve.</p>
        </div>
        <a class="botao botao-laranja inst-botao" href={whatsUrl(msgGarantia)} rel="noopener">
          <Icone nome="whats" />Chamar no WhatsApp
        </a>
      </div>
      <ol class="inst-trilho">
        {passos.map((p) => (
          <li><span class="inst-disco inst-disco-g"><IconeInst nome={p.i} /></span><b>{p.t}</b><p>{p.s}</p></li>
        ))}
      </ol>
    </section>

    <section class="inst-sec inst-sec--linha inst-duas gar-evitar" aria-labelledby="h-evitar">
      <div class="inst-texto">
        <h2 class="titulo-secao inst-h2" id="h-evitar">Evite a peça errada</h2>
        <p>Antes de fechar a compra, confira estes pontos. Assim a peça chega certa na primeira vez.</p>
        <ul class="inst-lista">
          <li><Icone nome="check" /><span>Confirme o <b>modelo, o ano e o motor</b> do seu carro antes de comprar.</span></li>
          <li><Icone nome="check" /><span>Compare o <b>código gravado</b> da sua peça velha com o código da página da peça.</span></li>
          <li><Icone nome="check" /><span>Veja as fotos e a ficha técnica na página da peça.</span></li>
        </ul>
      </div>
      <BuscaCodigo />
    </section>

    <section class="gar-ml" aria-labelledby="h-ml">
      <span class="inst-disco inst-disco-g"><IconeInst nome="loja" /></span>
      <div class="gar-ml-texto">
        <h2 class="gar-ml-titulo" id="h-ml">Comprou pelo Mercado Livre?</h2>
        <p>Quem comprou pelo Mercado Livre também tem a proteção de compra do próprio Mercado Livre, pelas regras da plataforma.</p>
      </div>
      <div class="gar-ml-lado">
        <div class="gar-ml-selo"><SeloReputacao variante="compacto" /></div>
        <a class="botao botao-linha" href="https://www.mercadolivre.com.br/perfil/IZZAT_CAR_IMPORTS" target="_blank" rel="noopener">Ver a loja no Mercado Livre</a>
      </div>
    </section>
  </div>

  {/* fim: a ação de ANTES da compra (a de depois já está em "Se a peça der problema") */}
  <Chamada
    id="h-chamada"
    titulo="Na dúvida, a gente confere antes"
    texto="Mande o carro e o código gravado da peça no WhatsApp antes de fechar. A gente confere no pátio e responde por lá."
    mensagem="Antes de comprar, quero confirmar se uma peça serve no meu carro. Meu carro é: ____"
  />
</Pagina>

<style>
  .gar-banner { margin-top: clamp(28px, 4vw, 48px); }
  /* certificado */
  .gar-cert { position: relative; display: grid; gap: 0; margin-top: clamp(28px, 4vw, 48px); border-radius: 28px; background: var(--surface); box-shadow: var(--shadow-1); overflow: hidden; }
  .gar-cert::before { content: ""; position: absolute; inset: 0 0 auto 0; height: 5px; background: linear-gradient(90deg, transparent, var(--accent) 20%, var(--accent) 80%, transparent); }
  .gar-cert-prazo { display: grid; gap: 6px; align-content: center; padding: var(--pad-cartao); }
  .gar-cert-num { margin: 0; display: flex; align-items: baseline; gap: 10px; font-size: clamp(96px, 13vw, 168px); line-height: .82; color: var(--ink); }
  .gar-cert-num span { font-size: .34em; letter-spacing: 0; }
  .gar-cert-titulo { margin: 4px 0 0; font-stretch: 80%; font-weight: 820; font-size: clamp(24px, 2.6vw, 34px); line-height: 1.05; text-wrap: balance; }
  .gar-cert-fatos { list-style: none; margin: 0; padding: var(--pad-cartao); display: grid; gap: 20px; align-content: center;
    border-top: 1.5px dashed var(--line-2); background: var(--surface-2); }
  .gar-cert-fatos li { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 14px; align-items: start; font-size: 15.5px; line-height: 1.5; color: var(--ink-2); }
  .gar-cert-fatos b { display: block; color: var(--ink); font-size: 17px; font-weight: 700; line-height: 1.3; }
  .gar-detran { display: inline-block; margin-top: 6px; padding-block: 2px 4px; font-weight: 650; color: var(--ink);
    text-decoration: underline; text-decoration-color: var(--line-2); text-underline-offset: 3px; }
  .gar-detran:hover { text-decoration-color: currentColor; }
  .gar-detran svg { display: inline-block; width: 15px; height: 15px; margin-left: 3px; vertical-align: -2px; fill: none; stroke: currentColor;
    stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
  .gar-fone { font-weight: 700; color: var(--ink); white-space: nowrap; }
  @media (min-width: 900px) {
    .gar-cert { grid-template-columns: 1fr 1fr; }
    .gar-cert-fatos { border-top: 0; border-left: 1.5px dashed var(--line-2); }
  }

  .gar-cabeca { display: grid; gap: 18px; margin-bottom: clamp(24px, 3vw, 36px); }
  .gar-cabeca .inst-h2 { margin-bottom: 10px; }
  @media (min-width: 900px) { .gar-cabeca { grid-template-columns: 1fr auto; align-items: end; gap: 40px; } }
  @media (max-width: 600px) { .gar-cabeca .botao { width: 100%; } }

  .gar-evitar { align-items: start; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 900px) { .gar-evitar { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } }

  /* Mercado Livre: cartão baixo, texto no meio e a loja do lado; fecha a página com respiro antes da chamada */
  .gar-ml { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 16px 20px; align-items: start; margin-block: clamp(8px, 2vw, 16px) clamp(32px, 5vw, 64px);
    padding: var(--pad-cartao); border-radius: 26px; background: var(--surface); box-shadow: var(--shadow-1); }
  .gar-ml-titulo { margin: 0 0 6px; font-stretch: 80%; font-weight: 820; font-size: clamp(24px, 2.4vw, 30px); line-height: 1.05; text-wrap: balance; }
  .gar-ml-texto p { margin: 0; max-width: 62ch; font-size: 16px; line-height: 1.55; color: var(--ink-2); }
  .gar-ml-lado { grid-column: 1 / -1; display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
  .gar-ml-selo:empty { display: none; }
  @media (min-width: 960px) {
    .gar-ml { grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; }
    .gar-ml-lado { grid-column: auto; flex-direction: column; align-items: flex-end; }
  }
  @media (max-width: 600px) { .gar-ml-lado .botao { width: 100%; } }
</style>
