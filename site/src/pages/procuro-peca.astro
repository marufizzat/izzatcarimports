---
// "Não achou a peça?": o formulário na PRIMEIRA tela. PC: título e dicas à esquerda, formulário à direita.
// Celular: título, formulário e só depois as dicas. Obrigatórios só marca, modelo, ano e peça; o modelo
// sugere os da marca escolhida (também com "VW", "GM", "Mercedes" ou o começo do nome) e, se a pessoa já salvou
// o "Meu carro", o carro vem preenchido. No fim do formulário: "Avise-me quando chegar peça para o meu <carro>"
// (WhatsApp com a mensagem pronta, sem prometer prazo).
import Pagina from '../layouts/Pagina.astro';
import Icone from '../components/Icone.astro';
import { WHATS, SITE, resumo } from '../lib/dados';
import { linkAviso } from '../lib/aviso';

const canonical = `${SITE}/procuro-peca.html`;
const marcas = resumo().marcas;
const modelosPorMarca = Object.fromEntries(marcas.map((m) => [m.n, m.m.map((x) => x.n)]));
const trilha: [string, string][] = [['Início', '/'], ['Não achou a peça?', '/procuro-peca.html']];
const ld = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: trilha.map(([n, h], i) => ({ '@type': 'ListItem', position: i + 1, name: n, item: `${SITE}${h}` })) };
---
<Pagina
  titulo="Não achou a peça? A gente procura | Izzat Car Imports"
  descricao="Não achou a peça no site? Conte a marca, o modelo, o ano e a peça. A gente procura no pátio e responde pelo WhatsApp."
  canonical={canonical}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(ld)} />

  <div class="moldura pc-pagina">
    <nav class="pc-trilha" aria-label="Você está em">
      <a href="/">Início</a><span aria-hidden="true">/</span><span aria-current="page">Não achou a peça?</span>
    </nav>

    <div class="pc-grade">
      <div class="pc-intro">
        <h1 class="display pc-h1">Não achou a peça?</h1>
        <p class="lead pc-lead">Nem toda peça está anunciada. Conte o carro e a peça no formulário.</p>
      </div>

      <form class="pc-form" id="form-procuro" novalidate data-whats={WHATS} data-modelos={JSON.stringify(modelosPorMarca)} aria-describedby="pc-nota">
        <div class="pc-form-topo">
          <img class="pc-rosto" src="/arte/v2/atendimento-rosto.webp" alt="" width="192" height="192" fetchpriority="low" decoding="async" />
          <p><b>A gente procura no pátio</b><span>e responde pelo WhatsApp, com foto.</span></p>
        </div>

        <p class="pc-salvo" id="pc-salvo" hidden></p>

        <fieldset class="pc-grupo">
          <legend>O carro</legend>
          <div class="pc-campos pc-campos-carro">
            <div class="campo">
              <label for="f-marca">Marca</label>
              <input id="f-marca" name="marca" type="text" list="lista-marcas" autocomplete="off" placeholder="Ex.: Volkswagen" required aria-describedby="e-marca" />
              <p class="erro" id="e-marca" hidden></p>
            </div>
            <div class="campo">
              <label for="f-modelo">Modelo</label>
              <input id="f-modelo" name="modelo" type="text" list="lista-modelos" autocomplete="off" placeholder="Ex.: Gol" required aria-describedby="e-modelo" />
              <p class="erro" id="e-modelo" hidden></p>
            </div>
            <div class="campo">
              <label for="f-ano">Ano</label>
              <input id="f-ano" name="ano" type="text" inputmode="numeric" autocomplete="off" placeholder="Ex.: 2015" required aria-describedby="e-ano" />
              <p class="erro" id="e-ano" hidden></p>
            </div>
          </div>
        </fieldset>

        <fieldset class="pc-grupo">
          <legend>A peça</legend>
          <div class="pc-campos pc-campos-2">
            <div class="campo pc-largo">
              <label for="f-peca">Qual peça você procura?</label>
              <input id="f-peca" name="peca" type="text" autocomplete="off" placeholder="Ex.: farol dianteiro esquerdo" required aria-describedby="e-peca" />
              <p class="erro" id="e-peca" hidden></p>
            </div>
            <div class="campo">
              <label for="f-codigo">Código gravado <span class="opc">(opcional)</span></label>
              <input id="f-codigo" name="codigo" type="text" autocomplete="off" placeholder="Se tiver, copie da peça" />
            </div>
            <div class="campo">
              <label for="f-cidade">Cidade e estado <span class="opc">(opcional)</span></label>
              <input id="f-cidade" name="cidade" type="text" autocomplete="address-level2" placeholder="Ex.: Pelotas/RS" />
            </div>
          </div>
        </fieldset>

        <datalist id="lista-marcas">{marcas.map((m) => <option value={m.n} />)}</datalist>
        <datalist id="lista-modelos"></datalist>

        <div class="pc-acao">
          <button type="submit" class="botao botao-laranja pc-enviar"><Icone nome="whats" />Enviar pelo WhatsApp</button>
          <p class="pc-nota" id="pc-nota">O WhatsApp abre com tudo preenchido. Você confere e envia por lá.</p>
          <p class="pc-status" role="status" aria-live="polite" id="pc-status"></p>
        </div>

        <div class="pc-aviso">
          <p>Quer saber quando chegar peça do seu carro no pátio?</p>
          <a class="botao botao-linha pc-aviso-botao" href={linkAviso(WHATS, 'carro')} rel="noopener" data-aviso>
            <Icone nome="whats" /><span>Me avise quando chegar peça</span>
          </a>
          <p class="pc-aviso-erro" id="pc-aviso-erro" role="status" aria-live="polite" hidden>Preencha a marca e o modelo do carro para a gente saber qual é.</p>
        </div>
      </form>

      <aside class="pc-dicas" aria-labelledby="h-dicas">
        <h2 class="pc-dicas-titulo" id="h-dicas">O que ajuda a gente</h2>
        <ul class="pc-lista">
          <li><Icone nome="check" /><span><b>Marca, modelo e ano</b> do carro.</span></li>
          <li><Icone nome="check" /><span><b>A peça</b>, como você fala. Por exemplo, farol, retrovisor ou caixa de câmbio.</span></li>
          <li><Icone nome="check" /><span><b>O código gravado</b>, se você tiver. É o jeito mais certo de achar.</span></li>
          <li><Icone nome="check" /><span><b>Cidade e estado</b>, para a gente combinar o envio.</span></li>
        </ul>
        <p class="pc-dica">Uma foto da peça velha também ajuda muito. Mande depois, pelo WhatsApp.</p>
      </aside>
    </div>
  </div>
</Pagina>

<script>
  import { lerMeuCarro, norm, EVENTO } from '../lib/meuCarro';
  import { linkAviso } from '../lib/aviso';
  import { mensagem, linkWhats } from '../lib/whats';

  const form = document.getElementById('form-procuro') as HTMLFormElement | null;
  const status = document.getElementById('pc-status');

  const regras: Record<string, { ok: (v: string) => boolean; msg: string }> = {
    marca: { ok: (v) => v.trim().length >= 2, msg: 'Informe a marca do carro, por exemplo Volkswagen.' },
    modelo: { ok: (v) => v.trim().length >= 1, msg: 'Falta o modelo. Por exemplo, Gol ou Polo.' },
    ano: {
      ok: (v) => {
        const m = v.trim().match(/^(\d{4})(?:\s*[\/-]\s*(\d{4}))?$/);
        if (!m) return false;
        const anos = [Number(m[1]), Number(m[2] ?? m[1])];
        return anos.every((a) => a >= 1950 && a <= 2030);
      },
      msg: 'Use o ano com 4 números, por exemplo 2015 ou 2015/2018.',
    },
    peca: { ok: (v) => v.trim().length >= 3, msg: 'Escreva qual peça você procura.' },
  };

  if (form && status) {
    const campos = Object.keys(regras);
    const campo = (nome: string) => form.elements.namedItem(nome) as HTMLInputElement;

    // modelos da marca digitada (sugestões do campo Modelo). Vale o nome inteiro, um apelido (VW, GM, Chevy, MB)
    // ou o começo do nome com 3+ letras ("Mercedes", "Land", "Citroen"). Empate no começo: a marca com mais peças.
    const modelos: Record<string, string[]> = JSON.parse(form.dataset.modelos || '{}');
    const APELIDOS: Record<string, string> = { vw: 'volkswagen', gm: 'chevrolet', chevy: 'chevrolet', mb: 'mercedesbenz', benz: 'mercedesbenz' };
    const marcaDe = (texto: string): string | undefined => {
      const t = norm(texto);
      if (!t) return undefined;
      const alvo = APELIDOS[t] ?? t;
      const nomes = Object.keys(modelos);
      return nomes.find((m) => norm(m) === alvo) ?? (alvo.length >= 3 ? nomes.find((m) => norm(m).startsWith(alvo)) : undefined);
    };
    const lista = document.getElementById('lista-modelos');
    const sugerirModelos = () => {
      const marca = marcaDe(campo('marca').value);
      lista?.replaceChildren(...(marca ? modelos[marca] : []).map((m) => Object.assign(document.createElement('option'), { value: m })));
    };
    campo('marca').addEventListener('input', sugerirModelos);

    // "Me avise quando chegar peça": o link (a mensagem do WhatsApp) acompanha o carro dos campos. O ano vem do campo;
    // sem ano no campo, o do "Meu carro" salvo, só se for o MESMO carro. O rótulo fica curto e fixo: com o carro ele
    // quebrava em 2 linhas no celular (57 px, fora das 2 alturas de botão).
    const aviso = form.querySelector<HTMLAnchorElement>('[data-aviso]');
    const avisoErro = document.getElementById('pc-aviso-erro');
    const carroDoForm = () => {
      const marcaTxt = campo('marca').value.trim();
      const modelo = campo('modelo').value.trim();
      if (marcaTxt.length < 2 || !modelo) return null;
      const marca = marcaDe(marcaTxt) ?? marcaTxt;
      const anoCampo = campo('ano').value.trim();
      const salvo = lerMeuCarro();
      const mesmo = !!salvo && norm(salvo.b) === norm(marca) && norm(salvo.m) === norm(modelo);
      const ano = regras.ano.ok(anoCampo) ? anoCampo : mesmo && salvo!.y ? String(salvo!.y) : '';
      return { nome: `${marca} ${modelo}`, ano };
    };
    const pintarAviso = () => {
      if (!aviso) return;
      const c = carroDoForm();
      aviso.href = linkAviso(form.dataset.whats || '', c ? c.nome : 'carro', c ? c.ano : null);
      if (c && avisoErro) avisoErro.hidden = true;
    };
    ['marca', 'modelo', 'ano'].forEach((n) => { campo(n).addEventListener('input', pintarAviso); campo(n).addEventListener('change', pintarAviso); });
    window.addEventListener(EVENTO, pintarAviso);
    aviso?.addEventListener('click', (e) => {
      if (carroDoForm()) return; // link de verdade: o WhatsApp abre com a mensagem pronta
      e.preventDefault();
      checar('marca', true);
      checar('modelo', true);
      if (avisoErro) avisoErro.hidden = false;
      (regras.marca.ok(campo('marca').value) ? campo('modelo') : campo('marca')).focus();
    });

    // vindo da busca do catálogo ("Não achou? A gente procura no pátio"): ?q=retrovisor+direito&carro=Volvo+XC60+2019
    // preenche a peça (ou o código gravado) e o carro. O endereço vale mais que o carro salvo.
    const u = new URLSearchParams(location.search);
    const qUrl = (u.get('q') || '').replace(/\s+/g, ' ').trim().slice(0, 120);
    const carroUrl = (u.get('carro') || '').replace(/\s+/g, ' ').trim().slice(0, 80);
    let daBusca = '';
    if (qUrl) {
      // código gravado ("8200 328 856", "A044297"): vai no campo do código; o resto, no da peça
      const codigo = /^[a-z0-9][a-z0-9 .\-\/]{4,}$/i.test(qUrl) && (qUrl.match(/\d/g) ?? []).length >= 5 && !/[a-z]{4,}/i.test(qUrl);
      campo(codigo ? 'codigo' : 'peca').value = codigo ? qUrl.toUpperCase() : qUrl;
      daBusca = codigo ? `o código ${qUrl.toUpperCase()}` : `“${qUrl}”`;
    }
    if (carroUrl) {
      const ano = carroUrl.match(/\s((?:19[5-9]|20[0-3])\d)$/)?.[1];
      const ws = (ano ? carroUrl.slice(0, -ano.length) : carroUrl).trim().split(' ');
      // a marca: o começo mais longo que é o nome de uma marca do site ("Land Rover Discovery" -> Land Rover)
      let k = 1;
      let marca = ws[0];
      for (let n = Math.min(3, ws.length - 1); n >= 1; n--) {
        const m = marcaDe(ws.slice(0, n).join(' '));
        if (m && norm(m) === norm(ws.slice(0, n).join(' '))) { k = n; marca = m; break; }
      }
      campo('marca').value = marca;
      campo('modelo').value = ws.slice(k).join(' ');
      const salvo = lerMeuCarro();
      const anoSalvo = salvo && norm(salvo.b) === norm(marca) && norm(salvo.m) === norm(campo('modelo').value) ? salvo.y : null;
      if (ano || anoSalvo) campo('ano').value = String(ano || anoSalvo);
      sugerirModelos();
    }

    // quem já salvou o "Meu carro" não precisa digitar de novo
    const c = lerMeuCarro();
    let carroTexto = carroUrl;
    let doSalvo = false;
    if (c && !campo('marca').value && !campo('modelo').value) {
      campo('marca').value = c.b;
      campo('modelo').value = c.m;
      if (c.y) campo('ano').value = String(c.y);
      sugerirModelos();
      carroTexto = `${c.b} ${c.m}${c.y ? ' ' + c.y : ''}`;
      doSalvo = true;
    }
    const nota = document.getElementById('pc-salvo');
    if (nota && (daBusca || carroUrl)) {
      nota.textContent = `Já preenchemos com a sua busca: ${[daBusca, carroTexto && `para ${carroTexto}`].filter(Boolean).join(' ')}. Se precisar, é só trocar.`;
      nota.hidden = false;
    } else if (nota && doSalvo) {
      nota.textContent = `Já preenchemos com o seu carro: ${carroTexto}. Se for outro, é só trocar.`;
      nota.hidden = false;
    }
    pintarAviso();

    const checar = (nome: string, mostrar: boolean) => {
      const el = campo(nome);
      const erro = document.getElementById('e-' + nome);
      if (!el || !erro) return true;
      const ok = regras[nome].ok(el.value);
      el.setAttribute('aria-invalid', ok ? 'false' : 'true');
      if (mostrar || !erro.hidden) {
        erro.textContent = ok ? '' : regras[nome].msg;
        erro.hidden = ok;
      }
      return ok;
    };

    campos.forEach((nome) => {
      const el = campo(nome);
      el.addEventListener('input', () => checar(nome, false));
      el.addEventListener('change', () => checar(nome, false));
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      let primeiro: HTMLElement | null = null;
      campos.forEach((nome) => {
        if (!checar(nome, true) && !primeiro) primeiro = campo(nome);
      });
      if (primeiro) {
        status.textContent = '';
        (primeiro as HTMLElement).focus();
        return;
      }

      const v = (nome: string) => (campo(nome).value || '').trim();
      const linhas = [mensagem('Procuro uma peça:'), '', `Carro: ${v('marca')} ${v('modelo')} ${v('ano')}`, `Peça: ${v('peca')}`];
      if (v('codigo')) linhas.push(`Código gravado: ${v('codigo')}`);
      if (v('cidade')) linhas.push(`Cidade: ${v('cidade')}`);
      const url = linkWhats(linhas.join('\n'));

      // link de verdade: o clique preserva o gesto e a rastreio.js conta o Contact
      const a = document.createElement('a');
      a.href = url;
      a.target = '_blank';
      a.rel = 'noopener';
      document.body.appendChild(a);
      a.click();
      a.remove();

      status.textContent = 'A gente abriu o WhatsApp com a sua busca. Se não abriu, ';
      const link = document.createElement('a');
      link.href = url;
      link.target = '_blank';
      link.rel = 'noopener';
      link.textContent = 'toque aqui';
      status.appendChild(link);
      status.appendChild(document.createTextNode('.'));
    });
  }
</script>

<style>
  .pc-pagina { padding-block: 14px clamp(56px, 8vw, 112px); }
  .pc-trilha { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 8px; margin-bottom: clamp(14px, 2vw, 22px); font-size: 13.5px; color: var(--ink-3); }
  .pc-trilha a { color: var(--ink-2); padding: 12px 6px; margin: -6px -6px; }
  .pc-trilha a:hover { color: var(--ink); text-decoration: underline; }

  /* celular: título, formulário, dicas. PC: título e dicas à esquerda, formulário à direita */
  .pc-grade { display: grid; gap: 22px; grid-template-areas: "intro" "form" "dicas"; }
  .pc-intro { grid-area: intro; display: grid; gap: 12px; align-content: start; }
  .pc-form { grid-area: form; }
  .pc-dicas { grid-area: dicas; }
  @media (min-width: 960px) {
    .pc-grade { grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); grid-template-areas: "intro form" "dicas form";
                grid-template-rows: auto 1fr; column-gap: clamp(40px, 5vw, 72px); row-gap: 32px; align-items: start; }
    .pc-intro { padding-top: 18px; }
  }
  .pc-h1 { margin: 0; font-size: var(--h1-pagina); }
  .pc-lead { margin: 0; max-width: 40ch; }

  /* formulário em cartão */
  .pc-form { display: grid; gap: 24px; padding: clamp(20px, 3vw, 34px); border-radius: 28px; background: var(--surface); box-shadow: var(--shadow-2); min-width: 0; }
  .pc-form-topo { display: flex; align-items: center; gap: 14px; padding-bottom: 20px; border-bottom: 1px solid var(--line); }
  .pc-rosto { flex: none; width: 56px; height: 56px; border-radius: 50%; object-fit: cover; background: #efeeeb;
              box-shadow: 0 0 0 3px var(--surface), 0 0 0 5px var(--accent); }
  .pc-form-topo p { margin: 0; display: grid; gap: 1px; }
  .pc-form-topo b { font-stretch: 86%; font-weight: 800; font-size: clamp(19px, 1.8vw, 22px); line-height: 1.15; color: var(--ink); }
  .pc-form-topo span { font-size: 15px; color: var(--ink-2); text-wrap: balance; }
  .pc-salvo { margin: -6px 0 0; padding: 12px 14px; border-radius: 14px; background: var(--accent-soft); font-size: 14.5px; line-height: 1.45; color: var(--ink); }
  .pc-salvo[hidden] { display: none; }

  .pc-grupo { margin: 0; padding: 0; border: 0; min-width: 0; }
  .pc-grupo legend { padding: 0; margin-bottom: 12px; font-stretch: 80%; font-weight: 820; font-size: 21px; line-height: 1.1; color: var(--ink); }
  .pc-campos { display: grid; gap: 14px; }
  .pc-campos-carro { grid-template-columns: 1fr 1fr; }
  .pc-campos-carro > .campo:first-child { grid-column: 1 / -1; }
  @media (min-width: 520px) { .pc-campos-carro { grid-template-columns: 1.15fr 1fr .8fr; } .pc-campos-carro > .campo:first-child { grid-column: auto; } }
  .pc-campos-2 { grid-template-columns: 1fr; }
  @media (min-width: 520px) { .pc-campos-2 { grid-template-columns: 1fr 1fr; } .pc-campos-2 > .pc-largo { grid-column: 1 / -1; } }

  /* campos: estilo comum no global.css (.campo), com o foco visível também no campo com erro */

  .pc-acao { display: grid; gap: 12px; justify-items: start; }
  .pc-enviar { min-height: var(--h); height: auto; padding: 14px 26px; font-size: 17px; }
  @media (max-width: 600px) { .pc-enviar { width: 100%; } }
  .pc-nota { margin: 0; font-size: 14.5px; line-height: 1.5; color: var(--ink-3); max-width: 46ch; }
  .pc-status { margin: 0; font-size: 15px; line-height: 1.5; color: var(--ink-2); overflow-wrap: anywhere; }
  .pc-status:empty { display: none; }
  .pc-status a { color: var(--accent-text); font-weight: 650; text-decoration: underline; text-underline-offset: 3px; }

  /* "Avise-me quando chegar peça": discreto, no fim do formulário */
  .pc-aviso { display: grid; gap: 10px; justify-items: start; padding-top: 20px; border-top: 1px solid var(--line); }
  .pc-aviso p { margin: 0; font-size: 15px; line-height: 1.45; color: var(--ink-2); }
  .pc-aviso-botao { --h: var(--botao-p); height: auto; min-height: var(--h); padding: 9px 16px; font-size: 15px; white-space: normal; text-align: left; line-height: 1.3; max-width: 100%; }
  .pc-aviso-botao :global(svg) { width: 19px; height: 19px; }
  @media (max-width: 600px) { .pc-aviso-botao { width: 100%; justify-content: flex-start; } }
  .pc-aviso .pc-aviso-erro { font-size: 14px; font-weight: 580; color: var(--accent-text); }
  .pc-aviso-erro[hidden] { display: none; }

  /* dicas */
  .pc-dicas { display: grid; gap: 16px; align-content: start; }
  .pc-dicas-titulo { margin: 0; font-stretch: 80%; font-weight: 820; font-size: clamp(22px, 2.2vw, 26px); line-height: 1.1; }
  .pc-lista { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .pc-lista li { display: flex; gap: 12px; align-items: flex-start; font-size: 16px; line-height: 1.5; color: var(--ink-2); }
  .pc-lista :global(svg) { width: 22px; height: 22px; flex: none; margin-top: 2px; color: var(--accent-text); }
  .pc-lista b { color: var(--ink); font-weight: 650; }
  .pc-dica { margin: 0; padding: 16px 18px; border-radius: 18px; background: var(--accent-soft); color: var(--ink); font-size: 15px; line-height: 1.5; }
</style>
