---
import Pagina from '../layouts/Pagina.astro';
import TopoArte from '../components/TopoArte.astro';
import Chamada from '../components/inst/Chamada.astro';
import Icone from '../components/Icone.astro';
import SeloCDV from '../components/SeloCDV.astro';
import { SITE } from '../lib/dados';
import { existsSync } from 'node:fs';
import { join } from 'node:path';

// arte do troféu (orquestrador entrega em /arte/v2/destaque-acegua.webp): só aparece se o arquivo existir
const temTrofeu = existsSync(join(process.cwd(), 'public', 'arte', 'v2', 'destaque-acegua.webp'));

const canonical = `${SITE}/sobre.html`;
const canonicalPath = '/sobre.html';
const historia = [
  { n: 1, t: 'Chega com baixa legal', s: 'O carro entra com a baixa feita, dentro da lei.', alt: 'Carro chegando ao pátio, com a documentação de baixa sobre um pedestal' },
  { n: 2, t: 'É desmontado com calma', s: 'Peça por peça, com cuidado.', alt: 'Farol já removido, apoiado num carrinho de ferramentas, ao lado do carro' },
  { n: 3, t: 'Cada peça é conferida', s: 'Ela é fotografada e anunciada com o código original, para você achar a peça certa.', alt: 'Alternador limpo sobre a bancada, com etiqueta laranja' },
  { n: 4, t: 'Embalada e enviada', s: 'Cada peça é embalada com cuidado, e todo envio vai com código de rastreio.', alt: 'Peça embalada em caixa de papelão, com fita laranja' },
];
---
<Pagina
  titulo="O pátio, desmanche em Aceguá-RS | Izzat Car Imports"
  descricao="Desmanche credenciado pelo Detran-RS, CDV nº 01060, em Aceguá-RS. Carros com baixa legal, cada peça identificada e rastreável, com código original."
  canonical={canonical}
>
  <TopoArte trilha={[['Início', '/index.html'], ['O pátio', canonicalPath]]}
    titulo="O pátio"
    lead="Um desmanche credenciado pelo Detran-RS, na fronteira de Aceguá. Cada carro chega com baixa legal, e cada peça sai identificada."
    arte="/arte/v2/topo-patio.webp" />

  <div class="moldura">
    <section class="inst-sec sob-historia" aria-labelledby="h-processo">
      <h2 class="titulo-secao inst-h2" id="h-processo">Do carro à peça</h2>
      <p class="sob-intro">Cada carro segue o mesmo caminho, do começo ao fim, dentro da lei.</p>
      <ol class="sob-passos">
        {historia.map((h) => (
          <li class="sob-passo">
            <figure>
              <img src={`/arte/v2/historia-${h.n}.webp`} alt={h.alt} width="1200" height="800" loading="lazy" decoding="async" />
              <figcaption><span class="sob-num num">{h.n}</span><span><b>{h.t}</b>{h.s}</span></figcaption>
            </figure>
          </li>
        ))}
      </ol>
    </section>

    <section class="inst-sec inst-sec--linha inst-duas" aria-labelledby="h-legal">
      <div class="inst-texto">
        <h2 class="titulo-secao inst-h2" id="h-legal">Legal e rastreável</h2>
        <p>A gente segue a Lei nº 12.977/2014, que regula o desmanche de veículos no Brasil. Por isso, cada carro tem a baixa legal e cada peça tem origem identificada.</p>
        <p>Credenciado pelo Detran-RS, com o CDV nº 01060.</p>
      </div>
      <div class="sob-selo">
        <SeloCDV tamanho={168} />
      </div>
    </section>

    <section class="inst-sec sob-premio-sec" aria-labelledby="h-destaque">
      <div class="sob-premio" class:list={[{ 'com-arte': temTrofeu }]}>
        {temTrofeu && (
          <div class="sob-premio-arte">
            <img src="/arte/v2/destaque-acegua.webp" alt="Troféu Destaque Aceguá 2025" width="1200" height="800" loading="lazy" decoding="async" />
          </div>
        )}
        <div class="sob-premio-txt">
          <span class="sob-premio-selo" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="9" r="5.5" /><path d="M8.6 13.4 7.4 21l4.6-2.4 4.6 2.4-1.2-7.6" /></svg></span>
          <h2 class="titulo-secao inst-h2" id="h-destaque">Destaque em Aceguá</h2>
          <p>O pátio ganhou o Destaque Aceguá 2025 no Melhores do Ano Aceguá, na categoria desmanche de veículos.</p>
          <p class="sob-destaque display"><span>Destaque</span> Aceguá 2025</p>
        </div>
      </div>
    </section>

    <section class="inst-sec inst-sec--linha inst-duas" aria-labelledby="h-onde">
      <div class="inst-texto">
        <h2 class="titulo-secao inst-h2" id="h-onde">Onde a gente está</h2>
        <p>Aceguá-RS, na fronteira com o Uruguai. A gente atende pelo WhatsApp e pelo Instagram <b class="inst-quebra">@cdvizzatcarimports</b>.</p>
        <div class="sob-acoes">
          <a class="botao botao-linha inst-botao" href="/catalogo.html">Ver o catálogo</a>
          <a class="botao botao-linha inst-botao" href="https://instagram.com/cdvizzatcarimports" target="_blank" rel="noopener">Instagram</a>
        </div>
      </div>
      <div class="sob-pino" aria-hidden="true">
        <span class="sob-pino-icone"><Icone nome="pino" /></span>
        <p>Aceguá/RS</p>
      </div>
    </section>
  </div>

  <Chamada
    id="h-chamada"
    titulo="Quer ver uma peça do pátio?"
    texto="Manda o modelo do carro ou o código gravado da peça. A gente responde pelo WhatsApp."
    mensagem="Olá! Vi o pátio no site e quero saber sobre uma peça."
  />
</Pagina>

<style>
  .sob-historia { padding-bottom: clamp(24px, 4vw, 48px); }
  .sob-historia .inst-h2 { margin-bottom: 8px; }
  .sob-intro { margin: 0 0 clamp(24px, 3.4vw, 40px); font-size: 17px; line-height: 1.6; color: var(--ink-2); max-width: 60ch; }
  .sob-passos { list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(28px, 4vw, 44px); grid-template-columns: 1fr; }
  @media (min-width: 760px) { .sob-passos { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 32px; } }
  .sob-passo figure { margin: 0; display: grid; gap: 16px; }
  .sob-passo img { width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 24px; background: #efeeeb; box-shadow: var(--shadow-1); }
  .sob-passo figcaption { display: grid; grid-template-columns: auto 1fr; gap: 14px; align-items: start; font-size: 16px; line-height: 1.5; color: var(--ink-2); }
  .sob-passo figcaption b { display: block; margin-bottom: 4px; font-stretch: 86%; font-weight: 800; font-size: clamp(20px, 2vw, 24px); line-height: 1.1; color: var(--ink); }
  .sob-num { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--accent); color: var(--on-accent); font-weight: 800; font-size: 17px;
    box-shadow: inset 0 1px 0 rgb(255 255 255 / .4), 0 6px 14px -6px rgb(255 106 0 / .7); }
  .sob-selo { display: grid; place-items: center; }
  @media (min-width: 900px) { .sob-selo { justify-items: start; } }
  .sob-acoes { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 24px; }
  .sob-pino {
    display: grid; justify-items: start; gap: 14px; padding: clamp(24px, 4vw, 40px);
    border-radius: 28px; background: var(--surface); box-shadow: var(--shadow-1);
  }
  .sob-pino-icone {
    display: grid; place-items: center; width: 64px; height: 64px; border-radius: 20px;
    background: var(--accent); color: var(--on-accent);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / .4), 0 8px 16px -8px rgb(255 106 0 / .7);
  }
  .sob-pino-icone :global(svg) { width: 30px; height: 30px; }
  .sob-pino p { margin: 0; font-size: 22px; font-weight: 700; font-stretch: 84%; color: var(--ink); }
  .sob-premio-sec { padding-block: clamp(8px, 2vw, 16px); }
  .sob-premio {
    position: relative; overflow: hidden; display: grid; gap: clamp(20px, 3vw, 36px); align-items: center;
    padding: clamp(26px, 4.4vw, 56px); border-radius: 32px; background: var(--surface); box-shadow: var(--shadow-1);
    isolation: isolate;
  }
  /* fio laranja em degradê na borda superior: a marca do prêmio, sem enfeite */
  .sob-premio::before {
    content: ""; position: absolute; inset: 0 0 auto 0; height: 5px; z-index: 1;
    background: linear-gradient(90deg, transparent, var(--accent) 22%, var(--accent) 78%, transparent);
  }
  .sob-premio::after {
    content: ""; position: absolute; right: -90px; top: -90px; width: 260px; height: 260px; border-radius: 50%; z-index: -1;
    background: radial-gradient(closest-side, var(--accent-soft), transparent);
  }
  @media (min-width: 900px) { .sob-premio.com-arte { grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); } }
  .sob-premio-arte { border-radius: 24px; overflow: hidden; background: #efeeeb; }
  .sob-premio-arte img { width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; }
  .sob-premio-txt { display: grid; gap: 14px; justify-items: start; }
  .sob-premio-selo {
    display: grid; place-items: center; width: 56px; height: 56px; border-radius: 18px;
    background: var(--accent); color: var(--on-accent);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / .4), 0 8px 16px -8px rgb(255 106 0 / .7);
  }
  .sob-premio-selo svg { width: 28px; height: 28px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .sob-premio-txt .inst-h2 { margin: 0; }
  .sob-premio-txt p:not(.sob-destaque) { margin: 0; font-size: 17px; line-height: 1.6; color: var(--ink-2); max-width: 52ch; }
  .sob-destaque { margin: 8px 0 0; font-size: clamp(44px, 7.4vw, 96px); color: var(--ink); line-height: .92; }
  .sob-destaque span { display: block; font-size: .42em; font-weight: 700; color: var(--accent-text); letter-spacing: 0; text-transform: none; }
  @media (prefers-reduced-motion: no-preference) { .sob-premio-selo { transition: transform .4s ease; } }
</style>
