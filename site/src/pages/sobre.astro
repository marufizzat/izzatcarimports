---
import Pagina from '../layouts/Pagina.astro';
import Topo from '../components/inst/Topo.astro';
import Chamada from '../components/inst/Chamada.astro';
import Icone from '../components/Icone.astro';
import SeloCDV from '../components/SeloCDV.astro';
import Video from '../components/Video.astro';
import { whatsUrl, SITE } from '../lib/dados';

const canonical = `${SITE}/sobre.html`;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Início', item: `${SITE}/index.html` },
    { '@type': 'ListItem', position: 2, name: 'O pátio', item: canonical },
  ],
};
---
<Pagina
  titulo="O pátio, desmanche em Aceguá-RS | Izzat Car Imports"
  descricao="Desmanche credenciado pelo Detran-RS, CDV nº 01060, em Aceguá-RS. Carros com baixa legal, cada peça identificada e rastreável, com código original."
  canonical={canonical}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(ld)} />
  </Fragment>

  <Topo
    titulo="O pátio"
    lead="Um desmanche credenciado pelo Detran-RS, na fronteira de Aceguá. Cada carro chega com baixa legal, e cada peça sai identificada."
    trilha={[{ nome: 'Início', href: '/index.html' }, { nome: 'O pátio' }]}
  />

  <div class="moldura">
    <figure class="inst-janela inst-janela--16x9 sob-galpao">
      <Video nome="h-galpao" rotulo="Galpão do desmanche: corredor de prateleiras com motores e peças, piso claro e luz natural" prioridade />
    </figure>

    <section class="inst-sec" aria-labelledby="h-processo">
      <div class="inst-duas">
        <div class="inst-texto">
          <h2 class="titulo-secao inst-h2" id="h-processo">De carro a peças</h2>
          <p>Cada carro segue o mesmo caminho, do começo ao fim, dentro da lei.</p>
        </div>
        <ol class="inst-numeros">
          <li>
            <div>
              <b>Chega com baixa legal</b>
              <p>O carro entra com a baixa feita, dentro da lei.</p>
            </div>
          </li>
          <li>
            <div>
              <b>É desmontado</b>
              <p>Peça por peça, com calma e cuidado.</p>
            </div>
          </li>
          <li>
            <div>
              <b>Cada peça é conferida</b>
              <p>Ela é fotografada e anunciada com o código original, para você achar a peça certa.</p>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <section class="sob-verticais-wrap" aria-labelledby="h-dentro">
      <h2 class="titulo-secao inst-h2" id="h-dentro">Por dentro do pátio</h2>
      <div class="inst-verticais">
        <figure class="inst-janela">
          <Video nome="v-showroom" rotulo="Showroom com parede de rodas e um Mini Cooper verde-água" />
        </figure>
        <figure class="inst-janela">
          <Video nome="v-rodas" rotulo="Parede de rodas de liga e aros, em movimento lento" />
        </figure>
        <figure class="inst-janela">
          <Video nome="v-motores" rotulo="Motores e caixas de câmbio em prateleiras metálicas" />
        </figure>
      </div>
    </section>

    <section class="inst-sec inst-sec--linha inst-duas" aria-labelledby="h-legal">
      <div class="inst-texto">
        <h2 class="titulo-secao inst-h2" id="h-legal">Legal e rastreável</h2>
        <p>A gente segue a Lei nº 12.977/2014, que regula o desmanche de veículos no Brasil. Por isso, cada carro tem a baixa legal e cada peça tem origem identificada.</p>
        <p>Credenciado pelo Detran-RS, com o CDV nº 01060.</p>
      </div>
      <div class="sob-selo">
        <SeloCDV tamanho={168} />
      </div>
    </section>

    <section class="inst-sec inst-sec--linha" aria-labelledby="h-destaque">
      <div class="inst-duas">
        <div class="inst-texto">
          <h2 class="titulo-secao inst-h2" id="h-destaque">Destaque em Aceguá</h2>
          <p>O pátio ganhou o Destaque Aceguá 2025 no Melhores do Ano Aceguá, na categoria desmanche de veículos.</p>
        </div>
        <p class="sob-destaque display"><span>Destaque</span> Aceguá 2025</p>
      </div>
    </section>

    <section class="inst-sec inst-sec--linha inst-duas" aria-labelledby="h-onde">
      <div class="inst-texto">
        <h2 class="titulo-secao inst-h2" id="h-onde">Onde a gente está</h2>
        <p>Aceguá-RS, na fronteira com o Uruguai. A gente atende pelo WhatsApp e pelo Instagram <b class="inst-quebra">@cdvizzatcarimports</b>.</p>
        <div class="sob-acoes">
          <a class="botao botao-linha inst-botao" href="/catalogo.html">Ver o catálogo</a>
          <a class="botao botao-linha inst-botao" href="https://instagram.com/cdvizzatcarimports" target="_blank" rel="noopener">Instagram</a>
        </div>
      </div>
      <div class="sob-pino" aria-hidden="true">
        <span class="sob-pino-icone"><Icone nome="pino" /></span>
        <p>Aceguá/RS</p>
      </div>
    </section>
  </div>

  <Chamada
    id="h-chamada"
    titulo="Quer ver uma peça do pátio?"
    texto="Manda o modelo do carro ou o código gravado da peça. A gente responde pelo WhatsApp."
    mensagem="Olá! Vi o pátio no site e quero saber sobre uma peça."
  />
</Pagina>

<script>
  // Quem pede menos movimento ve o video parado (o poster), sem tocar.
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLVideoElement>('video[autoplay]').forEach((v) => v.pause());
  }
</script>

<style>
  .sob-galpao { margin-top: 4px; }
  .sob-verticais-wrap { padding-block: clamp(48px, 7vw, 96px); }
  .sob-verticais-wrap .inst-h2 { margin-bottom: clamp(20px, 3vw, 32px); }
  .inst-verticais {
    display: grid; grid-auto-flow: column; grid-auto-columns: 64vw; gap: 14px;
    margin: 0 -16px; padding: 4px 16px 12px; overflow-x: auto; overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory; scroll-padding-inline: 16px; scrollbar-width: none;
  }
  .inst-verticais::-webkit-scrollbar { display: none; }
  .inst-verticais > figure { scroll-snap-align: start; aspect-ratio: 9 / 16; }
  @media (min-width: 768px) {
    .inst-verticais { margin: 0; padding: 0; grid-auto-flow: row; grid-template-columns: repeat(3, 1fr); grid-auto-columns: auto; overflow: visible; gap: 20px; }
    .inst-verticais > figure { aspect-ratio: 4 / 5; }
  }
  .sob-selo { display: grid; place-items: center; }
  @media (min-width: 900px) { .sob-selo { justify-items: start; } }
  .sob-acoes { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 24px; }
  .sob-pino {
    display: grid; justify-items: start; gap: 14px; padding: clamp(24px, 4vw, 40px);
    border-radius: 28px; background: var(--surface); box-shadow: var(--shadow-1);
  }
  .sob-pino-icone {
    display: grid; place-items: center; width: 64px; height: 64px; border-radius: 20px;
    background: var(--accent); color: var(--on-accent);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / .4), 0 8px 16px -8px rgb(255 106 0 / .7);
  }
  .sob-pino-icone :global(svg) { width: 30px; height: 30px; }
  .sob-pino p { margin: 0; font-size: 22px; font-weight: 700; font-stretch: 84%; color: var(--ink); }
  .sob-destaque { margin: 0; font-size: clamp(48px, 9vw, 116px); color: var(--ink); line-height: .9; }
  .sob-destaque span { display: block; font-size: .42em; font-weight: 700; color: var(--accent-text); letter-spacing: 0; text-transform: none; }
</style>
