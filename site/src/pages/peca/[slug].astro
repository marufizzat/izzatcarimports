---
import Pagina from '../../layouts/Pagina.astro';
import PecaTopo from '../../components/PecaTopo.astro';
import BannerV2 from '../../components/v2/BannerV2.astro';
import Icone from '../../components/Icone.astro';
import AbasDetalhes from '../../components/peca/AbasDetalhes.astro';
import DoMesmoCarro from '../../components/peca/DoMesmoCarro.astro';
import VaiJunto from '../../components/peca/VaiJunto.astro';
import GuiaCodigo from '../../components/peca/GuiaCodigo.astro';
import { pecas, pecaPorId, resumo, foto, brl, whatsUrl, SITE, capaEstudio, codigoDaPeca } from '../../lib/dados';
import { blocoPeca, precoWhats, DESCONTO_WHATS } from '../../lib/whats';
import { modelosDa } from '../../lib/meuCarro';
import { doMesmoCarro, vaiJunto } from '../../lib/relacionadas';
import { nomeModelos } from '../../lib/meuCarro';
import { nomeCompleto, nomeMensagem, titulosPecas } from '../../lib/nomePeca';
import { descricaoPeca, descricaoLink, tituloLink } from '../../lib/descricao';
import type { Peca } from '../../lib/dados';
import { fotosGaleria } from '../../lib/quadroFoto';

export function getStaticPaths() {
  return pecas().map((p) => ({ params: { slug: p.slug }, props: { id: p.id } }));
}

// Pecas por carro (marca + modelo), montadas uma vez por build.
let _porCarro: Map<string, Peca[]> | null = null;
function porCarro(): Map<string, Peca[]> {
  if (!_porCarro) {
    _porCarro = new Map();
    for (const x of pecas()) {
      if (!x.b || !x.m) continue;
      const k = `${x.b}|${x.m}`;
      const lista = _porCarro.get(k) ?? [];
      lista.push(x);
      _porCarro.set(k, lista);
    }
  }
  return _porCarro;
}

// Peças por modelo, contando as de 2+ carros em cada um (o "Vai junto" de um XC60 vê a capa que serve no S60 e no XC60).
let _porModelo: Map<string, Peca[]> | null = null;
function porModelo(): Map<string, Peca[]> {
  if (!_porModelo) {
    _porModelo = new Map();
    for (const x of pecas()) {
      if (!x.b) continue;
      for (const m of x.ms && x.ms.length ? x.ms : x.m ? [x.m] : []) {
        const k = `${x.b}|${m}`;
        const lista = _porModelo.get(k) ?? [];
        lista.push(x);
        _porModelo.set(k, lista);
      }
    }
  }
  return _porModelo;
}

// <title>: nome + carro + anos + código. O "MLB…" só entra quando duas peças dariam o MESMO título (várias
// "Fechadura" sem marca, por exemplo); contado uma vez por build.
const anosDe = (y: Peca['y'], sep: string) => (y ? (y[0] === y[1] ? String(y[0]) : `${y[0]}${sep}${y[1]}`) : '');
function tituloBase(x: Peca): string {
  return nomeCompleto(x);
}
let _abas: Map<string, string> | null = null;
const titulosDasPecas = () => (_abas ??= titulosPecas(pecas()));
let _titulos: Map<string, number> | null = null;
function tituloRepetido(t: string): boolean {
  if (!_titulos) {
    _titulos = new Map();
    for (const x of pecas()) { const k = tituloBase(x); _titulos.set(k, (_titulos.get(k) ?? 0) + 1); }
  }
  return (_titulos.get(t) ?? 0) > 1;
}

const p = pecaPorId(Astro.props.id) as Peca;
const r = resumo();
const fam = r.familias.find((f) => f.n === p.c);
const carro = p.m ? r.carros.find((c) => c.b === p.b && c.m === p.m) : undefined;
const marca = r.marcas.find((m) => m.n === p.b);
// Do mesmo carro: a MESMA GERACAO (anos que se sobrepoem), mesma subfamilia/familia primeiro. Outra geracao
// so completa quando faltam pecas, num grupo a parte e com o nome dito (regra em lib/relacionadas.ts).
// Fora da mesma família, a lista vinha em ordem alfabética (toda peça do XC60 mostrava "Absorvedor…", "Acabamento…"):
// aqui esse resto vai pelo preço mais parecido com o desta peça, e cada página mostra peças diferentes.
const nivel = (x: Peca) => (x.c === p.c ? (x.s && x.s === p.s ? 0 : 1) : 2);
const perto = (x: Peca) => Math.abs(Math.log((x.p || 1) / (p.p || 1)));
// "Vai junto" (lib/relacionadas.ts): até 4 do mesmo carro e geração que costumam ser trocadas com esta. Elas saem do
// "Do mesmo carro" (a mesma peça duas vezes na página, não), a não ser que ele ficasse vazio.
const junto = p.b && p.m ? vaiJunto(p, porModelo().get(`${p.b}|${p.m}`) ?? []) : { pecas: [], com: '' };
const idsJunto = new Set(junto.pecas.map((x) => x.id));
const doModelo = p.b && p.m ? porCarro().get(`${p.b}|${p.m}`) ?? [] : [];
const semJunto = doModelo.filter((x) => !idsJunto.has(x.id));
const doCarroBruto = p.b && p.m ? doMesmoCarro(p, semJunto.some((x) => x.id !== p.id) ? semJunto : doModelo, 9999) : { mesma: [], outras: [], semAno: false };
const doCarro = {
  ...doCarroBruto,
  mesma: doCarroBruto.mesma
    .map((x, i) => ({ x, i }))
    .sort((a, b) => nivel(a.x) - nivel(b.x) || (nivel(a.x) === 2 ? perto(a.x) - perto(b.x) : 0) || a.i - b.i)
    .map(({ x }) => x),
};
const temCarro = doCarro.mesma.length + doCarro.outras.length > 0;
// sem outra peca do modelo: as da mesma marca (titulo "Mais peças <marca>", sem prometer o carro)
const daMarca = temCarro ? [] : p.rel.map(pecaPorId).filter((x): x is Peca => !!x).slice(0, 6);
const url = `${SITE}/peca/${p.slug}.html`;
const nomeCarro = [p.b, p.m].filter(Boolean).join(' ');
const anosTxt = anosDe(p.y, ' a ');
// ficha: "Serve em": todos os carros da peça ("Volvo S60 e XC60" quando o título diz os dois), com os anos.
// Só com a marca: "Carro" (sem prometer o modelo); sem marca: só "Anos" (antes saía "Carro: , 2015 a 2024")
const carros = nomeModelos(p);
const serve = carros ? carros + (anosTxt ? `, ${anosTxt}` : '') : anosTxt;
const serveRotulo = p.m ? 'Serve em' : p.b ? 'Carro' : 'Anos';
const unica = p.q === 1;
// código só quando parece código de verdade (5+ com letra e número, ou 6+ dígitos), em maiúsculas
const codigo = codigoDaPeca(p.oem);
const base = tituloBase(p);
// o nome da peça fora da página (aba, schema, GA4/Pixel): o mesmo do título, nunca o título cru do ML (lib/nomePeca.ts)
const nomeFora = `${base}${tituloRepetido(base) ? ` ${p.id}` : ''}`;
// <title> em até 65 caracteres (o Google corta o resto): nome inteiro + carro + anos (+ código) + " | Izzat Car",
// cortado em partes inteiras e sem repetir entre as peças (lib/nomePeca.ts: tituloPeca/titulosPecas)
const titulo = titulosDasPecas().get(p.id) ?? nomeFora;
// a linha da peça nas mensagens do WhatsApp: "Nome · Carro anos · Cód. X" (o link leva o MLB para achar o anúncio)
const linhaPeca = nomeMensagem(p);
// descrição (Google e prévia do link): o nome limpo + carro + anos, nunca o título cru do anúncio; até 160 caracteres
// (lib/descricao.ts: a frase mais completa que couber)
const descricao = descricaoPeca(p, codigo, brl(p.p));
// prévia do link (WhatsApp, Facebook): título curto (nome + carro) e o preço e o código na 1ª linha (cliente oculto,
// atrito 10). O <title> e a meta description (Google) não mudam.
const ogTitulo = tituloLink(p);
const ogDescricao = descricaoLink(p, codigo, brl(p.p));
const trilha: [string, string][] = [['Início', '/'], ['Catálogo', '/catalogo.html']];
if (fam && fam.n !== 'Outros') trilha.push([fam.n, `/categoria/${fam.k}.html`]);
if (carro) trilha.push([`${carro.b} ${carro.m}`, `/carros/${carro.k}.html`]);
else if (marca) trilha.push([marca.n, `/marca/${marca.k}.html`]);
const capa = capaEstudio(p.id);
// fotos do anúncio sem o marketing do vendedor e com o carro inteiro no fim (as mesmas da galeria e do feed)
const fotosMl = fotosGaleria(p.fotos);
// WhatsApp (lib/whats.ts): a peça pelo nome limpo, carro, anos e código (nunca o título cru do anúncio); o carro da
// pessoa já vem com a marca e o modelo da peça (só o ano em branco), como no botão "Pedir no WhatsApp".
const pecaMsg = blocoPeca({ linha: linhaPeca, url });
const meuCarroMsg = !p.b ? 'Meu carro é ____ (modelo) ____ (ano).' : modelosDa(p).length > 1 ? `Meu carro é ${p.b} ____ ano ____.` : `Meu carro é ${carros} ano ____.`;

const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Product', name: nomeFora, image: [...(capa ? [SITE + capa] : []), ...fotosMl.slice(0, 6).map((k) => foto(k, 'F'))], sku: p.id,
      // mpn só com o código de verdade da peça (antes 97 peças levavam o MLB) e marca só quando lida (11 iam "Original")
      ...(codigo ? { mpn: codigo } : {}),
      description: `${descricao} Desmanche credenciado pelo Detran-RS, CDV nº 01060.`,
      ...(p.b ? { brand: { '@type': 'Brand', name: p.b } } : {}),
      category: p.s || p.c,
      offers: { '@type': 'Offer', url, price: p.p.toFixed(2), priceCurrency: 'BRL', availability: 'https://schema.org/InStock',
                itemCondition: 'https://schema.org/UsedCondition',
                seller: { '@type': 'AutoPartsStore', '@id': `${SITE}/#loja`, name: 'Izzat Car Imports' } } },
    { '@type': 'BreadcrumbList', itemListElement: [...trilha, [p.n, `/peca/${p.slug}.html`]].map(([n, h], i) => ({
        '@type': 'ListItem', position: i + 1, name: n, item: `${SITE}${h}` })) },
  ],
};
---
<Pagina titulo={titulo} descricao={descricao} ogTitulo={ogTitulo} ogDescricao={ogDescricao} ogImagem={capa ? `${SITE}${capa}` : foto(fotosMl[0], 'F') || undefined} ogTipo="product"
        produto={{ id: p.id, name: nomeFora, price: p.p, category: p.c }} rodapeSelos={false}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(ld)} />
  {/* prévia do link como produto (Facebook/WhatsApp leem o preço e o estado) */}
  <meta slot="head" property="product:price:amount" content={p.p.toFixed(2)} />
  <meta slot="head" property="product:price:currency" content="BRL" />
  <meta slot="head" property="product:condition" content="used" />
  {/* prévia do link (WhatsApp, Facebook): a capa de estúdio tem sempre 1000×1000 (capas_estudio.py); a foto do ML, sem
      medida (o tamanho muda de foto para foto) */}
  {capa && <meta slot="head" property="og:image:width" content="1000" />}
  {capa && <meta slot="head" property="og:image:height" content="1000" />}
  {capa && <meta slot="head" property="og:image:type" content="image/webp" />}
  <meta slot="head" property="og:image:alt" content={ogTitulo} />
  <link slot="head" rel="preload" as="image" href={capa ?? foto(fotosMl[0], 'F')} fetchpriority="high" />

  <div class="moldura">
    <nav class="trilha" aria-label="Você está em">
      {trilha.map(([n, h]) => <><a href={h}>{n}</a><span aria-hidden="true">/</span></>)}
      <span aria-current="page">{p.n}</span>
    </nav>
    <section class="topo"><PecaTopo p={p} /></section>
  </div>

  {junto.pecas.length > 0 && <VaiJunto pecas={junto.pecas as Peca[]} carro={nomeCarro} anos={anosTxt} com={junto.com} />}

  <div class="barra-compra" data-barra-compra aria-hidden="true">
    <div class="barra-info">
      <div class="barra-preco num"><small>R$</small> {brl(precoWhats(p.p))}</div>
      <span class="barra-de num">no WhatsApp · <s>R$ {brl(p.p)}</s></span>
    </div>
    {/* o link (com a mensagem pronta e o carro salvo) é o mesmo do botão principal: o script do PecaTopo copia */}
    <a class="botao botao-laranja" data-whats-espelho tabindex="-1"><Icone nome="whats" /><span><span class="barra-pedir">Pedir no </span>WhatsApp</span><span class="sr-only">, com {DESCONTO_WHATS}% de desconto</span></a>
  </div>

  <AbasDetalhes p={p} serve={serve} serveRotulo={serveRotulo} />

  {codigo && <GuiaCodigo cod={codigo} peca={pecaMsg} />}

  {temCarro && (
    <DoMesmoCarro carro={nomeCarro} modelo={p.m} anos={anosTxt}
                  link={carro ? `/carros/${carro.k}.html` : marca ? `/marca/${marca.k}.html` : '/catalogo.html'}
                  total={carro ? carro.c : marca ? marca.c : 0} pecas={doCarro.mesma.slice(0, 6)} outras={doCarro.outras.slice(0, 4)}
                  semAno={doCarro.semAno} />
  )}
  {!temCarro && daMarca.length > 0 && (
    <DoMesmoCarro titulo={marca ? `Mais peças ${marca.n}` : 'Mais peças'} carro={marca ? marca.n : ''}
                  sub={marca ? `De outros modelos ${marca.n}: confira o carro e o ano em cada cartão.` : 'Do nosso estoque: confira o carro e o ano em cada cartão.'}
                  link={marca ? `/marca/${marca.k}.html` : '/catalogo.html'} total={marca ? marca.c : r.total} pecas={daMarca} />
  )}

  <section class="secao">
    <div class="moldura">
      <BannerV2 nome="banner-serve" href={whatsUrl(`Quero confirmar se esta peça serve no meu carro:\n\n${pecaMsg}\n\n${meuCarroMsg}`)}
        texto="Serve no meu carro? Mande o modelo e o ano. A gente confere no pátio e responde com foto. Chamar no WhatsApp" />
    </div>
  </section>
</Pagina>

<script>
  // Barra fixa do celular. Regra: a 1ª tela SEMPRE tem um botão de compra. Ela aparece sempre que o botão laranja
  // ("Pedir no WhatsApp") não está INTEIRO à vista: abaixo da dobra no celular baixinho (já na carga), atrás do cabeçalho
  // ou fora da tela depois de rolar. Enquanto o preço grande está inteiro à vista (acima da barra), ela vem só com o
  // botão (.so-botao): nunca dois preços na tela e nunca a barra por cima do preço. O cabeçalho fixo cobre o topo: não conta.
  const barra = document.querySelector<HTMLElement>('[data-barra-compra]');
  const botao = document.querySelector<HTMLElement>('[data-compra-botoes] [data-whats]');
  const preco = document.querySelector<HTMLElement>('.compra-preco-linha');
  if (barra && botao && preco && 'IntersectionObserver' in window) {
    const topo = Math.round(document.querySelector('header.cab')?.getBoundingClientRect().height ?? 0);
    // altura que a barra ocupa no pé da tela (com a folga de baixo e a área segura do iPhone)
    const zona = Math.round(barra.offsetHeight + (parseFloat(getComputedStyle(barra).bottom) || 0) + 8);
    const link = barra.querySelector('a');
    let botaoInteiro = true, precoAVista = true, precoNaTela = true;
    const pintar = () => {
      const mostrar = !botaoInteiro;
      barra.classList.toggle('so-botao', precoAVista);
      // celular muito baixo (320×480): o preço grande ficaria pela metade atrás da barra, que já mostra o preço:
      // ele some enquanto estiver ali (volta assim que sobe para cima da barra)
      preco.classList.toggle('sob-barra', mostrar && !precoAVista && precoNaTela);
      if (barra.classList.contains('visivel') === mostrar) return;
      barra.classList.toggle('visivel', mostrar);
      barra.setAttribute('aria-hidden', String(!mostrar));
      link?.setAttribute('tabindex', mostrar ? '0' : '-1');
    };
    const inteiro = (e: IntersectionObserverEntry) => e.isIntersecting && e.intersectionRatio > 0.97;
    new IntersectionObserver(([e]) => { botaoInteiro = inteiro(e); pintar(); },
      { rootMargin: `-${topo}px 0px 0px 0px`, threshold: [0, 0.5, 0.98, 1] }).observe(botao);
    new IntersectionObserver(([e]) => { precoAVista = inteiro(e); pintar(); },
      { rootMargin: `-${topo}px 0px -${zona}px 0px`, threshold: [0, 0.5, 0.98, 1] }).observe(preco);
    new IntersectionObserver(([e]) => { precoNaTela = e.isIntersecting; pintar(); },
      { rootMargin: `-${topo}px 0px 0px 0px` }).observe(preco);
  }
</script>

<style>
  .trilha { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 8px; padding-block: 18px 14px; font-size: 13.5px; color: var(--ink-3); }
  /* alvo de toque de 44 px (padding) sem crescer a linha (a margem negativa devolve o espaço) */
  .trilha a { color: var(--ink-2); padding: 12px 6px; margin: -12px -6px; }
  .trilha a:hover { color: var(--ink); text-decoration: underline; }
  .trilha [aria-current] { color: var(--ink-3); max-width: 28ch; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .topo { padding-bottom: 32px; }
  /* celular: trilha numa linha só, para a foto e a compra subirem. Sem o nome desta peça (o título logo abaixo já
     mostra; antes a linha era cortada no meio da palavra: "… / Fiat Toro / Ga"); se o carro e a categoria não
     couberem, eles terminam em "…" (Início e Catálogo ficam inteiros) */
  @media (max-width: 959px) {
    .trilha { flex-wrap: nowrap; overflow: hidden; white-space: nowrap; padding: 12px 6px; margin-inline: -6px; }
    .trilha > * { flex: 0 0 auto; }
    .trilha > a { flex-shrink: 1; min-width: 4ch; overflow: hidden; text-overflow: ellipsis; }
    .trilha > a:nth-of-type(-n+2) { flex-shrink: 0; }
    .trilha [aria-current], .trilha > span[aria-hidden]:nth-last-child(2) { display: none; }
  }

  .barra-compra { position: fixed; left: 10px; right: 10px; bottom: calc(10px + env(safe-area-inset-bottom)); z-index: 40;
                  display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 9px 9px 9px 16px;
                  border-radius: 18px; background: color-mix(in oklab, var(--surface), transparent 6%); backdrop-filter: blur(16px);
                  box-shadow: var(--shadow-2), inset 0 0 0 1px var(--line);
                  transform: translateY(140%); visibility: hidden; transition: transform .35s cubic-bezier(.2,.8,.2,1), visibility 0s linear .35s; }
  .barra-compra.visivel { transform: none; visibility: visible; transition: transform .35s cubic-bezier(.2,.8,.2,1), visibility 0s; }
  /* aparelho fraco: sem desfoque atrás da barra (fundo sólido da mesma cor) */
  :global(html.leve) .barra-compra { background: var(--surface); backdrop-filter: none; }
  /* o preço nunca encolhe nem é cortado ("R$ 33.85…" saía por baixo do botão em 320 e 360 px): quem cede é o botão */
  .barra-info { display: grid; gap: 2px; flex: 1 0 auto; min-width: max-content; }
  .barra-preco { font-stretch: 80%; font-weight: 850; font-size: clamp(19px, 5.9vw, 23px); line-height: 1.05; white-space: nowrap; }
  .barra-preco small { font-size: .6em; color: var(--ink-2); }
  /* o preço da barra é o do WhatsApp (o botão dela); o do anúncio fica riscado embaixo */
  .barra-de { font-size: 12px; font-weight: 600; line-height: 1.2; color: var(--ink-2); white-space: nowrap; }
  .barra-unica { display: inline-flex; align-items: center; gap: 6px; font-size: 12.5px; font-weight: 700; line-height: 1.2; color: var(--accent-text); white-space: nowrap; }
  .barra-unica i { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); flex: none; }
  .barra-compra .botao { --h: var(--botao-p); flex: 0 1 auto; min-width: 0; height: var(--h); padding: 0 16px; font-size: 15px; white-space: nowrap; }
  /* desconto pelo WhatsApp: "−10%" pequeno, claro e com letra grafite, dentro do botão laranja */
  .barra-desc { flex: none; margin-left: -2px; padding: 3px 7px; border-radius: 999px; background: #fff; color: #1d1d1f;
                font-size: 12.5px; font-weight: 800; font-stretch: 90%; line-height: 1.1; box-shadow: 0 1px 2px rgb(140 50 0 / .25); }
  /* preço grande ainda à vista (1ª tela do celular baixinho): a barra vem só com o botão, largo */
  .barra-compra.so-botao { padding-left: 9px; }
  .barra-compra.so-botao .barra-info { display: none; }
  .barra-compra.so-botao .botao { flex: 1 1 auto; font-size: 16px; }
  .barra-compra.so-botao .barra-pedir { display: inline; }
  :global(.compra-preco-linha.sob-barra) { visibility: hidden; }
  /* celular estreito: o botão diz só "WhatsApp" (com o ícone) */
  @media (max-width: 379px) {
    .barra-compra { gap: 8px; padding-left: 14px; }
    .barra-compra .botao { padding: 0 14px; gap: 8px; }
    .barra-pedir { display: none; }
  }
  @media (min-width: 960px) { .barra-compra { display: none; } }
  @media (max-width: 959px) {
    :global(body:has(.barra-compra)) { padding-bottom: 84px; }
    /* teclado: com a barra à vista, o elemento focado para acima dela (WCAG 2.4.11, foco não encoberto) */
    :global(html:has(.barra-compra.visivel)) { scroll-padding-bottom: calc(96px + env(safe-area-inset-bottom)); }
  }
  @media (prefers-reduced-motion: reduce) { .barra-compra, .barra-compra.visivel { transition: none; } }
</style>
