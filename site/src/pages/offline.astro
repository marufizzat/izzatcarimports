---
// /offline.html — a página que o service worker (public/sw.js) mostra quando a rede caiu e a página pedida nunca foi
// guardada neste aparelho. Fica no casco do SW (baixada na instalação, com o CSS, o JS e o logo: integracoes/
// service-worker.mjs), então abre sem rede nenhuma. Fora do Google (noindex) e do sitemap.
// SEM DADO DO ESTOQUE aqui (nem cabeçalho/rodapé com contagem, reputação ou data): a versão do service worker é o hash
// desta página, e ela não pode mudar a cada rodada do robô. O que é da pessoa (as peças que ela viu, a lista de
// orçamento) vem do aparelho, pelo script (components/app/paginaOffline.ts).
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import Icone from '../components/Icone.astro';
import { whatsUrl, DESCONTO_WHATS } from '../lib/whats';
const whats = whatsUrl('Estou procurando uma peça.');
---
<Base titulo="Sem conexão | Izzat Car Imports" noindex canonical="https://izzatcarimports.com.br/offline.html"
  descricao="Você está sem conexão. As peças que você viu e a sua lista de orçamento continuam aqui.">
  <div class="off" data-pagina-offline>
    <header class="off-topo">
      <div class="moldura off-topo-linha">
        <Logo altura={46} />
        <a class="botao botao-laranja off-topo-whats" href={whats} target="_blank" rel="noopener" data-botao="sem-conexao" aria-label="Chamar no WhatsApp"><Icone nome="whats" /><span>WhatsApp</span></a>
      </div>
    </header>

    <main class="moldura off-main" id="conteudo">
      <section class="off-aviso" aria-labelledby="off-h1">
        <div class="off-arte" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h.01M8.5 16.43a5 5 0 0 1 7 0M5 12.86a10 10 0 0 1 5.17-2.69M19 12.86a10 10 0 0 0-2.01-1.53M2 8.82a15 15 0 0 1 4.18-2.65M22 8.82a15 15 0 0 0-11.29-3.76M2 2l20 20"/></svg>
        </div>
        <h1 class="off-h1" id="off-h1">Você está sem conexão</h1>
        <p class="off-lead">Esta página ainda não ficou guardada neste aparelho. Quando a internet voltar, ela abre sozinha.</p>
        <div class="off-botoes">
          <button type="button" class="botao botao-linha" data-off-tentar><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-2.64-6.36L21 8"/><path d="M21 3v5h-5"/></svg>Tentar de novo</button>
          <a class="botao botao-laranja" href={whats} target="_blank" rel="noopener" data-botao="sem-conexao"><Icone nome="whats" />Chamar no WhatsApp</a>
        </div>
        <p class="off-nota">No WhatsApp a mensagem fica pronta e sai assim que a conexão voltar.</p>
      </section>

      {/* a lista de orçamento (lib/lista.ts), montada pelo script; sem peça, nada aparece */}
      <section class="off-bloco" data-off-lista hidden aria-labelledby="off-lista-t">
        <div class="off-cabeca">
          <h2 class="off-h2" id="off-lista-t">Sua lista de orçamento</h2>
          <a class="off-link" href="/lista.html">Abrir a lista</a>
        </div>
        <ul class="off-itens" data-off-itens></ul>
        <div class="off-total">
          <div><span>Total no WhatsApp ({DESCONTO_WHATS}% de desconto)</span><b class="num" data-off-total></b></div>
          <a class="botao botao-laranja" data-off-pedir data-botao="lista" target="_blank" rel="noopener" href={whats}><Icone nome="whats" /><span>Pedir tudo no WhatsApp</span></a>
        </div>
      </section>

      {/* as peças que a pessoa abriu (lib/vistos.ts): as que estão guardadas abrem mesmo sem internet */}
      <section class="off-bloco" data-off-vistos hidden aria-labelledby="off-vistos-t">
        <div class="off-cabeca">
          <h2 class="off-h2" id="off-vistos-t">Você viu</h2>
          <p class="off-sub">Preços de quando você viu. As marcadas abrem sem internet.</p>
        </div>
        <ul class="off-grade" data-off-grade></ul>
      </section>

      <p class="off-dica" data-off-dica hidden>Dica: as peças que você abre ficam guardadas neste aparelho e abrem mesmo sem internet.</p>
    </main>
  </div>
</Base>

<script>
  import { iniciarOffline } from '../components/app/paginaOffline';
  iniciarOffline();
</script>

<style is:global>
  /* presos a .off (o HTML dos cartões vem do script, sem o atributo de escopo) */
  .off { min-height: calc(100dvh / var(--z, 1)); display: flex; flex-direction: column; }
  .off [hidden] { display: none !important; }
  .off .off-topo { position: sticky; top: 0; z-index: 10; padding-top: env(safe-area-inset-top); background: color-mix(in oklab, var(--bg), transparent 8%);
    border-bottom: 1px solid color-mix(in oklab, var(--line), transparent 25%); }
  .off .off-topo-linha { display: flex; align-items: center; justify-content: space-between; gap: 12px; height: 64px; }
  .off .off-topo-linha .logo img { height: 46px; width: auto; display: block; }
  .off .off-topo-whats { --h: 44px; height: 44px; padding: 0 14px; font-size: 15px; gap: 8px; }
  .off .off-topo-whats svg { width: 19px; height: 19px; }
  .off .off-main { flex: 1; padding-block: clamp(20px, 4vw, 48px) clamp(40px, 6vw, 80px); display: grid; gap: clamp(20px, 3vw, 32px); align-content: start; }
  .off .off-aviso { display: grid; justify-items: center; text-align: center; gap: 12px; padding: clamp(26px, 5vw, 52px) 20px clamp(24px, 4vw, 40px); border-radius: 26px;
    background: var(--surface); box-shadow: inset 0 0 0 1px var(--line), var(--shadow-1); }
  .off .off-arte { display: grid; place-items: center; width: 88px; height: 88px; border-radius: 28px; color: var(--accent-text);
    background: radial-gradient(circle at 30% 25%, #fff, var(--accent-soft) 70%);
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--accent), transparent 70%), 0 0 0 10px color-mix(in oklab, var(--accent-soft), transparent 40%); }
  .off .off-arte svg { width: 42px; height: 42px; }
  .off .off-h1 { margin: 10px 0 0; font-stretch: 84%; font-weight: 820; font-size: clamp(28px, 3.6vw, 40px); line-height: 1.04; letter-spacing: -.01em; text-wrap: balance; }
  .off .off-lead { margin: 0; max-width: 520px; font-size: 16px; line-height: 1.5; color: var(--ink-2); text-wrap: pretty; }
  .off .off-botoes { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 6px; }
  .off .off-botoes .botao { gap: 9px; }
  .off .off-nota { margin: 0; font-size: 13.5px; line-height: 1.4; color: var(--ink-3); text-wrap: pretty; }

  .off .off-bloco { display: grid; gap: 12px; }
  .off .off-cabeca { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 4px 16px; }
  .off .off-h2 { margin: 0; font-stretch: 84%; font-weight: 800; font-size: clamp(22px, 2.4vw, 28px); line-height: 1.08; }
  .off .off-sub { margin: 0; font-size: 14px; color: var(--ink-2); }
  .off .off-link { min-height: 44px; display: inline-flex; align-items: center; font-weight: 700; font-size: 15px; color: var(--ink); text-decoration: underline; text-underline-offset: 4px; }

  .off .off-itens { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .off .off-item { display: grid; grid-template-columns: 56px minmax(0, 1fr) auto; align-items: center; gap: 12px; padding: 10px 14px 10px 10px; border-radius: 16px;
    background: var(--surface); box-shadow: inset 0 0 0 1px var(--line); }
  .off .off-item .off-foto { width: 56px; height: 56px; border-radius: 11px; }
  .off .off-item-dados { display: grid; gap: 1px; min-width: 0; }
  .off .off-item-dados b { font-size: 15px; font-weight: 700; line-height: 1.25; overflow-wrap: anywhere; }
  .off .off-item-dados span { font-size: 12.5px; color: var(--ink-2); }
  .off .off-item-preco { font-weight: 750; font-size: 15px; white-space: nowrap; }
  .off .off-total { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 20px; padding: 16px 18px; border-radius: 18px;
    background: var(--surface); box-shadow: inset 0 0 0 1px var(--line), var(--shadow-1); }
  .off .off-total > div { display: grid; gap: 2px; }
  .off .off-total > div span { font-size: 13.5px; color: var(--ink-2); }
  .off .off-total > div b { font-stretch: 84%; font-weight: 850; font-size: 28px; line-height: 1; }
  .off .off-total .botao { gap: 9px; }
  @media (max-width: 559px) { .off .off-total .botao { width: 100%; } }

  /* "Você viu": cartões de 2 por fila no celular, até 6 no PC */
  .off .off-grade { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  @media (min-width: 700px) { .off .off-grade { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; } }
  @media (min-width: 1100px) { .off .off-grade { grid-template-columns: repeat(6, minmax(0, 1fr)); } }
  .off .off-cartao { position: relative; display: grid; gap: 8px; height: 100%; padding: 8px 8px 12px; border-radius: 18px; background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line), var(--shadow-1); color: var(--ink); }
  .off a.off-cartao:hover { box-shadow: inset 0 0 0 1.5px var(--line-2), var(--shadow-2); }
  .off .off-foto { position: relative; display: block; aspect-ratio: 1; border-radius: 12px; overflow: hidden; background: linear-gradient(#f4f3f0, #e7e5e1); }
  .off .off-foto img { width: 100%; height: 100%; object-fit: contain; display: block; }
  .off .off-foto img.falhou { visibility: hidden; }
  .off .off-cartao-txt { display: grid; gap: 2px; padding-inline: 4px; }
  .off .off-veic { font-size: 12px; font-weight: 650; line-height: 1.3; color: var(--ink-2); }
  .off .off-nome { font-size: 14.5px; font-weight: 700; line-height: 1.25; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .off .off-preco { margin-top: 4px; font-stretch: 86%; font-weight: 850; font-size: 19px; }
  .off .off-selo { position: absolute; left: 14px; top: 14px; display: inline-flex; align-items: center; gap: 4px; height: 24px; padding: 0 9px; border-radius: 999px;
    font-size: 11.5px; font-weight: 750; color: var(--serve-ink, #166534); background: var(--serve-bg, #ecfdf3); box-shadow: inset 0 0 0 1px var(--serve-borda, #a7e3bd); }
  .off .off-cartao.sem-copia { opacity: .62; }
  .off .off-dica { margin: 0; padding: 14px 16px; border-radius: 16px; background: var(--bg-2); font-size: 14.5px; line-height: 1.45; color: var(--ink-2); text-align: center; }
</style>
