---
// /categoria/<k>.html: um bloco de peças (components/categoria/PaginaCategoria.astro). As chaves antigas que o Google
// conhece redirecionam em [antiga].html.ts.
import PaginaCategoria from '../../components/categoria/PaginaCategoria.astro';
import { resumo } from '../../lib/dados';
export function getStaticPaths() {
  return resumo().familias.filter((f) => f.k !== 'outros' && f.c > 0).map((f) => ({ params: { k: f.k }, props: { k: f.k } }));
}
---
<PaginaCategoria k={Astro.props.k} />
