---
import Pagina from '../layouts/Pagina.astro';
import Catalogo from '../components/catalogo/Catalogo';
import CartaoPeca from '../components/CartaoPeca.astro';
import TopoArte from '../components/TopoArte.astro';
import { pecas, resumo } from '../lib/dados';
const r = resumo();
// Sem JS (e para o Google): as 48 mais novas + atalhos por tipo e por carro.
const primeiras = [...pecas()].sort((a, b) => (b.id > a.id ? 1 : -1)).slice(0, 48);
---
<Pagina titulo="Catálogo de peças originais | Izzat Car Imports"
        descricao={`Busque entre ${r.total.toLocaleString('pt-BR')} peças originais de desmanche legalizado: pelo nome, pelo carro ou pelo código gravado. Nota fiscal e 90 dias de garantia.`}>
  <link slot="head" rel="preload" href="/dados/busca.json" as="fetch" crossorigin />
  <TopoArte trilha={[['Início', '/index.html'], ['Catálogo', '/catalogo.html']]} titulo="Catálogo de peças"
    lead="Ache pelo nome da peça, pelo carro ou pelo código gravado nela. Todas originais, com nota fiscal e 90 dias de garantia."
    arte="/arte/v2/topo-catalogo.webp" />
  <div class="moldura cat-pagina">
    <Catalogo client:load total={r.total} />
    <noscript>
      <div class="cat-grade">{primeiras.map((p) => <CartaoPeca p={p} />)}</div>
    </noscript>
    <nav class="cat-atalhos" aria-label="Atalhos do catálogo">
      <div><h2>Por tipo de peça</h2>{r.familias.filter((f) => f.n !== 'Outros').map((f) => <a href={`/categoria/${f.k}.html`}>{f.n}</a>)}</div>
      <div><h2>Por carro</h2>{r.carros.slice(0, 24).map((c) => <a href={`/carros/${c.k}.html`}>{c.b} {c.m}</a>)}<a href="/carros.html">Todos os carros</a></div>
    </nav>
  </div>
</Pagina>

<style is:global>
  .cat-pagina { padding-block: clamp(20px, 3vw, 36px) 72px; }
  .cat-busca { position: sticky; top: 76px; z-index: 30; }
  @media (min-width: 960px) { .cat-busca { top: 96px; } }
  .cat-limpar-texto { width: 44px; height: 44px; flex: none; display: grid; place-items: center; border: 0; border-radius: 10px; background: transparent; color: var(--ink-3); }
  .cat-limpar-texto svg { width: 18px; height: 18px; }
  .cat-corpo { display: grid; gap: 28px; margin-top: 22px; }
  .cat-corpo > * { min-width: 0; }
  @media (min-width: 1024px) { .cat-corpo { grid-template-columns: 264px minmax(0, 1fr); gap: 36px; } }
  .cat-lateral { display: none; }
  @media (min-width: 1024px) { .cat-lateral { display: block; position: sticky; top: 180px; align-self: start; max-height: calc(100vh - 200px); overflow-y: auto; padding-right: 6px; scrollbar-width: thin; } }
  .cat-filtros { display: grid; gap: 22px; }
  .cat-grupo { border: 0; padding: 0; margin: 0; min-width: 0; }
  .cat-grupo legend { padding: 0; margin-bottom: 8px; font-stretch: 86%; font-weight: 800; font-size: 16px; }
  .cat-grupo ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  .cat-opcao { width: 100%; display: flex; justify-content: space-between; align-items: center; gap: 10px; min-height: 40px; padding: 8px 10px; border: 0;
               border-radius: 10px; background: transparent; text-align: left; font-size: 15px; color: var(--ink-2); transition: background-color .15s, color .15s; }
  .cat-opcao:hover { background: var(--surface); color: var(--ink); }
  .cat-opcao b { font-weight: 500; font-size: 13px; color: var(--ink-3); }
  .cat-opcao[aria-pressed="true"] { background: var(--accent-soft); color: var(--ink); font-weight: 650; box-shadow: inset 3px 0 0 var(--accent); }
  .cat-mais { margin-top: 6px; border: 0; background: none; padding: 6px 10px; font-weight: 600; font-size: 14px; color: var(--accent-text); }
  .cat-chave { display: flex; align-items: center; gap: 12px; cursor: pointer; font-size: 15px; color: var(--ink-2); }
  .cat-chave input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .cat-chave-trilho { position: relative; width: 44px; height: 26px; flex: none; border-radius: 99px; background: var(--line-2); transition: background-color .2s; }
  .cat-chave-trilho i { position: absolute; top: 3px; left: 3px; width: 20px; height: 20px; border-radius: 50%; background: #fff; box-shadow: 0 1px 3px rgb(0 0 0 / .25); transition: transform .2s; }
  .cat-chave input:checked + .cat-chave-trilho { background: var(--accent); }
  .cat-chave input:checked + .cat-chave-trilho i { transform: translateX(18px); }
  .cat-chave input:focus-visible + .cat-chave-trilho { outline: 3px solid var(--accent); outline-offset: 2px; }

  .cat-barra { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 12px; margin-bottom: 14px; }
  .cat-total { margin: 0 auto 0 0; font-size: 15px; color: var(--ink-2); }
  .cat-total b { font-stretch: 84%; font-weight: 800; font-size: 22px; color: var(--ink); }
  .cat-abrir-filtros { --h: 48px; padding: 0 16px; font-size: 15px; }
  @media (min-width: 1024px) { .cat-abrir-filtros { display: none; } }
  .cat-ordem { width: 200px; max-width: 100%; }
  @media (max-width: 420px) { .cat-ordem { width: 100%; } .cat-abrir-filtros { flex: 1; } .cat-total { flex-basis: 100%; } }
  .cat-ordem select { height: 48px; padding-top: 16px; }
  .cat-ativos { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 16px; }
  .cat-ficha { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; padding: 0 10px 0 14px; border: 0; border-radius: 10px;
               background: var(--ink); color: var(--bg); font-size: 14px; font-weight: 600; }
  .cat-ficha svg { width: 16px; height: 16px; opacity: .8; }
  .cat-limpar { border: 0; background: none; font-weight: 650; font-size: 14px; color: var(--accent-text); padding: 0 10px; min-height: 44px; }

  .cat-grade { display: grid; gap: 12px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 700px) { .cat-grade { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; } }
  @media (min-width: 1280px) { .cat-grade { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .cat-esqueleto { aspect-ratio: 1 / 1.5; border-radius: 18px; background: linear-gradient(100deg, var(--surface) 30%, var(--bg-2) 50%, var(--surface) 70%) 0 0 / 300% 100%;
                   animation: cat-brilho 1.4s ease infinite; }
  @keyframes cat-brilho { to { background-position: -100% 0; } }
  .cat-ver-mais { display: flex; margin: 28px auto 0; }
  .cat-aviso { display: grid; grid-template-columns: auto 1fr; gap: 10px 14px; align-items: center; margin-bottom: 18px; padding: 16px 18px; border-radius: 18px;
               background: var(--accent-soft); box-shadow: inset 0 0 0 1.5px color-mix(in oklab, var(--accent), transparent 60%); }
  .cat-aviso b { display: block; font-size: 16.5px; overflow-wrap: anywhere; }
  .cat-aviso span { display: block; font-size: 14.5px; color: var(--ink-2); }
  .cat-aviso .botao { grid-column: 1 / -1; justify-self: start; --h: 46px; }
  @media (min-width: 900px) { .cat-aviso { grid-template-columns: auto 1fr auto; } .cat-aviso .botao { grid-column: auto; } }
  .cat-erro { padding: 20px; border-radius: 16px; background: var(--surface); color: var(--ink-2); }
  .cat-vazio { display: grid; gap: 24px; align-items: center; padding: 24px; border-radius: 24px; background: var(--surface); box-shadow: var(--shadow-1); }
  @media (min-width: 768px) { .cat-vazio { grid-template-columns: 300px 1fr; padding: 32px; } }
  .cat-vazio img { width: 100%; max-width: 300px; height: auto; border-radius: 18px; justify-self: center; }
  .cat-vazio h2 { margin: 0 0 8px; font-stretch: 80%; font-weight: 820; font-size: 30px; line-height: 1.05; overflow-wrap: anywhere; }
  .cat-vazio p { margin: 0 0 18px; color: var(--ink-2); }
  .cat-vazio-botoes { display: flex; flex-wrap: wrap; gap: 10px; }
  @media (max-width: 600px) { .cat-vazio-botoes .botao { width: 100%; } .cat-vazio img { max-width: 220px; } }
  .cat-atalhos { display: grid; gap: 28px; margin-top: 72px; padding-top: 32px; border-top: 1px solid var(--line); }
  @media (min-width: 900px) { .cat-atalhos { grid-template-columns: 1fr 1fr; } }
  .cat-atalhos h2 { margin: 0 0 12px; font-stretch: 86%; font-weight: 800; font-size: 18px; }
  .cat-atalhos div { display: flex; flex-wrap: wrap; gap: 8px; align-content: start; }
  .cat-atalhos h2 { flex-basis: 100%; }
  .cat-atalhos a { padding: 8px 12px; border-radius: 10px; background: var(--surface); box-shadow: inset 0 0 0 1px var(--line); font-size: 14px; font-weight: 560; }
</style>
