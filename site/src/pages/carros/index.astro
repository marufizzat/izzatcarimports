---
import Pagina from '../../layouts/Pagina.astro';
import TopoArte from '../../components/TopoArte.astro';
import CarrosPatio from '../../components/v2/CarrosPatio.astro';
import { resumo, logoInfo } from '../../lib/dados';
const r = resumo();
const marcas = [...new Set(r.carros.map((c) => c.b))];
const kMarca = (b: string) => r.marcas.find((m) => m.n === b)?.k ?? b.toLowerCase();
---
<Pagina titulo="Peças por carro | Izzat Car Imports"
        descricao={`Escolha o seu carro e veja as peças originais que saíram dele: ${r.carros.slice(0, 8).map((c) => `${c.b} ${c.m}`).join(', ')} e mais ${r.carros.length - 8} modelos.`}>
  <TopoArte trilha={[['Início', '/index.html'], ['Carros', '/carros.html']]} titulo="Peças por carro"
    lead="Cada carro aqui passou pelo nosso pátio. Escolha o seu e veja as peças originais que saíram dele."
    arte="/arte/v2/topo-carros.webp" />

  <div class="moldura">
    <div class="filtro-carros" role="search">
      <label class="busca"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <input type="search" placeholder="Digite o modelo, por exemplo Compass" aria-label="Filtrar carros" data-filtro-carros /></label>
      <div class="marcas-filtro" data-marcas>
        <button type="button" aria-pressed="true" data-marca="">Todas</button>
        {marcas.map((m) => { const l = logoInfo(kMarca(m), 26, 18); return (
          <button type="button" aria-pressed="false" data-marca={m}>
            <span class="chip-logo">{l && <img src={l.src} alt="" width={l.w} height={l.h} class={l.png ? 'png' : 'svg'} loading="lazy" />}</span>{m}
          </button>); })}
      </div>
    </div>

    <section class="bloco-carros" aria-labelledby="h-carros">
      <div class="cabeca"><h2 class="titulo-secao" id="h-carros">Todos os carros do pátio</h2><p class="lead">{r.carros.length} carros, do que tem mais peças para o que tem menos. Toque no seu.</p></div>
      <CarrosPatio todos />
    </section>
    <p class="nenhum" data-nenhum hidden>Nenhum carro com esse nome por aqui. <a href="/procuro-peca.html">Peça para a gente procurar no pátio</a>.</p>
  </div>
</Pagina>
<script>
  const inp = document.querySelector<HTMLInputElement>('[data-filtro-carros]');
  const botoes = [...document.querySelectorAll<HTMLButtonElement>('[data-marca]')];
  const nenhum = document.querySelector<HTMLElement>('[data-nenhum]');
  // cartoes com arte (CarrosPatio) e linhas da lista: o modelo e a marca vem do texto do cartao
  const itens = [...document.querySelectorAll<HTMLElement>('.carros-v2 > li')];
  const norm = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/[^a-z0-9]/g, '');
  const dadosDe = (el: HTMLElement) => {
    const nome = (el.querySelector('b')?.textContent || '').trim();
    const marca = el.dataset.b || botoes.map((b) => b.dataset.marca || '').find((m) => m && nome.startsWith(m + ' ')) || '';
    return { nome, marca };
  };
  let marcaAtiva = '';
  const aplicar = () => {
    const q = norm(inp?.value || '');
    let n = 0;
    itens.forEach((el) => {
      const { nome, marca } = dadosDe(el);
      const ok = (!marcaAtiva || marca === marcaAtiva) && (!q || norm(nome).includes(q));
      el.hidden = !ok; if (ok) n++;
    });
    if (nenhum) nenhum.hidden = n > 0;
  };
  inp?.addEventListener('input', aplicar);
  botoes.forEach((b) => b.addEventListener('click', () => {
    marcaAtiva = b.dataset.marca || ''; botoes.forEach((x) => x.setAttribute('aria-pressed', String(x === b))); aplicar();
  }));
</script>
<style>
  .filtro-carros { display: grid; gap: 14px; margin-bottom: 8px; }
  .filtro-carros .busca { max-width: 640px; }
  .marcas-filtro { display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; padding: 2px; }
  @media (min-width: 900px) { .marcas-filtro { flex-wrap: wrap; } }
  .marcas-filtro button { flex: none; display: inline-flex; align-items: center; gap: 8px; height: 42px; padding: 0 14px 0 6px; border: 0; border-radius: 12px;
    background: var(--surface); box-shadow: inset 0 0 0 1px var(--line); font-weight: 650; font-size: 14.5px; color: var(--ink); cursor: pointer; transition: box-shadow .2s; }
  .marcas-filtro button:first-child { padding-left: 14px; }
  .marcas-filtro button:hover { box-shadow: inset 0 0 0 1.5px var(--ink-3); }
  .chip-logo { width: 32px; height: 30px; display: grid; place-items: center; border-radius: 9px; background: #f3f2ef; }
  .chip-logo:empty { display: none; }
  .chip-logo img.svg { filter: brightness(0) saturate(100%) invert(9%) sepia(5%) saturate(500%) hue-rotate(200deg); }
  .marcas-filtro button[aria-pressed="true"] { background: var(--ink); color: var(--bg); box-shadow: none; }
  .bloco-carros { padding-top: clamp(40px, 6vw, 72px); }
  .cabeca { display: grid; gap: 8px; margin-bottom: 24px; }
  .cabeca .lead { margin: 0; }
  .nenhum { padding-bottom: 72px; color: var(--ink-2); } .nenhum a { color: var(--accent-text); font-weight: 600; text-decoration: underline; }
</style>
