---
// 404. O GitHub Pages devolve esta página (com o status 404) para todo endereço que não existe.
// Peça vendida (cliente oculto, atrito 3): o site só tem as peças ativas, então o link de uma peça que vendeu (no
// Google, no WhatsApp, no Instagram) cai aqui. Quando o endereço é /peca/<slug>-<MLB>.html, a página vira "Essa peça
// já foi vendida": o nome e o carro lidos do endereço (lib/vendida.ts, com o dicionário do estoque que vai abaixo),
// "Me avise se chegar outra" no WhatsApp, "Ver parecidas" no catálogo e até 6 cartões parecidos. O script do <head>
// marca html.nf-peca antes do 1º desenho (o "Página não encontrada" nunca pisca) e deixa o GA4 mandar peca_vendida.
// Qualquer outro endereço: a 404 de sempre.
import Pagina from '../layouts/Pagina.astro';
import Icone from '../components/Icone.astro';
import { readFileSync, existsSync } from 'node:fs';
import { join } from 'node:path';
import { whatsUrl, SITE, pecas, pecaPorId } from '../lib/dados';
import { montarDicionario, conferirAntes, RE_MLB_PECA, SHARDS } from '../lib/vendida';
import { scriptCurto } from '../lib/scriptCurto';

const canonical = `${SITE}/404.html`;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Início', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Página não encontrada', item: canonical },
  ],
};
// marcas, modelos e a grafia das palavras do estoque (~7 KB; só a 404 leva)
const dic = JSON.stringify(montarDicionario(pecas())).replace(/</g, '\\u003c');
// Anúncio tirado do site de propósito (excluir_do_site.json, na raiz: gêmeo de outro, mesmo título, preço e fotos): o
// endereço dele não é "peça vendida". Com o gêmeo à venda (o MLB que o motivo cita), a 404 leva para ele; sem gêmeo à
// venda, diz "Essa peça saiu do site" (nunca "já foi vendida": não foi).
const arqExcluidos = join(process.cwd(), '..', 'excluir_do_site.json');
const excluidos: Record<string, string> = existsSync(arqExcluidos) ? JSON.parse(readFileSync(arqExcluidos, 'utf-8')) : {};
const gemeas = Object.fromEntries(Object.entries(excluidos).flatMap(([id, motivo]) => {
  const outro = (String(motivo).match(/MLB\d{6,14}/g) ?? []).find((x) => x !== id && pecaPorId(x));
  return outro ? [[id, outro]] : [];
}));
const foraDoSite = Object.keys(excluidos).filter((id) => !gemeas[id]);
// Antes do 1º desenho (lib/vendida.ts: conferirAntes): o endereço tem MLB de peça? Só o <main> fica escondido (o cabeçalho
// aparece), o arquivo do estoque é pedido daqui mesmo e a peça que segue à venda abre sem esperar o script da página.
// 400 ms sem resposta: "Abrindo a peça…"; 2,5 s: a página aparece dizendo que ainda confere (nunca "Página não
// encontrada" antes de saber: com rede lenta eram 4 s de tela branca e depois a 404 por ~2,7 s; revisão 14, item 25).
const ESPERA_MS = 400;
const TETO_MS = 2500;
const topo = scriptCurto(`(${conferirAntes.toString()})(${JSON.stringify(RE_MLB_PECA.source)},${SHARDS},${JSON.stringify(gemeas)},${ESPERA_MS},${TETO_MS})`);
---
<Pagina
  titulo="Página não encontrada | Izzat Car Imports"
  descricao="Essa página não existe ou saiu do ar. Busque a peça no catálogo ou fale com a gente pelo WhatsApp."
  canonical={canonical}
  noindex
>
  <Fragment slot="head">
    <script is:inline set:html={topo} />
    <style is:inline set:html=".nf-conferindo main{visibility:hidden}" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(ld)} />
  </Fragment>

  {/* a conferência demorou mais de 400 ms (html.nf-abrindo): um aviso calmo no lugar da tela vazia */}
  <p class="nf-aguarde" role="status"><i aria-hidden="true"></i>Abrindo a peça…</p>
  {/* a trilha no topo à esquerda, como nas outras páginas (antes ficava no meio, embaixo da arte) */}
  <nav class="moldura nf-trilha-wrap" aria-label="Você está em">
    <ol class="nf-trilha">
      <li><a href="/">Início</a></li>
      <li class="nf-geral"><span aria-current="page">Página não encontrada</span></li>
      <li class="nf-espera"><span aria-current="page">Conferindo a peça</span></li>
      <li class="nf-vendida"><a href="/catalogo.html">Peças</a></li>
      <li class="nf-vendida"><span aria-current="page">Peça vendida</span></li>
    </ol>
  </nav>
  <div class="moldura nf">
    <figure class="nf-arte">
      <img src="/arte/v2/404.webp" alt="" width="800" height="800" decoding="async" />
    </figure>

    <div class="nf-texto nf-geral">
      <h1 class="display nf-h1">Página não encontrada</h1>
      <p class="lead nf-lead">O link pode estar errado ou a página mudou de lugar. Busque a peça ou fale com a gente.</p>

      <form class="busca nf-busca" action="/catalogo.html" method="get" role="search">
        <Icone nome="busca" />
        <input type="search" name="q" placeholder="Peça ou código" aria-label="Buscar peça, carro ou código" autocomplete="off" enterkeyhint="search" />
        <button type="submit" class="botao botao-laranja botao-buscar" aria-label="Buscar"><Icone nome="busca" /><span>Buscar</span></button>
      </form>

      <div class="nf-links">
        <a class="botao botao-linha nf-botao" href="/catalogo.html">Ver o catálogo</a>
        <a class="botao botao-linha nf-botao" href="/carros.html">Peças por carro</a>
        <a class="botao botao-laranja nf-botao" href={whatsUrl('Procuro uma peça.')} rel="noopener" data-botao="404-procuro">
          <Icone nome="whats" />Chamar no WhatsApp
        </a>
      </div>
    </div>

    {/* rede lenta (html.nf-lenta, depois de 2,5 s sem resposta do estoque): a página diz que ainda confere, com saídas.
        Se a peça segue à venda, o botão "Abrir a peça" aparece aqui (nada navega sozinho depois que a pessoa já vê a página) */}
    <div class="nf-texto nf-espera" data-espera>
      <h1 class="display nf-h1" data-e-titulo>Conferindo a peça…</h1>
      <p class="lead nf-lead" role="status" data-e-lead>A conexão está lenta. A gente ainda está conferindo se esta peça continua à venda.</p>
      <div class="nf-links">
        <a class="botao botao-laranja nf-botao" href="/catalogo.html" data-e-abrir hidden>Abrir a peça</a>
        <a class="botao botao-linha nf-botao" href="/catalogo.html">Ver o catálogo</a>
        <a class="botao botao-linha nf-botao" href={whatsUrl('Procuro uma peça.')} rel="noopener" data-botao="404-conferindo">
          <Icone nome="whats" />Chamar no WhatsApp
        </a>
      </div>
    </div>

    {/* peça vendida: o texto do nome e do carro entra pelo script (lido do endereço) */}
    <div class="nf-texto nf-vendida" data-vendida>
      <h1 class="display nf-h1" data-v-h1>Essa peça já foi vendida</h1>
      <div class="nf-v-peca">
        <span class="nf-v-selo" data-v-selo>Vendida</span>
        <b class="nf-v-nome" data-v-nome></b>
        <span class="nf-v-carro num" data-v-carro></span>
      </div>
      <p class="lead nf-lead" data-v-lead>Peça usada é única: quando vende, acabou. Veja as parecidas ou receba um aviso se chegar outra.</p>
      <div class="nf-links">
        <a class="botao botao-laranja nf-botao" href={whatsUrl('Uma peça que eu vi no site já vendeu. Me avisa se chegar outra?')} rel="noopener" data-botao="vendida-avise" data-v-avise>
          <Icone nome="whats" />Me avise se chegar outra
        </a>
        <a class="botao botao-linha nf-botao" href="/catalogo.html" data-v-ver>Ver parecidas</a>
      </div>
    </div>
  </div>

  <section class="nf-vendida nf-v-grade" aria-labelledby="h-parecidas" data-v-grade>
    <div class="moldura">
      <div class="nf-v-cabeca">
        <h2 class="titulo-secao" id="h-parecidas" data-v-titulo>Parecidas à venda</h2>
        <a class="botao botao-linha" href="/catalogo.html" data-v-todas>Ver todas</a>
      </div>
      <div class="trilho nf-v-cartoes" data-v-cartoes></div>
    </div>
  </section>
  <script is:inline type="application/json" id="nf-dic" set:html={dic} />
  {foraDoSite.length > 0 && <script is:inline type="application/json" id="nf-fora" set:html={JSON.stringify(foraDoSite)} />}
</Pagina>

<script>
  import { RE_VENDIDA, mlbDoEndereco, caminhoLimpo, decidirEndereco, lerSlug, mensagemVendida, filtrosIniciais, linkFiltros, anosCurto, type Dicionario } from '../lib/vendida';
  import { linkWhats, whatsUrl } from '../lib/whats';

  const html = document.documentElement;
  // o endereço sem a barra do fim e com o MLB em maiúsculas (vendida com "mlb" minúsculo ou "….html/" vale igual)
  const caminho = caminhoLimpo(location.pathname);
  // mostra a página (a 404 de sempre, a vendida ou o que já estiver marcado): tira os estados de espera
  type Conferencia = { id: string; alvo: string; tarde: () => boolean; estoque: Promise<string | null | undefined>; fim: () => void };
  const w = window as unknown as { IZZAT_VENDIDA?: string; gtag?: (...a: unknown[]) => void; __nf?: Conferencia };
  // e para os relógios do <head> (senão a página já resolvida voltaria para "Abrindo…"/"Conferindo…")
  const revelar = () => { w.__nf?.fim(); html.classList.remove('nf-conferindo', 'nf-abrindo', 'nf-lenta'); };

  // a peça que saiu do site (o MLB não está mais no estoque e o endereço é de peça): a página "vendida" de sempre
  function mostrarVendida(mlb: string) {
    const raiz = document.querySelector<HTMLElement>('[data-vendida]');
    const json = document.getElementById('nf-dic')?.textContent;
    const m = RE_VENDIDA.exec(caminho);
    if (!raiz || !json || !m) return;
    html.classList.add('nf-peca');
    w.IZZAT_VENDIDA = mlb;
    // o GA4 (rastreio.js) lê IZZAT_VENDIDA quando carrega; se já carregou, manda daqui (uma vez só)
    if (w.gtag) w.gtag('event', 'peca_vendida', { mlb, pagina: caminho });
    document.title = 'Essa peça já foi vendida | Izzat Car Imports';
    const v = lerSlug(m[1].toLowerCase(), mlb, JSON.parse(json) as Dicionario);
    const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s);
    // anúncio tirado do site de propósito (excluir_do_site.json) e sem um igual à venda: saiu do site, não foi vendido
    const fora = (JSON.parse(document.getElementById('nf-fora')?.textContent || '[]') as string[]).includes(mlb);
    if (fora) {
      document.title = 'Essa peça saiu do site | Izzat Car Imports';
      const h1 = $('[data-v-h1]'), selo = $('[data-v-selo]'), lead = $('[data-v-lead]');
      if (h1) h1.textContent = 'Essa peça saiu do site';
      if (selo) selo.textContent = 'Fora do site';
      if (lead) lead.textContent = 'Este anúncio não está mais no site. Veja as parecidas ou chame no WhatsApp: a gente procura no pátio.';
    }
    // o nome e o carro só aparecem quando o carro foi reconhecido (texto inventado no endereço nunca vira texto do site)
    const nome = $('[data-v-nome]'), carro = $('[data-v-carro]');
    if (nome) nome.textContent = v.nome || (v.carro ? 'Peça' : `Anúncio ${v.mlb}`);
    if (carro) carro.textContent = v.carro ? [v.carro, anosCurto(v.anos)].filter(Boolean).join(' · ') : 'Anúncio do Mercado Livre';
    if (v.nome) document.title = `${fora ? 'Fora do site' : 'Vendida'}: ${[v.nome, v.carro].filter(Boolean).join(' ')} | Izzat Car Imports`;
    // a arte é só enfeite aqui (o texto dela fala da página que não existe)
    document.querySelector('.nf-arte img')?.setAttribute('alt', '');
    const avise = $<HTMLAnchorElement>('[data-v-avise]');
    if (avise) {
      avise.href = fora
        ? whatsUrl(`${v.nome ? `Procuro ${v.nome}${v.carro ? ` para ${v.carro}` : ''}. ` : ''}Vi o anúncio ${v.mlb}, que saiu do site. Tem no pátio?`)
        : linkWhats(mensagemVendida(v));
      if (fora) avise.lastChild!.textContent = 'Procurar no pátio';
    }
    const ver = $<HTMLAnchorElement>('[data-v-ver]'), todas = $<HTMLAnchorElement>('[data-v-todas]');
    const link = (href: string) => { if (ver) ver.href = href; if (todas) todas.href = href; };
    link(linkFiltros(filtrosIniciais(v)));
    if (!v.carro && ver) ver.textContent = 'Ver o catálogo';

    // as parecidas: com o índice da busca (o mesmo do catálogo), sem travar a página
    const grade = $('[data-v-grade]'), cartoes = $('[data-v-cartoes]'), titulo = $('[data-v-titulo]');
    if (v.carro && grade && cartoes) {
      import('../lib/vendidaCartoes').then(async ({ carregarParecidas, cartaoHtml, vigiarFotos }) => {
        const r = await carregarParecidas(v);
        link(linkFiltros(r.filtros));
        if (!r.itens.length) { grade.classList.add('nf-v-fora'); return; }
        if (titulo && r.doCarro) titulo.textContent = `Mais peças ${r.filtros.modelo ? `do ${r.filtros.marca} ${r.filtros.modelo}` : r.filtros.marca}`;
        vigiarFotos(cartoes);
        cartoes.innerHTML = r.itens.map(cartaoHtml).join('');
        grade.classList.add('nf-v-pronta');
      }).catch(() => { grade.classList.add('nf-v-fora'); /* sem o índice: ficam os botões, que já levam ao catálogo */ });
    } else grade?.classList.add('nf-v-fora');
  }

  // O endereço com MLB: o estoque (um arquivo pequeno, pedido pelo script do <head>: window.__nf) diz se a peça segue à
  // venda. Sem resposta (a conferência falhou), a 404 de sempre: nunca "vendida" sem ter conferido. A peça que segue à
  // venda já foi aberta pelo <head>; aqui só chega a que respondeu DEPOIS do teto (a pessoa já está vendo a página): o
  // botão "Abrir a peça" aparece, nada navega sozinho.
  async function decidir() {
    const mlb = mlbDoEndereco(caminho);
    const nf = w.__nf;
    if (!mlb || !nf) return revelar();
    document.title = 'Abrindo a peça… | Izzat Car Imports';
    const h = await nf.estoque;
    document.title = 'Página não encontrada | Izzat Car Imports';
    if (h === undefined) return revelar();
    const d = decidirEndereco(caminho, location.search, location.hash, h);
    if (d.acao === 'ir') {
      if (!nf.tarde()) { location.replace(d.destino); return; }
      const abrir = document.querySelector<HTMLAnchorElement>('[data-e-abrir]');
      const titulo = document.querySelector('[data-e-titulo]'), lead = document.querySelector('[data-e-lead]');
      if (!abrir || !titulo || !lead) { location.replace(d.destino); return; }
      document.title = 'Esta peça continua à venda | Izzat Car Imports';
      titulo.textContent = nf.alvo === nf.id ? 'Esta peça continua à venda' : 'Tem uma igual à venda';
      lead.textContent = nf.alvo === nf.id ? 'O endereço dela mudou. Abra a página de hoje:' : 'O anúncio que você abriu saiu do site, mas há um igual à venda:';
      abrir.href = d.destino;
      abrir.hidden = false;
      return;
    }
    if (d.acao === 'vendida') mostrarVendida(mlb);
    revelar();
  }
  decidir();
</script>

<style>
  /* peça vendida x 404 comum: o script do <head> marca html.nf-peca antes do 1º desenho */
  :global(html.nf-peca) .nf-geral, :global(html:not(.nf-peca)) .nf-vendida { display: none !important; }
  /* rede lenta (html.nf-lenta): no lugar das duas, "Conferindo a peça…" com as saídas */
  :global(html.nf-lenta) :is(.nf-geral, .nf-vendida), :global(html:not(.nf-lenta)) .nf-espera { display: none !important; }
  /* "Abrindo a peça…" (html.nf-abrindo, depois de 400 ms escondida): no alto da área da página, com o cabeçalho à vista */
  .nf-aguarde { display: none; }
  :global(html.nf-abrindo) .nf-aguarde {
    visibility: visible; position: absolute; left: 0; right: 0; top: 0; z-index: 1; margin: 0; padding-top: clamp(96px, 22vh, 200px);
    display: flex; align-items: center; justify-content: center; gap: 12px; font-size: 17px; font-weight: 600; color: var(--ink-2);
  }
  :global(html.nf-conferindo main) { position: relative; }
  .nf-aguarde i { width: 18px; height: 18px; border-radius: 50%; border: 2.5px solid var(--line-2); border-top-color: var(--accent); animation: nf-gira .9s linear infinite; }
  @keyframes nf-gira { to { transform: rotate(1turn); } }
  @media (prefers-reduced-motion: reduce) { .nf-aguarde i { animation: none; } }

  .nf-trilha-wrap { padding-top: 14px; }
  .nf { display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(32px, 5vw, 72px); align-items: center; padding-block: clamp(8px, 3vw, 40px) clamp(56px, 8vw, 112px); }
  @media (min-width: 900px) { .nf { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } }
  .nf-arte { margin: 0; border-radius: 28px; overflow: hidden; aspect-ratio: 1 / 1; max-width: 520px; width: 100%; justify-self: center; background: #f4f3f0; box-shadow: var(--shadow-1); }
  /* celular e tablet: primeiro o título, a busca e as saídas; a arte vem depois, menor */
  @media (max-width: 899px) { .nf-arte { order: 2; max-width: 260px; } }
  .nf-arte img { width: 100%; height: 100%; object-fit: cover; }
  .nf-texto { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0; justify-items: start; min-width: 0; }
  .nf-texto > * { max-width: 100%; }
  .nf-trilha { display: flex; flex-wrap: wrap; align-items: center; margin: 0 0 14px; padding: 0; list-style: none; font-size: 13.5px; color: var(--ink-3); }
  .nf-trilha li { display: inline-flex; align-items: center; }
  .nf-trilha li + li::before { content: "/"; margin: 0 10px; color: var(--line-2); }
  .nf-trilha a { color: var(--ink-2); padding: 12px 6px; margin: -4px -6px; }
  .nf-trilha a:hover { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }
  .nf-trilha span { color: var(--ink-2); padding-block: 8px; }
  .nf-h1 { font-size: var(--h1-pagina); margin: 0; }
  .nf-lead { margin: clamp(16px, 2vw, 22px) 0 0; max-width: 44ch; }
  .nf-busca { margin-top: clamp(24px, 3.4vw, 36px); width: 100%; max-width: 560px; }
  .nf-busca .botao { padding: 0 18px; }
  .nf-links { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 20px; }
  .nf-botao { white-space: normal; height: auto; min-height: var(--h); padding-block: 12px; text-align: center; line-height: 1.2; max-width: 100%; }
  @media (max-width: 600px) { .nf-botao { width: 100%; } }

  /* peça vendida: a ficha da peça (nome e carro), os botões e as parecidas; no celular, sem a arte (as parecidas sobem) */
  :global(html.nf-peca) .nf { padding-block-end: clamp(32px, 5vw, 64px); }
  @media (max-width: 899px) { :global(html.nf-peca) .nf-arte { display: none; } }
  @media (min-width: 900px) { :global(html.nf-peca) .nf-arte { max-width: 440px; } }
  .nf-v-peca { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 2px 12px; align-items: center; width: 100%; max-width: 520px;
    margin-top: clamp(18px, 2.4vw, 26px); padding: 14px 18px; border-radius: 18px; background: var(--surface); box-shadow: var(--shadow-1);
    min-height: 74px; }
  .nf-v-selo { grid-row: 1 / 3; align-self: center; padding: 6px 10px; border-radius: 999px; background: var(--ink); color: var(--bg);
    font-size: 12.5px; font-weight: 750; letter-spacing: .02em; text-transform: uppercase; }
  .nf-v-nome { font-stretch: 88%; font-weight: 800; font-size: 18px; line-height: 1.2; color: var(--ink); text-wrap: balance; min-height: 1.2em; }
  .nf-v-carro { font-size: 14.5px; line-height: 1.35; color: var(--ink-2); min-height: 1.35em; }
  .nf-vendida .nf-lead { margin-top: 16px; }

  .nf-v-grade { padding-block: clamp(36px, 5vw, 64px) clamp(56px, 8vw, 96px); background: var(--bg-2); }
  .nf-v-cabeca { display: grid; gap: 14px; margin-bottom: 18px; align-items: end; }
  /* o lugar das parecidas fica guardado desde o 1º desenho (html.nf-peca vem do <head>): quando os cartões chegam, o rodapé
     não desce (CLS 0,15 no celular lento). Sem carro reconhecido ou sem parecidas, o script tira a seção (.nf-v-fora). */
  .nf-v-grade:not(.nf-v-pronta) { visibility: hidden; }   /* sem o atributo hidden: o do Tailwind é display:none !important numa camada, não dá para reservar o lugar */
  .nf-v-grade.nf-v-fora { display: none !important; }
  .nf-v-cartoes:empty { min-height: 435px; }
  @media (min-width: 1024px) { .nf-v-cartoes:empty { min-height: 985px; } }
  @media (min-width: 1280px) { .nf-v-cartoes:empty { min-height: 419px; } }
  @media (min-width: 768px) { .nf-v-cabeca { grid-template-columns: 1fr auto; } }
  .nf-v-cabeca .titulo-secao { margin: 0; font-size: clamp(24px, 2.4vw, 30px); line-height: 1.05; }
  @media (max-width: 767px) { .nf-v-cabeca .botao { justify-self: start; } }
  /* como o "Do mesmo carro" da peça: trilho no celular; no PC, 3 por fila e 6 numa fila só no PC largo */
  @media (min-width: 1024px) { .nf-v-cartoes { grid-auto-flow: row; grid-template-columns: repeat(3, minmax(0, 1fr)); overflow: visible; scroll-snap-type: none; } }
  @media (min-width: 1280px) { .nf-v-cartoes { grid-template-columns: repeat(6, minmax(0, 1fr)); } }
</style>
