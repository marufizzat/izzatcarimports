---
import Pagina from '../../layouts/Pagina.astro';
import TopoArte from '../../components/TopoArte.astro';
import GradePecas from '../../components/GradePecas.astro';
import ModelosMarca from '../../components/marca/ModelosMarca.astro';
import TextoApoio from '../../components/TextoApoio.astro';
import { pecas, resumo, logoInfo } from '../../lib/dados';
import { textosMarca, tituloMarca } from '../../lib/textos';
export function getStaticPaths() { return resumo().marcas.map((m) => ({ params: { k: m.k }, props: { k: m.k } })); }
const r = resumo();
const m = r.marcas.find((x) => x.k === Astro.props.k)!;
const lista = pecas().filter((p) => p.b === m.n).sort((a, b) => (b.id > a.id ? 1 : -1));
const carros = r.carros.filter((c) => c.b === m.n);
const logo = logoInfo(m.k, 160, 90);
const texto = textosMarca(m, lista);
const qtd = (n: number, um: string, varios: string) => `${n.toLocaleString('pt-BR')} ${n === 1 ? um : varios}`;
const lead = m.m.length > 0
  ? `${qtd(m.c, 'peça original', 'peças originais')} de ${qtd(m.m.length, 'modelo', 'modelos')}. Escolha o seu carro ou confira as mais novas.`
  : `${qtd(m.c, 'peça original', 'peças originais')} de ${m.n}. As mais novas estão logo abaixo.`;
---
<Pagina titulo={tituloMarca(m.n)} descricao={texto.meta}>
  <TopoArte trilha={[['Início', '/'], ['Carros', '/carros.html'], [m.n, `/marca/${m.k}.html`]]}
    titulo={`Peças ${m.n}`} logo={logo} lead={lead} />

  <div class="moldura">
    <ModelosMarca marca={m} carros={carros} logo={logo} />
    <section class="secao-lista" aria-labelledby="h-novas">
      <div class="grade-cabeca">
        <h2 class="titulo-secao" id="h-novas">As mais novas de {m.n}</h2>
        <p class="num">{lista.length > 24 ? `24 de ${lista.length.toLocaleString('pt-BR')} peças` : `${lista.length} ${lista.length === 1 ? 'peça' : 'peças'}`}</p>
      </div>
      <div class="mais-novas"><GradePecas lista={lista.slice(0, 24)} total={lista.length} linkTodas={`/catalogo.html?marca=${encodeURIComponent(m.n)}`} /></div>
    </section>
    {/* texto de apoio no fim: a escolha do carro e as peças vêm antes */}
    <section class="secao-lista secao-apoio">
      <TextoApoio paragrafos={texto.paragrafos} />
    </section>
  </div>
</Pagina>
<style>
  .secao-lista { padding-top: clamp(40px, 6vw, 64px); padding-bottom: 24px; }
  .secao-lista:last-child { padding-bottom: 72px; }
  .grade-cabeca { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 6px 20px; margin-bottom: clamp(18px, 2.4vw, 26px); }
  .grade-cabeca h2 { margin: 0; }
  .grade-cabeca p { margin: 0; font-size: 15px; color: var(--ink-2); }
  .mais-novas { margin-top: 4px; }
</style>
