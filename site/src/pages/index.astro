---
import Pagina from '../layouts/Pagina.astro';
import AberturaV2 from '../components/v2/AberturaV2.astro';
import SelosV2 from '../components/v2/SelosV2.astro';
import GradeCategorias from '../components/v2/GradeCategorias.astro';
import NuvemMarcas from '../components/v2/NuvemMarcas.astro';
import CarrosPatio from '../components/v2/CarrosPatio.astro';
import BannerV2 from '../components/v2/BannerV2.astro';
import CartaoPeca from '../components/CartaoPeca.astro';
import SugestoesBusca from '../components/ui/SugestoesBusca';
import Acordeao from '../components/ui/Acordeao.astro';
import { pecaPorId, resumo, whatsUrl, temEstudio, SITE } from '../lib/dados';

const r = resumo();
const chegou = r.chegou.map(pecaPorId).filter((p): p is NonNullable<typeof p> => !!p && temEstudio(p.id)).slice(0, 14);
const msgServe = 'Olá! Quero saber se uma peça serve no meu carro. Meu carro é: ____ (modelo) ____ (ano). A peça é: ____';
const msgOficina = 'Olá! Sou de oficina/revenda e quero mandar uma lista de peças. Carro e ano: ____. Peças: ____';
const msgProcura = 'Olá! Não achei a peça no site. Meu carro é ____ (modelo e ano) e procuro: ____';

const perguntas = [
  ['A peça é original?', 'Sim. Toda peça sai de um carro com baixa legal no Detran-RS e é original de fábrica. Somos desmanche credenciado, CDV nº 01060.'],
  ['Tem garantia?', 'Tem: 90 dias de garantia em toda peça. Se der problema nesse prazo, fale com a gente pelo WhatsApp com o número do pedido e fotos.'],
  ['Vocês emitem nota fiscal?', 'Sim, em toda venda.'],
  ['Como sei se a peça serve no meu carro?', 'Confira o carro e os anos na página da peça e o código gravado. Na dúvida, mande o modelo e o ano do seu carro no WhatsApp que a gente confere na peça antes de você comprar.'],
  ['Como faço para comprar?', 'Pelo Mercado Livre, no botão de cada peça, ou direto pelo WhatsApp, com a mensagem já pronta.'],
  ['Enviam para todo o Brasil?', 'Sim, com código de rastreio. Pelo WhatsApp a gente cota o frete para o seu CEP.'],
  ['Não achei a peça. E agora?', 'Nem toda peça está anunciada. Mande o carro e a peça no WhatsApp que a gente procura no pátio.'],
];
const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'AutoPartsStore', '@id': `${SITE}/#loja`, name: 'Izzat Car Imports', url: `${SITE}/`,
      logo: `${SITE}/identidade/logo.png`, image: `${SITE}/identidade/og.jpg`, telephone: '+55 53 99117-0950',
      description: 'Desmanche credenciado pelo Detran-RS (CDV nº 01060). Peças originais de carros com baixa legal, nota fiscal e 90 dias de garantia.',
      address: { '@type': 'PostalAddress', addressLocality: 'Aceguá', addressRegion: 'RS', addressCountry: 'BR' },
      sameAs: ['https://instagram.com/cdvizzatcarimports', 'https://www.mercadolivre.com.br/perfil/IZZAT_CAR_IMPORTS'] },
    { '@type': 'WebSite', '@id': `${SITE}/#site`, url: `${SITE}/`, name: 'Izzat Car Imports', inLanguage: 'pt-BR',
      potentialAction: { '@type': 'SearchAction', target: `${SITE}/catalogo.html?q={busca}`, 'query-input': 'required name=busca' } },
  ],
};
---
<Pagina titulo="Izzat Car Imports | Peças originais de desmanche legalizado"
        descricao={`Peças originais de carros com baixa legal no Detran-RS (CDV nº 01060). Nota fiscal e 90 dias de garantia em toda peça. Ache pelo carro ou pelo código gravado.`}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(ld)} />
  <link slot="head" rel="preload" as="image" href="/arte/v2/abertura-estudio.webp" media="(min-width: 768px)" fetchpriority="high" />
  <link slot="head" rel="preload" as="image" href="/arte/v2/abertura-estudio-celular.webp" media="(max-width: 767px)" fetchpriority="high" />

  <AberturaV2 arte="/arte/v2/abertura-estudio.webp" arteCelular="/arte/v2/abertura-estudio-celular.webp">
    <SugestoesBusca slot="busca" client:idle tamanho="grande" placeholder="Peça, carro ou código" />
  </AberturaV2>

  <section class="selos-faixa" aria-label="Garantias da Izzat Car">
    <div class="moldura"><SelosV2 /></div>
  </section>

  <section class="secao" aria-labelledby="t-cat">
    <div class="moldura">
      <div class="cabeca-secao linha">
        <div>
          <h2 id="t-cat" class="titulo-secao">Peças por sistema do carro</h2>
          <p class="lead">Escolha a parte do carro e veja tudo o que tem no estoque.</p>
        </div>
        <a class="botao botao-linha" href="/catalogo.html">Ver o catálogo inteiro</a>
      </div>
      <GradeCategorias />
    </div>
  </section>

  <section class="secao faixa" aria-labelledby="t-chegou">
    <div class="moldura">
      <div class="cabeca-secao linha">
        <div>
          <h2 id="t-chegou" class="titulo-secao">Chegou no pátio</h2>
          <p class="lead">Os anúncios mais novos, direto do desmonte.</p>
        </div>
        <div class="cabeca-acoes">
          <span class="setas" aria-hidden="false">
            <button type="button" class="seta" data-rolar="-1" aria-label="Peças anteriores"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg></button>
            <button type="button" class="seta" data-rolar="1" aria-label="Próximas peças"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg></button>
          </span>
          <a class="botao botao-linha" href="/catalogo.html?ordem=novos">Ver todas as novidades</a>
        </div>
      </div>
      <div class="trilho" data-trilho>{chegou.map((p, i) => <CartaoPeca p={p} eager={i < 2} />)}</div>
    </div>
  </section>

  <section class="secao secao-banner">
    <div class="moldura">
      <BannerV2 nome="banner-serve" href={whatsUrl(msgServe)}
        texto="Serve no meu carro? Manda o modelo e o ano. A gente confere e te responde com foto. Chamar no WhatsApp" />
    </div>
  </section>

  <section class="secao" aria-labelledby="t-marcas">
    <div class="moldura">
      <div class="cabeca-secao">
        <h2 id="t-marcas" class="titulo-secao">Escolha pela marca do seu carro</h2>
        <p class="lead">{r.marcas.length} marcas no estoque. Toque na sua para ver só as peças dela.</p>
      </div>
      <NuvemMarcas />
    </div>
  </section>

  <section class="secao secao-banner">
    <div class="moldura">
      <BannerV2 nome="banner-nao-achou" href={whatsUrl(msgProcura)}
        texto="Não achou a peça? A gente procura no pátio. Nem toda peça está anunciada. Manda o carro e a peça no WhatsApp. Chamar no WhatsApp" />
    </div>
  </section>

  <section class="secao faixa" aria-labelledby="t-carros">
    <div class="moldura">
      <div class="cabeca-secao linha">
        <div>
          <h2 id="t-carros" class="titulo-secao">Carros do pátio</h2>
          <p class="lead">Escolha o carro e veja todas as peças que saíram dele.</p>
        </div>
        <a class="botao botao-linha" href="/carros.html">Ver os {r.carros.length} carros</a>
      </div>
      <CarrosPatio />
    </div>
  </section>

  <section class="secao" aria-labelledby="t-como">
    <div class="moldura">
      <div class="cabeca-secao linha">
        <div>
          <h2 id="t-como" class="titulo-secao">Como comprar</h2>
          <p class="lead">Do código gravado na peça até a sua porta.</p>
        </div>
        <a class="botao botao-linha" href="/como-comprar.html">Ver os detalhes</a>
      </div>
      <ol class="passos">
        {[['Ache a peça', 'Pelo nome, pelo carro ou pelo código gravado.'],
          ['Confirme o seu carro', 'Manda o modelo e o ano. A gente confere na peça.'],
          ['Feche a compra', 'No Mercado Livre ou direto pelo WhatsApp.'],
          ['Receba em casa', 'Com nota fiscal e código de rastreio.']].map(([t, s], i) => (
          <li><img src={`/arte/v2/passo-${i + 1}.webp`} alt={`${i + 1}. ${t}. ${s}`} width="800" height="800" loading="lazy" decoding="async" /></li>
        ))}
      </ol>
    </div>
  </section>


  <section class="secao faixa secao-banner">
    <div class="moldura">
      <BannerV2 nome="banner-oficinas" href={whatsUrl(msgOficina)}
        texto="Oficinas e revendas: separamos as peças pra sua oficina. Manda a lista com carro e ano: a gente confere e responde com foto e código. Falar com a gente" />
    </div>
  </section>

  <section class="secao" aria-labelledby="t-faq">
    <div class="moldura faq">
      <div class="cabeca-secao">
        <h2 id="t-faq" class="titulo-secao">Perguntas que a gente mais recebe</h2>
        <p class="lead">Respostas curtas, do jeito que a gente responde no balcão.</p>
        <aside class="faq-ajuda">
          <img src="/arte/v2/atendimento.webp" alt="" width="1024" height="537" loading="lazy" decoding="async" />
          <div class="faq-ajuda-txt">
            <b>Ficou outra dúvida?</b>
            <span>Manda no WhatsApp. Quem responde é a equipe do pátio.</span>
            <a class="botao botao-laranja" href={whatsUrl('Olá! Tenho uma dúvida:')}>Perguntar no WhatsApp</a>
          </div>
        </aside>
      </div>
      <Acordeao itens={perguntas.map(([pergunta, resposta]) => ({ pergunta, resposta }))} />
    </div>
  </section>
</Pagina>

<script>
  document.querySelectorAll<HTMLElement>('section').forEach((sec) => {
    const t = sec.querySelector<HTMLElement>('[data-trilho]');
    const bs = sec.querySelectorAll<HTMLButtonElement>('[data-rolar]');
    if (!t || !bs.length) return;
    const atualiza = () => { bs[0].disabled = t.scrollLeft < 8; bs[1].disabled = t.scrollLeft + t.clientWidth > t.scrollWidth - 8; };
    bs.forEach((b) => b.addEventListener('click', () => t.scrollBy({ left: Number(b.dataset.rolar) * t.clientWidth * 0.8, behavior: 'smooth' })));
    t.addEventListener('scroll', atualiza, { passive: true }); atualiza();
  });
</script>

<style>
  .cabeca-secao { display: grid; gap: 8px; margin-bottom: 28px; max-width: 62ch; }
  .cabeca-secao.linha { max-width: none; grid-template-columns: 1fr; align-items: end; gap: 16px; }
  @media (min-width: 768px) { .cabeca-secao.linha { grid-template-columns: 1fr auto; } }
  .cabeca-secao .lead { margin: 0; }
  .titulo-secao { margin: 0; }
  .faixa { background: var(--bg-2); }

  .selos-faixa { position: relative; z-index: 1; margin-top: -28px; }
  @media (max-width: 767px) { .selos-faixa { margin-top: 0; padding-top: 4px; } }
  .secao-banner { padding-block: clamp(28px, 4vw, 56px); }

  .passos { list-style: none; margin: 0; padding: 4px 4px 12px; display: grid; grid-auto-flow: column; grid-auto-columns: 78%; gap: 14px;
            overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
  .passos::-webkit-scrollbar { display: none; }
  .passos li { scroll-snap-align: start; }
  .passos img { display: block; width: 100%; height: auto; border-radius: 22px; box-shadow: var(--shadow-1); background: #efeeeb; }
  @media (min-width: 900px) { .passos { grid-auto-flow: row; grid-template-columns: repeat(4, 1fr); overflow: visible; gap: 18px; } }

  .cabeca-acoes { display: flex; align-items: center; gap: 12px; }
  .setas { display: none; gap: 8px; }
  @media (min-width: 900px) and (hover: hover) { .setas { display: inline-flex; } }
  .seta { width: 48px; height: 48px; display: grid; place-items: center; border-radius: 50%; border: 0; cursor: pointer; background: var(--surface);
    color: var(--ink); box-shadow: inset 0 0 0 1px var(--line-2); transition: box-shadow .2s, transform .2s; }
  .seta svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .seta:hover { box-shadow: inset 0 0 0 1.5px var(--ink-3), 0 6px 14px -8px rgb(0 0 0 / .3); }
  .seta:disabled { opacity: .35; cursor: default; box-shadow: inset 0 0 0 1px var(--line); }
  .seta:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }

  .faq { display: grid; gap: 8px; }
  @media (min-width: 1024px) { .faq { grid-template-columns: .85fr 1.15fr; gap: 56px; align-items: start; } }
  .faq-ajuda { margin-top: 18px; border-radius: 24px; overflow: hidden; background: var(--surface); box-shadow: var(--shadow-1); }
  .faq-ajuda img { display: block; width: 100%; height: auto; background: #efeeeb; }
  .faq-ajuda-txt { display: grid; gap: 6px; padding: 18px 20px 20px; }
  .faq-ajuda b { font-stretch: 86%; font-weight: 800; font-size: 20px; }
  .faq-ajuda span { font-size: 15px; color: var(--ink-2); }
  .faq-ajuda .botao { margin-top: 10px; justify-self: start; }
  @media (min-width: 1024px) { .faq .cabeca-secao { position: sticky; top: 110px; } }
</style>
