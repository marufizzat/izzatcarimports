---
import { lojaLd } from '../lib/loja';
import Pagina from '../layouts/Pagina.astro';
import AberturaV2 from '../components/v2/AberturaV2.astro';
import SelosV2 from '../components/v2/SelosV2.astro';
import GradeCategorias from '../components/v2/GradeCategorias.astro';
import NuvemMarcas from '../components/v2/NuvemMarcas.astro';
import CarrosPatio from '../components/v2/CarrosPatio.astro';
import BannerV2 from '../components/v2/BannerV2.astro';
import VitrineDestaques from '../components/v2/VitrineDestaques.astro';
import OficinasV2 from '../components/v2/OficinasV2.astro';
import Coverflow from '../components/v2/Coverflow.astro';
import VoceViu from '../components/v2/VoceViu.astro';
import ChegouCarro from '../components/v2/ChegouCarro.astro';
import SugestoesBusca from '../components/ui/SugestoesBusca';
import Acordeao from '../components/ui/Acordeao.astro';
import Icone from '../components/Icone.astro';
import { pecaPorId, resumo, marcasVisiveis, whatsUrl, temEstudio, SITE } from '../lib/dados';

const r = resumo();
const chegou = r.chegou.map(pecaPorId).filter((p): p is NonNullable<typeof p> => !!p && temEstudio(p.id)).slice(0, 14);
const msgServe = 'Quero saber se uma peça serve no meu carro. Meu carro é: ____ (modelo) ____ (ano). A peça é: ____';
const msgProcura = 'Não achei a peça no site. Meu carro é ____ (modelo e ano) e procuro: ____';

const perguntas = [
  ['A peça é original?', 'Sim. Toda peça sai de um carro com baixa legal no Detran-RS e é original de fábrica. Somos desmanche credenciado, CDV nº 01060.'],
  ['Tem garantia?', 'Tem: 90 dias de garantia em toda peça. Se der problema nesse prazo, fale com a gente pelo WhatsApp com o número do pedido e fotos.'],
  ['Vocês emitem nota fiscal?', 'Sim, em toda venda.'],
  ['Como sei se a peça serve no meu carro?', 'Confira o carro e os anos na página da peça e o código gravado. Na dúvida, mande o modelo e o ano do seu carro no WhatsApp que a gente confere na peça antes de você comprar.'],
  ['Como faço para comprar?', 'Pelo Mercado Livre, no botão de cada peça, ou direto pelo WhatsApp, com a mensagem já pronta.'],
  ['Enviam para todo o Brasil?', 'Sim. Pelo WhatsApp, o frete é combinado na hora, pelo seu CEP. Comprando pelo Mercado Livre, o frete e o prazo são os calculados lá, no anúncio.'],
  ['Não achei a peça. E agora?', 'Nem toda peça está anunciada. Mande o carro e a peça no WhatsApp que a gente procura no pátio.'],
];
const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    lojaLd(),
    { '@type': 'WebSite', '@id': `${SITE}/#site`, url: `${SITE}/`, name: 'Izzat Car Imports', alternateName: ['IzzatCar Imports'], inLanguage: 'pt-BR',
      potentialAction: { '@type': 'SearchAction', target: `${SITE}/catalogo.html?q={busca}`, 'query-input': 'required name=busca' } },
  ],
};
---
<Pagina titulo="Izzat Car Imports | Peças originais de desmanche legalizado" rodapeSelos={false}
        descricao={`Peças originais de carros com baixa legal no Detran-RS (CDV nº 01060). Nota fiscal e 90 dias de garantia em toda peça. Ache pelo carro ou pelo código gravado.`}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(ld)} />
  <link slot="head" rel="preload" as="image" href="/arte/v2/abertura-estudio.webp" media="(min-width: 768px)" fetchpriority="high" />
  <link slot="head" rel="preload" as="image" href="/arte/v2/abertura-estudio-celular.webp" media="(max-width: 767px)" fetchpriority="high" />

  <AberturaV2 arte="/arte/v2/abertura-estudio.webp" arteCelular="/arte/v2/abertura-estudio-celular.webp">
    <SugestoesBusca slot="busca" client:idle tamanho="grande" placeholder="Ex.: rádio XC60" />
  </AberturaV2>

  <section class="selos-faixa" aria-label="Garantias da Izzat Car">
    <div class="moldura"><SelosV2 /></div>
  </section>

  {/* da pessoa (só no navegador dela; sem histórico, nada aparece e nada se mexe) */}
  <ChegouCarro />
  <VoceViu />

  <section class="secao vitrine-secao" aria-labelledby="t-destaques">
    <div class="moldura">
      <div class="cabeca-secao">
        <h2 id="t-destaques" class="titulo-secao">Destaques do pátio</h2>
        <p class="lead">Peças originais com preço, nota fiscal e 90 dias de garantia. Abra a peça para ver as fotos e o código gravado.</p>
      </div>
      <VitrineDestaques />
      <BannerV2 class="vitrine-serve" nome="banner-serve" href={whatsUrl(msgServe)}
        texto="Serve no meu carro? Mande o modelo e o ano. A gente confere e responde com foto. Chamar no WhatsApp" />
    </div>
  </section>

  <section class="secao cv" aria-labelledby="t-cat">
    <div class="moldura">
      <div class="cabeca-secao">
        <h2 id="t-cat" class="titulo-secao">Peças por categoria</h2>
        <p class="lead">Escolha a parte do carro e confira tudo o que tem no estoque.</p>
      </div>
      <GradeCategorias />
    </div>
  </section>

  <section class="secao faixa cv" aria-labelledby="t-chegou">
    <div class="moldura">
      <div class="cabeca-secao linha">
        <div>
          <h2 id="t-chegou" class="titulo-secao">Chegou no pátio</h2>
          <p class="lead">Os anúncios mais novos, direto do pátio.</p>
        </div>
        <a class="botao botao-linha so-largo" href="/catalogo.html?ordem=novos">Ver todas as novidades</a>
      </div>
      <Coverflow id="t-chegou" rotulo="Anúncios novos do pátio" pecas={chegou} />
      <a class="botao botao-linha so-celular secao-mais" href="/catalogo.html?ordem=novos">Ver todas as novidades</a>
    </div>
  </section>

  <section class="secao cv" aria-labelledby="t-marcas">
    <div class="moldura">
      <div class="cabeca-secao">
        <h2 id="t-marcas" class="titulo-secao">Escolha pela marca do seu carro</h2>
        <p class="lead">{marcasVisiveis().length} marcas para escolher. Escolha a sua para ver só as peças dela.</p>
      </div>
      <NuvemMarcas />
    </div>
  </section>

  <section class="secao secao-banner">
    <div class="moldura">
      <BannerV2 formato="arte" nome="banner-nao-achou" href={whatsUrl(msgProcura)}
        texto="Não achou a peça? A gente procura no pátio. Nem toda peça está anunciada. Manda o carro e a peça no WhatsApp. Chamar no WhatsApp" />
    </div>
  </section>

  <section class="secao faixa cv" aria-labelledby="t-carros">
    <div class="moldura">
      <div class="cabeca-secao linha">
        <div>
          <h2 id="t-carros" class="titulo-secao">Carros do pátio</h2>
          <p class="lead">Escolha o carro e confira todas as peças que saíram dele.</p>
        </div>
        <a class="botao botao-linha so-largo" href="/carros.html">Ver os {r.carros.length} carros</a>
      </div>
      <CarrosPatio />
      <a class="botao botao-linha so-celular secao-mais" href="/carros.html">Ver os {r.carros.length} carros</a>
    </div>
  </section>

  <section class="secao cv" aria-labelledby="t-como">
    <div class="moldura">
      <div class="cabeca-secao linha">
        <div>
          <h2 id="t-como" class="titulo-secao">Como comprar</h2>
          <p class="lead">Do código gravado na peça até a sua porta.</p>
        </div>
        <a class="botao botao-linha so-largo" href="/como-comprar.html">Ver os detalhes</a>
      </div>
      {/* no celular a fila desliza de lado: ganha parada no Tab só quando rola (lib/trilhoFoco.ts: paradaSeRolar) */}
      <ol class="passos" aria-label="Como comprar, em 4 passos" data-rola>
        {[['Ache a peça', 'Pelo nome, pelo carro ou pelo código gravado.'],
          ['Confirme o seu carro', 'Mande o modelo e o ano. A gente confere na peça.'],
          ['Feche a compra', 'No Mercado Livre ou direto pelo WhatsApp.'],
          ['Receba em casa', 'Com nota fiscal e código de rastreio.']].map(([t, s], i) => (
          <li><img src={`/arte/v2/passo-${i + 1}.webp`} alt={`${i + 1}. ${t}`} width="800" height="671" loading="lazy" decoding="async" /><p>{s}</p></li>
        ))}
      </ol>
      <a class="botao botao-linha so-celular secao-mais" href="/como-comprar.html">Ver os detalhes</a>
    </div>
  </section>


  <section class="secao secao-oficinas">
    <div class="moldura">
      <OficinasV2 />
    </div>
  </section>

  <section class="secao cv" aria-labelledby="t-faq">
    <div class="moldura faq">
      <div class="cabeca-secao">
        <h2 id="t-faq" class="titulo-secao">Perguntas que a gente mais recebe</h2>
        <p class="lead">Respostas curtas, do jeito que a gente responde no balcão.</p>
      </div>
      <Acordeao itens={perguntas.map(([pergunta, resposta]) => ({ pergunta, resposta }))} />
      <div class="faq-ajuda">
        <img class="faq-ajuda-icone" src="/icones/conversa-96.webp" alt="" width="96" height="96" loading="lazy" decoding="async" />
        <div class="faq-ajuda-txt">
          <b>Ficou outra dúvida?</b>
          <span>Mande no WhatsApp. Quem responde é a equipe do pátio.</span>
          <a class="botao botao-laranja" href={whatsUrl('Tenho uma dúvida:')}><Icone nome="whats" />Chamar no WhatsApp</a>
        </div>
      </div>
    </div>
  </section>
</Pagina>

<script>
  import { paradaSeRolar } from '../lib/trilhoFoco';
  paradaSeRolar('[data-rola]');
</script>

<style>
  .cabeca-secao { display: grid; gap: 8px; margin-bottom: 28px; max-width: 62ch; }
  .cabeca-secao.linha { max-width: none; grid-template-columns: 1fr; align-items: end; gap: 16px; }
  @media (min-width: 768px) { .cabeca-secao.linha { grid-template-columns: 1fr auto; } }
  /* celular: o "Ver todas…" da seção vem DEPOIS dos cartões (antes ocupava a 1ª dobra de cada seção). Um link
     em cada lugar, cada um só na sua largura: assim a ordem do Tab é a da tela nos dois (antes o CSS trocava a
     ordem e o Tab passava pelo botão antes dos cartões) */
  .cabeca-secao.linha > div { display: grid; gap: 8px; }
  .secao-mais { display: flex; width: 100%; margin-top: 10px; }
  @media (max-width: 767px) { .so-largo { display: none; } }
  @media (min-width: 768px) { .so-celular { display: none; } }
  .cabeca-secao .lead { margin: 0; }
  .titulo-secao { margin: 0; }
  .faixa { background: var(--bg-2); }
  /* duas seções seguidas com o mesmo fundo: o respiro de uma não soma com o da outra (era um buraco de 170–224 px) */
  .secao:not(.faixa):has(+ .secao:not(.faixa)) { padding-bottom: clamp(32px, 4vw, 60px); }
  .secao:not(.faixa) + .secao:not(.faixa) { padding-top: clamp(32px, 4vw, 60px); }
  /* Fluidez: seções abaixo da dobra só são desenhadas quando chegam perto da tela (a home abre mais leve no
     celular). "auto" guarda o tamanho já desenhado (sem pulo na rolagem). Só em seções com o respiro normal
     (.secao): nada nelas passa da borda (o content-visibility corta o que passar). */
  .cv { content-visibility: auto; contain-intrinsic-size: auto 900px; }

  .selos-faixa { position: relative; z-index: 1; margin-top: -28px; }
  @media (max-width: 767px) { .selos-faixa { margin-top: 0; padding-top: 4px; } }
  .secao-banner { padding-block: clamp(28px, 4vw, 56px); }
  .secao-oficinas { padding-block: clamp(28px, 4vw, 64px); }
  .vitrine-secao { padding-top: clamp(48px, 6vw, 88px); }
  .vitrine-secao :global(.vitrine-serve) { margin-top: clamp(36px, 4.4vw, 56px); }

  /* passos: a arte mostra o número e o título; a frase vai em texto vivo embaixo (a desenhada era miúda e em outra
     fonte e fica fora do corte: as 4 artes têm o título até 668 px e a frase a partir de 674 px, de 800).
     Ao refazer as artes só com número e título, tirar o aspect-ratio do corte. */
  .passos { list-style: none; margin: 0; padding: 4px 4px 12px; display: grid; grid-auto-flow: column; grid-auto-columns: 78%; gap: 14px;
            overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
  .passos::-webkit-scrollbar { display: none; }
  .passos li { scroll-snap-align: start; display: grid; align-content: start; border-radius: 22px; overflow: hidden; box-shadow: var(--shadow-1);
               background: linear-gradient(90deg, #e9e6e4, #e1dddb); }
  .passos img { display: block; width: 100%; height: auto; aspect-ratio: 800 / 671; object-fit: cover; object-position: 50% 0; }
  .passos p { margin: -2px 0 0; padding: 0 clamp(16px, 6%, 24px) clamp(16px, 6%, 22px); font-size: 15px; line-height: 1.4; color: #3d3d42; text-wrap: pretty; }
  @media (min-width: 600px) { .passos { grid-auto-flow: row; grid-auto-columns: auto; grid-template-columns: repeat(2, minmax(0, 1fr)); overflow: visible; gap: 16px; } }
  @media (min-width: 900px) { .passos { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px; } }


  .faq { display: grid; gap: 8px; }
  /* PC: título e a ajuda na coluna da esquerda, perguntas na direita (no HTML a ajuda vem depois das perguntas) */
  @media (min-width: 1024px) {
    /* a 3ª linha (1fr) recebe a altura das perguntas: título e ajuda ficam colados em cima, como antes */
    .faq { grid-template-columns: .85fr 1.15fr; grid-template-rows: auto auto 1fr; column-gap: 56px; row-gap: 0; align-items: start; }
    .faq > .cabeca-secao { grid-column: 1; grid-row: 1; }
    /* (:global: as perguntas são outro componente, sem o escopo desta página) */
    .faq > :global(:not(.cabeca-secao, .faq-ajuda)) { grid-column: 2; grid-row: 1 / span 3; }
    .faq > .faq-ajuda { grid-column: 1; grid-row: 2; }
  }
  .faq-ajuda { margin-top: 18px; display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 16px; align-items: start;
               padding: 20px 22px 22px; border-radius: 24px; background: var(--surface); box-shadow: var(--shadow-1); }
  .faq-ajuda-icone { width: 52px; height: 52px; filter: drop-shadow(0 8px 14px rgb(200 70 0 / .22)); }
  .faq-ajuda-txt { display: grid; gap: 6px; }
  .faq-ajuda b { font-stretch: 86%; font-weight: 800; font-size: 20px; }
  .faq-ajuda span { font-size: 15px; color: var(--ink-2); }
  .faq-ajuda .botao { margin-top: 10px; justify-self: start; }
  /* celular e tablet: o "Ficou outra dúvida?" vem depois das perguntas */
  @media (max-width: 1023px) {
    .faq .cabeca-secao .lead { margin-bottom: 20px; }
    .faq-ajuda { margin-top: 16px; }
  }
</style>
