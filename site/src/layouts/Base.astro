---
import '../styles/global.css';
interface Props {
  titulo: string; descricao?: string; direcao?: 'a' | 'b' | 'c'; canonical?: string;
  ogImagem?: string; noindex?: boolean; ogTipo?: 'website' | 'product';
  /** prévia do link (WhatsApp, Facebook) diferente do <title>/description do Google (a peça: o preço primeiro) */
  ogTitulo?: string; ogDescricao?: string;
}
const { titulo, descricao = 'Peças originais de carros com baixa legal no Detran-RS. Nota fiscal e 90 dias de garantia em toda peça. Envio para todo o Brasil.',
        direcao = 'a', canonical, ogImagem = '/identidade/og.jpg', noindex = false, ogTipo = 'website' } = Astro.props;
const { ogTitulo = titulo, ogDescricao = descricao } = Astro.props;
const canon = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
// prévia pública (Cloudflare): o Google não indexa a cópia congelada do catálogo
const previa = process.env.PREVIA === '1';
// regras de especulação (prerender na intenção: moderate), iguais em toda página
const REGRAS = JSON.stringify({ prerender: [{ where: { href_matches: ['/peca/*', '/carros/*', '/carros.html', '/categoria/*', '/marca/*', '/catalogo.html'] }, eagerness: 'moderate' }] });
---
<!doctype html>
<html lang="pt-BR" data-direcao={direcao}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{titulo}</title>
  <meta name="description" content={descricao} />
  <link rel="canonical" href={canon} />
  {/* página fora do índice (404, aviso): "noindex, follow" (os links dela continuam valendo); a prévia não segue nada.
      As outras: a foto grande nos resultados do Google (sem isso ele pode mostrar só a miniatura). */}
  {previa ? <meta name="robots" content="noindex, nofollow" />
    : noindex ? <meta name="robots" content="noindex, follow" />
    : <meta name="robots" content="max-image-preview:large" />}
  {/* aparelho fraco (até 2 núcleos, até 4 GB de memória ou economia de dados): html.leve tira o vidro desfocado, o 3D
      e as animações de altura (cada componente diz o que muda). Antes do 1º desenho, para nada trocar na frente da
      pessoa. Núcleos só abaixo de 3: o Safari (iPhone, iPad, Mac) informa 4 ou 8 de propósito, nunca menos; a memória
      só o Chrome informa (iPhone fica fora, como deve). */}
  {/* tela larga (o zoom da raiz, global.css): navegador antigo em que o retângulo (getBoundingClientRect) não acompanha
      o zoom fica sem a escala (html.z1), senão a conta do toque e do mouse sairia errada. Navegador atual (o que tem
      `currentCSSZoom`: Chrome 128+, Firefox 126+, Safari novo) nem mede; o resto mede um <p> de 1 px com zoom 2, antes
      do 1º desenho. Sem script a escala vale (não há conta a errar). */}
  <script is:inline>{let n=navigator,d=document,h=d.documentElement,c=h.classList,e;(n.hardwareConcurrency<3||n.deviceMemory<5||n.connection?.saveData)&&c.add('leve');if(!('currentCSSZoom'in h)){e=d.createElement('p');e.style.cssText='position:fixed;zoom:2;width:1px';h.append(e);e.getBoundingClientRect().width<2&&c.add('z1');e.remove()}}</script>
  {/* navegar como aplicativo: a foto do cartão que voa para a página da peça e, onde não há regras de especulação,
      o HTML da próxima página baixado no toque (public/navegar.js) */}
  <script is:inline src="/navegar.js" defer></script>
  {/* a próxima página já carregada (Chrome/Edge): a peça, o carro, a categoria, a marca e o catálogo são preparados
      quando o dedo encosta no link (no PC, com o mouse parado 200 ms em cima). Só endereços do site; WhatsApp, Mercado
      Livre e o que abre noutra aba nunca. O mesmo bloco em toda página (cada byte vale 5 mil vezes). */}
  <script is:inline type="speculationrules" set:html={REGRAS} />
  <meta name="theme-color" content="#f5f5f7" />
  {/* ícone quadrado (o Google exige quadrado, múltiplo de 48 px; o carro.svg é retangular e virava o globo cinza) */}
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" href="/favicon-96.png" sizes="96x96" type="image/png" />
  <link rel="icon" href="/icone-192.png" sizes="192x192" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  {/* o app na tela de início do iPhone: o nome curto e a barra de status clara (o site é claro) */}
  <meta name="apple-mobile-web-app-title" content="Izzat Car" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  {/* fotos do ML são <img> (sem CORS): o preconnect sem crossorigin é o que elas reaproveitam */}
  <link rel="preconnect" href="https://http2.mlstatic.com" />
  <meta property="og:type" content={ogTipo} />
  <meta property="og:locale" content="pt_BR" />
  <meta property="og:site_name" content="Izzat Car Imports" />
  <meta property="og:title" content={ogTitulo} />
  <meta property="og:url" content={canon} />
  <meta property="og:description" content={ogDescricao} />
  <meta property="og:image" content={new URL(ogImagem, Astro.site).href} />
  {/* X/Twitter (e quem lê o mesmo cartão): a imagem grande, com o título e a descrição de cima */}
  <meta name="twitter:card" content="summary_large_image" />
  <slot name="head" />
</head>
<body>
  <slot />
</body>
</html>
