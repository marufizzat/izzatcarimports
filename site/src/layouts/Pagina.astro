---
// Layout de producao: cabecalho + conteudo + rodape + rastreio (GA4/Pixel).
import Base from './Base.astro';
import Cabecalho from '../components/Cabecalho.astro';
import Rodape from '../components/Rodape.astro';
interface Props { titulo: string; descricao?: string; canonical?: string; ogImagem?: string; noindex?: boolean; ogTipo?: 'website' | 'product'; ogTitulo?: string; ogDescricao?: string; produto?: object; rodapeSelos?: boolean; }
const { produto, rodapeSelos = true, ...resto } = Astro.props;
---
<Base {...resto} direcao="a">
  <Fragment slot="head">
    <slot name="head" />
    {produto && <script is:inline set:html={`window.IZZAT_PRODUCT=${JSON.stringify(produto)};`} />}
    <script is:inline src="/rastreio.js" defer></script>
  </Fragment>
  <a class="pular" href="#conteudo">Pular para o conteúdo</a>
  <Cabecalho />
  <main id="conteudo"><slot /></main>
  <Rodape selos={rodapeSelos} />
</Base>
<style is:global>
  .pular { position: absolute; left: 12px; top: -60px; z-index: 100; padding: 10px 16px; border-radius: 10px; background: var(--ink); color: var(--bg); }
  .pular:focus { top: 12px; }
  /* rede de segurança (auditoria 4, 1.1): o que vazar do conteúdo não alarga a página no celular. clip (e não hidden)
     não cria caixa de rolagem: o sticky do catálogo e da galeria continua funcionando */
  main#conteudo { overflow-x: clip; }
</style>
